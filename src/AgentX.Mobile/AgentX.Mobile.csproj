<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- iOS is excluded on Linux so the Android CI job (which can only install the maui-android
         workload — the full `maui` workload is unsupported on Linux) restores cleanly without a
         -p:TargetFrameworks override, which would disable the MAUI SDK's implicit framework
         references (UseMaui() etc.). iOS still builds on Windows/macOS. AX-QA-004. -->
    <TargetFrameworks>net8.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net8.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>AgentX.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>Agent-X Mobile</ApplicationTitle>
    <ApplicationId>com.strategia.agentx.mobile</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Track the single product version from Directory.Build.props instead of a stale
         hardcoded string, so the mobile "About" version matches the product line (AX-QA-014). -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Maui.Controls is a REQUIRED explicit PackageReference: as of .NET 8 the MAUI SDK no
         longer auto-includes it from <UseMaui>true</UseMaui> and emits warning MA002 when it is absent
         (`dotnet new maui` carries it too). Version 8.0.100 matches the maui-android workload band
         pinned by global.json (SDK 8.0.4xx). HISTORICAL NOTE (AX-QA-004): the earlier net8.0-android
         build break was NOT a missing-reference problem — Microsoft.Maui.Controls.dll was always
         resolved and Microsoft.Maui.Hosting was a global using. The defect was a wrong-API call in
         MauiProgram.cs: a non-existent parameterless `.UseMaui()`. The correct user-facing bootstrap is
         `.UseMauiApp<App>()` (it invokes the internal UseMaui for you). -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />
    <!-- Backs builder.Logging.AddDebug() in the #if DEBUG block of MauiProgram.cs. Without it a Debug
         net8.0-android build fails (CS1061 on AddDebug); Release compiles the call out. Version tracks
         the unified Microsoft.Extensions.Logging band (8.0.1) pulled in by the MAUI runtime. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="CommunityToolkit.Maui" Version="9.1.1" />
  </ItemGroup>

  <!-- App icon + splash screen (single-project resizetizer assets). Required so the Android
       build can generate @mipmap/appicon referenced by AndroidManifest.xml (AX-QA-004). -->
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#6366F1" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" BaseSize="128,128" />
  </ItemGroup>

  <!-- MAUI resource inclusions -->
  <ItemGroup>
    <MauiXaml Update="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="AppShell.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\DocumentsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\SearchPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\ConversationsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\SettingsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>
</Project>
