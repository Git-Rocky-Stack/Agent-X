  <data name="Encryption_SectionHeader.Text" xml:space="preserve"><value>Database Encryption</value></data>
  <data name="Encryption_Description.Text" xml:space="preserve"><value>Encrypt your knowledge vault with AES-256 (SQLCipher). The key is managed automatically and tied to your Windows account.</value></data>

