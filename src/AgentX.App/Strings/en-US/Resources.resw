  <data name="Privacy_PrivacyPolicy.Text" xml:space="preserve"><value>PRIVACY POLICY</value></data>
  <data name="Privacy_EffectiveDateFebruary26.Text" xml:space="preserve"><value>Effective Date: February 26, 2026</value></data>
  <data name="Privacy_StrategiaXWeUs.Text" xml:space="preserve"><value>Strategia-X ('we', 'us', 'our') operates Agent-X. This Privacy Policy explains how we handle your information when you use our desktop application.</value></data>
  <data name="Privacy_LocalFirstPrivacy.Text" xml:space="preserve"><value>Local-First Privacy</value></data>
  <data name="Privacy_YourDataNeverLeaves.Text" xml:space="preserve"><value>Your data never leaves your device. All AI processing, document storage, and conversations remain entirely on your machine.</value></data>
  <data name="Privacy_Verified.Text" xml:space="preserve"><value>VERIFIED</value></data>
  <data name="Privacy_OurCommitmentToPrivacy.Text" xml:space="preserve"><value>Our Commitment to Privacy</value></data>
  <data name="Privacy_AgentXIsDesigned.Text" xml:space="preserve"><value>Agent-X is designed with privacy as a core principle. All your data — documents, conversations, embeddings, and settings — is stored locally on your device. We do not operate cloud servers that process or store your personal data.</value></data>
  <data name="Privacy_OurLocalFirstArchitecture.Text" xml:space="preserve"><value>Our local-first architecture means you retain full ownership and control of every piece of information you create or import into Agent-X. There are no accounts to create, no data syncing, and no telemetry being transmitted.</value></data>
  <data name="Privacy_InformationWeCollect.Text" xml:space="preserve"><value>Information We Collect</value></data>
  <data name="Privacy_InformationYouProvide.Text" xml:space="preserve"><value>Information You Provide</value></data>
  <data name="Privacy_WhenYouUseAgent.Text" xml:space="preserve"><value>When you use Agent-X, the following information is created and stored locally on your device:</value></data>
  <data name="Privacy_DocumentsYouImportInto.Text" xml:space="preserve"><value>Documents you import into the Knowledge Vault</value></data>
  <data name="Privacy_ConversationsWithAiModels.Text" xml:space="preserve"><value>Conversations with AI models</value></data>
  <data name="Privacy_SettingsAndPreferencesYou.Text" xml:space="preserve"><value>Settings and preferences you configure</value></data>
  <data name="Privacy_CollectionNamesAndOrganization.Text" xml:space="preserve"><value>Collection names and organizational tags</value></data>
