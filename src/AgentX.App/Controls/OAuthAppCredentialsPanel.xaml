<UserControl
    x:Class="AgentX.App.Controls.OAuthAppCredentialsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:AgentX.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <c:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" IsInverted="True"/>
    </UserControl.Resources>

    <!-- The client of the user's own Google and Microsoft OAuth apps, shared by the Calendar
         and Email connector pages. Saving applies it at once, without a restart. -->
    <StackPanel Spacing="20">
        <StackPanel Spacing="4">
            <TextBlock x:Uid="OAuthApp_Title" Text="OAuth App Credentials"
                       Style="{StaticResource HeadingSmallStyle}"
                       AutomationProperties.HeadingLevel="Level2"/>
            <TextBlock x:Uid="OAuthApp_Intro" Text="Agent-X does not ship OAuth client credentials, so connecting an account needs your own. The Calendar and Email connectors share them, and they apply as soon as you save."
                       Style="{StaticResource BodySecondaryStyle}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Google: a Desktop app client, whose token requests carry its client secret -->
        <StackPanel Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="OAuthApp_GoogleHeading" Text="Google (Gmail and Google Calendar)"
                           Style="{StaticResource BodyStrongStyle}"
                           AutomationProperties.HeadingLevel="Level3"/>
                <TextBlock x:Uid="OAuthApp_GoogleHint" Text="Create an OAuth client ID of type Desktop app in the Google Cloud Console (APIs &amp; Services &gt; Credentials). Its project needs the Gmail and Google Calendar APIs enabled, and your account added as a test user."
                           Style="{StaticResource CaptionStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Name="GoogleClientIdLabel"
                           x:Uid="OAuthApp_GoogleClientIdLabel" Text="Client ID"
                           Style="{StaticResource LabelStyle}"/>
                <Grid>
                    <TextBox Text="{x:Bind ViewModel.GoogleClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             x:Uid="OAuthApp_GoogleClientIdBox" PlaceholderText="Ends with .apps.googleusercontent.com"
                             AutomationProperties.LabeledBy="{x:Bind GoogleClientIdLabel}"
                             FontFamily="{StaticResource FontMono}"
                             Style="{StaticResource InputTextBoxStyle}"/>
                    <!-- NO-GO edge while the value cannot be saved -->
                    <Border BorderBrush="{ThemeResource ErrorBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RCard}"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind ViewModel.HasGoogleClientIdError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.GoogleClientIdError, Mode=OneWay}"
                           Style="{StaticResource CaptionStyle}"
                           Foreground="{ThemeResource LedNoGoTextBrush}"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.HasGoogleClientIdError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Name="GoogleClientSecretLabel"
                           x:Uid="OAuthApp_GoogleClientSecretLabel" Text="Client secret"
                           Style="{StaticResource LabelStyle}"/>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Masked until revealed, like the Local API token in Settings -->
                    <PasswordBox Password="{x:Bind ViewModel.GoogleClientSecret, Mode=TwoWay}"
                                 AutomationProperties.LabeledBy="{x:Bind GoogleClientSecretLabel}"
                                 CornerRadius="{StaticResource RCard}"
                                 MinHeight="40"
                                 Visibility="{x:Bind ViewModel.IsGoogleClientSecretRevealed, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <TextBox Text="{x:Bind ViewModel.GoogleClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{x:Bind GoogleClientSecretLabel}"
                             FontFamily="{StaticResource FontMono}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Visibility="{x:Bind ViewModel.IsGoogleClientSecretRevealed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                    <Border BorderBrush="{ThemeResource ErrorBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RCard}"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind ViewModel.HasGoogleClientSecretError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>

                    <ToggleButton Grid.Column="1"
                                  x:Uid="OAuthApp_RevealGoogleSecret" Content="Show"
                                  Style="{StaticResource GhostToggleButtonStyle}"
                                  MinHeight="40"
                                  IsChecked="{x:Bind ViewModel.IsGoogleClientSecretRevealed, Mode=TwoWay}"/>
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.GoogleClientSecretError, Mode=OneWay}"
                           Style="{StaticResource CaptionStyle}"
                           Foreground="{ThemeResource LedNoGoTextBrush}"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.HasGoogleClientSecretError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </StackPanel>

        <!-- Microsoft: a public client (mobile and desktop applications), so there is no secret -->
        <StackPanel Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="OAuthApp_MicrosoftHeading" Text="Microsoft (Outlook mail and calendar)"
                           Style="{StaticResource BodyStrongStyle}"
                           AutomationProperties.HeadingLevel="Level3"/>
                <TextBlock x:Uid="OAuthApp_MicrosoftHint" Text="Register an app in the Microsoft Entra admin center (App registrations) for accounts in any organizational directory and personal Microsoft accounts. Under Authentication, add the Mobile and desktop applications platform with the redirect URI below. No client secret is needed."
                           Style="{StaticResource CaptionStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Name="MicrosoftRedirectLabel"
                           x:Uid="OAuthApp_MicrosoftRedirectLabel" Text="Redirect URI"
                           Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{x:Bind ViewModel.MicrosoftRedirectUri, Mode=OneWay}"
                         IsReadOnly="True"
                         AutomationProperties.LabeledBy="{x:Bind MicrosoftRedirectLabel}"
                         FontFamily="{StaticResource FontMono}"
                         Style="{StaticResource InputTextBoxStyle}"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Name="MicrosoftClientIdLabel"
                           x:Uid="OAuthApp_MicrosoftClientIdLabel" Text="Application (client) ID"
                           Style="{StaticResource LabelStyle}"/>
                <Grid>
                    <TextBox Text="{x:Bind ViewModel.MicrosoftClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.LabeledBy="{x:Bind MicrosoftClientIdLabel}"
                             FontFamily="{StaticResource FontMono}"
                             Style="{StaticResource InputTextBoxStyle}"/>
                    <Border BorderBrush="{ThemeResource ErrorBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RCard}"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind ViewModel.HasMicrosoftClientIdError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.MicrosoftClientIdError, Mode=OneWay}"
                           Style="{StaticResource CaptionStyle}"
                           Foreground="{ThemeResource LedNoGoTextBrush}"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.HasMicrosoftClientIdError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </StackPanel>

        <!-- Save: stores the credentials (the secret DPAPI-encrypted) and registers the providers -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Uid="OAuthApp_Save" Content="Save Credentials"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"/>
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.SavedMessage, Mode=OneWay}"
                       Style="{StaticResource CaptionStyle}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.HasSavedMessage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.SaveError, Mode=OneWay}"
                       Style="{StaticResource CaptionStyle}"
                       Foreground="{ThemeResource LedNoGoTextBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.HasSaveError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </StackPanel>
</UserControl>
