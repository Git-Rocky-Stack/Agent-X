<UserControl
    x:Class="AgentX.App.Controls.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Visibility="Collapsed">

    <Grid x:Name="OverlayRoot"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <!-- ═══════════════════════════════════════════════════════
             SEMI-TRANSPARENT BACKDROP (click to dismiss)
             ═══════════════════════════════════════════════════════ -->
        <Border x:Name="BackdropLayer"
                Background="{ThemeResource OverlayBrush}"
                Opacity="0"
                Tapped="BackdropLayer_Tapped" />

        <!-- ═══════════════════════════════════════════════════════
             FLOATING COMMAND PALETTE CARD
             An overlay faceplate (ROverlay) with the search input as a
             recessed well. Rows are built in code-behind from the pages
             the navigation rail registers, so the two can never drift.
             ═══════════════════════════════════════════════════════ -->
        <Border x:Name="PaletteCard"
                Width="480"
                MaxHeight="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,80,0,0"
                Background="{ThemeResource FaceplateBrush}"
                CornerRadius="{StaticResource ROverlay}"
                BorderBrush="{ThemeResource FaceplateBorderBrush}"
                BorderThickness="1"
                Opacity="0"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PaletteTranslate" Y="-12" />
            </Border.RenderTransform>

            <Grid>
                <StackPanel>

                    <!-- ═══════════════════════════════════════
                         SEARCH INPUT SECTION
                         ═══════════════════════════════════════ -->
                    <Grid Padding="16,16,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchInput"
                                 x:Uid="Palette_SearchInput"
                                 PlaceholderText="Type a command or search..."
                                 Height="48"
                                 FontFamily="{StaticResource FontPrimary}"
                                 FontSize="16"
                                 Foreground="{ThemeResource WellTextBrush}"
                                 Background="{ThemeResource WellBrush}"
                                 BorderThickness="1"
                                 BorderBrush="{ThemeResource HairlineBrush}"
                                 CornerRadius="{StaticResource RCard}"
                                 Padding="16,12,16,12"
                                 PlaceholderForeground="{ThemeResource InputPlaceholderBrush}"
                                 SelectionHighlightColor="{ThemeResource AccentPrimaryBrush}"
                                 TextChanged="SearchInput_TextChanged"
                                 KeyDown="SearchInput_KeyDown" />

                        <!-- Key chords are wells: void-black in both shifts -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource VoidBrush}"
                                BorderBrush="{ThemeResource HairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RCard}"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">
                            <TextBlock Text="ESC"
                                       FontFamily="{StaticResource FontTelemetry}"
                                       FontSize="10"
                                       Foreground="{ThemeResource WellTextBrush}"
                                       Opacity="0.5"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Separator -->
                    <Border Height="1"
                            Background="{ThemeResource BorderSubtleBrush}"
                            Margin="16,12,16,0" />

                    <!-- ═══════════════════════════════════════
                         RESULTS LIST
                         ═══════════════════════════════════════ -->
                    <ScrollViewer x:Name="ResultsScroller"
                                  MaxHeight="400"
                                  Padding="8,8,8,4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ResultsPanel"
                                    Spacing="2" />
                    </ScrollViewer>

                    <!-- ═══════════════════════════════════════
                         FOOTER HINTS (brushed stripe)
                         ═══════════════════════════════════════ -->
                    <Border Background="{ThemeResource StripeBrush}"
                            CornerRadius="0,0,8,8"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="20">

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Background="{ThemeResource VoidBrush}"
                                        BorderBrush="{ThemeResource HairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RCard}"
                                        Padding="4,2">
                                    <TextBlock Text="&#x2191;&#x2193;"
                                               FontFamily="{StaticResource FontTelemetry}"
                                               FontSize="10"
                                               Foreground="{ThemeResource WellTextBrush}"
                                               Opacity="0.5" />
                                </Border>
                                <TextBlock x:Uid="Palette_NavigateHint"
                                           Text="Navigate"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Background="{ThemeResource VoidBrush}"
                                        BorderBrush="{ThemeResource HairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RCard}"
                                        Padding="4,2">
                                    <TextBlock Text="&#x21B5;"
                                               FontFamily="{StaticResource FontTelemetry}"
                                               FontSize="10"
                                               Foreground="{ThemeResource WellTextBrush}"
                                               Opacity="0.5" />
                                </Border>
                                <TextBlock x:Uid="Palette_OpenHint"
                                           Text="Open"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Background="{ThemeResource VoidBrush}"
                                        BorderBrush="{ThemeResource HairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RCard}"
                                        Padding="4,2">
                                    <TextBlock Text="Esc"
                                               FontFamily="{StaticResource FontTelemetry}"
                                               FontSize="10"
                                               Foreground="{ThemeResource WellTextBrush}"
                                               Opacity="0.5" />
                                </Border>
                                <TextBlock x:Uid="Palette_CloseHint"
                                           Text="Close"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
