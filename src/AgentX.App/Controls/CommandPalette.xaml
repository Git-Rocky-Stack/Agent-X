<UserControl
    x:Class="AgentX.App.Controls.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Visibility="Collapsed">

    <Grid x:Name="OverlayRoot"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <!-- ═══════════════════════════════════════════════════════
             SEMI-TRANSPARENT BACKDROP (click to dismiss)
             ═══════════════════════════════════════════════════════ -->
        <Border x:Name="BackdropLayer"
                Background="#99000000"
                Opacity="0"
                Tapped="BackdropLayer_Tapped" />

        <!-- ═══════════════════════════════════════════════════════
             FLOATING COMMAND PALETTE CARD
             ═══════════════════════════════════════════════════════ -->
        <Border x:Name="PaletteCard"
                Width="480"
                MaxHeight="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,80,0,0"
                Background="#FF111111"
                CornerRadius="16"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                Opacity="0"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PaletteTranslate" Y="-12" />
            </Border.RenderTransform>

            <!-- Subtle red glow at top of card -->
            <Grid>
                <Border CornerRadius="16,16,0,0"
                        Height="2"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0.0" />
                            <GradientStop Color="{StaticResource RedGlow30}" Offset="0.3" />
                            <GradientStop Color="{StaticResource Red500}" Offset="0.5" />
                            <GradientStop Color="{StaticResource RedGlow30}" Offset="0.7" />
                            <GradientStop Color="Transparent" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel>

                    <!-- ═══════════════════════════════════════
                         SEARCH INPUT SECTION
                         ═══════════════════════════════════════ -->
                    <Grid Padding="16,16,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchInput"
                                 PlaceholderText="Type a command or search..."
                                 Height="48"
                                 FontFamily="{StaticResource FontPrimary}"
                                 FontSize="16"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Background="#FF0A0A0A"
                                 BorderThickness="0"
                                 CornerRadius="8"
                                 Padding="16,12,16,12"
                                 PlaceholderForeground="{StaticResource InputPlaceholderBrush}"
                                 SelectionHighlightColor="{StaticResource AccentPrimaryBrush}"
                                 TextChanged="SearchInput_TextChanged"
                                 KeyDown="SearchInput_KeyDown" />

                        <Border Grid.Column="1"
                                Background="#FF1A1A1A"
                                CornerRadius="6"
                                Padding="8,6"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">
                            <TextBlock Text="ESC"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Separator -->
                    <Border Height="1"
                            Background="{StaticResource BorderSubtleBrush}"
                            Margin="16,12,16,0" />

                    <!-- ═══════════════════════════════════════
                         RESULTS LIST
                         ═══════════════════════════════════════ -->
                    <ScrollViewer x:Name="ResultsScroller"
                                  MaxHeight="400"
                                  Padding="8,8,8,4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ResultsPanel"
                                    Spacing="2" />
                    </ScrollViewer>

                    <!-- ═══════════════════════════════════════
                         FOOTER HINTS
                         ═══════════════════════════════════════ -->
                    <Border Background="#FF0A0A0A"
                            CornerRadius="0,0,16,16"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="20">

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="#FF1A1A1A"
                                        CornerRadius="4"
                                        Padding="6,3">
                                    <TextBlock Text="&#x2191;&#x2193;"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                </Border>
                                <TextBlock Text="Navigate"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="#FF1A1A1A"
                                        CornerRadius="4"
                                        Padding="6,3">
                                    <TextBlock Text="&#x21B5;"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                </Border>
                                <TextBlock Text="Open"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="#FF1A1A1A"
                                        CornerRadius="4"
                                        Padding="6,3">
                                    <TextBlock Text="Esc"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                </Border>
                                <TextBlock Text="Close"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
