<UserControl
    x:Class="AgentX.App.Controls.NotificationOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:AgentX.App.Services"
    IsHitTestVisible="True">

    <ItemsRepeater x:Name="NotificationRepeater"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,16,24,0">
        <ItemsRepeater.Layout>
            <StackLayout Spacing="8" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="services:NotificationItem">
                <Border Background="{StaticResource CardHighBrush}"
                        BorderBrush="{StaticResource BorderMediumBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10,14,10"
                        MinWidth="300"
                        MaxWidth="420"
                        Opacity="{x:Bind Opacity, Mode=OneWay}"
                        HorizontalAlignment="Right">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Severity icon -->
                        <FontIcon Glyph="{x:Bind GlyphIcon}"
                                  Foreground="{x:Bind SeverityBrush}"
                                  FontSize="16"
                                  VerticalAlignment="Top"
                                  Margin="0,2,0,0" />

                        <!-- Text content -->
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Title}"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <TextBlock Text="{x:Bind Message}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap"
                                       MaxLines="3"
                                       Opacity="0.8" />
                        </StackPanel>

                        <!-- Dismiss button -->
                        <Button Grid.Column="2"
                                Style="{StaticResource MessageActionButtonStyle}"
                                Click="OnDismissClick"
                                Tag="{x:Bind Id}"
                                ToolTipService.ToolTip="Dismiss"
                                VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE711;" FontSize="10"
                                      Foreground="{StaticResource TextTertiaryBrush}" />
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsRepeater.ItemTemplate>
    </ItemsRepeater>
</UserControl>
