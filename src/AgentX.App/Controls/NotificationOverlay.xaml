<UserControl
    x:Class="AgentX.App.Controls.NotificationOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:AgentX.App.Services"
    IsHitTestVisible="True">

    <ItemsRepeater x:Name="NotificationRepeater"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,16,24,0">
        <ItemsRepeater.Layout>
            <StackLayout Spacing="8" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
            <!-- Annunciator alert row (DESIGN.md): a dark module in both
                 shifts with an LED dot carrying the severity tone -->
            <DataTemplate x:DataType="services:NotificationItem">
                <Border Background="{ThemeResource WellBrush}"
                        BorderBrush="{ThemeResource HairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RControl}"
                        Padding="14,10,14,10"
                        MinWidth="300"
                        MaxWidth="420"
                        Opacity="{x:Bind Opacity, Mode=OneWay}"
                        HorizontalAlignment="Right">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Severity LED dot -->
                        <Ellipse Width="8" Height="8"
                                 Fill="{x:Bind SeverityBrush}"
                                 VerticalAlignment="Top"
                                 Margin="0,6,0,0" />

                        <!-- Text content -->
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Title}"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource WellTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <TextBlock Text="{x:Bind Message}"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{ThemeResource WellTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       MaxLines="3" />
                        </StackPanel>

                        <!-- Dismiss button -->
                        <Button Grid.Column="2"
                                Style="{StaticResource MessageActionButtonStyle}"
                                Click="OnDismissClick"
                                Tag="{x:Bind Id}"
                                x:Uid="Notification_Dismiss"
                                AutomationProperties.Name="Dismiss"
                                ToolTipService.ToolTip="Dismiss"
                                VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE711;" FontSize="10"
                                      Foreground="{ThemeResource WellTextSecondaryBrush}" />
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsRepeater.ItemTemplate>
    </ItemsRepeater>
</UserControl>
