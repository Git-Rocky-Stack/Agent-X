<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ====================================================================
                  AGENT-X HARDWARE PRIMITIVES (Tier 1)
            Four-layer raised-hardware depth system, in XAML
    ====================================================================

    Source of truth: DESIGN.md. This file holds the material brushes for
    the Command Console recipes, per shift, plus the primitives that are
    still expressed as styles. Where a recipe became a templated control,
    the control consumes these brushes directly:

      Layer 0  Chassis    - flat page canvas (Colors.xaml)
      Layer 1  Faceplate  - Controls/Faceplate (template in
                            Themes/Generic.xaml: plate, stripe, bevel,
                            four hex socket bolts)
      Layer 2  Well       - WellStyle (ALWAYS dark, Night and Day)
      Layer 3  Control    - ControlCapStyle (cards are BasedOn it), the
                            machined cap button styles, Controls/LampTile

    Rules:
      - Every surface declares its layer; never mix raised and recessed
        treatments on one element.
      - Grain is directional machine brushing, never fractal noise.
      - Day Shift re-skins surfaces to silver; wells and lamp caps stay
        void-dark (the displays-stay-dark rule).
      - HighContrast collapses every recipe to flat SystemColor
        surfaces; decorative metalwork (bolts, sheen) disappears.
      - Cap press = 1px cap travel at 80ms. LED strike = 80ms attack /
        240ms decay. Blink = 1Hz step, warnings only, until clicked.
    ====================================================================
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ===========================================================
             NIGHT OPS - brushed black aluminum
             =========================================================== -->
        <ResourceDictionary x:Key="Default">

            <LinearGradientBrush x:Key="FaceplateBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF1C1C1C" Offset="0" />
                <GradientStop Color="#FF151515" Offset="0.35" />
                <GradientStop Color="#FF101010" Offset="0.7" />
                <GradientStop Color="#FF0C0C0C" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="FaceplateBorderBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="FaceplateHighlightBrush" Color="#1AFFFFFF" />

            <LinearGradientBrush x:Key="ControlCapBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF1F1F1F" Offset="0" />
                <GradientStop Color="#FF171717" Offset="0.6" />
                <GradientStop Color="#FF121212" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ControlCapBorderBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="ControlCapHighlightBrush" Color="#1AFFFFFF" />

            <LinearGradientBrush x:Key="StripeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF2A2A2A" Offset="0" />
                <GradientStop Color="#FF1F1F1F" Offset="0.55" />
                <GradientStop Color="#FF181818" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="StripeRuleBrush" Color="#CC000000" />

            <LinearGradientBrush x:Key="WellGradientBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF080808" Offset="0" />
                <GradientStop Color="#FF0A0A0A" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="LampCapBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF141414" Offset="0" />
                <GradientStop Color="#FF0C0C0C" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="ArmedCapBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFC8333A" Offset="0" />
                <GradientStop Color="#FFAA2024" Offset="0.55" />
                <GradientStop Color="#FF7F171A" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ArmedCapBorderBrush" Color="#FF7F171A" />
            <SolidColorBrush x:Key="ArmedCapTextBrush" Color="#FFF5F5F5" />

            <LinearGradientBrush x:Key="ChromeCapBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFF2F2F2" Offset="0" />
                <GradientStop Color="#FFD9D9D9" Offset="0.55" />
                <GradientStop Color="#FFC4C4C4" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ChromeCapBorderBrush" Color="#FF8A8A8A" />
            <SolidColorBrush x:Key="ChromeCapTextBrush" Color="#FF0D0D0D" />

            <!-- Stainless socket cap, lit from the upper left. The old ramp
                 topped out at #3A3A3A, which is a dark grey with no specular,
                 so the bolts read as flat discs and washed into the plate.
                 A real machined cap carries a bright hotspot, a steel body and
                 a shaded lower-right rim. -->
            <RadialGradientBrush x:Key="BoltOuterBrush" Center="0.35,0.3" GradientOrigin="0.35,0.3" RadiusX="0.78" RadiusY="0.78">
                <GradientStop Color="#FFE4E4E4" Offset="0" />
                <GradientStop Color="#FFA8A8A8" Offset="0.33" />
                <GradientStop Color="#FF6A6A6A" Offset="0.62" />
                <GradientStop Color="#FF333333" Offset="0.85" />
                <GradientStop Color="#FF161616" Offset="1" />
            </RadialGradientBrush>
            <!-- Machined edge: the turned rim catches light top-left and falls
                 into shadow bottom-right. This is what separates the cap from
                 the faceplate and stops it lying flat. -->
            <LinearGradientBrush x:Key="BoltRimBrush" StartPoint="0.15,0" EndPoint="0.85,1">
                <GradientStop Color="#FFF4F4F4" Offset="0" />
                <GradientStop Color="#8CBFBFBF" Offset="0.42" />
                <GradientStop Color="#FF0A0A0A" Offset="1" />
            </LinearGradientBrush>
            <!-- Allen socket: near wall in shadow, far wall picking up the
                 bounce, so the recess reads as depth instead of a flat hexagon. -->
            <LinearGradientBrush x:Key="BoltSocketBrush" StartPoint="0.2,0" EndPoint="0.8,1">
                <GradientStop Color="#FF000000" Offset="0" />
                <GradientStop Color="#FF090909" Offset="0.55" />
                <GradientStop Color="#FF3E3E3E" Offset="1" />
            </LinearGradientBrush>
            <!-- Socket chamfer: only the lower lip catches light. -->
            <LinearGradientBrush x:Key="BoltSocketRimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#00FFFFFF" Offset="0.35" />
                <GradientStop Color="#59FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <!-- Countersink: a soft ring, not a hard black disc. -->
            <RadialGradientBrush x:Key="BoltHaloBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#00000000" Offset="0.70" />
                <GradientStop Color="#7A000000" Offset="0.88" />
                <GradientStop Color="#26000000" Offset="1" />
            </RadialGradientBrush>

        </ResourceDictionary>

        <!-- ===========================================================
             DAY SHIFT - silver anodized (designed, not inverted).
             Wells and lamp caps keep their Night values: displays
             stay dark on silver hardware.
             =========================================================== -->
        <ResourceDictionary x:Key="Light">

            <LinearGradientBrush x:Key="FaceplateBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFF5F5F3" Offset="0" />
                <GradientStop Color="#FFEAEAE7" Offset="0.35" />
                <GradientStop Color="#FFE0E0DC" Offset="0.7" />
                <GradientStop Color="#FFD8D8D4" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="FaceplateBorderBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="FaceplateHighlightBrush" Color="#EBFFFFFF" />

            <LinearGradientBrush x:Key="ControlCapBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFF7F7F5" Offset="0" />
                <GradientStop Color="#FFEBEBE8" Offset="0.6" />
                <GradientStop Color="#FFDEDEDA" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ControlCapBorderBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="ControlCapHighlightBrush" Color="#EBFFFFFF" />

            <LinearGradientBrush x:Key="StripeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFF0F0ED" Offset="0" />
                <GradientStop Color="#FFE2E2DE" Offset="0.55" />
                <GradientStop Color="#FFD5D5D1" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="StripeRuleBrush" Color="#33000000" />

            <LinearGradientBrush x:Key="WellGradientBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF080808" Offset="0" />
                <GradientStop Color="#FF0A0A0A" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="LampCapBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF141414" Offset="0" />
                <GradientStop Color="#FF0C0C0C" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="ArmedCapBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFC8333A" Offset="0" />
                <GradientStop Color="#FFAA2024" Offset="0.55" />
                <GradientStop Color="#FF7F171A" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ArmedCapBorderBrush" Color="#FF7F171A" />
            <SolidColorBrush x:Key="ArmedCapTextBrush" Color="#FFF5F5F5" />

            <!-- Chrome CTA inverts to black gloss on silver hardware -->
            <LinearGradientBrush x:Key="ChromeCapBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF2E2E2C" Offset="0" />
                <GradientStop Color="#FF1F1F1D" Offset="0.55" />
                <GradientStop Color="#FF181816" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="ChromeCapBorderBrush" Color="#FF0D0D0D" />
            <SolidColorBrush x:Key="ChromeCapTextBrush" Color="#FFF5F5F5" />

            <RadialGradientBrush x:Key="BoltOuterBrush" Center="0.35,0.3" GradientOrigin="0.35,0.3" RadiusX="0.78" RadiusY="0.78">
                <GradientStop Color="#FFFFFFFF" Offset="0" />
                <GradientStop Color="#FFE6E6E2" Offset="0.33" />
                <GradientStop Color="#FFB4B4AE" Offset="0.62" />
                <GradientStop Color="#FF83837D" Offset="0.85" />
                <GradientStop Color="#FF5A5A55" Offset="1" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="BoltRimBrush" StartPoint="0.15,0" EndPoint="0.85,1">
                <GradientStop Color="#FFFFFFFF" Offset="0" />
                <GradientStop Color="#73FFFFFF" Offset="0.42" />
                <GradientStop Color="#FF6B6B66" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BoltSocketBrush" StartPoint="0.2,0" EndPoint="0.8,1">
                <GradientStop Color="#FF1C1C1A" Offset="0" />
                <GradientStop Color="#FF2A2A28" Offset="0.55" />
                <GradientStop Color="#FF66665F" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BoltSocketRimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#00FFFFFF" Offset="0.35" />
                <GradientStop Color="#66FFFFFF" Offset="1" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="BoltHaloBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#00000000" Offset="0.70" />
                <GradientStop Color="#59000000" Offset="0.88" />
                <GradientStop Color="#1A000000" Offset="1" />
            </RadialGradientBrush>

        </ResourceDictionary>

        <!-- ===========================================================
             HIGH CONTRAST - the hardware skin collapses to flat
             system surfaces; decorative metalwork disappears.
             =========================================================== -->
        <ResourceDictionary x:Key="HighContrast">

            <SolidColorBrush x:Key="FaceplateBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FaceplateBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FaceplateHighlightBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="ControlCapBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ControlCapBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ControlCapHighlightBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="StripeBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="StripeRuleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="WellGradientBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="LampCapBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="ArmedCapBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ArmedCapBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ArmedCapTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />

            <SolidColorBrush x:Key="ChromeCapBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ChromeCapBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChromeCapTextBrush" Color="{ThemeResource SystemColorButtonTextColor}" />

            <SolidColorBrush x:Key="BoltOuterBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BoltSocketBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BoltHaloBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BoltRimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BoltSocketRimBrush" Color="{ThemeResource SystemColorWindowColor}" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ===============================================================
         LAYER 1 - FACEPLATE
         Lives in Controls/Faceplate (Themes/Generic.xaml). The plate,
         stripe header, bevel and corner bolts are one templated control
         consuming the Faceplate*/Stripe*/Bolt* brushes above.
         =============================================================== -->

    <!-- ===============================================================
         LAYER 2 - RECESSED WELL (always dark, Night and Day)
         Pair with WellTextBrush / LcdPhosphorBrush foregrounds and the
         Lcd*/Stream* text styles from Typography.xaml.
         =============================================================== -->

    <Style x:Key="WellStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource WellGradientBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WellBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RCard}" />
    </Style>

    <!-- ===============================================================
         LAYER 3 - RAISED CONTROLS
         =============================================================== -->

    <Style x:Key="ControlCapStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlCapBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlCapBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RControl}" />
    </Style>

    <!-- LED dot: pair with a Led*LampBrush fill -->
    <Style x:Key="LedDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
    </Style>

    <!-- ===============================================================
         MACHINED CAP BUTTONS
         Press = 1px cap travel at 80ms; hover = specular sheen lift.
         Caps carry the neutral Ring focus outline (contrast-safe on
         every cap fill, including armed red); flat surfaces elsewhere
         use the armed focus ring per DESIGN.md.
         =============================================================== -->

    <Style x:Key="MachinedCapButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource ControlCapBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlCapBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RControl}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimarySemiBold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource RingBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="Cap"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="CapTravel" Y="0" />
                            </Border.RenderTransform>
                            <Grid>
                                <!-- specular top highlight (machined edge) -->
                                <Border Background="{ThemeResource ControlCapHighlightBrush}"
                                        Height="1" VerticalAlignment="Top"
                                        Margin="1,1,1,0" IsHitTestVisible="False"
                                        CornerRadius="4,4,0,0" />
                                <!-- hover sheen -->
                                <Border x:Name="Sheen" Background="#FFFFFFFF" Opacity="0"
                                        IsHitTestVisible="False"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <!-- press shade: the cap sinks 1px and darkens; on the
                                     armed cap this is the ArmedDeep pressed state
                                     DESIGN.md specifies, and it works on every fill -->
                                <Border x:Name="PressShade" Background="#FF000000" Opacity="0"
                                        IsHitTestVisible="False"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center"
                                                  AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sheen"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="PressShade"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="CapTravel"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sheen"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.05" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="PressShade"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sheen"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="PressShade"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.14" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="CapTravel"
                                                         Storyboard.TargetProperty="Y"
                                                         To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.4" Duration="0:0:0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Armed cap: consequential commands only (steady red = LIVE) -->
    <Style x:Key="ArmedCapButtonStyle" TargetType="Button" BasedOn="{StaticResource MachinedCapButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource ArmedCapBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource ArmedCapTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ArmedCapBorderBrush}" />
    </Style>

    <!-- Chrome cap: at most one polished CTA per view.
         Inverts to black gloss in Day Shift. -->
    <Style x:Key="ChromeCapButtonStyle" TargetType="Button" BasedOn="{StaticResource MachinedCapButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource ChromeCapBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource ChromeCapTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ChromeCapBorderBrush}" />
    </Style>

</ResourceDictionary>
