<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║                  AGENT-X CHAT STYLE SYSTEM                      ║
    ║                                                                  ║
    ║  Chat-specific styles: message bubbles, conversation items,      ║
    ║  streaming indicators, code blocks, and action buttons.          ║
    ║  Designed for premium dark theme with red accent system.         ║
    ╚══════════════════════════════════════════════════════════════════╝
    -->

    <!-- ═══════════════════════════════════════════════════════════════
         USER MESSAGE BUBBLE
         Right-aligned, Surface3 background, speech-bubble radius
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="UserMessageStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardHighBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4,4,2,4" />
        <Setter Property="Padding" Value="16,12,16,12" />
        <Setter Property="MaxWidth" Value="680" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         ASSISTANT MESSAGE BUBBLE
         Left-aligned, Surface1 background, red accent left border
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="AssistantMessageStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2,4,4,4" />
        <Setter Property="Padding" Value="16,12,16,12" />
        <Setter Property="MaxWidth" Value="720" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         SYSTEM MESSAGE
         Centered, muted appearance, italic
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="SystemMessageStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
        <Setter Property="Padding" Value="24,8,24,8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="560" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         ASSISTANT MESSAGE ACCENT BORDER (red left line)
         Applied as an inner element for the accent feel
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="AssistantAccentBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentPrimaryBrush}" />
        <Setter Property="Width" Value="2" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         STREAMING CURSOR (blinking red indicator)
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="StreamingCursorStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentPrimaryBrush}" />
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="2,0,0,2" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         CHAT TIMESTAMP
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="ChatTimestampStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontTelemetry}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         MESSAGE META INFO (tokens, speed, time)
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="MessageMetaStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontTelemetry}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         CODE BLOCK
         Recessed area with mono font, scrollable
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="CodeBlockStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource WellBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXS}" />
        <Setter Property="Padding" Value="14,10,14,10" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         MESSAGE ACTION BUTTONS (copy, regenerate, etc.)
         Small ghost-style buttons that appear on hover
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="MessageActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSM}" />
        <Setter Property="Padding" Value="6,4,6,4" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="BackgroundBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundBorder"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                                     Value="{ThemeResource CardHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="BackgroundBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1.0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundBorder"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                                     Value="{ThemeResource CardPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BackgroundBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.3" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         CONVERSATION LIST ITEM STYLE
         Hover-interactive item for the sidebar conversation list
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="ConversationItemStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
        <Setter Property="Padding" Value="12,10,12,10" />
        <Setter Property="Margin" Value="0,1,0,1" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         CONVERSATION ITEM SELECTED STATE
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="ConversationItemSelectedStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentGlowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
        <Setter Property="Padding" Value="12,10,12,10" />
        <Setter Property="Margin" Value="0,1,0,1" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         CHAT TOP BAR STYLE
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="ChatTopBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource StripeBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StripeRuleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,8,16,8" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         CHAT INPUT BAR STYLE (bottom bar container)
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="ChatInputBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardGradientVerticalBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,12,16,12" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         SIDEBAR HEADER STYLE
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="SidebarHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="16,12,16,12" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         PINNED INDICATOR BADGE
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="PinnedBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentSubtleBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRound}" />
        <Setter Property="Padding" Value="6,2,6,2" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         WELCOME CARD (empty state)
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="WelcomeCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardGradientSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ROverlay}" />
        <Setter Property="Padding" Value="48,40,48,40" />
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         CONNECTION STATUS DOT
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="StatusDotConnectedStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="{ThemeResource OnlineBrush}" />
    </Style>

    <Style x:Key="StatusDotDisconnectedStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="{ThemeResource OfflineBrush}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         SYSTEM PROMPT PICKER ITEM
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="PromptPickerItemStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
        <Setter Property="Padding" Value="12,8,12,8" />
    </Style>

</ResourceDictionary>
