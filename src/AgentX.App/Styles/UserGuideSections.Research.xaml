                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="UserGuide_MobileCompanion_Feature1_Title"
                                           Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock x:Uid="UserGuide_MobileCompanion_Feature1_Description"
                                           Style="{StaticResource BodySecondaryStyle}" />
