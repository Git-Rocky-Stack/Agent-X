                    <Border Style="{StaticResource CardInsetStyle}" Padding="14,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="UserGuide_MobileCompanion_Feature3_Title"
                                           Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock x:Uid="UserGuide_MobileCompanion_Feature3_Description"
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardInsetStyle}" Padding="14,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE118;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="UserGuide_MobileCompanion_Feature4_Title"
                                           Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock x:Uid="UserGuide_MobileCompanion_Feature4_Description"
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource SeparatorStyle}" />

                <!-- Sync -->
                <TextBlock x:Uid="UserGuide_MobileCompanion_Sync_Title"
