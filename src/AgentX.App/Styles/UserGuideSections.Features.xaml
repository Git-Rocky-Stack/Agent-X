                               x:Uid="UserGuide_AskYourFiles_Title"
                               Style="{StaticResource HeadingMediumStyle}" />
                </Grid>

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_AskYourFiles_Description" />

                <!-- How RAG Works -->
                <TextBlock x:Uid="UserGuide_AskYourFiles_HowItWorks_Title"
                           Style="{StaticResource HeadingSmallStyle}" />

                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28"
                                CornerRadius="{StaticResource RadiusRound}"
                                Background="{StaticResource AccentSubtleBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="1"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}" VerticalAlignment="Center"
                                   x:Uid="UserGuide_AskYourFiles_Step1" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28"
                                CornerRadius="{StaticResource RadiusRound}"
                                Background="{StaticResource AccentSubtleBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="2"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}" VerticalAlignment="Center"
                                   x:Uid="UserGuide_AskYourFiles_Step2" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28"
                                CornerRadius="{StaticResource RadiusRound}"
                                Background="{StaticResource AccentSubtleBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="3"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}" VerticalAlignment="Center"
                                   x:Uid="UserGuide_AskYourFiles_Step3" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28"
                                CornerRadius="{StaticResource RadiusRound}"
                                Background="{StaticResource AccentSubtleBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="4"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}" VerticalAlignment="Center"
                                   x:Uid="UserGuide_AskYourFiles_Step4" />
                    </Grid>
                </StackPanel>

                <Border Style="{StaticResource SeparatorStyle}" />

                <!-- Citations -->
                <TextBlock x:Uid="UserGuide_AskYourFiles_Citations_Title"
                           Style="{StaticResource HeadingSmallStyle}" />

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_AskYourFiles_Citations_Description" />
