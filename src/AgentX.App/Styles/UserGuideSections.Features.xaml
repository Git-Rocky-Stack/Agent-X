    <!-- ═══════════════════════════════════════════════════════════════
         ROW 4: AI CHAT
         ═══════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="AiChatTemplate">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="16">
                <!-- Section Header -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8BD;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="20"
                              Foreground="{StaticResource TextAccentBrush}" />
                    <TextBlock Grid.Column="1"
                               x:Uid="UserGuide_AiChat_Title"
                               Style="{StaticResource HeadingMediumStyle}" />
                </Grid>

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_AiChat_Description" />

                <!-- How to use -->
                <TextBlock x:Uid="UserGuide_AiChat_Using_Title"
                           Style="{StaticResource HeadingSmallStyle}" />

                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28"
                                CornerRadius="{StaticResource RadiusRound}"
                                Background="{StaticResource AccentSubtleBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="1"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}" VerticalAlignment="Center"
                                   x:Uid="UserGuide_AiChat_Step1" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28"
                                CornerRadius="{StaticResource RadiusRound}"
                                Background="{StaticResource AccentSubtleBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="2"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}" VerticalAlignment="Center"
                                   x:Uid="UserGuide_AiChat_Step2" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28"
                                CornerRadius="{StaticResource RadiusRound}"
                                Background="{StaticResource AccentSubtleBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock Text="3"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}" VerticalAlignment="Center"
                                   x:Uid="UserGuide_AiChat_Step3" />
                    </Grid>
                </StackPanel>

                <Border Style="{StaticResource SeparatorStyle}" />

                <TextBlock x:Uid="UserGuide_AiChat_Conversation_Title"
                           Style="{StaticResource HeadingSmallStyle}" />

                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}"
                                   x:Uid="UserGuide_AiChat_Conversation1" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}"
                                   x:Uid="UserGuide_AiChat_Conversation2" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}"
                                   x:Uid="UserGuide_AiChat_Conversation3" />
                    </Grid>
                </StackPanel>

                <Border Style="{StaticResource SeparatorStyle}" />

                <TextBlock x:Uid="UserGuide_AiChat_Advanced_Title"
                           Style="{StaticResource HeadingSmallStyle}" />

                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}"
                                   x:Uid="UserGuide_AiChat_Advanced1" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}"
                                   x:Uid="UserGuide_AiChat_Advanced2" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}"
                                   x:Uid="UserGuide_AiChat_Advanced3" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}"
                                   x:Uid="UserGuide_AiChat_Advanced4" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════════════════════
         ROW 5: ASK YOUR FILES (RAG)
         ═══════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="AskYourFilesTemplate">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="16">
                <!-- Section Header -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE82D;"
