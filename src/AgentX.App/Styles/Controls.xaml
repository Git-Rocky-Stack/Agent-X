<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║                 AGENT-X CONTROL STYLE SYSTEM                    ║
    ║                                                                  ║
    ║  Buttons, Cards, Inputs, Badges — flat surfaces with crisp 1px   ║
    ║  borders, deliberate corner radii, and quiet interaction state   ║
    ║  transitions (no gradient fades, no ambient glows).              ║
    ║                                                                  ║
    ║  Button typography (deliberate hierarchy — confirmed consistent):║
    ║    14px / SemiBold / 40px min-height — AccentButton, Secondary   ║
    ║    14px / Normal   / 36px min-height — Ghost, GhostToggle        ║
    ║    12px / SemiBold / 32px min-height — FilterChip (compact)      ║
    ║    36x36 circle                       — IconButton               ║
    ║  FontFamily = FontPrimary across all button tiers.               ║
    ╚══════════════════════════════════════════════════════════════════╝
    -->

    <!-- ═══════════════════════════════════════════════════════════════
         TRANSITION DURATIONS
         ═══════════════════════════════════════════════════════════════ -->

    <Duration x:Key="TransitionFast">0:0:0.15</Duration>
    <Duration x:Key="TransitionNormal">0:0:0.25</Duration>
    <Duration x:Key="TransitionSlow">0:0:0.4</Duration>

    <!-- ═══════════════════════════════════════════════════════════════
         PRIMARY ACCENT BUTTON - the ARMED machined cap (DESIGN.md).
         Consequential commands only. Rebased onto the Hardware.xaml cap
         template: gradient cap, 1px press travel at 80ms, sheen hover,
         neutral Ring focus outline (contrast-safe on the red fill).
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ArmedCapButtonStyle}">
        <Setter Property="Padding" Value="24,12,24,12" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         SECONDARY BUTTON - neutral machined cap
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MachinedCapButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="20,10,20,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         GHOST BUTTON (Text-only, minimal)
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
        <Setter Property="Padding" Value="12,8,12,8" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         GHOST TOGGLE BUTTON (Ghost visual for ToggleButton controls)
         Mirrors GhostButtonStyle. A Style with TargetType="Button" cannot
         be applied to a ToggleButton (ToggleButton derives from ButtonBase,
         not Button), so toggle controls that want the ghost look must use
         this TargetType="ToggleButton" variant.
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="GhostToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
        <Setter Property="Padding" Value="12,8,12,8" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         ICON BUTTON (Circular, for toolbar actions)
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- W=H=36, so RadiusFull keeps this a perfect circle (the only
             permitted "round" shape — pills are forbidden). -->
        <Setter Property="CornerRadius" Value="{StaticResource RadiusFull}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         CARD STYLES (Gradient elevation system)
         ═══════════════════════════════════════════════════════════════ -->

    <!-- Standard Card — Used for most content containers -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardGradientBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLG}" />
        <Setter Property="Padding" Value="{StaticResource PaddingCard}" />
    </Style>

    <!-- Elevated Card — Prominent elements, modals -->
    <Style x:Key="CardElevatedStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardGradientVerticalBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderMediumBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLG}" />
        <Setter Property="Padding" Value="{StaticResource PaddingCard}" />
    </Style>

    <!-- Accent Card — Featured / highlighted content -->
    <Style x:Key="CardAccentStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentCardGradientBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderAccentGradientBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLG}" />
        <Setter Property="Padding" Value="{StaticResource PaddingCard}" />
    </Style>

    <!-- Interactive Card — Clickable items (list items, file cards) -->
    <Style x:Key="CardInteractiveStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardGradientSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Inset Card — Recessed input areas, code blocks -->
    <!-- Inset content card on the faceplate surface. Follows the shift
         (recessed carbon at night, recessed silver by day): the
         displays-stay-dark rule covers LCD wells and lamp caps, not
         generic content cards, so this must NOT use the well tokens. -->
    <Style x:Key="CardInsetStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         INPUT STYLES
         ═══════════════════════════════════════════════════════════════ -->

    <!-- Console plate forms (DESIGN.md): inputs are recessed dark wells
         with light text in BOTH shifts - the displays-stay-dark rule.
         The Fluent TextControl*/ComboBox* lightweight resources are
         overridden per-theme in Colors.xaml so template hover/focus
         states cannot flash the well light in Day Shift. -->
    <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource WellBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource WellTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXS}" />
        <Setter Property="Padding" Value="14,10,14,10" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="PlaceholderForeground" Value="{ThemeResource InputPlaceholderBrush}" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource AccentPrimaryBrush}" />
    </Style>

    <!-- Chat Input - the primary stream well: larger, multi-line -->
    <Style x:Key="ChatInputStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXS}" />
        <Setter Property="Padding" Value="18,14,18,14" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxHeight" Value="200" />
    </Style>

    <!-- Search Input -->
    <Style x:Key="SearchInputStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXS}" />
        <Setter Property="Padding" Value="18,10,18,10" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         BADGE / CHIP STYLES
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="BadgeDefaultStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRound}" />
        <Setter Property="Padding" Value="10,4,10,4" />
    </Style>

    <Style x:Key="BadgeAccentStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RedGlow20}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRound}" />
        <Setter Property="Padding" Value="10,4,10,4" />
    </Style>

    <Style x:Key="BadgeSuccessStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SuccessSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SuccessBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRound}" />
        <Setter Property="Padding" Value="10,4,10,4" />
    </Style>

    <Style x:Key="BadgeWarningStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource WarningSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WarningBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRound}" />
        <Setter Property="Padding" Value="10,4,10,4" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         INLINE STATUS BARS
         Captures the repeated inline status-banner pattern: a tinted
         semantic background with a matching-color border, used for
         error / success / info callouts embedded in page content.
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="InlineErrorBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ErrorSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ErrorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
        <Setter Property="Padding" Value="{StaticResource PaddingCard}" />
    </Style>

    <Style x:Key="InlineSuccessBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SuccessSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SuccessBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
        <Setter Property="Padding" Value="{StaticResource PaddingCard}" />
    </Style>

    <Style x:Key="InlineInfoBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource InfoSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource InfoBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
        <Setter Property="Padding" Value="{StaticResource PaddingCard}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         SEPARATOR
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="SeparatorStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,8,0,8" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         PROGRESS BAR
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="AccentProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{ThemeResource AccentPrimaryBrush}" />
        <Setter Property="Background" Value="{ThemeResource CardPressedBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRound}" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="MaxHeight" Value="4" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         TAB RADIO BUTTON (Tab-bar navigation style)
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="TabRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,10,16,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="BackgroundBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Border>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundBorder"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                                     Value="{ThemeResource CardHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundBorder"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                                     Value="{ThemeResource CardPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BackgroundBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.4" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundBorder"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                                     Value="{ThemeResource AccentSubtleBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                       Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                                     Value="{ThemeResource TextAccentBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         TOOLTIP
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="PremiumToolTipStyle" TargetType="ToolTip">
        <Setter Property="Background" Value="{ThemeResource CardHighBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderMediumBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
        <Setter Property="Padding" Value="12,8,12,8" />
        <Setter Property="FontSize" Value="12" />
    </Style>

</ResourceDictionary>
