<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║                AGENT-X DOCUMENT STYLE SYSTEM                    ║
    ║                                                                  ║
    ║  Styles for the Knowledge Vault, Document Detail, and           ║
    ║  Collection Manager pages. Premium file management UI.          ║
    ╚══════════════════════════════════════════════════════════════════╝
    -->

    <!-- DocumentCardStyle was removed during the 2026-09-06 parity sweep. It had
         no consumer anywhere in the app, in markup or code, and the document grid
         it was written for uses DocumentGridItemStyle. Checked for a waiting
         consumer before removing: there is none. -->

    <!-- ═══════════════════════════════════════════════════════════════
         DROP ZONE STYLE
         Dashed-border area for drag-and-drop file import.
         Card surface with a subtle dashed border.
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="DropZoneStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderMediumBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="{StaticResource RControl}" />
        <Setter Property="Padding" Value="48,40,48,40" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         DROP ZONE ACTIVE STYLE (when dragging over)
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="DropZoneActiveStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="{StaticResource RControl}" />
        <Setter Property="Padding" Value="48,40,48,40" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         FILE TYPE BADGE
         Small type indicator badge showing the file extension.
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="FileTypeBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentSubtleBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RControl}" />
        <Setter Property="Padding" Value="8,3,8,3" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         TAG BADGE
         Small accent-tinted badge for document tags.
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="TagBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RControl}" />
        <Setter Property="Padding" Value="8,2,8,2" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         FILE TYPE ICON CONTAINER
         Large icon area on the left side of a document card.
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="FileTypeIconContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentSubtleBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RControl}" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         COLLECTION TREE ITEM STYLE
         Tree view item for the collection sidebar list.
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="CollectionTreeItemStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource RControl}" />
        <Setter Property="Padding" Value="12,10,12,10" />
        <Setter Property="Margin" Value="0,1,0,1" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         DOCUMENT GRID ITEM STYLE
         For ItemsRepeater items in the document grid.
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="DocumentGridItemStyle" TargetType="Border" BasedOn="{StaticResource ControlCapStyle}">
        <Setter Property="Padding" Value="20" />
        <Setter Property="MinHeight" Value="200" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         FILTER CHIP STYLES
         Toggleable filter chips for the filter bar.
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="FilterChipStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RControl}" />
        <Setter Property="Padding" Value="14,6,14,6" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style x:Key="FilterChipActiveStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentSubtleBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextAccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentGlowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RControl}" />
        <Setter Property="Padding" Value="14,6,14,6" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         INDEXING STATUS BAR
         Bottom bar showing indexing progress.
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="IndexingStatusBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardGradientVerticalBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RControl}" />
        <Setter Property="Padding" Value="20,14,20,14" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         STAT BADGE (for the stats bar)
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="StatBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardGradientBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RControl}" />
        <Setter Property="Padding" Value="20,14,20,14" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         COLLECTION PANEL STYLES
         Left and right panel styles for Collection Manager.
         ═══════════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════════
         DOCUMENT SIMPLE CARD (for collection view)
         Simpler version of document card for collection detail.
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="DocumentSimpleCardStyle" TargetType="Border" BasedOn="{StaticResource ControlCapStyle}">
        <Setter Property="Padding" Value="16" />
    </Style>

</ResourceDictionary>
