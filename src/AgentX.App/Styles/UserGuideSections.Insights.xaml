<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║       USER GUIDE INSIGHTS & OPERATIONS SECTIONS                   ║
    ║                                                                  ║
    ║  ComparisonTemplate, InboxTemplate, AnalyticsTemplate,           ║
    ║  OperationsTemplate, SyncTemplate — added by the 2026-07         ║
    ║  documentation accuracy pass so every navigation destination     ║
    ║  has guide coverage.                                             ║
    ╚══════════════════════════════════════════════════════════════════╝
    -->

    <!-- ═══════════════════════════════════════════════════════════════
         DOCUMENT COMPARISON
         ═══════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="ComparisonTemplate">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8F4;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="20"
                              Foreground="{ThemeResource TextAccentBrush}" />
                    <TextBlock Grid.Column="1"
                               x:Uid="UserGuide_Comparison_Title"
                               Style="{StaticResource HeadingMediumStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                </Grid>

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_Comparison_Description" />

                <StackPanel Spacing="10">
                    <Border Style="{StaticResource CardInsetStyle}" Padding="14,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="{ThemeResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="UserGuide_Comparison_Feature1_Title"
                                           Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock x:Uid="UserGuide_Comparison_Feature1_Description"
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardInsetStyle}" Padding="14,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE773;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="{ThemeResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="UserGuide_Comparison_Feature2_Title"
                                           Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock x:Uid="UserGuide_Comparison_Feature2_Description"
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardInsetStyle}" Padding="14,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="{ThemeResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="UserGuide_Comparison_Feature3_Title"
                                           Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock x:Uid="UserGuide_Comparison_Feature3_Description"
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

