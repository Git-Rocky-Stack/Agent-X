<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║               AGENT-X NAVIGATION VIEW OVERRIDES                 ║
    ║                                                                  ║
    ║  Premium dark NavigationView with gradient sidebar, subtle       ║
    ║  selection indicators, and smooth hover transitions.             ║
    ╚══════════════════════════════════════════════════════════════════╝
    -->

    <!-- NavigationView Overrides -->
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource BackgroundPrimary}" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource BackgroundPrimary}" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource Black}" />

    <!-- NavigationViewItem Selection Indicator (accent red line) -->
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource Red500}" />

    <!-- NavigationViewItem Text Colors -->
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{StaticResource Silver500}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{StaticResource PureWhite}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{StaticResource LightGrey200}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="{StaticResource Silver300}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundDisabled" Color="{StaticResource Charcoal500}" />

    <!-- NavigationViewItem Backgrounds -->
    <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource White05}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{StaticResource White05}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="{StaticResource White10}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{StaticResource White10}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{StaticResource White10}" />

    <!-- NavigationViewItem Icon Colors -->
    <SolidColorBrush x:Key="NavigationViewItemIconForeground" Color="{StaticResource Silver600}" />
    <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelected" Color="{StaticResource Red400}" />
    <SolidColorBrush x:Key="NavigationViewItemIconForegroundPointerOver" Color="{StaticResource Silver400}" />

    <!-- NavigationView Separator -->
    <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="{StaticResource BorderSubtle}" />

    <!-- NavigationView Header -->
    <SolidColorBrush x:Key="NavigationViewHeaderForeground" Color="{StaticResource PureWhite}" />

    <!-- NavigationView Content Grid Border -->
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />

    <!-- Top-level NavigationView Border (remove default) -->
    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
    <Thickness x:Key="NavigationViewContentPresenterMargin">0</Thickness>

    <!-- NavigationViewItem Style Override -->
    <Style x:Key="AgentXNavItemStyle" TargetType="NavigationViewItem">
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="4,2,4,2" />
    </Style>

    <!-- Navigation Section Header -->
    <Style x:Key="NavSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        <Setter Property="Margin" Value="16,16,0,6" />
    </Style>

</ResourceDictionary>
