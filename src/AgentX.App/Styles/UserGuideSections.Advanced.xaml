                    </Border>

                    <!-- Code Files -->
                    <Border BorderBrush="{ThemeResource BorderSubtleBrush}"
                            BorderThickness="1,1,1,0"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="UserGuide_FileFormats_Code"
                                       Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Style="{StaticResource MonoSmallStyle}" VerticalAlignment="Center"
                                       Text=".cs .py .js ..." />
                            <TextBlock Grid.Column="2" x:Uid="UserGuide_FileFormats_Code_Extraction"
                                       Style="{StaticResource BodySecondaryStyle}" />
                        </Grid>
                    </Border>

                    <!-- Images (last row, bottom corners) -->
                    <Border BorderBrush="{ThemeResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="0,0,8,8"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="UserGuide_FileFormats_Images"
                                       Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text=".png .jpg .jpeg" Style="{StaticResource MonoSmallStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Uid="UserGuide_FileFormats_Images_Extraction"
                                       Style="{StaticResource BodySecondaryStyle}" />
                        </Grid>
                    </Border>

                </StackPanel>

                <TextBlock Style="{StaticResource BodySecondaryStyle}"
                           x:Uid="UserGuide_FileFormats_CodeList" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════════════════════
         ROW 18: TROUBLESHOOTING
         ═══════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="TroubleshootingTemplate">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="16">
                <!-- Section Header -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE90F;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="20"
                              Foreground="{ThemeResource TextAccentBrush}" />
                    <TextBlock Grid.Column="1"
                               x:Uid="UserGuide_Troubleshooting_Title"
                               Style="{StaticResource HeadingMediumStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                </Grid>

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_Troubleshooting_Description" />

                <!-- Issue 1: Ollama not detected -->
                <Border Style="{StaticResource CardInsetStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{ThemeResource WarningBrush}" />
                            <TextBlock Grid.Column="1" x:Uid="UserGuide_Troubleshooting_Issue1_Title"
                                       Style="{StaticResource HeadingSmallStyle}" />
                        </Grid>
                        <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                   x:Uid="UserGuide_Troubleshooting_Issue1_Description" />
                    </StackPanel>
                </Border>

                <!-- Issue 2: Slow responses -->
                <Border Style="{StaticResource CardInsetStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{ThemeResource WarningBrush}" />
                            <TextBlock Grid.Column="1" x:Uid="UserGuide_Troubleshooting_Issue2_Title"
                                       Style="{StaticResource HeadingSmallStyle}" />
                        </Grid>
                        <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                   x:Uid="UserGuide_Troubleshooting_Issue2_Description" />
                    </StackPanel>
                </Border>

                <!-- Issue 3: Documents not indexing -->
                <Border Style="{StaticResource CardInsetStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{ThemeResource WarningBrush}" />
                            <TextBlock Grid.Column="1" x:Uid="UserGuide_Troubleshooting_Issue3_Title"
                                       Style="{StaticResource HeadingSmallStyle}" />
                        </Grid>
                        <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                   x:Uid="UserGuide_Troubleshooting_Issue3_Description" />
                    </StackPanel>
                </Border>

                <!-- Issue 4: High memory usage -->
                <Border Style="{StaticResource CardInsetStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{ThemeResource WarningBrush}" />
                            <TextBlock Grid.Column="1" x:Uid="UserGuide_Troubleshooting_Issue4_Title"
                                       Style="{StaticResource HeadingSmallStyle}" />
                        </Grid>
                        <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                   x:Uid="UserGuide_Troubleshooting_Issue4_Description" />
                    </StackPanel>
                </Border>

                <!-- Issue 5: Search returns no results -->
                <Border Style="{StaticResource CardInsetStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{ThemeResource WarningBrush}" />
                            <TextBlock Grid.Column="1" x:Uid="UserGuide_Troubleshooting_Issue5_Title"
                                       Style="{StaticResource HeadingSmallStyle}" />
                        </Grid>
                        <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                   x:Uid="UserGuide_Troubleshooting_Issue5_Description" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

