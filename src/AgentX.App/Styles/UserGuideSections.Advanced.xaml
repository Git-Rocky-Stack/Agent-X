    <!-- ═══════════════════════════════════════════════════════════════
         ROW 11: SEMANTIC SEARCH
         ═══════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="SemanticSearchTemplate">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="16">
                <!-- Section Header -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE721;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="20"
                              Foreground="{ThemeResource TextAccentBrush}" />
                    <TextBlock Grid.Column="1"
                               x:Uid="UserGuide_SemanticSearch_Title"
                               Style="{StaticResource HeadingMediumStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                </Grid>

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_SemanticSearch_Description" />

                <!-- How it works -->
                <TextBlock x:Uid="UserGuide_SemanticSearch_HowItWorks_Title"
                           Style="{StaticResource HeadingSmallStyle}" />

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_SemanticSearch_HowItWorks_Description" />

                <Border Style="{StaticResource SeparatorStyle}" />

                <!-- Using search -->
                <TextBlock x:Uid="UserGuide_SemanticSearch_Using_Title"
                           Style="{StaticResource HeadingSmallStyle}" />

                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="{ThemeResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}"
                                   x:Uid="UserGuide_SemanticSearch_Using1" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="{ThemeResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}"
                                   x:Uid="UserGuide_SemanticSearch_Using2" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="{ThemeResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}"
                                   x:Uid="UserGuide_SemanticSearch_Using3" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="{ThemeResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}"
                                   x:Uid="UserGuide_SemanticSearch_Using4" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="{ThemeResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}"
                                   x:Uid="UserGuide_SemanticSearch_Using5" />
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="{ThemeResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}"
                                   x:Uid="UserGuide_SemanticSearch_Using6" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

