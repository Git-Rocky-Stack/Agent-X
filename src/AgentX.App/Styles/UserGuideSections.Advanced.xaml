    <!-- ═══════════════════════════════════════════════════════════════
         ROW 14: SETTINGS
         ═══════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="SettingsTemplate">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="16">
                <!-- Section Header -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE713;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="20"
                              Foreground="{ThemeResource TextAccentBrush}" />
                    <TextBlock Grid.Column="1"
                               x:Uid="UserGuide_Settings_Title"
                               Style="{StaticResource HeadingMediumStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                </Grid>

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_Settings_Description" />

                <!-- Settings Groups -->
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardInsetStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="UserGuide_Settings_Group1_Title"
                                       Style="{StaticResource AccentBodyStyle}" />
                            <TextBlock x:Uid="UserGuide_Settings_Group1_Description"
                                       Style="{StaticResource BodySmallStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardInsetStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="UserGuide_Settings_Group2_Title"
                                       Style="{StaticResource AccentBodyStyle}" />
                            <TextBlock x:Uid="UserGuide_Settings_Group2_Description"
                                       Style="{StaticResource BodySmallStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardInsetStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="UserGuide_Settings_Group3_Title"
                                       Style="{StaticResource AccentBodyStyle}" />
                            <TextBlock x:Uid="UserGuide_Settings_Group3_Description"
                                       Style="{StaticResource BodySmallStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardInsetStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="UserGuide_Settings_Group4_Title"
                                       Style="{StaticResource AccentBodyStyle}" />
                            <TextBlock x:Uid="UserGuide_Settings_Group4_Description"
                                       Style="{StaticResource BodySmallStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Style="{StaticResource BodySecondaryStyle}"
                           x:Uid="UserGuide_Settings_Shortcut" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════════════════════
         ROW 15: KEYBOARD SHORTCUTS
         ═══════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="KeyboardShortcutsTemplate">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="16">
                <!-- Section Header -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE765;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="20"
                              Foreground="{ThemeResource TextAccentBrush}" />
                    <TextBlock Grid.Column="1"
                               x:Uid="UserGuide_KeyboardShortcuts_Title"
                               Style="{StaticResource HeadingMediumStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                </Grid>

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_KeyboardShortcuts_Description" />

                <!-- Shortcuts Table -->
                <StackPanel Spacing="0">

                    <!-- Table Header -->
                    <Border Background="{ThemeResource CardBrush}"
                            CornerRadius="8,8,0,0"
                            BorderBrush="{ThemeResource BorderSubtleBrush}"
                            BorderThickness="1,1,1,0"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="UserGuide_KeyboardShortcuts_Table_Shortcut"
                                       Style="{StaticResource OverlineStyle}" />
                            <TextBlock Grid.Column="1" x:Uid="UserGuide_KeyboardShortcuts_Table_Action"
                                       Style="{StaticResource OverlineStyle}" />
                        </Grid>
                    </Border>

                    <!-- Ctrl+K -->
                    <Border BorderBrush="{ThemeResource BorderSubtleBrush}"
                            BorderThickness="1,1,1,0"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource CardElevatedBrush}"
                                            BorderBrush="{ThemeResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="Ctrl" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="+" Foreground="{ThemeResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <Border Background="{ThemeResource CardElevatedBrush}"
                                            BorderBrush="{ThemeResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="K" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                            </Grid>
                            <TextBlock Grid.Column="1" x:Uid="UserGuide_KeyboardShortcuts_Action1"
                                       Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Ctrl+N -->
                    <Border BorderBrush="{ThemeResource BorderSubtleBrush}"
                            BorderThickness="1,1,1,0"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource CardElevatedBrush}"
                                            BorderBrush="{ThemeResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="Ctrl" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="+" Foreground="{ThemeResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <Border Background="{ThemeResource CardElevatedBrush}"
                                            BorderBrush="{ThemeResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="N" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                            </Grid>
                            <TextBlock Grid.Column="1" x:Uid="UserGuide_KeyboardShortcuts_Action2"
                                       Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Ctrl+I -->
                    <Border BorderBrush="{ThemeResource BorderSubtleBrush}"
                            BorderThickness="1,1,1,0"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource CardElevatedBrush}"
                                            BorderBrush="{ThemeResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="Ctrl" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="+" Foreground="{ThemeResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <Border Background="{ThemeResource CardElevatedBrush}"
                                            BorderBrush="{ThemeResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="I" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                            </Grid>
                            <TextBlock Grid.Column="1" x:Uid="UserGuide_KeyboardShortcuts_Action3"
                                       Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Ctrl+F -->
                    <Border BorderBrush="{ThemeResource BorderSubtleBrush}"
                            BorderThickness="1,1,1,0"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource CardElevatedBrush}"
                                            BorderBrush="{ThemeResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="Ctrl" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="+" Foreground="{ThemeResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <Border Background="{ThemeResource CardElevatedBrush}"
                                            BorderBrush="{ThemeResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="F" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                            </Grid>
                            <TextBlock Grid.Column="1" x:Uid="UserGuide_KeyboardShortcuts_Action4"
                                       Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Ctrl+Shift+F -->
                    <Border BorderBrush="{ThemeResource BorderSubtleBrush}"
                            BorderThickness="1,1,1,0"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource CardElevatedBrush}"
                                            BorderBrush="{ThemeResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="Ctrl" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="+" Foreground="{ThemeResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <Border Background="{ThemeResource CardElevatedBrush}"
                                            BorderBrush="{ThemeResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="Shift" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="+" Foreground="{ThemeResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <Border Background="{ThemeResource CardElevatedBrush}"
                                            BorderBrush="{ThemeResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="F" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                            </Grid>
                            <TextBlock Grid.Column="1" x:Uid="UserGuide_KeyboardShortcuts_Action5"
                                       Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Ctrl+, -->
                    <Border BorderBrush="{ThemeResource BorderSubtleBrush}"
                            BorderThickness="1,1,1,0"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource CardElevatedBrush}"
                                            BorderBrush="{ThemeResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="Ctrl" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="+" Foreground="{ThemeResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <Border Background="{ThemeResource CardElevatedBrush}"
                                            BorderBrush="{ThemeResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
