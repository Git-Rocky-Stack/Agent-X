            <!-- Scrollbar Brushes -->
            <SolidColorBrush x:Key="ScrollbarTrackBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#2E000000" />
            <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#42000000" />

            <!-- Shadow / Overlay -->
            <SolidColorBrush x:Key="OverlayBrush" Color="#80000000" />
            <SolidColorBrush x:Key="OverlayLightBrush" Color="#40000000" />

        </ResourceDictionary>

        <!-- ===========================================================
             HIGH CONTRAST - exempt from the hardware skin, by design.
             All chrome, text, and borders bind to SystemColor* tokens
             so users with HC schemes (HC Black, HC White, HC #1, HC #2)
             see correct contrast. Brand red is replaced by the system
             accent. Flat surfaces, full-opacity borders, system focus.
             The aesthetic sweep must never touch this dictionary's
             bindings - state is carried by stencil words, not color.
             =========================================================== -->
        <ResourceDictionary x:Key="HighContrast">

            <!-- Window & Page Backgrounds -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
