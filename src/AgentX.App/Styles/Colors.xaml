<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ====================================================================
                     AGENT-X COLOR ARCHITECTURE
                 Command Console (Carbon Pro chassis)
    ====================================================================

    Source of truth: DESIGN.md (repo root). Ported from Team-X's
    Command Console system on 2026-07-05 and adapted for WinUI 3.

    Three-theme system:
      Default (Night Ops)  - brushed black aluminum on AMOLED carbon,
                             armed red #AA2024, LED lamp semantics.
      Light  (Day Shift)   - silver anodized hardware, a deliberately
                             designed variant, never an auto-invert.
                             Displays (wells, LCDs, lamp caps) STAY DARK.
      HighContrast         - fully exempt from the hardware skin. Binds
                             to OS SystemColor* tokens. Untouchable.

    Architecture (order matters in WinUI XAML - property elements
    must come BEFORE content):
      1. ThemeDictionaries (property element, must be first)
      2. Raw Color tokens - SHARED across themes (gradient stops,
         shadow colors, legacy consumers of colors-not-brushes)
      3. Layout tokens - spacing, radius, padding, breakpoints

    Migration state: token layer is Command Console (Tier 1). Screens
    adopt the four-layer hardware recipes per-screen during the sweep
    (Tiers 2-3). Legacy keys are preserved with re-pointed values so
    every existing {ThemeResource}/{StaticResource} keeps resolving.
    The old flat-elevation doctrine is superseded by DESIGN.md's
    four-layer raised-hardware depth system.

    LED semantics (the dual-form red rule, non-negotiable):
      LedGo    #41E25E  steady   - running / healthy / phosphor
      LedHold  #FFB000  steady   - caution / pending / queued
      LedWarn  #FF4438  BLINK 1Hz - unacknowledged warning ONLY
      LedNoGo  #C8453E  steady   - terminal fault (failed, dead)
      LedScope #58C4BC  steady   - informational (rarest color)
      Steady red = LIVE/armed. Blinking red = demands acknowledgment.
      Never blink anything else; never show a steady LedWarn.
    ====================================================================
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ===========================================================
             DEFAULT (NIGHT OPS) - carbon chassis, armed red
             =========================================================== -->
        <ResourceDictionary x:Key="Default">

            <!-- Window & Page Backgrounds (chassis) -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FF050505" />
            <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#FF0D0D0D" />

            <!-- Ambient surface brushes (legacy "Gradient" keys are solids) -->
            <SolidColorBrush x:Key="WindowGradientBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="SidebarGradientBrush" Color="#FF0D0D0D" />
            <SolidColorBrush x:Key="HeaderGradientBrush" Color="#FF050505" />

            <!-- Card Surface Brushes (carbon panel bases; faceplate
                 gradients live in Hardware.xaml for swept screens) -->
            <SolidColorBrush x:Key="CardBrush" Color="#FF141414" />
            <SolidColorBrush x:Key="CardElevatedBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="CardHighBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#FF2A2A2A" />
            <SolidColorBrush x:Key="CardPressedBrush" Color="#FF303030" />

            <!-- Legacy Card "Gradient" keys (flat solids) -->
            <SolidColorBrush x:Key="CardGradientBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="CardGradientVerticalBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="CardGradientSubtleBrush" Color="#FF141414" />

            <!-- Accent Card (featured / highlighted elements) -->
            <SolidColorBrush x:Key="AccentCardGradientBrush" Color="#FF141414" />
            <SolidColorBrush x:Key="AccentGlowGradientBrush" Color="#26AA2024" />

            <!-- Border Brushes (hairline discipline: 8% / 16% / 24%) -->
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="BorderMediumBrush" Color="#29FFFFFF" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="BorderFocusBrush" Color="#FFAA2024" />

            <!-- Legacy Border "Gradient" keys -->
            <SolidColorBrush x:Key="BorderGradientBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="BorderAccentGradientBrush" Color="#FFAA2024" />

            <!-- Text Brushes (silver ramp - engraved enamel) -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFB3B3B3" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF888888" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#FF5A5A5A" />
            <SolidColorBrush x:Key="TextInverseBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="TextAccentBrush" Color="#FFE0252B" />
            <SolidColorBrush x:Key="TextLinkBrush" Color="#FFF08A8E" />
            <SolidColorBrush x:Key="TextEmphasisBrush" Color="#FFD1D1D1" />

            <!-- Accent Brushes (ARMED RED - steady means LIVE) -->
            <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#FFAA2024" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFC8333A" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF7F171A" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1FAA2024" />
            <SolidColorBrush x:Key="AccentGlowBrush" Color="#38E0252B" />
            <SolidColorBrush x:Key="AccentLitBrush" Color="#FFE0252B" />
            <SolidColorBrush x:Key="AccentDeepBrush" Color="#FF7F171A" />

            <!-- Legacy Accent "Gradient" keys -->
            <SolidColorBrush x:Key="AccentGradientBrush" Color="#FFAA2024" />
            <SolidColorBrush x:Key="AccentGradientHoverBrush" Color="#FFC8333A" />

            <!-- Status Brushes (LED semantics - see the dual-form rule.
                 ErrorBrush is the steady NO-GO terminal-fault tone; the
                 blinking warn tone is LedWarnLampBrush, blink-only.) -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF41E25E" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFFFB000" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FFC8453E" />
            <SolidColorBrush x:Key="InfoBrush" Color="#FF58C4BC" />
            <SolidColorBrush x:Key="OnlineBrush" Color="#FF41E25E" />
            <SolidColorBrush x:Key="OfflineBrush" Color="#FF5A5A5A" />
            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#2641E25E" />
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="#26FFB000" />
            <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#26C8453E" />
            <SolidColorBrush x:Key="InfoSubtleBrush" Color="#2658C4BC" />

            <!-- LED lamp brushes (shift-invariant: lamps and dots keep
                 night values in Day Shift; only LED TEXT darkens) -->
            <SolidColorBrush x:Key="LedGoLampBrush" Color="#FF41E25E" />
            <SolidColorBrush x:Key="LedHoldLampBrush" Color="#FFFFB000" />
            <SolidColorBrush x:Key="LedWarnLampBrush" Color="#FFFF4438" />
            <SolidColorBrush x:Key="LedNoGoLampBrush" Color="#FFC8453E" />
            <SolidColorBrush x:Key="LedScopeLampBrush" Color="#FF58C4BC" />
            <SolidColorBrush x:Key="LedGoTextBrush" Color="#FF41E25E" />
            <SolidColorBrush x:Key="LedHoldTextBrush" Color="#FFFFB000" />
            <SolidColorBrush x:Key="LedWarnTextBrush" Color="#FFFF4438" />
            <SolidColorBrush x:Key="LedNoGoTextBrush" Color="#FFC8453E" />
            <SolidColorBrush x:Key="LedScopeTextBrush" Color="#FF58C4BC" />

            <!-- Console hardware brushes -->
            <SolidColorBrush x:Key="ChromeBrush" Color="#FFE6E6E6" />
            <SolidColorBrush x:Key="RingBrush" Color="#FFE6E6E6" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="#29FFFFFF" />

            <!-- Recessed wells (Layer 2 - ALWAYS dark, both shifts) -->
            <SolidColorBrush x:Key="WellBrush" Color="#FF080808" />
            <SolidColorBrush x:Key="WellBorderBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="WellTextBrush" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="WellTextSecondaryBrush" Color="#FFB3B3B3" />
            <SolidColorBrush x:Key="VoidBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="LcdPhosphorBrush" Color="#FF41E25E" />
            <SolidColorBrush x:Key="LcdAmberBrush" Color="#FFFFB000" />
            <SolidColorBrush x:Key="LcdHotBrush" Color="#FFE0252B" />

            <!-- Data-Visualization Brushes -->
            <SolidColorBrush x:Key="GraphTagBrush" Color="#FFB3B3B3" />
            <SolidColorBrush x:Key="GraphTagSubtleBrush" Color="#26B3B3B3" />
            <SolidColorBrush x:Key="ChartSeriesBrush" Color="#FFAA2024" />
            <SolidColorBrush x:Key="ChartSeriesSubtleBrush" Color="#26AA2024" />

            <!-- Input Field Brushes (console plate forms: recessed wells) -->
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF0A0A0A" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#FFAA2024" />
            <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#FF5A5A5A" />

            <!-- Fluent lightweight overrides: keep TextBox/PasswordBox/
                 AutoSuggestBox template states inside the dark well in
                 every interaction state (the template would otherwise
                 swap its own Background/Foreground on hover and focus). -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#FF0A0A0A" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF0D0D0D" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF080808" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FF101010" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#FF5A5A5A" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#29FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFAA2024" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF5A5A5A" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF6B6B6B" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF5A5A5A" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#FFAA2024" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF0A0A0A" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF0D0D0D" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FF080808" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#29FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#FFAA2024" />
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#FF5A5A5A" />

            <!-- Bat-lever toggle (DESIGN.md): recessed dark track in both
                 shifts, machined metal thumb, armed red when on -->
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FF0A0A0A" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#FF0D0D0D" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#FF080808" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#29FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#29FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFAA2024" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFC8333A" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF7F171A" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF7F171A" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF7F171A" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FF5E1114" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFD1D1D1" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />

            <!-- Scrollbar Brushes -->
            <SolidColorBrush x:Key="ScrollbarTrackBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#33FFFFFF" />

            <!-- Shadow / Overlay -->
            <SolidColorBrush x:Key="OverlayBrush" Color="#CC000000" />
            <SolidColorBrush x:Key="OverlayLightBrush" Color="#80000000" />

        </ResourceDictionary>

        <!-- ===========================================================
             LIGHT (DAY SHIFT) - silver anodized hardware.
             Designed variant, never an auto-invert. The chassis stays
             darker than the raised plates so silver reads as raised.
             Displays (wells, LCDs, lamp caps) STAY VOID-DARK.
             =========================================================== -->
        <ResourceDictionary x:Key="Light">

            <!-- Window & Page Backgrounds (chassis behind the plates) -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFC4C4BF" />
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFCBCBC6" />
            <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#FFC0C0BB" />

            <!-- Ambient surface brushes -->
            <SolidColorBrush x:Key="WindowGradientBrush" Color="#FFC4C4BF" />
            <SolidColorBrush x:Key="SidebarGradientBrush" Color="#FFC0C0BB" />
            <SolidColorBrush x:Key="HeaderGradientBrush" Color="#FFCBCBC6" />

            <!-- Card Surface Brushes (silver plates ascend brighter) -->
            <SolidColorBrush x:Key="CardBrush" Color="#FFEAEAE7" />
            <SolidColorBrush x:Key="CardElevatedBrush" Color="#FFF0F0ED" />
            <SolidColorBrush x:Key="CardHighBrush" Color="#FFF5F5F3" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#FFF7F7F5" />
            <SolidColorBrush x:Key="CardPressedBrush" Color="#FFDEDEDA" />

            <!-- Legacy Card "Gradient" keys (flat solids) -->
            <SolidColorBrush x:Key="CardGradientBrush" Color="#FFF0F0ED" />
            <SolidColorBrush x:Key="CardGradientVerticalBrush" Color="#FFF5F5F3" />
            <SolidColorBrush x:Key="CardGradientSubtleBrush" Color="#FFEAEAE7" />

            <!-- Accent Card -->
            <SolidColorBrush x:Key="AccentCardGradientBrush" Color="#FFEAEAE7" />
            <SolidColorBrush x:Key="AccentGlowGradientBrush" Color="#1FAA2024" />

            <!-- Border Brushes (low-opacity black on silver) -->
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="BorderMediumBrush" Color="#2E000000" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#42000000" />
            <SolidColorBrush x:Key="BorderFocusBrush" Color="#FFAA2024" />

            <!-- Legacy Border "Gradient" keys -->
            <SolidColorBrush x:Key="BorderGradientBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="BorderAccentGradientBrush" Color="#FFAA2024" />

            <!-- Text Brushes (day silver ramp - dark enamel on silver) -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF44443F" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF62625E" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#FF96968F" />
            <SolidColorBrush x:Key="TextInverseBrush" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="TextAccentBrush" Color="#FF941B1F" />
            <SolidColorBrush x:Key="TextLinkBrush" Color="#FF7F171A" />
            <SolidColorBrush x:Key="TextEmphasisBrush" Color="#FF2E2E2C" />

            <!-- Accent Brushes (armed red; hover darkens on silver) -->
            <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#FFAA2024" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF941B1F" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF7F171A" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1FAA2024" />
            <SolidColorBrush x:Key="AccentGlowBrush" Color="#26AA2024" />
            <SolidColorBrush x:Key="AccentLitBrush" Color="#FFC8333A" />
            <SolidColorBrush x:Key="AccentDeepBrush" Color="#FF7F171A" />

            <!-- Legacy Accent "Gradient" keys -->
            <SolidColorBrush x:Key="AccentGradientBrush" Color="#FFAA2024" />
            <SolidColorBrush x:Key="AccentGradientHoverBrush" Color="#FF941B1F" />

            <!-- Status Brushes (LED TEXT tones darkened for silver
                 surfaces; lamps and dots keep night values below) -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF177A3D" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FF996300" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FFC81E13" />
            <SolidColorBrush x:Key="InfoBrush" Color="#FF256F69" />
            <SolidColorBrush x:Key="OnlineBrush" Color="#FF177A3D" />
            <SolidColorBrush x:Key="OfflineBrush" Color="#FF96968F" />
            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#2641E25E" />
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="#26FFB000" />
            <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#26C8453E" />
            <SolidColorBrush x:Key="InfoSubtleBrush" Color="#2658C4BC" />

            <!-- LED lamp brushes (night values - shift-invariant) -->
            <SolidColorBrush x:Key="LedGoLampBrush" Color="#FF41E25E" />
            <SolidColorBrush x:Key="LedHoldLampBrush" Color="#FFFFB000" />
            <SolidColorBrush x:Key="LedWarnLampBrush" Color="#FFFF4438" />
            <SolidColorBrush x:Key="LedNoGoLampBrush" Color="#FFC8453E" />
            <SolidColorBrush x:Key="LedScopeLampBrush" Color="#FF58C4BC" />
            <SolidColorBrush x:Key="LedGoTextBrush" Color="#FF177A3D" />
            <SolidColorBrush x:Key="LedHoldTextBrush" Color="#FF996300" />
            <SolidColorBrush x:Key="LedWarnTextBrush" Color="#FFC81E13" />
            <SolidColorBrush x:Key="LedNoGoTextBrush" Color="#FFC81E13" />
            <SolidColorBrush x:Key="LedScopeTextBrush" Color="#FF256F69" />

            <!-- Console hardware brushes (Ring goes dark graphite in Day) -->
            <SolidColorBrush x:Key="ChromeBrush" Color="#FF2E2E2C" />
            <SolidColorBrush x:Key="RingBrush" Color="#FF44443F" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="#33000000" />

            <!-- Recessed wells (displays-stay-dark rule: void in Day too) -->
            <SolidColorBrush x:Key="WellBrush" Color="#FF080808" />
            <SolidColorBrush x:Key="WellBorderBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="WellTextBrush" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="WellTextSecondaryBrush" Color="#FFB3B3B3" />
            <SolidColorBrush x:Key="VoidBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="LcdPhosphorBrush" Color="#FF41E25E" />
            <SolidColorBrush x:Key="LcdAmberBrush" Color="#FFFFB000" />
            <SolidColorBrush x:Key="LcdHotBrush" Color="#FFE0252B" />

            <!-- Data-Visualization Brushes -->
            <SolidColorBrush x:Key="GraphTagBrush" Color="#FF44443F" />
            <SolidColorBrush x:Key="GraphTagSubtleBrush" Color="#1A44443F" />
            <SolidColorBrush x:Key="ChartSeriesBrush" Color="#FFAA2024" />
            <SolidColorBrush x:Key="ChartSeriesSubtleBrush" Color="#1FAA2024" />

            <!-- Input Field Brushes (Tier 2 sweep: inputs are recessed
                 dark wells with light text in Day Shift too - the
                 displays-stay-dark rule, like black displays on silver
                 studio hardware) -->
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF0A0A0A" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#66000000" />
            <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#FFAA2024" />
            <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#FF5A5A5A" />

            <!-- Fluent lightweight overrides: same dark-well discipline
                 in Day Shift; the well's edge carves into the silver
                 plate with a dark border instead of a white hairline. -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#FF0A0A0A" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF0D0D0D" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF080808" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#FF62625E" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#66000000" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#80000000" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFAA2024" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#33000000" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF5A5A5A" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF6B6B6B" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF5A5A5A" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#FFAA2024" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF0A0A0A" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF0D0D0D" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FF080808" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#FFF5F5F5" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#66000000" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#80000000" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#FFAA2024" />
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#FF5A5A5A" />

            <!-- Bat-lever toggle: the recessed track stays dark on silver
                 hardware (displays-stay-dark); hover darkens the armed fill -->
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FF0A0A0A" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#FF0D0D0D" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#FF080808" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#66000000" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#80000000" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#66000000" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFAA2024" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF941B1F" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF7F171A" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF7F171A" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF7F171A" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FF5E1114" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFD1D1D1" />
