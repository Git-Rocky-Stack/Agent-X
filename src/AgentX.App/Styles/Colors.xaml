<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║                    AGENT-X COLOR ARCHITECTURE                   ║
    ║                                                                  ║
    ║  Three-theme system: Default (Dark), Light, HighContrast.        ║
    ║                                                                  ║
    ║  Architecture (order matters in WinUI XAML — property elements   ║
    ║  must come BEFORE content):                                      ║
    ║    1. ThemeDictionaries (property element, must be first)        ║
    ║         • Default (Dark) — Agent-X signature palette             ║
    ║         • Light — executive light, AA-contrast text              ║
    ║         • HighContrast — binds to OS SystemColor* tokens         ║
    ║    2. Raw Color tokens — SHARED across themes.                   ║
    ║         Used by gradient stops, shadow colors, and legacy        ║
    ║         XAML references that consume colors (not brushes).       ║
    ║    3. Layout tokens — spacing, radius, padding, breakpoints,     ║
    ║         shadow geometry. SHARED, theme-invariant.                ║
    ║                                                                  ║
    ║  Tier 5a (this PR) ships the architecture + Light + HighContrast ║
    ║  palettes + a PoC migration of shared style dictionaries and     ║
    ║  five anchor pages. Tier 5b will mechanically migrate the        ║
    ║  remaining {StaticResource Brush} references → {ThemeResource}.  ║
    ║                                                                  ║
    ║  Flat-elevation system across all themes. NO gradients — depth   ║
    ║  comes from layered solid surfaces, subtle 1px borders, and      ║
    ║  confident typography. Gradients read as AI-generated; flat tone ║
    ║  reads as deliberate, Fortune-10 craft.                          ║
    ║                                                                  ║
    ║  The *Gradient* brush keys below are retained as solid brushes   ║
    ║  for binary back-compat with existing consumers. New code should ║
    ║  prefer the un-suffixed equivalents (CardBrush, AccentPrimary,   ║
    ║  BorderSubtle).                                                  ║
    ╚══════════════════════════════════════════════════════════════════╝
    -->

    <!-- ═══════════════════════════════════════════════════════════════
         THEMED BRUSH SYSTEM
         ═══════════════════════════════════════════════════════════════

         Brushes are defined per-theme inside ResourceDictionary.ThemeDictionaries.
         Key names are identical across themes — only the underlying color
         differs. Consumers must use {ThemeResource} (not {StaticResource})
         for these brushes to actually re-resolve when the theme switches.

         Light palette principles (executive-light, not "bright white"):
           • Backgrounds: near-white scale (#FFFFFF → #F0F0F0), never harsh.
           • Surfaces: ascend FROM white as elevation increases (inverse of
             dark, where surfaces ascend from black). Surface0 is whitest,
             Surface4 is deepest off-white.
           • Borders: low-opacity black (vs low-opacity white in dark).
           • Text: deep grey (#1A1A1A) primary, never pure black (harsh).
             Secondary / tertiary cascade down through mid-greys.
           • Accent: same Red500 brand — works on both palettes. Border
             focus uses Red600 (slightly darker) in Light for AA contrast
             against the near-white background.
           • Contrast targets: WCAG AA (4.5:1) minimum, AAA (7:1) for body.

         HighContrast principles:
           • Uses WinUI SystemColor* tokens so the app respects the user's
             OS High Contrast scheme choice (HC Black / HC White / HC #1 /
             HC #2). XamlControlsResources surfaces these automatically.
           • Brand red is replaced by SystemColorHighlightColor for
             accents — users with HC schemes need the system accent to
             render, not our brand color.
           • Borders use SystemColorWindowTextColor (full-opacity) — HC
             schemes require 1px solid full-opacity borders to meet AA.
         ═══════════════════════════════════════════════════════════════ -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ───────────────────────────────────────────────────────────
             DEFAULT THEME (DARK) — the Agent-X signature palette
             ─────────────────────────────────────────────────────────── -->
        <ResourceDictionary x:Key="Default">

            <!-- Window & Page Backgrounds -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FF050505" />
            <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#FF0A0A0A" />

            <!-- Ambient surface brushes (flat — legacy "Gradient" keys are solids) -->
            <SolidColorBrush x:Key="WindowGradientBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="SidebarGradientBrush" Color="#FF0A0A0A" />
            <SolidColorBrush x:Key="HeaderGradientBrush" Color="#FF050505" />

            <!-- Card Surface Brushes (elevation system) -->
            <SolidColorBrush x:Key="CardBrush" Color="#FF161616" />
            <SolidColorBrush x:Key="CardElevatedBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="CardHighBrush" Color="#FF1E1E1E" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#FF2A2A2A" />
            <SolidColorBrush x:Key="CardPressedBrush" Color="#FF303030" />

            <!-- Legacy Card "Gradient" keys (flat — match the un-suffixed brushes) -->
            <SolidColorBrush x:Key="CardGradientBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="CardGradientVerticalBrush" Color="#FF1E1E1E" />
            <SolidColorBrush x:Key="CardGradientSubtleBrush" Color="#FF161616" />

            <!-- Accent Card (featured / highlighted elements) -->
            <SolidColorBrush x:Key="AccentCardGradientBrush" Color="#FF161616" />
            <SolidColorBrush x:Key="AccentGlowGradientBrush" Color="#26C41E3A" />

            <!-- Border Brushes -->
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="BorderMediumBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="BorderFocusBrush" Color="#FFC41E3A" />

            <!-- Legacy Border "Gradient" keys -->
            <SolidColorBrush x:Key="BorderGradientBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="BorderAccentGradientBrush" Color="#FFC41E3A" />

            <!-- Text Brushes -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFB0B0B0" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF808080" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#FF484848" />
            <SolidColorBrush x:Key="TextInverseBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="TextAccentBrush" Color="#FFD4344D" />
            <SolidColorBrush x:Key="TextLinkBrush" Color="#FFE8546B" />

            <!-- Accent Brushes (brand red — identical across Dark/Light, system in HC) -->
            <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#FFC41E3A" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFD4344D" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#FFA51D33" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1AC41E3A" />
            <SolidColorBrush x:Key="AccentGlowBrush" Color="#33C41E3A" />

            <!-- Legacy Accent "Gradient" keys -->
            <SolidColorBrush x:Key="AccentGradientBrush" Color="#FFC41E3A" />
            <SolidColorBrush x:Key="AccentGradientHoverBrush" Color="#FFD4344D" />

            <!-- Status Brushes (semantic colors stay constant across themes) -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF22C55E" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFF59E0B" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FFEF4444" />
            <SolidColorBrush x:Key="InfoBrush" Color="#FF3B82F6" />
            <SolidColorBrush x:Key="OnlineBrush" Color="#FF10B981" />
            <SolidColorBrush x:Key="OfflineBrush" Color="#FF6B7280" />
            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#2622C55E" />
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="#26F59E0B" />
            <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#26EF4444" />
            <SolidColorBrush x:Key="InfoSubtleBrush" Color="#263B82F6" />

            <!-- Data-Visualization Brushes -->
            <SolidColorBrush x:Key="GraphTagBrush" Color="#FFB0B0B0" />
            <SolidColorBrush x:Key="GraphTagSubtleBrush" Color="#26B0B0B0" />
            <SolidColorBrush x:Key="ChartSeriesBrush" Color="#FFC41E3A" />
            <SolidColorBrush x:Key="ChartSeriesSubtleBrush" Color="#26C41E3A" />

            <!-- Input Field Brushes -->
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF111111" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#FFC41E3A" />
            <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#FF5C5C5C" />

            <!-- Scrollbar Brushes -->
            <SolidColorBrush x:Key="ScrollbarTrackBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#33FFFFFF" />

            <!-- Shadow / Overlay -->
            <SolidColorBrush x:Key="OverlayBrush" Color="#CC000000" />
            <SolidColorBrush x:Key="OverlayLightBrush" Color="#80000000" />

        </ResourceDictionary>

        <!-- ───────────────────────────────────────────────────────────
             LIGHT THEME — executive light, premium feel, AA contrast
             ─────────────────────────────────────────────────────────── -->
        <ResourceDictionary x:Key="Light">

            <!-- Window & Page Backgrounds -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFFCFCFC" />
            <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="#FFF6F6F6" />

            <!-- Ambient surface brushes -->
            <SolidColorBrush x:Key="WindowGradientBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SidebarGradientBrush" Color="#FFF6F6F6" />
            <SolidColorBrush x:Key="HeaderGradientBrush" Color="#FFFCFCFC" />

            <!-- Card Surface Brushes (elevation reads as DEEPER tint, not lighter) -->
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardElevatedBrush" Color="#FFF8F8F8" />
            <SolidColorBrush x:Key="CardHighBrush" Color="#FFF1F1F1" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#FFECECEC" />
            <SolidColorBrush x:Key="CardPressedBrush" Color="#FFE2E2E2" />

            <!-- Legacy Card "Gradient" keys (flat solids) -->
            <SolidColorBrush x:Key="CardGradientBrush" Color="#FFF8F8F8" />
            <SolidColorBrush x:Key="CardGradientVerticalBrush" Color="#FFF1F1F1" />
            <SolidColorBrush x:Key="CardGradientSubtleBrush" Color="#FFFFFFFF" />

            <!-- Accent Card -->
            <SolidColorBrush x:Key="AccentCardGradientBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentGlowGradientBrush" Color="#1AC41E3A" />

            <!-- Border Brushes (low-opacity BLACK, not white) -->
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#14000000" />
            <SolidColorBrush x:Key="BorderMediumBrush" Color="#26000000" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#3D000000" />
            <SolidColorBrush x:Key="BorderFocusBrush" Color="#FFA51D33" />

            <!-- Legacy Border "Gradient" keys -->
            <SolidColorBrush x:Key="BorderGradientBrush" Color="#14000000" />
            <SolidColorBrush x:Key="BorderAccentGradientBrush" Color="#FFA51D33" />

            <!-- Text Brushes (deep grey, never pure black) -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF595959" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF7D7D7D" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#FFB0B0B0" />
            <SolidColorBrush x:Key="TextInverseBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextAccentBrush" Color="#FFA51D33" />
            <SolidColorBrush x:Key="TextLinkBrush" Color="#FF8B1A2B" />

            <!-- Accent Brushes (brand red — slightly darker shifts for AA contrast on near-white) -->
            <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#FFA51D33" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFC41E3A" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF8B1A2B" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1AC41E3A" />
            <SolidColorBrush x:Key="AccentGlowBrush" Color="#26C41E3A" />

            <!-- Legacy Accent "Gradient" keys -->
            <SolidColorBrush x:Key="AccentGradientBrush" Color="#FFA51D33" />
            <SolidColorBrush x:Key="AccentGradientHoverBrush" Color="#FFC41E3A" />

            <!-- Status Brushes (semantic colors — same hues, mostly identical
                 across themes; subtle variants nudged for visibility on light bg) -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF15803D" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFB45309" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FFB91C1C" />
            <SolidColorBrush x:Key="InfoBrush" Color="#FF1D4ED8" />
            <SolidColorBrush x:Key="OnlineBrush" Color="#FF047857" />
            <SolidColorBrush x:Key="OfflineBrush" Color="#FF6B7280" />
            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#1A22C55E" />
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="#1AF59E0B" />
            <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#1AEF4444" />
            <SolidColorBrush x:Key="InfoSubtleBrush" Color="#1A3B82F6" />

            <!-- Data-Visualization Brushes -->
            <SolidColorBrush x:Key="GraphTagBrush" Color="#FF595959" />
            <SolidColorBrush x:Key="GraphTagSubtleBrush" Color="#1A595959" />
            <SolidColorBrush x:Key="ChartSeriesBrush" Color="#FFA51D33" />
            <SolidColorBrush x:Key="ChartSeriesSubtleBrush" Color="#1AC41E3A" />

            <!-- Input Field Brushes -->
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#26000000" />
            <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#FFA51D33" />
            <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#FF9E9E9E" />

            <!-- Scrollbar Brushes -->
            <SolidColorBrush x:Key="ScrollbarTrackBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#26000000" />
            <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#3D000000" />

            <!-- Shadow / Overlay -->
            <SolidColorBrush x:Key="OverlayBrush" Color="#80000000" />
            <SolidColorBrush x:Key="OverlayLightBrush" Color="#40000000" />

        </ResourceDictionary>

        <!-- ───────────────────────────────────────────────────────────
             HIGH CONTRAST THEME — respects OS HC scheme choice
             All chrome, text, and borders bind to SystemColor* tokens
             so users with HC schemes (HC Black, HC White, HC #1, HC #2)
             see correct contrast. Brand red is replaced by the system
             accent so user-chosen HC accents render correctly.
             ─────────────────────────────────────────────────────────── -->
        <ResourceDictionary x:Key="HighContrast">

            <!-- Window & Page Backgrounds -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <!-- Ambient surface brushes -->
            <SolidColorBrush x:Key="WindowGradientBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SidebarGradientBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HeaderGradientBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <!-- Card Surface Brushes (HC has no elevation system — flat window color) -->
            <SolidColorBrush x:Key="CardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardHighBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CardPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <!-- Legacy Card "Gradient" keys -->
            <SolidColorBrush x:Key="CardGradientBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardGradientVerticalBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardGradientSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <!-- Accent Card -->
            <SolidColorBrush x:Key="AccentCardGradientBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AccentGlowGradientBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <!-- Border Brushes (HC requires full-opacity, no transparency) -->
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BorderMediumBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BorderFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <!-- Legacy Border "Gradient" keys -->
            <SolidColorBrush x:Key="BorderGradientBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BorderAccentGradientBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <!-- Text Brushes -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="TextInverseBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="TextAccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="TextLinkBrush" Color="{ThemeResource SystemColorHotlightColor}" />

            <!-- Accent Brushes (system highlight — what the OS calls "accent") -->
            <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentGlowBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <!-- Legacy Accent "Gradient" keys -->
            <SolidColorBrush x:Key="AccentGradientBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentGradientHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <!-- Status Brushes (system colors — HC doesn't distinguish status hues) -->
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="InfoBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OnlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OfflineBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ErrorSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InfoSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <!-- Data-Visualization Brushes -->
            <SolidColorBrush x:Key="GraphTagBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GraphTagSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ChartSeriesBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChartSeriesSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <!-- Input Field Brushes -->
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="InputPlaceholderBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

            <!-- Scrollbar Brushes -->
            <SolidColorBrush x:Key="ScrollbarTrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <!-- Shadow / Overlay -->
            <SolidColorBrush x:Key="OverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OverlayLightBrush" Color="{ThemeResource SystemColorWindowColor}" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ═══════════════════════════════════════════════════════════════
         RAW COLOR TOKENS — shared across themes
         (Used by gradient stops, shadow colors, and legacy references.
          These values do NOT swap on theme change — they describe the
          dark palette as our "default" pigment vocabulary. Theme-aware
          consumers must use the brushes above, not these raw colors.)
         ═══════════════════════════════════════════════════════════════ -->

    <!-- Background Scale (darkest → lightest) -->
    <Color x:Key="Black">#FF000000</Color>
    <Color x:Key="BackgroundPrimary">#FF050505</Color>
    <Color x:Key="BackgroundSecondary">#FF0A0A0A</Color>
    <Color x:Key="BackgroundTertiary">#FF0F0F0F</Color>

    <!-- Surface Scale (card elevations) -->
    <Color x:Key="Surface0">#FF111111</Color>
    <Color x:Key="Surface1">#FF161616</Color>
    <Color x:Key="Surface2">#FF1A1A1A</Color>
    <Color x:Key="Surface3">#FF1E1E1E</Color>
    <Color x:Key="Surface4">#FF242424</Color>
    <Color x:Key="SurfaceHover">#FF2A2A2A</Color>
    <Color x:Key="SurfacePressed">#FF303030</Color>

    <!-- Border Scale -->
    <Color x:Key="BorderSubtle">#1AFFFFFF</Color>
    <Color x:Key="BorderMedium">#33FFFFFF</Color>
    <Color x:Key="BorderStrong">#4DFFFFFF</Color>
    <Color x:Key="BorderFocus">#FFC41E3A</Color>

    <!-- Charcoal Scale -->
    <Color x:Key="Charcoal900">#FF1A1A1A</Color>
    <Color x:Key="Charcoal800">#FF222222</Color>
    <Color x:Key="Charcoal700">#FF2E2E2E</Color>
    <Color x:Key="Charcoal600">#FF3A3A3A</Color>
    <Color x:Key="Charcoal500">#FF484848</Color>
    <Color x:Key="Charcoal400">#FF5C5C5C</Color>

    <!-- Silver / Grey Scale -->
    <Color x:Key="Silver700">#FF6B6B6B</Color>
    <Color x:Key="Silver600">#FF808080</Color>
    <Color x:Key="Silver500">#FF999999</Color>
    <Color x:Key="Silver400">#FFB0B0B0</Color>
    <Color x:Key="Silver300">#FFC0C0C0</Color>

    <!-- Light Grey Scale -->
    <Color x:Key="LightGrey200">#FFD4D4D4</Color>
    <Color x:Key="LightGrey100">#FFE0E0E0</Color>
    <Color x:Key="LightGrey50">#FFECECEC</Color>

    <!-- White Scale -->
    <Color x:Key="White95">#F2FFFFFF</Color>
    <Color x:Key="White90">#E6FFFFFF</Color>
    <Color x:Key="White80">#CCFFFFFF</Color>
    <Color x:Key="White70">#B3FFFFFF</Color>
    <Color x:Key="White60">#99FFFFFF</Color>
    <Color x:Key="White50">#80FFFFFF</Color>
    <Color x:Key="White40">#66FFFFFF</Color>
    <Color x:Key="White30">#4DFFFFFF</Color>
    <Color x:Key="White20">#33FFFFFF</Color>
    <Color x:Key="White10">#1AFFFFFF</Color>
    <Color x:Key="White05">#0DFFFFFF</Color>
    <Color x:Key="PureWhite">#FFFFFFFF</Color>

    <!-- Red / Accent Scale (brand colors — identical across all three themes) -->
    <Color x:Key="Red950">#FF3D0A12</Color>
    <Color x:Key="Red900">#FF5C1018</Color>
    <Color x:Key="Red800">#FF7A1520</Color>
    <Color x:Key="Red700">#FF8B1A2B</Color>
    <Color x:Key="Red600">#FFA51D33</Color>
    <Color x:Key="Red500">#FFC41E3A</Color>
    <Color x:Key="Red400">#FFD4344D</Color>
    <Color x:Key="Red300">#FFE8546B</Color>
    <Color x:Key="Red200">#FFF0899A</Color>
    <Color x:Key="Red100">#FFF5B3BF</Color>
    <Color x:Key="Red50">#FFFCE8EB</Color>

    <!-- Red Opacity Variants -->
    <Color x:Key="RedGlow30">#4DC41E3A</Color>
    <Color x:Key="RedGlow20">#33C41E3A</Color>
    <Color x:Key="RedGlow15">#26C41E3A</Color>
    <Color x:Key="RedGlow10">#1AC41E3A</Color>
    <Color x:Key="RedGlow05">#0DC41E3A</Color>

    <!-- Status Colors (brand-neutral, identical across themes) -->
    <Color x:Key="StatusSuccess">#FF22C55E</Color>
    <Color x:Key="StatusWarning">#FFF59E0B</Color>
    <Color x:Key="StatusError">#FFEF4444</Color>
    <Color x:Key="StatusInfo">#FF3B82F6</Color>
    <Color x:Key="StatusOnline">#FF10B981</Color>
    <Color x:Key="StatusOffline">#FF6B7280</Color>
    <Color x:Key="StatusSuccessSubtle">#2622C55E</Color>
    <Color x:Key="StatusWarningSubtle">#26F59E0B</Color>
    <Color x:Key="StatusErrorSubtle">#26EF4444</Color>
    <Color x:Key="StatusInfoSubtle">#263B82F6</Color>

    <!-- Data-Visualization Colors (kept on-palette).
         GraphTag was violet (#8B5CF6) — replaced with Silver400 so graph
         tag pills read as neutral metadata, not a third brand color.
         ChartSeries was orange (#F97316) — replaced with Red500 so series
         accents share the primary brand red. Keys preserved for back-compat. -->
    <Color x:Key="GraphTagColor">#FFB0B0B0</Color>
    <Color x:Key="GraphTagSubtle">#26B0B0B0</Color>
    <Color x:Key="ChartSeriesColor">#FFC41E3A</Color>
    <Color x:Key="ChartSeriesSubtle">#26C41E3A</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         ELEVATION SHADOW DEFINITIONS (theme-invariant geometry)
         ═══════════════════════════════════════════════════════════════ -->

    <x:String x:Key="ShadowSmall">0 1 3 0</x:String>
    <x:String x:Key="ShadowMedium">0 4 12 0</x:String>
    <x:String x:Key="ShadowLarge">0 8 24 0</x:String>
    <x:String x:Key="ShadowXLarge">0 16 48 0</x:String>

    <!-- ═══════════════════════════════════════════════════════════════
         SPACING & SIZING TOKENS (theme-invariant)
         ═══════════════════════════════════════════════════════════════ -->

    <x:Double x:Key="SpacingXXS">2</x:Double>
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingSM">8</x:Double>
    <x:Double x:Key="SpacingMD">12</x:Double>
    <x:Double x:Key="SpacingLG">16</x:Double>
    <x:Double x:Key="SpacingXL">24</x:Double>
    <x:Double x:Key="SpacingXXL">32</x:Double>
    <x:Double x:Key="Spacing3XL">48</x:Double>
    <x:Double x:Key="Spacing4XL">64</x:Double>

    <CornerRadius x:Key="RadiusNone">0</CornerRadius>
    <CornerRadius x:Key="RadiusXS">2</CornerRadius>
    <CornerRadius x:Key="RadiusSM">4</CornerRadius>
    <CornerRadius x:Key="RadiusMD">8</CornerRadius>
    <CornerRadius x:Key="RadiusLG">12</CornerRadius>
    <CornerRadius x:Key="RadiusXL">16</CornerRadius>
    <!-- Symmetry: shapes are squares / rounded rectangles / perfect circles —
         never oblong capsules. Use RadiusFull (9999) only when the element
         is W=H and you genuinely want a perfect circle (avatars, icon
         buttons). Everything else: pill capsules are visually loud and
         "AI generated" — keep corners moderate (RadiusSM/MD). -->
    <CornerRadius x:Key="RadiusRound">4</CornerRadius>
    <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

    <Thickness x:Key="BorderThin">1</Thickness>
    <Thickness x:Key="BorderMediumThickness">1.5</Thickness>
    <Thickness x:Key="BorderThick">2</Thickness>

    <Thickness x:Key="PaddingSM">8</Thickness>
    <Thickness x:Key="PaddingMD">12</Thickness>
    <Thickness x:Key="PaddingLG">16</Thickness>
    <Thickness x:Key="PaddingXL">24</Thickness>
    <Thickness x:Key="PaddingXXL">32</Thickness>
    <Thickness x:Key="PaddingCard">20</Thickness>
    <Thickness x:Key="PaddingPage">32,24,32,24</Thickness>

    <!-- ═══════════════════════════════════════════════════════════════
         ADAPTIVE BREAKPOINTS  (Tier 3 — adaptive layout)
         ═══════════════════════════════════════════════════════════════

         These thresholds drive AdaptiveTrigger.MinWindowWidth across the
         app. WinUI's AdaptiveTrigger requires literal numeric values, not
         StaticResource references — these tokens are the *single source
         of truth* for review, code search, and consistency. When a page
         adds an AdaptiveTrigger, copy the numeric value from here and
         leave a sibling XAML comment naming the token (e.g. the literal
         text "BreakpointMedium") so the link to this table stays
         greppable.

         Tier     Min width   Use
         Narrow      0         fallback / always matches (base state)
         Medium    960         one collapse step — sidebar narrows; chat
                               top-bar labels collapse to icons
         Wide     1280         full layout — all labels visible, panes at
                               their original design width
         XWide    1600         wider gutters, broader cards (future use) -->

    <x:Double x:Key="BreakpointMedium">960</x:Double>
    <x:Double x:Key="BreakpointWide">1280</x:Double>
    <x:Double x:Key="BreakpointXWide">1600</x:Double>

</ResourceDictionary>
