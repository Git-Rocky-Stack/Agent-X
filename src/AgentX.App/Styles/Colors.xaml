<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║                    AGENT-X COLOR ARCHITECTURE                   ║
    ║                                                                  ║
    ║  Premium dark theme with red accent system.                      ║
    ║  Palette: Black, Charcoal, Silver, Light Grey, White, Red.       ║
    ║                                                                  ║
    ║  Flat-elevation system. NO gradients — depth comes from layered  ║
    ║  solid surfaces (Surface0 → Surface4), subtle 1px borders, and   ║
    ║  confident typography. Gradients read as AI-generated; flat tone ║
    ║  reads as deliberate, Fortune-10 craft.                          ║
    ║                                                                  ║
    ║  The *Gradient* brush keys below are retained as solid brushes   ║
    ║  for binary back-compat with existing consumers. New code should ║
    ║  prefer the un-suffixed equivalents (CardBrush, AccentPrimary,   ║
    ║  BorderSubtle).                                                  ║
    ╚══════════════════════════════════════════════════════════════════╝
    -->

    <!-- ═══════════════════════════════════════════════════════════════
         RAW COLOR TOKENS (Semantic naming — never use hex in XAML)
         ═══════════════════════════════════════════════════════════════ -->

    <!-- Background Scale (darkest → lightest) -->
    <Color x:Key="Black">#FF000000</Color>
    <Color x:Key="BackgroundPrimary">#FF050505</Color>
    <Color x:Key="BackgroundSecondary">#FF0A0A0A</Color>
    <Color x:Key="BackgroundTertiary">#FF0F0F0F</Color>

    <!-- Surface Scale (card elevations) -->
    <Color x:Key="Surface0">#FF111111</Color>
    <Color x:Key="Surface1">#FF161616</Color>
    <Color x:Key="Surface2">#FF1A1A1A</Color>
    <Color x:Key="Surface3">#FF1E1E1E</Color>
    <Color x:Key="Surface4">#FF242424</Color>
    <Color x:Key="SurfaceHover">#FF2A2A2A</Color>
    <Color x:Key="SurfacePressed">#FF303030</Color>

    <!-- Border Scale -->
    <Color x:Key="BorderSubtle">#1AFFFFFF</Color>
    <Color x:Key="BorderMedium">#33FFFFFF</Color>
    <Color x:Key="BorderStrong">#4DFFFFFF</Color>
    <Color x:Key="BorderFocus">#FFC41E3A</Color>

    <!-- Charcoal Scale -->
    <Color x:Key="Charcoal900">#FF1A1A1A</Color>
    <Color x:Key="Charcoal800">#FF222222</Color>
    <Color x:Key="Charcoal700">#FF2E2E2E</Color>
    <Color x:Key="Charcoal600">#FF3A3A3A</Color>
    <Color x:Key="Charcoal500">#FF484848</Color>
    <Color x:Key="Charcoal400">#FF5C5C5C</Color>

    <!-- Silver / Grey Scale -->
    <Color x:Key="Silver700">#FF6B6B6B</Color>
    <Color x:Key="Silver600">#FF808080</Color>
    <Color x:Key="Silver500">#FF999999</Color>
    <Color x:Key="Silver400">#FFB0B0B0</Color>
    <Color x:Key="Silver300">#FFC0C0C0</Color>

    <!-- Light Grey Scale -->
    <Color x:Key="LightGrey200">#FFD4D4D4</Color>
    <Color x:Key="LightGrey100">#FFE0E0E0</Color>
    <Color x:Key="LightGrey50">#FFECECEC</Color>

    <!-- White Scale -->
    <Color x:Key="White95">#F2FFFFFF</Color>
    <Color x:Key="White90">#E6FFFFFF</Color>
    <Color x:Key="White80">#CCFFFFFF</Color>
    <Color x:Key="White70">#B3FFFFFF</Color>
    <Color x:Key="White60">#99FFFFFF</Color>
    <Color x:Key="White50">#80FFFFFF</Color>
    <Color x:Key="White40">#66FFFFFF</Color>
    <Color x:Key="White30">#4DFFFFFF</Color>
    <Color x:Key="White20">#33FFFFFF</Color>
    <Color x:Key="White10">#1AFFFFFF</Color>
    <Color x:Key="White05">#0DFFFFFF</Color>
    <Color x:Key="PureWhite">#FFFFFFFF</Color>

    <!-- Red / Accent Scale -->
    <Color x:Key="Red950">#FF3D0A12</Color>
    <Color x:Key="Red900">#FF5C1018</Color>
    <Color x:Key="Red800">#FF7A1520</Color>
    <Color x:Key="Red700">#FF8B1A2B</Color>
    <Color x:Key="Red600">#FFA51D33</Color>
    <Color x:Key="Red500">#FFC41E3A</Color>
    <Color x:Key="Red400">#FFD4344D</Color>
    <Color x:Key="Red300">#FFE8546B</Color>
    <Color x:Key="Red200">#FFF0899A</Color>
    <Color x:Key="Red100">#FFF5B3BF</Color>
    <Color x:Key="Red50">#FFFCE8EB</Color>

    <!-- Red Opacity Variants -->
    <Color x:Key="RedGlow30">#4DC41E3A</Color>
    <Color x:Key="RedGlow20">#33C41E3A</Color>
    <Color x:Key="RedGlow15">#26C41E3A</Color>
    <Color x:Key="RedGlow10">#1AC41E3A</Color>
    <Color x:Key="RedGlow05">#0DC41E3A</Color>

    <!-- Status Colors -->
    <Color x:Key="StatusSuccess">#FF22C55E</Color>
    <Color x:Key="StatusWarning">#FFF59E0B</Color>
    <Color x:Key="StatusError">#FFEF4444</Color>
    <Color x:Key="StatusInfo">#FF3B82F6</Color>
    <Color x:Key="StatusOnline">#FF10B981</Color>
    <Color x:Key="StatusOffline">#FF6B7280</Color>
    <Color x:Key="StatusSuccessSubtle">#2622C55E</Color>
    <Color x:Key="StatusWarningSubtle">#26F59E0B</Color>
    <Color x:Key="StatusErrorSubtle">#26EF4444</Color>
    <Color x:Key="StatusInfoSubtle">#263B82F6</Color>

    <!-- Data-Visualization Colors (kept on-palette).
         GraphTag was violet (#8B5CF6) — replaced with Silver400 so graph
         tag pills read as neutral metadata, not a third brand color.
         ChartSeries was orange (#F97316) — replaced with Red500 so series
         accents share the primary brand red. Keys preserved for back-compat. -->
    <Color x:Key="GraphTagColor">#FFB0B0B0</Color>
    <Color x:Key="GraphTagSubtle">#26B0B0B0</Color>
    <Color x:Key="ChartSeriesColor">#FFC41E3A</Color>
    <Color x:Key="ChartSeriesSubtle">#26C41E3A</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         SEMANTIC BRUSH SYSTEM
         ═══════════════════════════════════════════════════════════════ -->

    <!-- Window & Page Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource BackgroundPrimary}" />
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondary}" />

    <!-- Ambient surface brushes (flat — depth via layered solids, not gradients) -->
    <SolidColorBrush x:Key="WindowGradientBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="SidebarGradientBrush" Color="{StaticResource BackgroundSecondary}" />
    <SolidColorBrush x:Key="HeaderGradientBrush" Color="{StaticResource BackgroundPrimary}" />

    <!-- Card Surface Brushes (elevation system) -->
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource Surface1}" />
    <SolidColorBrush x:Key="CardElevatedBrush" Color="{StaticResource Surface2}" />
    <SolidColorBrush x:Key="CardHighBrush" Color="{StaticResource Surface3}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource SurfaceHover}" />
    <SolidColorBrush x:Key="CardPressedBrush" Color="{StaticResource SurfacePressed}" />

    <!-- Card Surface Brushes (flat — match the un-suffixed Card brushes above) -->
    <SolidColorBrush x:Key="CardGradientBrush" Color="{StaticResource Surface2}" />
    <SolidColorBrush x:Key="CardGradientVerticalBrush" Color="{StaticResource Surface3}" />
    <SolidColorBrush x:Key="CardGradientSubtleBrush" Color="{StaticResource Surface1}" />

    <!-- Accent Card (featured / highlighted elements) — flat Surface1 + the
         accent treatment is the BorderFocusBrush (solid red) edge -->
    <SolidColorBrush x:Key="AccentCardGradientBrush" Color="{StaticResource Surface1}" />
    <SolidColorBrush x:Key="AccentGlowGradientBrush" Color="{StaticResource RedGlow15}" />

    <!-- Border Brushes -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />
    <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMedium}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocus}" />

    <!-- Border brushes (flat — edge accent is opacity, not gradient direction) -->
    <SolidColorBrush x:Key="BorderGradientBrush" Color="{StaticResource BorderSubtle}" />
    <SolidColorBrush x:Key="BorderAccentGradientBrush" Color="{StaticResource BorderFocus}" />

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource White95}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Silver400}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource Silver600}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource Charcoal500}" />
    <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="TextAccentBrush" Color="{StaticResource Red400}" />
    <SolidColorBrush x:Key="TextLinkBrush" Color="{StaticResource Red300}" />

    <!-- Accent Brushes -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource Red500}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource Red400}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource Red600}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource RedGlow10}" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource RedGlow20}" />

    <!-- Accent Brushes for buttons / highlights (flat — confidence through
         saturation, not gradient direction) -->
    <SolidColorBrush x:Key="AccentGradientBrush" Color="{StaticResource Red500}" />
    <SolidColorBrush x:Key="AccentGradientHoverBrush" Color="{StaticResource Red400}" />

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource StatusSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource StatusWarning}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource StatusError}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource StatusInfo}" />
    <SolidColorBrush x:Key="OnlineBrush" Color="{StaticResource StatusOnline}" />
    <SolidColorBrush x:Key="OfflineBrush" Color="{StaticResource StatusOffline}" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource StatusSuccessSubtle}" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource StatusWarningSubtle}" />
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="{StaticResource StatusErrorSubtle}" />
    <SolidColorBrush x:Key="InfoSubtleBrush" Color="{StaticResource StatusInfoSubtle}" />

    <!-- Data-Visualization Brushes (graph nodes / chart series) -->
    <SolidColorBrush x:Key="GraphTagBrush" Color="{StaticResource GraphTagColor}" />
    <SolidColorBrush x:Key="GraphTagSubtleBrush" Color="{StaticResource GraphTagSubtle}" />
    <SolidColorBrush x:Key="ChartSeriesBrush" Color="{StaticResource ChartSeriesColor}" />
    <SolidColorBrush x:Key="ChartSeriesSubtleBrush" Color="{StaticResource ChartSeriesSubtle}" />

    <!-- Input Field Brushes -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource Surface0}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource BorderSubtle}" />
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{StaticResource Red500}" />
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="{StaticResource Charcoal400}" />

    <!-- Scrollbar Brushes -->
    <SolidColorBrush x:Key="ScrollbarTrackBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="{StaticResource White10}" />
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="{StaticResource White20}" />

    <!-- Shadow / Overlay -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#CC000000" />
    <SolidColorBrush x:Key="OverlayLightBrush" Color="#80000000" />

    <!-- ═══════════════════════════════════════════════════════════════
         ELEVATION SHADOW DEFINITIONS
         ═══════════════════════════════════════════════════════════════ -->

    <x:String x:Key="ShadowSmall">0 1 3 0</x:String>
    <x:String x:Key="ShadowMedium">0 4 12 0</x:String>
    <x:String x:Key="ShadowLarge">0 8 24 0</x:String>
    <x:String x:Key="ShadowXLarge">0 16 48 0</x:String>

    <!-- ═══════════════════════════════════════════════════════════════
         SPACING & SIZING TOKENS
         ═══════════════════════════════════════════════════════════════ -->

    <x:Double x:Key="SpacingXXS">2</x:Double>
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingSM">8</x:Double>
    <x:Double x:Key="SpacingMD">12</x:Double>
    <x:Double x:Key="SpacingLG">16</x:Double>
    <x:Double x:Key="SpacingXL">24</x:Double>
    <x:Double x:Key="SpacingXXL">32</x:Double>
    <x:Double x:Key="Spacing3XL">48</x:Double>
    <x:Double x:Key="Spacing4XL">64</x:Double>

    <CornerRadius x:Key="RadiusNone">0</CornerRadius>
    <CornerRadius x:Key="RadiusXS">2</CornerRadius>
    <CornerRadius x:Key="RadiusSM">4</CornerRadius>
    <CornerRadius x:Key="RadiusMD">8</CornerRadius>
    <CornerRadius x:Key="RadiusLG">12</CornerRadius>
    <CornerRadius x:Key="RadiusXL">16</CornerRadius>
    <CornerRadius x:Key="RadiusRound">9999</CornerRadius>

    <Thickness x:Key="BorderThin">1</Thickness>
    <Thickness x:Key="BorderMediumThickness">1.5</Thickness>
    <Thickness x:Key="BorderThick">2</Thickness>

    <Thickness x:Key="PaddingSM">8</Thickness>
    <Thickness x:Key="PaddingMD">12</Thickness>
    <Thickness x:Key="PaddingLG">16</Thickness>
    <Thickness x:Key="PaddingXL">24</Thickness>
    <Thickness x:Key="PaddingXXL">32</Thickness>
    <Thickness x:Key="PaddingCard">20</Thickness>
    <Thickness x:Key="PaddingPage">32,24,32,24</Thickness>

</ResourceDictionary>
