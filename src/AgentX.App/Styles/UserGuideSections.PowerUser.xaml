<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║          USER GUIDE POWER USER SECTIONS (NEW)                     ║
    ║                                                                  ║
    ║  AdvancedQueriesTemplate, PerformanceTuningTemplate,              ║
    ║  ExportTemplate                                                   ║
    ╚══════════════════════════════════════════════════════════════════╝
    -->

    <!-- ═══════════════════════════════════════════════════════════════
         ADVANCED QUERIES
         ═══════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="AdvancedQueriesTemplate">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="16">
                <!-- Section Header -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8C8;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="20"
                              Foreground="{StaticResource TextAccentBrush}" />
                    <TextBlock Grid.Column="1"
                               x:Uid="UserGuide_AdvancedQueries_Title"
                               Style="{StaticResource HeadingMediumStyle}" />
                </Grid>

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_AdvancedQueries_Description" />

                <!-- Techniques -->
                <TextBlock x:Uid="UserGuide_AdvancedQueries_Techniques_Title"
                           Style="{StaticResource HeadingSmallStyle}" />

                <StackPanel Spacing="10">
                    <Border Style="{StaticResource CardInsetStyle}" Padding="14,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Collection Scoping"
                                           Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock x:Uid="UserGuide_AdvancedQueries_Technique1"
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardInsetStyle}" Padding="14,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Time-Bounding"
                                           Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock x:Uid="UserGuide_AdvancedQueries_Technique2"
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardInsetStyle}" Padding="14,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Comparative Queries"
                                           Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock x:Uid="UserGuide_AdvancedQueries_Technique3"
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardInsetStyle}" Padding="14,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Structured Output"
                                           Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock x:Uid="UserGuide_AdvancedQueries_Technique4"
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════════════════════
         PERFORMANCE TUNING
         ═══════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="PerformanceTuningTemplate">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="16">
                <!-- Section Header -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9C9;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="20"
                              Foreground="{StaticResource TextAccentBrush}" />
                    <TextBlock Grid.Column="1"
                               x:Uid="UserGuide_PerformanceTuning_Title"
                               Style="{StaticResource HeadingMediumStyle}" />
                </Grid>

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_PerformanceTuning_Description" />

                <!-- Memory -->
                <TextBlock x:Uid="UserGuide_PerformanceTuning_Memory_Title"
                           Style="{StaticResource HeadingSmallStyle}" />

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_PerformanceTuning_Memory" />

                <Border Style="{StaticResource SeparatorStyle}" />

                <!-- Queries -->
                <TextBlock x:Uid="UserGuide_PerformanceTuning_Queries_Title"
                           Style="{StaticResource HeadingSmallStyle}" />

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_PerformanceTuning_Queries" />

                <Border Style="{StaticResource SeparatorStyle}" />

                <!-- Local Models -->
                <TextBlock x:Uid="UserGuide_PerformanceTuning_Local_Title"
                           Style="{StaticResource HeadingSmallStyle}" />

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_PerformanceTuning_Local" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════════════════════
         EXPORT & DATA PORTABILITY
         ═══════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="ExportTemplate">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="16">
                <!-- Section Header -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE89C;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="20"
                              Foreground="{StaticResource TextAccentBrush}" />
                    <TextBlock Grid.Column="1"
                               x:Uid="UserGuide_Export_Title"
                               Style="{StaticResource HeadingMediumStyle}" />
                </Grid>

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_Export_Description" />

                <!-- Conversation Export -->
                <TextBlock x:Uid="UserGuide_Export_Conversations_Title"
                           Style="{StaticResource HeadingSmallStyle}" />

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_Export_Conversations" />

                <Border Style="{StaticResource SeparatorStyle}" />

                <!-- Document Export -->
                <TextBlock x:Uid="UserGuide_Export_Documents_Title"
                           Style="{StaticResource HeadingSmallStyle}" />

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_Export_Documents" />

                <Border Style="{StaticResource SeparatorStyle}" />

                <!-- Backups -->
                <TextBlock x:Uid="UserGuide_Export_Backup_Title"
                           Style="{StaticResource HeadingSmallStyle}" />

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_Export_Backup" />

                <Border Style="{StaticResource SeparatorStyle}" />

                <!-- Restore -->
                <TextBlock x:Uid="UserGuide_Export_Restore_Title"
                           Style="{StaticResource HeadingSmallStyle}" />

                <TextBlock Style="{StaticResource BodyStyle}"
                           x:Uid="UserGuide_Export_Restore" />
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
