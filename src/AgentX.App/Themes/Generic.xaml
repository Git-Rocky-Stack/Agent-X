<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AgentX.App.Controls">

    <!--
    ====================================================================
       DEFAULT STYLES FOR AGENT-X TEMPLATED CONTROLS (DESIGN.md)
    ====================================================================
    Self-contained by design: templated-control resources resolve here
    at parse time, so fonts and shadows are declared locally. Brushes
    resolve dynamically via ThemeResource against Colors/Hardware.xaml
    theme dictionaries (Night Ops / Day Shift / HighContrast).
    -->

    <FontFamily x:Key="FaceplateKickerFont">ms-appx:///Assets/Fonts/DepartureMono-Regular.otf#Departure Mono</FontFamily>
    <ThemeShadow x:Key="FaceplateControlShadow" />

    <Style TargetType="controls:Faceplate">
        <Setter Property="Padding" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Faceplate">
                    <Grid>
                        <!-- The plate: brushed aluminum, machined radius,
                             ambient depth (raised 24 units off the chassis) -->
                        <Border x:Name="Plate"
                                Background="{ThemeResource FaceplateBrush}"
                                BorderBrush="{ThemeResource FaceplateBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Shadow="{StaticResource FaceplateControlShadow}"
                                Translation="0,0,24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Brushed stripe header; side padding clears the bolts -->
                                <Border Grid.Row="0"
                                        Visibility="{TemplateBinding StripeVisibility}"
                                        Background="{ThemeResource StripeBrush}"
                                        BorderBrush="{ThemeResource StripeRuleBrush}"
                                        BorderThickness="0,0,0,1"
                                        Height="36"
                                        Padding="40,0"
                                        CornerRadius="2,2,0,0">
                                    <TextBlock Text="{TemplateBinding Kicker}"
                                               FontFamily="{StaticResource FaceplateKickerFont}"
                                               FontSize="10"
                                               CharacterSpacing="50"
                                               Foreground="{ThemeResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- machined top bevel -->
                                <Border Grid.Row="0"
                                        Height="1"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource FaceplateHighlightBrush}"
                                        Margin="1,1,1,0"
                                        IsHitTestVisible="False" />

                                <ContentPresenter Grid.Row="1"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>

                        <!-- 4 corner hex socket bolts (decorative metalwork:
                             hidden from hit-testing and AT; the HC theme
                             dictionaries render them window-colored) -->
                        <Grid IsHitTestVisible="False"
                              Visibility="{TemplateBinding BoltsVisibility}">
                            <Grid Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                <Ellipse Width="20" Height="20" Fill="{ThemeResource BoltHaloBrush}" />
                                <Ellipse Width="16" Height="16" Fill="{ThemeResource BoltOuterBrush}" />
                                <Path Fill="{ThemeResource BoltSocketBrush}"
                                      Data="M 10,6.2 L 13.3,8.1 L 13.3,11.9 L 10,13.8 L 6.7,11.9 L 6.7,8.1 Z" />
                            </Grid>
                            <Grid Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                <Ellipse Width="20" Height="20" Fill="{ThemeResource BoltHaloBrush}" />
                                <Ellipse Width="16" Height="16" Fill="{ThemeResource BoltOuterBrush}" />
                                <Path Fill="{ThemeResource BoltSocketBrush}"
                                      Data="M 10,6.2 L 13.3,8.1 L 13.3,11.9 L 10,13.8 L 6.7,11.9 L 6.7,8.1 Z" />
                            </Grid>
                            <Grid Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8">
                                <Ellipse Width="20" Height="20" Fill="{ThemeResource BoltHaloBrush}" />
                                <Ellipse Width="16" Height="16" Fill="{ThemeResource BoltOuterBrush}" />
                                <Path Fill="{ThemeResource BoltSocketBrush}"
                                      Data="M 10,6.2 L 13.3,8.1 L 13.3,11.9 L 10,13.8 L 6.7,11.9 L 6.7,8.1 Z" />
                            </Grid>
                            <Grid Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                                <Ellipse Width="20" Height="20" Fill="{ThemeResource BoltHaloBrush}" />
                                <Ellipse Width="16" Height="16" Fill="{ThemeResource BoltOuterBrush}" />
                                <Path Fill="{ThemeResource BoltSocketBrush}"
                                      Data="M 10,6.2 L 13.3,8.1 L 13.3,11.9 L 10,13.8 L 6.7,11.9 L 6.7,8.1 Z" />
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
