<Page
    x:Class="AgentX.App.Views.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AgentX.App.Controls"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:PercentToWidthConverter   x:Key="PercentToWidth" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">

        <Grid Padding="{StaticResource PaddingPage}" RowSpacing="24" MaxWidth="1200" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><!-- 0: Header              -->
                <RowDefinition Height="Auto" /><!-- 1: Loading indicator   -->
                <RowDefinition Height="Auto" /><!-- 2: Summary Cards       -->
                <RowDefinition Height="Auto" /><!-- 3: Indexing progress   -->
                <RowDefinition Height="Auto" /><!-- 4: Workflow Intel      -->
                <RowDefinition Height="Auto" /><!-- 5: Conversation Intel  -->
                <RowDefinition Height="Auto" /><!-- 6: Activity Trends     -->
                <RowDefinition Height="Auto" /><!-- 7: Model Usage         -->
                <RowDefinition Height="Auto" /><!-- 8: Document Types      -->
                <RowDefinition Height="Auto" /><!-- 9: Performance Metrics -->
            </Grid.RowDefinitions>

            <!-- ================================================================
                 ROW 0: PAGE HEADER
                 ================================================================ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="Ana_Title" Text="Analytics"
                               Style="{StaticResource DisplaySmallStyle}" />
                    <TextBlock x:Uid="Ana_Subtitle" Text="Usage statistics, performance metrics, and activity trends"
                               Style="{StaticResource BodySecondaryStyle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        x:Uid="Ana_RefreshBtn" Content="Refresh"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- ================================================================
                 ROW 1: LOADING INDICATOR
                 ================================================================ -->
            <controls:Faceplate Grid.Row="1" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVis}, Mode=OneWay}" Kicker="MOD - ANLY - 01">
                <StackPanel Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Center" Padding="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="20" Height="20"
                                  Foreground="{ThemeResource TextAccentBrush}" />
                    <TextBlock x:Uid="Ana_Loading" Text="Loading analytics data..."
                               Style="{StaticResource BodySecondaryStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </controls:Faceplate>

            <!-- ================================================================
                 ROW 2: SUMMARY STAT CARDS (3 × 2 grid)
                 ================================================================ -->
            <Grid Grid.Row="2"
                  ColumnSpacing="16" RowSpacing="16"
                  Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Card: Total Conversations -->
                <controls:Faceplate Grid.Row="0" Grid.Column="0" Kicker="MOD - ANLY - 02">
                    <Grid>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8BD;" FontSize="13"
                                          Foreground="{ThemeResource TextAccentBrush}" />
                                <TextBlock x:Uid="Ana_ConvOverline" Text="CONVERSATIONS" Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TotalConversations, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock x:Uid="Ana_ConvCaption" Text="Total sessions started"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Grid>
                </controls:Faceplate>

                <!-- Card: Total Messages -->
                <controls:Faceplate Grid.Row="0" Grid.Column="1" Kicker="MOD - ANLY - 03">
                    <Grid>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F2;" FontSize="13"
                                          Foreground="{ThemeResource InfoBrush}" />
                                <TextBlock x:Uid="Ana_MsgOverline" Text="MESSAGES" Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TotalMessages, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock x:Uid="Ana_MsgCaption" Text="Sent and received"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Grid>
                </controls:Faceplate>

                <!-- Card: Total Tokens -->
                <controls:Faceplate Grid.Row="0" Grid.Column="2" Kicker="MOD - ANLY - 04">
                    <Grid>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9D9;" FontSize="13"
                                          Foreground="{ThemeResource WarningBrush}" />
                                <TextBlock x:Uid="Ana_TokensOverline" Text="TOKENS USED" Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TotalTokensUsed, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.AverageTokensPerMessage, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}" />
                                <TextBlock x:Uid="Ana_AvgPerMsgLabel" Text="avg / message"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </controls:Faceplate>

                <!-- Card: Documents -->
                <controls:Faceplate Grid.Row="1" Grid.Column="0" Kicker="MOD - ANLY - 05">
                    <Grid>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F1;" FontSize="13"
                                          Foreground="{ThemeResource SuccessBrush}" />
                                <TextBlock x:Uid="Ana_DocsOverline" Text="DOCUMENTS" Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TotalDocuments, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.DocumentsIndexed, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}"
                                           Foreground="{ThemeResource SuccessBrush}" />
                                <TextBlock x:Uid="Ana_IndexedDotLabel" Text="indexed ·" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.DocumentsPending, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}"
                                           Foreground="{ThemeResource WarningBrush}" />
                                <TextBlock x:Uid="Ana_PendingLabel" Text="pending" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </controls:Faceplate>

                <!-- Card: Searches -->
                <controls:Faceplate Grid.Row="1" Grid.Column="1" Kicker="MOD - ANLY - 06">
                    <Grid>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="13"
                                          Foreground="{ThemeResource AccentHoverBrush}" />
                                <TextBlock x:Uid="Ana_SearchesOverline" Text="SEARCHES" Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TotalSearches, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock x:Uid="Ana_SearchesCaption" Text="Semantic and keyword queries"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Grid>
                </controls:Faceplate>

                <!-- Card: Avg Response Time -->
                <controls:Faceplate Grid.Row="1" Grid.Column="2" Kicker="MOD - ANLY - 07">
                    <Grid>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE916;" FontSize="13"
                                          Foreground="{ThemeResource InfoBrush}" />
                                <TextBlock x:Uid="Ana_AvgRespOverline" Text="AVG RESPONSE" Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.AverageResponseTime, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock x:Uid="Ana_AvgRespCaption" Text="AI generation latency"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Grid>
                </controls:Faceplate>
            </Grid>

            <!-- ================================================================
                 ROW 3: INDEXING PROGRESS + TOKENS / CONV INSIGHT
                 ================================================================ -->
            <controls:Faceplate Grid.Row="3" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" Kicker="MOD - ANLY - 08">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Label + % -->
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Uid="Ana_IndexingOverline" Text="KNOWLEDGE INDEXING"
                                   Style="{StaticResource OverlineStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.IndexingCompletionLabel, Mode=OneWay}"
                                   Style="{StaticResource HeadingSmallStyle}" />
                    </StackPanel>

                    <!-- Progress bar + legend -->
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <ProgressBar Value="{x:Bind ViewModel.IndexingCompletionFraction, Mode=OneWay}"
                                     Minimum="0" Maximum="1"
                                     Style="{StaticResource AccentProgressBarStyle}"
                                     Height="6" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6"
                                         Fill="{ThemeResource SuccessBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CaptionStyle}">
                                    <Run Text="{x:Bind ViewModel.DocumentsIndexed, Mode=OneWay}" />
                                    <Run x:Uid="Ana_IndexedRun" Text=" indexed" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6"
                                         Fill="{ThemeResource WarningBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CaptionStyle}">
                                    <Run Text="{x:Bind ViewModel.DocumentsPending, Mode=OneWay}" />
                                    <Run x:Uid="Ana_PendingRun" Text=" pending" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Tokens / conversation insight -->
                    <StackPanel Grid.Column="2" Spacing="2"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Uid="Ana_TokensPerConvOverline" Text="TOKENS / CONV"
                                   Style="{StaticResource OverlineStyle}"
                                   TextAlignment="Right" />
                        <TextBlock Text="{x:Bind ViewModel.TokensPerConversation, Mode=OneWay}"
                                   Style="{StaticResource HeadingSmallStyle}"
                                   TextAlignment="Right" />
                    </StackPanel>
                </Grid>
            </controls:Faceplate>

            <!-- ================================================================
                 ROW 4: WORKFLOW INTELLIGENCE
                 ================================================================ -->
            <controls:Faceplate Grid.Row="4" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" Kicker="MOD - ANLY - 09">
                <StackPanel Spacing="20">

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8AF;" FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}" />
                            <TextBlock x:Uid="Ana_WorkflowIntelTitle" Text="Workflow Intelligence"
                                       Style="{StaticResource HeadingSmallStyle}" />
                        </StackPanel>
                        <TextBlock x:Uid="Ana_WorkflowIntelSubtitle" Text="Workflow adoption, reliability, and recent results derived from stored workflow-run history"
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.WorkflowIntelligenceStatusMessage, Mode=OneWay}"
                               Style="{StaticResource BodySecondaryStyle}"
                               Visibility="{x:Bind ViewModel.HasWorkflowIntelligence, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                    <StackPanel Spacing="20"
                                Visibility="{x:Bind ViewModel.HasWorkflowIntelligence, Converter={StaticResource BoolToVis}, Mode=OneWay}">

                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{ThemeResource CardBrush}"
                                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Padding="16,12,16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="Ana_TotalRunsOverline" Text="TOTAL RUNS" Style="{StaticResource OverlineStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.WorkflowRunsTotal, Mode=OneWay}"
                                               Style="{StaticResource MetricSmallStyle}" />
                                    <TextBlock x:Uid="Ana_TotalRunsCaption" Text="All recorded workflow executions"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{ThemeResource CardBrush}"
                                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Padding="16,12,16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="Ana_SuccessRateOverline" Text="SUCCESS RATE" Style="{StaticResource OverlineStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.WorkflowSuccessRate, Mode=OneWay}"
                                               Style="{StaticResource MetricSmallStyle}" />
                                    <TextBlock x:Uid="Ana_SuccessRateCaption" Text="Completed outcomes across finished runs"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="{ThemeResource CardBrush}"
                                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Padding="16,12,16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="Ana_AvgRunDurOverline" Text="AVG RUN DURATION" Style="{StaticResource OverlineStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.WorkflowAverageRunDuration, Mode=OneWay}"
                                               Style="{StaticResource MetricSmallStyle}" />
                                    <TextBlock x:Uid="Ana_AvgRunDurCaption" Text="Mean duration across completed workflow runs"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3"
                                    Background="{ThemeResource AccentSubtleBrush}"
                                    BorderBrush="{ThemeResource BorderAccentGradientBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Padding="16,12,16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="Ana_ActiveWfOverline" Text="ACTIVE WORKFLOWS (30D)" Style="{StaticResource OverlineStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.WorkflowActiveRecently, Mode=OneWay}"
                                               Style="{StaticResource MetricSmallStyle}"
                                               Foreground="{ThemeResource TextAccentBrush}" />
                                    <TextBlock x:Uid="Ana_ActiveWfCaption" Text="Distinct workflows used during the recent 30-day window"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource SeparatorStyle}" />

                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource ChartSeriesBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="Ana_WfTrendLabel" Text="30-Day Workflow Run Trend" Style="{StaticResource LabelStyle}" />
                            </StackPanel>

                            <TextBlock x:Uid="Ana_WfTrendEmpty" Text="No workflow runs landed in the last 30 days yet."
                                       Style="{StaticResource CaptionStyle}"
                                       Visibility="{x:Bind ViewModel.HasWorkflowTrendData, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Visibility="{x:Bind ViewModel.HasWorkflowTrendData, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.DailyWorkflowRuns, Mode=OneWay}"
                                               Height="64">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="2" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AnalyticsDailyItem">
                                            <Grid Width="24" Height="64" VerticalAlignment="Bottom"
                                                  ToolTipService.ToolTip="{x:Bind Tooltip}">
                                                <Rectangle Width="20"
                                                           Height="{x:Bind BarHeight}"
                                                           Fill="{ThemeResource ChartSeriesBrush}"
                                                           RadiusX="2" RadiusY="2"
                                                           VerticalAlignment="Bottom"
                                                           HorizontalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>

                        <Border Style="{StaticResource SeparatorStyle}" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="Ana_TopWfTitle" Text="Top Workflows"
                                               Style="{StaticResource HeadingSmallStyle}" />
                                    <TextBlock x:Uid="Ana_TopWfSubtitle" Text="Highest-volume workflows, ranked from actual run history rather than cached counters."
                                               Style="{StaticResource BodySecondaryStyle}" />
                                </StackPanel>

                                <TextBlock x:Uid="Ana_TopWfEmpty" Text="No workflow leaders yet."
                                           Style="{StaticResource BodySecondaryStyle}"
                                           Visibility="{x:Bind ViewModel.HasTopWorkflows, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.TopWorkflows, Mode=OneWay}"
                                               Visibility="{x:Bind ViewModel.HasTopWorkflows, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="12" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AnalyticsWorkflowTopItem">
                                            <Border Background="{ThemeResource CardBrush}"
                                                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMD}"
                                                    Padding="16">
                                                <StackPanel Spacing="10">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{x:Bind WorkflowName}"
                                                                       Style="{StaticResource HeadingSmallStyle}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Category}"
                                                                       Style="{StaticResource CaptionStyle}"
                                                                       Visibility="{x:Bind HasCategory, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{x:Bind LastRunLabel}"
                                                                   Style="{StaticResource CaptionStyle}"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>

                                                    <TextBlock Text="{x:Bind RunVolumeLabel}"
                                                               Style="{StaticResource BodyStyle}" />
                                                    <TextBlock Text="{x:Bind SuccessRateLabel}"
                                                               Style="{StaticResource CaptionStyle}" />
                                                    <TextBlock Text="{x:Bind ReliabilityLabel}"
                                                               Style="{StaticResource CaptionStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="Ana_RecentWfTitle" Text="Recent Workflow Runs"
                                               Style="{StaticResource HeadingSmallStyle}" />
                                    <TextBlock x:Uid="Ana_RecentWfSubtitle" Text="Latest stored outcomes, including short output or error previews for inspection."
                                               Style="{StaticResource BodySecondaryStyle}" />
                                </StackPanel>

                                <TextBlock x:Uid="Ana_RecentWfEmpty" Text="No recent workflow runs yet."
                                           Style="{StaticResource BodySecondaryStyle}"
                                           Visibility="{x:Bind ViewModel.HasRecentWorkflowRuns, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecentWorkflowRuns, Mode=OneWay}"
                                               Visibility="{x:Bind ViewModel.HasRecentWorkflowRuns, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="12" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AnalyticsWorkflowRecentRunItem">
                                            <Border Background="{ThemeResource CardBrush}"
                                                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMD}"
                                                    Padding="16">
                                                <StackPanel Spacing="10">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{x:Bind WorkflowName}"
                                                                       Style="{StaticResource HeadingSmallStyle}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind TimelineLabel}"
                                                                       Style="{StaticResource CaptionStyle}" />
                                                        </StackPanel>

                                                        <Border Grid.Column="1"
                                                                Style="{StaticResource BadgeDefaultStyle}"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{x:Bind StatusLabel}"
                                                                       Style="{StaticResource CaptionStyle}"
                                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                                        </Border>
                                                    </Grid>

                                        <TextBlock Text="{x:Bind PreviewText}"
                                                   Style="{StaticResource BodyStyle}"
                                                   TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </controls:Faceplate>

            <!-- ================================================================
                 ROW 5: CONVERSATION INTELLIGENCE
                 ================================================================ -->
            <controls:Faceplate Grid.Row="5" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" Kicker="MOD - ANLY - 10">
                <StackPanel Spacing="20">

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8BD;" FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}" />
                            <TextBlock x:Uid="Ana_ConvIntelTitle" Text="Conversation Intelligence"
                                       Style="{StaticResource HeadingSmallStyle}" />
                        </StackPanel>
                        <TextBlock x:Uid="Ana_ConvIntelSubtitle" Text="Durable summaries for long-running conversations, with freshness and coverage visible in one place"
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{ThemeResource CardBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="Ana_SummarizedOverline" Text="SUMMARIZED CONVERSATIONS" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SummarizedConversations, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}" />
                                <TextBlock x:Uid="Ana_SummarizedCaption" Text="Distinct conversations with stored snapshots"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="{ThemeResource CardBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="Ana_SnapshotsOverline" Text="CURRENT SNAPSHOTS" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentSummarySnapshots, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}" />
                                <TextBlock x:Uid="Ana_SnapshotsCaption" Text="Immutable summary versions stored on disk"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{ThemeResource CardBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="Ana_StaleOverline" Text="STALE SUMMARIES" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.StaleConversationSummaries, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}" />
                                <TextBlock x:Uid="Ana_StaleCaption" Text="Stored summaries that no longer reflect the latest thread state"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3"
                                Background="{ThemeResource AccentSubtleBrush}"
                                BorderBrush="{ThemeResource BorderAccentGradientBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="Ana_PendingRefreshOverline" Text="PENDING REFRESHES" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.PendingSummaryRefreshes, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}"
                                           Foreground="{ThemeResource TextAccentBrush}" />
                                <TextBlock x:Uid="Ana_PendingRefreshCaption" Text="Conversations waiting for first-pass or incremental refresh"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <Border Background="{ThemeResource AccentSubtleBrush}"
                            BorderBrush="{ThemeResource AccentPrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMD}"
                            Padding="16,14"
                            Visibility="{x:Bind ViewModel.HasFocusedConversationLanding, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Ana_FocusedConvTitle" Text="Focused Conversation Summary"
                                           Style="{StaticResource BodyStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FocusedConversationSourceLabel, Mode=OneWay}"
                                           Style="{StaticResource BodySecondaryStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Uid="Ana_FocusedConvHint" Text="The matching durable summary was moved to the top of the list so you can review it without hunting through Analytics."
                                           Style="{StaticResource CaptionStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Spacing="8"
                                        VerticalAlignment="Top">
                                <Button x:Uid="Ana_RefreshSummaryBtn" Content="Refresh Summary"
                                        Command="{x:Bind ViewModel.RefreshFocusedConversationSummaryCommand}"
                                        Style="{StaticResource GhostButtonStyle}" />
                                <Button x:Uid="Ana_DismissBtn" Content="Dismiss"
                                        Command="{x:Bind ViewModel.DismissFocusedConversationLandingCommand}"
                                        Style="{StaticResource GhostButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{ThemeResource CardBrush}"
                            BorderBrush="{ThemeResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMD}"
                            Padding="14,12"
                            Visibility="{x:Bind ViewModel.HasConversationIntelligenceStatusMessage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{x:Bind ViewModel.ConversationIntelligenceStatusMessage, Mode=OneWay}"
                                   Style="{StaticResource BodySecondaryStyle}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock x:Uid="Ana_NoSummaries" Text="No durable conversation summaries yet. Open Analytics again after a few chats to seed the first snapshots."
                               Style="{StaticResource BodySecondaryStyle}"
                               Visibility="{x:Bind ViewModel.HasRecentConversationSummaries, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecentConversationSummaries, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasRecentConversationSummaries, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnalyticsConversationSummaryItem">
                                <Border Background="{ThemeResource CardBrush}"
                                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Padding="16">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Title}"
                                                           Style="{StaticResource HeadingSmallStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{x:Bind CoverageLabel}"
                                                               Style="{StaticResource CaptionStyle}" />
                                                    <TextBlock Text="{x:Bind GeneratedAtLabel}"
                                                               Style="{StaticResource CaptionStyle}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Style="{StaticResource BadgeDefaultStyle}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{x:Bind StatusLabel}"
                                                           Style="{StaticResource CaptionStyle}"
                                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                            </Border>
                                        </Grid>

                                                <TextBlock Text="{x:Bind PreviewText}"
                                                   Style="{StaticResource BodyStyle}"
                                                   TextWrapping="WrapWholeWords" />

                                        <Border Style="{StaticResource BadgeAccentStyle}"
                                                HorizontalAlignment="Left"
                                                Visibility="{x:Bind HasSourceLabel, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                            <TextBlock x:Uid="Ana_OpenedFromOpsBadge" Text="Opened from Operations"
                                                       Style="{StaticResource BadgeStyle}"
                                                       Foreground="{ThemeResource TextAccentBrush}" />
                                        </Border>

                                        <TextBlock Text="{x:Bind KeyPointsPreview}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="WrapWholeWords"
                                                   Visibility="{x:Bind HasKeyPoints, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="Ana_RecallTitle" Text="Semantic Recall Probe"
                                       Style="{StaticResource HeadingSmallStyle}" />
                            <TextBlock x:Uid="Ana_RecallSubtitle" Text="Durable message embeddings let you probe semantically similar past turns across conversations without relying on transient chat memory."
                                       Style="{StaticResource BodySecondaryStyle}" />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{ThemeResource CardBrush}"
                                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Padding="16,12,16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="Ana_EmbeddedOverline" Text="EMBEDDED MESSAGES" Style="{StaticResource OverlineStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.EmbeddedMessages, Mode=OneWay}"
                                               Style="{StaticResource MetricSmallStyle}" />
                                    <TextBlock x:Uid="Ana_EmbeddedCaption" Text="Messages currently recall-ready"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{ThemeResource CardBrush}"
                                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Padding="16,12,16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="Ana_PendingEmbOverline" Text="PENDING EMBEDDINGS" Style="{StaticResource OverlineStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.PendingMessageEmbeddings, Mode=OneWay}"
                                               Style="{StaticResource MetricSmallStyle}" />
                                    <TextBlock x:Uid="Ana_PendingEmbCaption" Text="Eligible messages still waiting for durable embeddings"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="{ThemeResource AccentSubtleBrush}"
                                    BorderBrush="{ThemeResource BorderAccentGradientBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Padding="16,12,16,12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="Ana_RecallReadyOverline" Text="RECALL-READY CONVERSATIONS" Style="{StaticResource OverlineStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.RecallReadyConversations, Mode=OneWay}"
                                               Style="{StaticResource MetricSmallStyle}"
                                               Foreground="{ThemeResource TextAccentBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.LastMessageEmbeddingRefresh, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     x:Uid="Ana_RecallQueryBox" PlaceholderText="Try: product roadmap drift, pricing discussion, dashboard analytics, summary refresh"
                                     Text="{x:Bind ViewModel.RecallQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.RunConversationRecallCommand}"
                                    x:Uid="Ana_SearchRecallBtn" Content="Search Recall"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="140" />
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.RecallStatusMessage, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}" />

                        <TextBlock x:Uid="Ana_NoRecallMatches" Text="No recall matches yet. Run a probe query after chats have been embedded."
                                   Style="{StaticResource BodySecondaryStyle}"
                                   Visibility="{x:Bind ViewModel.HasConversationRecallResults, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ConversationRecallResults, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.HasConversationRecallResults, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:AnalyticsConversationRecallItem">
                                    <Border Background="{ThemeResource CardBrush}"
                                            BorderBrush="{ThemeResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMD}"
                                            Padding="16">
                                        <StackPanel Spacing="10">
                                            <Border Style="{StaticResource BadgeAccentStyle}"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding HasSourceLabel, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding SourceLabel}"
                                                           Style="{StaticResource BadgeStyle}"
                                                           Foreground="{ThemeResource TextAccentBrush}" />
                                            </Border>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{x:Bind ConversationLabel}"
                                                               Style="{StaticResource HeadingSmallStyle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind TimestampLabel}"
                                                               Style="{StaticResource CaptionStyle}" />
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        Style="{StaticResource BadgeDefaultStyle}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{x:Bind SimilarityLabel}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{x:Bind PreviewText}"
                                                       Style="{StaticResource BodyStyle}"
                                                       TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <Border Style="{StaticResource SeparatorStyle}" />

                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="Ana_ThemesTitle" Text="Conversation Themes"
                                           Style="{StaticResource HeadingSmallStyle}" />
                                <TextBlock x:Uid="Ana_ThemesSubtitle" Text="Materialized cross-conversation clusters built from durable summaries. This is the first persistent theme layer above stored summaries and recall."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>

                            <Grid ColumnSpacing="16" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{ThemeResource CardBrush}"
                                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Padding="16,12,16,12">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="Ana_ActiveClustersOverline" Text="ACTIVE THEME CLUSTERS" Style="{StaticResource OverlineStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.ActiveThemeClusters, Mode=OneWay}"
                                                   Style="{StaticResource MetricSmallStyle}" />
                                        <TextBlock x:Uid="Ana_ActiveClustersCaption" Text="Persisted conversation themes currently materialized"
                                                   Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="{ThemeResource CardBrush}"
                                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Padding="16,12,16,12">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="Ana_ClusteredConvOverline" Text="CLUSTERED CONVERSATIONS" Style="{StaticResource OverlineStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.ClusteredThemeConversations, Mode=OneWay}"
                                                   Style="{StaticResource MetricSmallStyle}" />
                                        <TextBlock x:Uid="Ana_ClusteredConvCaption" Text="Conversations with a current durable theme assignment"
                                                   Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="{ThemeResource CardBrush}"
                                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Padding="16,12,16,12">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="Ana_NewThemesOverline" Text="NEW THEMES (7D)" Style="{StaticResource OverlineStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.NewThemeClusters7d, Mode=OneWay}"
                                                   Style="{StaticResource MetricSmallStyle}" />
                                        <TextBlock x:Uid="Ana_NewThemesCaption" Text="Theme clusters first seen during the last 7 days"
                                                   Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3"
                                        Background="{ThemeResource AccentSubtleBrush}"
                                        BorderBrush="{ThemeResource BorderAccentGradientBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Padding="16,12,16,12">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="Ana_LastMaterializedOverline" Text="LAST MATERIALIZED" Style="{StaticResource OverlineStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.LastThemeMaterialized, Mode=OneWay}"
                                                   Style="{StaticResource MetricSmallStyle}"
                                                   Foreground="{ThemeResource TextAccentBrush}" />
                                        <TextBlock x:Uid="Ana_LastMaterializedCaption" Text="Latest durable cluster recomputation"
                                                   Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock x:Uid="Ana_NoThemes" Text="No conversation themes yet. Once durable summaries accumulate, Analytics will surface the first cross-conversation clusters here."
                                       Style="{StaticResource BodySecondaryStyle}"
                                       Visibility="{x:Bind ViewModel.HasConversationThemeClusters, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.ConversationThemeClusters, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.HasConversationThemeClusters, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AnalyticsConversationThemeItem">
                                        <Border Background="{ThemeResource CardBrush}"
                                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusMD}"
                                                Padding="16">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind Label}"
                                                                   Style="{StaticResource HeadingSmallStyle}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind ActivityLabel}"
                                                                   Style="{StaticResource CaptionStyle}"
                                                                   TextWrapping="WrapWholeWords" />
                                                    </StackPanel>

                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource BadgeDefaultStyle}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{x:Bind LastActiveAtLabel}"
                                                                   Style="{StaticResource CaptionStyle}"
                                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{x:Bind PreviewText}"
                                                           Style="{StaticResource BodyStyle}"
                                                           TextWrapping="WrapWholeWords" />

                                                <TextBlock Text="{x:Bind KeyPointsPreview}"
                                                           Style="{StaticResource CaptionStyle}"
                                                           TextWrapping="WrapWholeWords"
                                                           Visibility="{x:Bind HasKeyPoints, Converter={StaticResource BoolToVis}, Mode=OneWay}" />

                                                <TextBlock Text="{x:Bind RecentConversationsPreview}"
                                                           Style="{StaticResource CaptionStyle}"
                                                           TextWrapping="WrapWholeWords"
                                                           Visibility="{x:Bind HasRecentConversations, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Border Style="{StaticResource SeparatorStyle}" />

                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="Ana_ThemeTrendsTitle" Text="Theme Trends"
                                               Style="{StaticResource HeadingSmallStyle}" />
                                    <TextBlock x:Uid="Ana_ThemeTrendsSubtitle" Text="Daily persisted activity windows for the materialized theme layer. Analytics reads only stored rows here, so trend cards stay stable and cheap to load."
                                               Style="{StaticResource BodySecondaryStyle}" />
                                </StackPanel>

                                <Grid ColumnSpacing="16" RowSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{ThemeResource CardBrush}"
                                            BorderBrush="{ThemeResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMD}"
                                            Padding="16,12,16,12">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Uid="Ana_TrendingOverline" Text="TRENDING THEMES" Style="{StaticResource OverlineStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.TrendingThemes, Mode=OneWay}"
                                                       Style="{StaticResource MetricSmallStyle}" />
                                            <TextBlock x:Uid="Ana_TrendingCaption" Text="Themes with stronger 7-day activity than the prior 7-day window"
                                                       Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Background="{ThemeResource CardBrush}"
                                            BorderBrush="{ThemeResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMD}"
                                            Padding="16,12,16,12">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Uid="Ana_NewEntriesOverline" Text="NEW THEME ENTRIES (7D)" Style="{StaticResource OverlineStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.NewThemeEntries7d, Mode=OneWay}"
                                                       Style="{StaticResource MetricSmallStyle}" />
                                            <TextBlock x:Uid="Ana_NewEntriesCaption" Text="Current cluster assignments first materialized during the last 7 days"
                                                       Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Background="{ThemeResource CardBrush}"
                                            BorderBrush="{ThemeResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMD}"
                                            Padding="16,12,16,12">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Uid="Ana_MostActiveOverline" Text="MOST ACTIVE THEME" Style="{StaticResource OverlineStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.MostActiveTheme, Mode=OneWay}"
                                                       Style="{StaticResource HeadingSmallStyle}"
                                                       TextWrapping="WrapWholeWords"
                                                       MaxLines="2" />
                                            <TextBlock x:Uid="Ana_MostActiveCaption" Text="Highest persisted 7-day activity total across the theme layer"
                                                       Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3"
                                            Background="{ThemeResource AccentSubtleBrush}"
                                            BorderBrush="{ThemeResource BorderAccentGradientBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusMD}"
                                            Padding="16,12,16,12">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Uid="Ana_LastTrendOverline" Text="LAST TREND REFRESH" Style="{StaticResource OverlineStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.LastThemeTrendRefresh, Mode=OneWay}"
                                                       Style="{StaticResource MetricSmallStyle}"
                                                       Foreground="{ThemeResource TextAccentBrush}" />
                                            <TextBlock x:Uid="Ana_LastTrendCaption" Text="Latest persisted theme-trend materialization"
                                                       Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock x:Uid="Ana_NoTrendRows" Text="No durable theme trend rows yet. Once clusters are refreshed, Analytics will surface their daily activity windows here."
                                           Style="{StaticResource BodySecondaryStyle}"
                                           Visibility="{x:Bind ViewModel.HasConversationThemeTrends, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ConversationThemeTrends, Mode=OneWay}"
                                               Visibility="{x:Bind ViewModel.HasConversationThemeTrends, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="12" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AnalyticsConversationThemeTrendItem">
                                            <Border Background="{ThemeResource CardBrush}"
                                                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMD}"
                                                    Padding="16">
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{x:Bind Label}"
                                                                       Style="{StaticResource HeadingSmallStyle}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind ActivitySummary}"
                                                                       Style="{StaticResource CaptionStyle}"
                                                                       TextWrapping="WrapWholeWords" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1"
                                                                    Spacing="4"
                                                                    HorizontalAlignment="Right">
                                                            <Border Style="{StaticResource BadgeDefaultStyle}"
                                                                    HorizontalAlignment="Right">
                                                                <TextBlock Text="{x:Bind MomentumLabel}"
                                                                           Style="{StaticResource CaptionStyle}"
                                                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{x:Bind LastActiveAtLabel}"
                                                                       Style="{StaticResource CaptionStyle}"
                                                                       HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Text="{x:Bind PreviewText}"
                                                               Style="{StaticResource BodyStyle}"
                                                               TextWrapping="WrapWholeWords" />

                                                    <TextBlock Text="{x:Bind NewEntriesLabel}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               Visibility="{x:Bind HasNewEntries, Converter={StaticResource BoolToVis}, Mode=OneWay}" />

                                                    <ItemsRepeater ItemsSource="{x:Bind Bars, Mode=OneWay}">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout Orientation="Horizontal" Spacing="3" />
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:AnalyticsConversationThemeTrendBarItem">
                                                                <Border Width="7"
                                                                        Height="48"
                                                                        Background="{ThemeResource AccentSubtleBrush}"
                                                                        CornerRadius="3"
                                                                        VerticalAlignment="Bottom"
                                                                        ToolTipService.ToolTip="{x:Bind Tooltip}">
                                                                    <Grid VerticalAlignment="Stretch">
                                                                        <Border Height="{x:Bind BarHeight}"
                                                                                Background="{ThemeResource TextAccentBrush}"
                                                                                CornerRadius="3"
                                                                                VerticalAlignment="Bottom" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </controls:Faceplate>

            <!-- ================================================================
                 ROW 6: ACTIVITY TRENDS (3 bar-chart panels)
                 ================================================================ -->
            <controls:Faceplate Grid.Row="6" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" Kicker="MOD - ANLY - 11">
                <StackPanel Spacing="20">

                    <!-- Section header -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}" />
                            <TextBlock x:Uid="Ana_ActivityTitle" Text="Activity Trends"
                                       Style="{StaticResource HeadingSmallStyle}" />
                        </StackPanel>
                        <TextBlock x:Uid="Ana_ActivitySubtitle" Text="Daily activity over the last 30 days"
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <!-- === Conversations === -->
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="#AA2024" VerticalAlignment="Center" />
                            <TextBlock x:Uid="Ana_ConvSeriesLabel" Text="Conversations" Style="{StaticResource LabelStyle}" />
                        </StackPanel>

                        <TextBlock x:Uid="Ana_NoConvData" Text="No conversation data yet. Start chatting to see trends."
                                   Style="{StaticResource CaptionStyle}"
                                   Visibility="{x:Bind ViewModel.HasDailyConversationData, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Visibility="{x:Bind ViewModel.HasDailyConversationData, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DailyConversations, Mode=OneWay}"
                                           Height="64">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="2" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AnalyticsDailyItem">
                                        <Grid Width="24" Height="64" VerticalAlignment="Bottom"
                                              ToolTipService.ToolTip="{x:Bind Tooltip}">
                                            <Rectangle Width="20"
                                                       Height="{x:Bind BarHeight}"
                                                       Fill="#AA2024"
                                                       RadiusX="2" RadiusY="2"
                                                       VerticalAlignment="Bottom"
                                                       HorizontalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- === Documents === -->
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="#58C4BC" VerticalAlignment="Center" />
                            <TextBlock x:Uid="Ana_DocsSeriesLabel" Text="Documents Imported" Style="{StaticResource LabelStyle}" />
                        </StackPanel>

                        <TextBlock x:Uid="Ana_NoDocData" Text="No document import data yet. Import files to see trends."
                                   Style="{StaticResource CaptionStyle}"
                                   Visibility="{x:Bind ViewModel.HasDailyDocumentData, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Visibility="{x:Bind ViewModel.HasDailyDocumentData, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DailyDocuments, Mode=OneWay}"
                                           Height="64">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="2" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AnalyticsDailyItem">
                                        <Grid Width="24" Height="64" VerticalAlignment="Bottom"
                                              ToolTipService.ToolTip="{x:Bind Tooltip}">
                                            <Rectangle Width="20"
                                                       Height="{x:Bind BarHeight}"
                                                       Fill="#58C4BC"
                                                       RadiusX="2" RadiusY="2"
                                                       VerticalAlignment="Bottom"
                                                       HorizontalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- === Searches === -->
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="#41E25E" VerticalAlignment="Center" />
                            <TextBlock x:Uid="Ana_SearchSeriesLabel" Text="Searches" Style="{StaticResource LabelStyle}" />
                        </StackPanel>

                        <TextBlock x:Uid="Ana_NoSearchData" Text="No search data yet. Use semantic or keyword search to see trends."
                                   Style="{StaticResource CaptionStyle}"
                                   Visibility="{x:Bind ViewModel.HasDailySearchData, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Visibility="{x:Bind ViewModel.HasDailySearchData, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DailySearches, Mode=OneWay}"
                                           Height="64">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="2" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AnalyticsDailyItem">
                                        <Grid Width="24" Height="64" VerticalAlignment="Bottom"
                                              ToolTipService.ToolTip="{x:Bind Tooltip}">
                                            <Rectangle Width="20"
                                                       Height="{x:Bind BarHeight}"
                                                       Fill="#41E25E"
                                                       RadiusX="2" RadiusY="2"
                                                       VerticalAlignment="Bottom"
                                                       HorizontalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                </StackPanel>
            </controls:Faceplate>

            <!-- ================================================================
                 ROW 7: MODEL USAGE (horizontal bars)
                 ================================================================ -->
            <controls:Faceplate Grid.Row="7" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" Kicker="MOD - ANLY - 12">
                <StackPanel Spacing="20">

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE950;" FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}" />
                            <TextBlock x:Uid="Ana_ModelUsageTitle" Text="Model Usage" Style="{StaticResource HeadingSmallStyle}" />
                        </StackPanel>
                        <TextBlock x:Uid="Ana_ModelUsageSubtitle" Text="AI model distribution by conversation count"
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <TextBlock x:Uid="Ana_NoModelData" Text="No model data yet. Start a conversation to see model usage."
                               Style="{StaticResource BodySecondaryStyle}"
                               Visibility="{x:Bind ViewModel.HasModelData, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ModelUsage, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasModelData, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnalyticsModelItem">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Model name -->
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind DisplayName}"
                                               Style="{StaticResource BodyStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <!-- Bar track -->
                                    <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                                        <Rectangle Fill="{ThemeResource CardPressedBrush}"
                                                   RadiusX="4" RadiusY="4" />
                                        <!-- BarWidthFraction is 0.0–1.0; converter multiplies by
                                             ConverterParameter (400 px) to produce a pixel width. -->
                                        <Rectangle HorizontalAlignment="Left"
                                                   RadiusX="4" RadiusY="4"
                                                   Height="8"
                                                   Fill="#AA2024"
                                                   Width="{x:Bind BarWidthFraction,
                                                           Converter={StaticResource PercentToWidth},
                                                           ConverterParameter=400}" />
                                    </Grid>

                                    <!-- Percentage -->
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind PercentageLabel}"
                                               Style="{StaticResource LabelStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />

                                    <!-- Conversation count -->
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind CountLabel}"
                                               Style="{StaticResource CaptionStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                </StackPanel>
            </controls:Faceplate>

            <!-- ================================================================
                 ROW 8: DOCUMENT TYPES (horizontal bars)
                 ================================================================ -->
            <controls:Faceplate Grid.Row="8" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" Kicker="MOD - ANLY - 13">
                <StackPanel Spacing="20">

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F1;" FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}" />
                            <TextBlock x:Uid="Ana_DocTypesTitle" Text="Document Types" Style="{StaticResource HeadingSmallStyle}" />
                        </StackPanel>
                        <TextBlock x:Uid="Ana_DocTypesSubtitle" Text="File type breakdown across your knowledge vault"
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <TextBlock x:Uid="Ana_NoDocsImported" Text="No documents imported yet. Add files to your Knowledge Vault to see type distribution."
                               Style="{StaticResource BodySecondaryStyle}"
                               Visibility="{x:Bind ViewModel.HasFileTypeData, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.FileTypeDistribution, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasFileTypeData, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnalyticsFileTypeItem">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Type badge -->
                                    <Border Grid.Column="0"
                                            Style="{StaticResource BadgeDefaultStyle}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FileType}"
                                                   Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </Border>

                                    <!-- Bar track -->
                                    <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                                        <Rectangle Fill="{ThemeResource CardPressedBrush}"
                                                   RadiusX="4" RadiusY="4" />
                                        <Rectangle HorizontalAlignment="Left"
                                                   RadiusX="4" RadiusY="4"
                                                   Height="8"
                                                   Fill="#58C4BC"
                                                   Width="{x:Bind BarWidthFraction,
                                                           Converter={StaticResource PercentToWidth},
                                                           ConverterParameter=400}" />
                                    </Grid>

                                    <!-- Percentage -->
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind PercentageLabel}"
                                               Style="{StaticResource LabelStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />

                                    <!-- File count -->
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind CountLabel}"
                                               Style="{StaticResource CaptionStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />

                                    <!-- Total size -->
                                    <TextBlock Grid.Column="4"
                                               Text="{x:Bind TotalSize}"
                                               Style="{StaticResource CaptionStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                </StackPanel>
            </controls:Faceplate>

            <!-- ================================================================
                 ROW 9: PERFORMANCE METRICS
                 ================================================================ -->
            <controls:Faceplate Grid.Row="9" Margin="0,0,0,24" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" Kicker="MOD - ANLY - 14">
                <StackPanel Spacing="20">

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE916;" FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}" />
                            <TextBlock x:Uid="Ana_PerfTitle" Text="Performance Metrics" Style="{StaticResource HeadingSmallStyle}" />
                        </StackPanel>
                        <TextBlock x:Uid="Ana_PerfSubtitle" Text="AI inference timing statistics across all assistant responses"
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <!-- No-data fallback -->
                    <TextBlock x:Uid="Ana_NoTimingData" Text="No timing data yet. Response times are tracked automatically after the first AI reply."
                               Style="{StaticResource BodySecondaryStyle}"
                               Visibility="{x:Bind ViewModel.HasPerformanceData, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                    <!-- Row 1: Average · Median · P95 · Throughput -->
                    <Grid ColumnSpacing="16" RowSpacing="16"
                          Visibility="{x:Bind ViewModel.HasPerformanceData, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Average -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Background="{ThemeResource CardBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="Ana_AvgOverline" Text="AVERAGE" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.PerfAverage, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}" />
                                <TextBlock x:Uid="Ana_AvgCaption" Text="Mean response time" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Median P50 -->
                        <Border Grid.Row="0" Grid.Column="1"
                                Background="{ThemeResource CardBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="Ana_MedianOverline" Text="MEDIAN (P50)" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.PerfMedian, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}" />
                                <TextBlock x:Uid="Ana_MedianCaption" Text="Half of responses are faster" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- P95 -->
                        <Border Grid.Row="0" Grid.Column="2"
                                Background="{ThemeResource CardBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="Ana_P95Overline" Text="P95" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.PerfP95, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}" />
                                <TextBlock x:Uid="Ana_P95Caption" Text="95th-percentile latency" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Throughput (accent highlight) -->
                        <Border Grid.Row="0" Grid.Column="3"
                                Background="{ThemeResource AccentSubtleBrush}"
                                BorderBrush="{ThemeResource BorderAccentGradientBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="Ana_ThroughputOverline" Text="THROUGHPUT" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.PerfTokensPerSecond, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}"
                                           Foreground="{ThemeResource TextAccentBrush}" />
                                <TextBlock x:Uid="Ana_ThroughputCaption" Text="Avg tokens per second" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Fastest -->
                        <Border Grid.Row="1" Grid.Column="0"
                                Background="{ThemeResource CardBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72A;" FontSize="11"
                                              Foreground="{ThemeResource SuccessBrush}" />
                                    <TextBlock x:Uid="Ana_FastestOverline" Text="FASTEST" Style="{StaticResource OverlineStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.PerfFastest, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}"
                                           Foreground="{ThemeResource SuccessBrush}" />
                                <TextBlock x:Uid="Ana_FastestCaption" Text="Best observed response" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Slowest -->
                        <Border Grid.Row="1" Grid.Column="1"
                                Background="{ThemeResource CardBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72B;" FontSize="11"
                                              Foreground="{ThemeResource WarningBrush}" />
                                    <TextBlock x:Uid="Ana_SlowestOverline" Text="SLOWEST" Style="{StaticResource OverlineStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.PerfSlowest, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}"
                                           Foreground="{ThemeResource WarningBrush}" />
                                <TextBlock x:Uid="Ana_SlowestCaption" Text="Worst observed response" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Total Inference Time — spans 2 columns -->
                        <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                Background="{ThemeResource CardBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="Ana_TotalInfOverline" Text="TOTAL INFERENCE TIME" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.PerfTotalInference, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}" />
                                <TextBlock x:Uid="Ana_TotalInfCaption" Text="Cumulative AI generation time across all sessions"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>
            </controls:Faceplate>

        </Grid>
    </ScrollViewer>

</Page>
