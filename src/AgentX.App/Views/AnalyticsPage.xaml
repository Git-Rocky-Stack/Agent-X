<Page
    x:Class="AgentX.App.Views.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:PercentToWidthConverter   x:Key="PercentToWidth" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">

        <Grid Padding="{StaticResource PaddingPage}" RowSpacing="24" MaxWidth="1200" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><!-- 0: Header              -->
                <RowDefinition Height="Auto" /><!-- 1: Loading indicator   -->
                <RowDefinition Height="Auto" /><!-- 2: Summary Cards       -->
                <RowDefinition Height="Auto" /><!-- 3: Indexing progress   -->
                <RowDefinition Height="Auto" /><!-- 4: Conversation Intel  -->
                <RowDefinition Height="Auto" /><!-- 5: Activity Trends     -->
                <RowDefinition Height="Auto" /><!-- 6: Model Usage         -->
                <RowDefinition Height="Auto" /><!-- 7: Document Types      -->
                <RowDefinition Height="Auto" /><!-- 8: Performance Metrics -->
            </Grid.RowDefinitions>

            <!-- ================================================================
                 ROW 0: PAGE HEADER
                 ================================================================ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Analytics"
                               Style="{StaticResource DisplaySmallStyle}" />
                    <TextBlock Text="Usage statistics, performance metrics, and activity trends"
                               Style="{StaticResource BodySecondaryStyle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- ================================================================
                 ROW 1: LOADING INDICATOR
                 ================================================================ -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Center" Padding="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="20" Height="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                    <TextBlock Text="Loading analytics data..."
                               Style="{StaticResource BodySecondaryStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ================================================================
                 ROW 2: SUMMARY STAT CARDS (3 × 2 grid)
                 ================================================================ -->
            <Grid Grid.Row="2"
                  ColumnSpacing="16" RowSpacing="16"
                  Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Card: Total Conversations -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <FontIcon Glyph="&#xE8BD;" FontSize="56"
                                  Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.04"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,-4,-4,0" />
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8BD;" FontSize="13"
                                          Foreground="{StaticResource TextAccentBrush}" />
                                <TextBlock Text="CONVERSATIONS" Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TotalConversations, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock Text="Total sessions started"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card: Total Messages -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <FontIcon Glyph="&#xE8F2;" FontSize="56"
                                  Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.04"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,-4,-4,0" />
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F2;" FontSize="13"
                                          Foreground="{StaticResource InfoBrush}" />
                                <TextBlock Text="MESSAGES" Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TotalMessages, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock Text="Sent and received"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card: Total Tokens -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <FontIcon Glyph="&#xE9D9;" FontSize="56"
                                  Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.04"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,-4,-4,0" />
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9D9;" FontSize="13"
                                          Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="TOKENS USED" Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TotalTokensUsed, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.AverageTokensPerMessage, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="avg / message"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card: Documents -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <FontIcon Glyph="&#xE8F1;" FontSize="56"
                                  Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.04"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,-4,-4,0" />
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F1;" FontSize="13"
                                          Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="DOCUMENTS" Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TotalDocuments, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.DocumentsIndexed, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}"
                                           Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="indexed ·" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.DocumentsPending, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}"
                                           Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="pending" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card: Searches -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <FontIcon Glyph="&#xE721;" FontSize="56"
                                  Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.04"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,-4,-4,0" />
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="13"
                                          Foreground="{StaticResource AccentHoverBrush}" />
                                <TextBlock Text="SEARCHES" Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TotalSearches, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock Text="Semantic and keyword queries"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card: Avg Response Time -->
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <FontIcon Glyph="&#xE916;" FontSize="56"
                                  Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.04"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,-4,-4,0" />
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE916;" FontSize="13"
                                          Foreground="{StaticResource InfoBrush}" />
                                <TextBlock Text="AVG RESPONSE" Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.AverageResponseTime, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock Text="AI generation latency"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================================================================
                 ROW 3: INDEXING PROGRESS + TOKENS / CONV INSIGHT
                 ================================================================ -->
            <Border Grid.Row="3"
                    Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Label + % -->
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="KNOWLEDGE INDEXING"
                                   Style="{StaticResource OverlineStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.IndexingCompletionLabel, Mode=OneWay}"
                                   Style="{StaticResource HeadingSmallStyle}" />
                    </StackPanel>

                    <!-- Progress bar + legend -->
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <ProgressBar Value="{x:Bind ViewModel.IndexingCompletionFraction, Mode=OneWay}"
                                     Minimum="0" Maximum="1"
                                     Style="{StaticResource AccentProgressBarStyle}"
                                     Height="6" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource SuccessBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CaptionStyle}">
                                    <Run Text="{x:Bind ViewModel.DocumentsIndexed, Mode=OneWay}" />
                                    <Run Text=" indexed" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="6" Height="6"
                                         Fill="{StaticResource WarningBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CaptionStyle}">
                                    <Run Text="{x:Bind ViewModel.DocumentsPending, Mode=OneWay}" />
                                    <Run Text=" pending" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Tokens / conversation insight -->
                    <StackPanel Grid.Column="2" Spacing="2"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="TOKENS / CONV"
                                   Style="{StaticResource OverlineStyle}"
                                   TextAlignment="Right" />
                        <TextBlock Text="{x:Bind ViewModel.TokensPerConversation, Mode=OneWay}"
                                   Style="{StaticResource HeadingSmallStyle}"
                                   TextAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================================
                 ROW 4: CONVERSATION INTELLIGENCE
                 ================================================================ -->
            <Border Grid.Row="4"
                    Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}">
                <StackPanel Spacing="20">

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8BD;" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" />
                            <TextBlock Text="Conversation Intelligence"
                                       Style="{StaticResource HeadingSmallStyle}" />
                        </StackPanel>
                        <TextBlock Text="Durable summaries for long-running conversations, with freshness and coverage visible in one place"
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="SUMMARIZED CONVERSATIONS" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SummarizedConversations, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}" />
                                <TextBlock Text="Distinct conversations with stored snapshots"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="CURRENT SNAPSHOTS" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentSummarySnapshots, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}" />
                                <TextBlock Text="Immutable summary versions stored on disk"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="STALE SUMMARIES" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.StaleConversationSummaries, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}" />
                                <TextBlock Text="Stored summaries that no longer reflect the latest thread state"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3"
                                Background="{StaticResource AccentSubtleBrush}"
                                BorderBrush="{StaticResource BorderAccentGradientBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="PENDING REFRESHES" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.PendingSummaryRefreshes, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}"
                                           Foreground="{StaticResource TextAccentBrush}" />
                                <TextBlock Text="Conversations waiting for first-pass or incremental refresh"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <TextBlock Text="No durable conversation summaries yet. Open Analytics again after a few chats to seed the first snapshots."
                               Style="{StaticResource BodySecondaryStyle}"
                               Visibility="{x:Bind ViewModel.HasRecentConversationSummaries, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecentConversationSummaries, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasRecentConversationSummaries, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnalyticsConversationSummaryItem">
                                <Border Background="{StaticResource InputBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Padding="16">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Title}"
                                                           Style="{StaticResource HeadingSmallStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{x:Bind CoverageLabel}"
                                                               Style="{StaticResource CaptionStyle}" />
                                                    <TextBlock Text="{x:Bind GeneratedAtLabel}"
                                                               Style="{StaticResource CaptionStyle}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Style="{StaticResource BadgeDefaultStyle}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{x:Bind StatusLabel}"
                                                           Style="{StaticResource CaptionStyle}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{x:Bind PreviewText}"
                                                   Style="{StaticResource BodyStyle}"
                                                   TextWrapping="WrapWholeWords" />

                                        <TextBlock Text="{x:Bind KeyPointsPreview}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="WrapWholeWords"
                                                   Visibility="{x:Bind HasKeyPoints, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- ================================================================
                 ROW 5: ACTIVITY TRENDS (3 bar-chart panels)
                 ================================================================ -->
            <Border Grid.Row="5"
                    Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}">
                <StackPanel Spacing="20">

                    <!-- Section header -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" />
                            <TextBlock Text="Activity Trends"
                                       Style="{StaticResource HeadingSmallStyle}" />
                        </StackPanel>
                        <TextBlock Text="Daily activity over the last 30 days"
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <!-- === Conversations === -->
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="#C41E3A" VerticalAlignment="Center" />
                            <TextBlock Text="Conversations" Style="{StaticResource LabelStyle}" />
                        </StackPanel>

                        <TextBlock Text="No conversation data yet. Start chatting to see trends."
                                   Style="{StaticResource CaptionStyle}"
                                   Visibility="{x:Bind ViewModel.HasDailyConversationData, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Visibility="{x:Bind ViewModel.HasDailyConversationData, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DailyConversations, Mode=OneWay}"
                                           Height="64">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="2" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AnalyticsDailyItem">
                                        <Grid Width="24" Height="64" VerticalAlignment="Bottom"
                                              ToolTipService.ToolTip="{x:Bind Tooltip}">
                                            <Rectangle Width="20"
                                                       Height="{x:Bind BarHeight}"
                                                       Fill="#C41E3A"
                                                       RadiusX="2" RadiusY="2"
                                                       VerticalAlignment="Bottom"
                                                       HorizontalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- === Documents === -->
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="#3B82F6" VerticalAlignment="Center" />
                            <TextBlock Text="Documents Imported" Style="{StaticResource LabelStyle}" />
                        </StackPanel>

                        <TextBlock Text="No document import data yet. Import files to see trends."
                                   Style="{StaticResource CaptionStyle}"
                                   Visibility="{x:Bind ViewModel.HasDailyDocumentData, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Visibility="{x:Bind ViewModel.HasDailyDocumentData, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DailyDocuments, Mode=OneWay}"
                                           Height="64">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="2" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AnalyticsDailyItem">
                                        <Grid Width="24" Height="64" VerticalAlignment="Bottom"
                                              ToolTipService.ToolTip="{x:Bind Tooltip}">
                                            <Rectangle Width="20"
                                                       Height="{x:Bind BarHeight}"
                                                       Fill="#3B82F6"
                                                       RadiusX="2" RadiusY="2"
                                                       VerticalAlignment="Bottom"
                                                       HorizontalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- === Searches === -->
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center" />
                            <TextBlock Text="Searches" Style="{StaticResource LabelStyle}" />
                        </StackPanel>

                        <TextBlock Text="No search data yet. Use semantic or keyword search to see trends."
                                   Style="{StaticResource CaptionStyle}"
                                   Visibility="{x:Bind ViewModel.HasDailySearchData, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Visibility="{x:Bind ViewModel.HasDailySearchData, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DailySearches, Mode=OneWay}"
                                           Height="64">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="2" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AnalyticsDailyItem">
                                        <Grid Width="24" Height="64" VerticalAlignment="Bottom"
                                              ToolTipService.ToolTip="{x:Bind Tooltip}">
                                            <Rectangle Width="20"
                                                       Height="{x:Bind BarHeight}"
                                                       Fill="#22C55E"
                                                       RadiusX="2" RadiusY="2"
                                                       VerticalAlignment="Bottom"
                                                       HorizontalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ================================================================
                 ROW 6: MODEL USAGE (horizontal bars)
                 ================================================================ -->
            <Border Grid.Row="6"
                    Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}">
                <StackPanel Spacing="20">

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE950;" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" />
                            <TextBlock Text="Model Usage" Style="{StaticResource HeadingSmallStyle}" />
                        </StackPanel>
                        <TextBlock Text="AI model distribution by conversation count"
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <TextBlock Text="No model data yet. Start a conversation to see model usage."
                               Style="{StaticResource BodySecondaryStyle}"
                               Visibility="{x:Bind ViewModel.HasModelData, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ModelUsage, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasModelData, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnalyticsModelItem">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Model name -->
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind DisplayName}"
                                               Style="{StaticResource BodyStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <!-- Bar track -->
                                    <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                                        <Rectangle Fill="{StaticResource InputBackgroundBrush}"
                                                   RadiusX="4" RadiusY="4" />
                                        <!-- BarWidthFraction is 0.0–1.0; converter multiplies by
                                             ConverterParameter (400 px) to produce a pixel width. -->
                                        <Rectangle HorizontalAlignment="Left"
                                                   RadiusX="4" RadiusY="4"
                                                   Height="8"
                                                   Fill="#C41E3A"
                                                   Width="{x:Bind BarWidthFraction,
                                                           Converter={StaticResource PercentToWidth},
                                                           ConverterParameter=400}" />
                                    </Grid>

                                    <!-- Percentage -->
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind PercentageLabel}"
                                               Style="{StaticResource LabelStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />

                                    <!-- Conversation count -->
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind CountLabel}"
                                               Style="{StaticResource CaptionStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                </StackPanel>
            </Border>

            <!-- ================================================================
                 ROW 7: DOCUMENT TYPES (horizontal bars)
                 ================================================================ -->
            <Border Grid.Row="7"
                    Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}">
                <StackPanel Spacing="20">

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F1;" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" />
                            <TextBlock Text="Document Types" Style="{StaticResource HeadingSmallStyle}" />
                        </StackPanel>
                        <TextBlock Text="File type breakdown across your knowledge vault"
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <TextBlock Text="No documents imported yet. Add files to your Knowledge Vault to see type distribution."
                               Style="{StaticResource BodySecondaryStyle}"
                               Visibility="{x:Bind ViewModel.HasFileTypeData, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.FileTypeDistribution, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasFileTypeData, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnalyticsFileTypeItem">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Type badge -->
                                    <Border Grid.Column="0"
                                            Style="{StaticResource BadgeDefaultStyle}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FileType}"
                                                   Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>

                                    <!-- Bar track -->
                                    <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                                        <Rectangle Fill="{StaticResource InputBackgroundBrush}"
                                                   RadiusX="4" RadiusY="4" />
                                        <Rectangle HorizontalAlignment="Left"
                                                   RadiusX="4" RadiusY="4"
                                                   Height="8"
                                                   Fill="#3B82F6"
                                                   Width="{x:Bind BarWidthFraction,
                                                           Converter={StaticResource PercentToWidth},
                                                           ConverterParameter=400}" />
                                    </Grid>

                                    <!-- Percentage -->
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind PercentageLabel}"
                                               Style="{StaticResource LabelStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />

                                    <!-- File count -->
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind CountLabel}"
                                               Style="{StaticResource CaptionStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />

                                    <!-- Total size -->
                                    <TextBlock Grid.Column="4"
                                               Text="{x:Bind TotalSize}"
                                               Style="{StaticResource CaptionStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                </StackPanel>
            </Border>

            <!-- ================================================================
                 ROW 8: PERFORMANCE METRICS
                 ================================================================ -->
            <Border Grid.Row="8"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,24"
                    Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}">
                <StackPanel Spacing="20">

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE916;" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" />
                            <TextBlock Text="Performance Metrics" Style="{StaticResource HeadingSmallStyle}" />
                        </StackPanel>
                        <TextBlock Text="AI inference timing statistics across all assistant responses"
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <!-- No-data fallback -->
                    <TextBlock Text="No timing data yet. Response times are tracked automatically after the first AI reply."
                               Style="{StaticResource BodySecondaryStyle}"
                               Visibility="{x:Bind ViewModel.HasPerformanceData, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />

                    <!-- Row 1: Average · Median · P95 · Throughput -->
                    <Grid ColumnSpacing="16" RowSpacing="16"
                          Visibility="{x:Bind ViewModel.HasPerformanceData, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Average -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="AVERAGE" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.PerfAverage, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}" />
                                <TextBlock Text="Mean response time" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Median P50 -->
                        <Border Grid.Row="0" Grid.Column="1"
                                Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="MEDIAN (P50)" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.PerfMedian, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}" />
                                <TextBlock Text="Half of responses are faster" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- P95 -->
                        <Border Grid.Row="0" Grid.Column="2"
                                Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="P95" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.PerfP95, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}" />
                                <TextBlock Text="95th-percentile latency" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Throughput (accent highlight) -->
                        <Border Grid.Row="0" Grid.Column="3"
                                Background="{StaticResource AccentSubtleBrush}"
                                BorderBrush="{StaticResource BorderAccentGradientBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="THROUGHPUT" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.PerfTokensPerSecond, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}"
                                           Foreground="{StaticResource TextAccentBrush}" />
                                <TextBlock Text="Avg tokens per second" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Fastest -->
                        <Border Grid.Row="1" Grid.Column="0"
                                Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72A;" FontSize="11"
                                              Foreground="{StaticResource SuccessBrush}" />
                                    <TextBlock Text="FASTEST" Style="{StaticResource OverlineStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.PerfFastest, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}"
                                           Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="Best observed response" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Slowest -->
                        <Border Grid.Row="1" Grid.Column="1"
                                Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72B;" FontSize="11"
                                              Foreground="{StaticResource WarningBrush}" />
                                    <TextBlock Text="SLOWEST" Style="{StaticResource OverlineStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.PerfSlowest, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}"
                                           Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="Worst observed response" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Total Inference Time — spans 2 columns -->
                        <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12,16,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="TOTAL INFERENCE TIME" Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.PerfTotalInference, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}" />
                                <TextBlock Text="Cumulative AI generation time across all sessions"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>

</Page>
