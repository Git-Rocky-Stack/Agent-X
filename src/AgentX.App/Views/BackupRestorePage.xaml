<Page
    x:Class="AgentX.App.Views.BackupRestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AgentX.App.Controls"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:StatusToColorConverter x:Key="StatusToColor" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Padding="{StaticResource PaddingPage}" RowSpacing="24" MaxWidth="900" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- === PAGE HEADER === -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock x:Uid="Backup_BackupRestore" Text="Backup &amp; Restore"
                           Style="{StaticResource DisplaySmallStyle}" />
                <TextBlock x:Uid="Backup_ProtectYourKnowledgeBase" Text="Protect your knowledge base with encrypted backups and one-click restore."
                           Style="{StaticResource BodySecondaryStyle}" />
            </StackPanel>

            <!-- === SIZE ESTIMATE CARD === -->
            <controls:Faceplate Grid.Row="1" Padding="24" Visibility="{x:Bind ViewModel.HasEstimate, Mode=OneWay, Converter={StaticResource BoolToVis}}" Kicker="MOD - BAK - 01">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Database Size -->
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock x:Uid="Backup_Database" Text="Database" Style="{StaticResource CaptionStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Style="{StaticResource HeadingSmallStyle}" FontWeight="Bold">
                                <Run Text="{x:Bind ViewModel.DatabaseSizeMB, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="MB" Style="{StaticResource CaptionStyle}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Documents Size -->
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Uid="Backup_Documents" Text="Documents" Style="{StaticResource CaptionStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Style="{StaticResource HeadingSmallStyle}" FontWeight="Bold">
                                <Run Text="{x:Bind ViewModel.DocumentsSizeMB, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="MB" Style="{StaticResource CaptionStyle}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Total Estimate -->
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock x:Uid="Backup_TotalEstimated" Text="Total Estimated" Style="{StaticResource CaptionStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Style="{StaticResource HeadingSmallStyle}" FontWeight="Bold"
                                       Foreground="{ThemeResource AccentPrimaryBrush}">
                                <Run Text="{x:Bind ViewModel.EstimatedSizeMB, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="MB" Style="{StaticResource CaptionStyle}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Document Count -->
                    <StackPanel Grid.Column="3" Spacing="4">
                        <TextBlock x:Uid="Backup_Documents2" Text="Documents" Style="{StaticResource CaptionStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource HeadingSmallStyle}" FontWeight="Bold">
                                <Run Text="{x:Bind ViewModel.EstimatedDocCount, Mode=OneWay}" />
                            </TextBlock>

                            <!-- The estimate is taken once on load and goes stale as
                                 documents are added, so it needs a way to be refreshed. -->
                            <Button Content="&#xE72C;"
                                    Command="{x:Bind ViewModel.EstimateBackupSizeCommand}"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="12"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="4" MinWidth="0" MinHeight="0"
                                    VerticalAlignment="Center"
                                    x:Uid="Backup_RecalculateTip" ToolTipService.ToolTip="Recalculate estimate"
                                    AutomationProperties.Name="Recalculate estimate" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </controls:Faceplate>

            <!-- === CREATE BACKUP CARD === -->
            <controls:Faceplate Grid.Row="2" Padding="24" Kicker="MOD - BAK - 02">
                <StackPanel Spacing="20">
                    <TextBlock x:Uid="Backup_CreateBackup" Text="Create Backup"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <!-- Destination -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Backup_DestinationFolder" Text="Destination Folder" Style="{StaticResource LabelStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ViewModel.BackupDestination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     x:Uid="Backup_SelectBackupDestinationPh" PlaceholderText="Select backup destination..."
                                     Style="{StaticResource InputTextBoxStyle}" />
                            <Button Grid.Column="1" x:Uid="Backup_Browse" Content="Browse"
                                    Click="BrowseBackupDestination"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </StackPanel>

                    <!-- Options Row -->
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Encryption -->
                        <StackPanel Grid.Column="0" Spacing="8">
                            <CheckBox x:Uid="Backup_EncryptBackupAes256" Content="Encrypt backup (AES-256)"
                                      IsChecked="{x:Bind ViewModel.UseEncryption, Mode=TwoWay}" />
                            <PasswordBox Password="{x:Bind ViewModel.EncryptionPassword, Mode=TwoWay}"
                                         x:Uid="Backup_EncryptionPasswordPh" PlaceholderText="Encryption password"
                                         Visibility="{x:Bind ViewModel.UseEncryption, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- Include Documents -->
                        <StackPanel Grid.Column="1" Spacing="8">
                            <CheckBox x:Uid="Backup_IncludeIndexedDocuments" Content="Include indexed documents"
                                      IsChecked="{x:Bind ViewModel.IncludeDocuments, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <!-- Notes -->
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Backup_NotesOptional" Text="Notes (optional)" Style="{StaticResource LabelStyle}" />
                        <TextBox Text="{x:Bind ViewModel.BackupNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 x:Uid="Backup_AddANoteAboutPh" PlaceholderText="Add a note about this backup..."
                                 Style="{StaticResource InputTextBoxStyle}" />
                    </StackPanel>

                    <!-- Progress -->
                    <StackPanel Spacing="4"
                                Visibility="{x:Bind ViewModel.IsBackingUp, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                     Maximum="100" />
                        <TextBlock Style="{StaticResource CaptionStyle}">
                            <Run Text="{x:Bind ViewModel.ProgressPhase, Mode=OneWay}" />
                            <Run Text=" - " />
                            <Run Text="{x:Bind ViewModel.ProgressItem, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Backup Button -->
                    <Button x:Uid="Backup_CreateBackup2" Content="Create Backup"
                            Command="{x:Bind ViewModel.CreateBackupCommand}"
                            IsEnabled="{x:Bind ViewModel.IsBackingUp, Mode=OneWay, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </controls:Faceplate>

            <!-- === SCHEDULED BACKUPS CARD ===
                 AppSettings.BackupSchedule. Saving applies it at once (BackupService starts or
                 stops the scheduled-backup loop); there is no restart and no settings.json edit. -->
            <controls:Faceplate Grid.Row="3" Padding="24" Kicker="MOD - BAK - 03">
                <StackPanel Spacing="20">
                    <TextBlock x:Uid="Backup_ScheduledBackups" Text="Scheduled Backups"
                               Style="{StaticResource HeadingSmallStyle}" />
                    <TextBlock x:Uid="Backup_ScheduleDescription"
                               Text="While Agent-X is running, it can back up on its own. The next backup is due one interval after the last scheduled one, and one that is due runs about five minutes after the schedule starts."
                               Style="{StaticResource BodySecondaryStyle}"
                               TextWrapping="Wrap" />

                    <ToggleSwitch x:Uid="Backup_ScheduleEnabled" Header="Back up automatically"
                                  IsOn="{x:Bind ViewModel.ScheduledBackupEnabled, Mode=TwoWay}" />

                    <StackPanel Spacing="20"
                                Visibility="{x:Bind ViewModel.ScheduledBackupEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Interval -->
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="ScheduleIntervalLabel"
                                           x:Uid="Backup_ScheduleInterval" Text="Interval (hours)"
                                           Style="{StaticResource LabelStyle}" />
                                <NumberBox Value="{x:Bind ViewModel.ScheduledIntervalHours, Mode=TwoWay}"
                                           Minimum="1" Maximum="720" SpinButtonPlacementMode="Compact"
                                           AutomationProperties.LabeledBy="{x:Bind ScheduleIntervalLabel}" />
                                <TextBlock x:Uid="Backup_ScheduleIntervalHint" Text="24 is daily, 168 weekly, 720 every 30 days."
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>

                            <!-- Retention -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Name="ScheduleKeepLabel"
                                           x:Uid="Backup_ScheduleKeep" Text="Scheduled backups to keep"
                                           Style="{StaticResource LabelStyle}" />
                                <NumberBox Value="{x:Bind ViewModel.MaxBackupsToKeep, Mode=TwoWay}"
                                           Minimum="0" Maximum="1000" SpinButtonPlacementMode="Compact"
                                           AutomationProperties.LabeledBy="{x:Bind ScheduleKeepLabel}" />
                                <TextBlock x:Uid="Backup_ScheduleKeepHint" Text="Older scheduled backups are deleted; 0 keeps all. Manual backups are never deleted."
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Destination -->
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="ScheduleDestinationLabel"
                                       x:Uid="Backup_ScheduleDestination" Text="Destination Folder"
                                       Style="{StaticResource LabelStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind ViewModel.ScheduledBackupDestination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         x:Uid="Backup_ScheduleDestinationPh" PlaceholderText="Empty: the Agent-X data folder"
                                         AutomationProperties.LabeledBy="{x:Bind ScheduleDestinationLabel}"
                                         Style="{StaticResource InputTextBoxStyle}" />
                                <Button Grid.Column="1" x:Uid="Backup_ScheduleBrowse" Content="Browse"
                                        Click="BrowseScheduleDestination"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                        </StackPanel>

                        <!-- Encryption -->
                        <StackPanel Spacing="8">
                            <CheckBox x:Uid="Backup_ScheduleEncrypt" Content="Encrypt scheduled backups (AES-256)"
                                      IsChecked="{x:Bind ViewModel.ScheduledBackupUseEncryption, Mode=TwoWay}" />
                            <PasswordBox Password="{x:Bind ViewModel.ScheduledBackupPassword, Mode=TwoWay}"
                                         x:Uid="Backup_SchedulePasswordPh" PlaceholderText="Password for scheduled backups"
                                         Visibility="{x:Bind ViewModel.ScheduledBackupUseEncryption, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Uid="Backup_SaveSchedule" Content="Save Schedule"
                                Command="{x:Bind ViewModel.SaveScheduleCommand}"
                                IsEnabled="{x:Bind ViewModel.IsSavingSchedule, Mode=OneWay, Converter={StaticResource InverseBool}}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.ScheduleStatusMessage, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </controls:Faceplate>

            <!-- === RESTORE CARD === -->
            <controls:Faceplate Grid.Row="4" Padding="24" Kicker="MOD - BAK - 04">
                <StackPanel Spacing="20">
                    <TextBlock x:Uid="Backup_RestoreFromBackup" Text="Restore from Backup"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Backup_BackupFile" Text="Backup File" Style="{StaticResource LabelStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ViewModel.RestoreFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     x:Uid="Backup_SelectAgentxbakFilePh" PlaceholderText="Select .agentxbak file..."
                                     Style="{StaticResource InputTextBoxStyle}" />
                            <Button Grid.Column="1" x:Uid="Backup_Browse2" Content="Browse"
                                    Click="BrowseRestoreFile"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </StackPanel>

                    <!-- Restore Progress -->
                    <StackPanel Spacing="4"
                                Visibility="{x:Bind ViewModel.IsRestoring, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                     Maximum="100" />
                        <TextBlock Style="{StaticResource CaptionStyle}">
                            <Run Text="{x:Bind ViewModel.ProgressPhase, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Restore Result -->
                    <Border Visibility="{x:Bind ViewModel.RestoreCompleted, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            Background="{ThemeResource AccentSubtleBrush}"
                            CornerRadius="{StaticResource RControl}"
                            Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="Backup_RestoreComplete" Text="Restore Complete"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource SuccessBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.RestoreSummary, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button x:Uid="Backup_Restore" Content="Restore"
                            Click="OnRestoreClick"
                            IsEnabled="{x:Bind ViewModel.IsRestoring, Mode=OneWay, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </controls:Faceplate>

            <!-- === BACKUP HISTORY === -->
            <controls:Faceplate Grid.Row="5" Padding="24" Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay, Converter={StaticResource BoolToVis}}" Kicker="MOD - BAK - 05">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="Backup_BackupHistory" Text="Backup History"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.BackupHistory}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:BackupHistoryItem">
                                <Border Background="{ThemeResource CardGradientSubtleBrush}"
                                        CornerRadius="{StaticResource RControl}"
                                        Padding="16">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon -->
                                        <FontIcon Grid.Column="0"
                                                  Glyph="&#xE8F1;"
                                                  FontSize="20"
                                                  Foreground="{ThemeResource AccentPrimaryBrush}"
                                                  VerticalAlignment="Center" />

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FileName}"
                                                       Style="{StaticResource BodyStyle}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Style="{StaticResource CaptionStyle}">
                                                    <Run Text="{x:Bind SizeMB}" /><Run Text=" MB" />
                                                </TextBlock>
                                                <TextBlock Text="{x:Bind BackupTypeLabel}"
                                                           Style="{StaticResource CaptionStyle}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Integrity Badge - label + color bound to real IsValid
                                             state instead of a constant green "Valid". -->
                                        <Border Grid.Column="2"
                                                CornerRadius="{StaticResource RControl}"
                                                Background="{ThemeResource AccentSubtleBrush}"
                                                Padding="8,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind IntegrityLabel, Mode=OneWay}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Foreground="{x:Bind IntegrityStatus, Mode=OneWay, Converter={StaticResource StatusToColor}}" />
                                        </Border>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                                    VerticalAlignment="Center">
                                            <Button Content="&#xE72C;"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    x:Uid="Backup_RestoreThisBackupTip" ToolTipService.ToolTip="Restore this backup"
                                                    AutomationProperties.Name="Restore this backup"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Tag="{x:Bind FilePath}"
                                                    Click="OnRestoreFromHistoryClick"
                                                    Padding="8" MinWidth="0" MinHeight="0" />
                                            <Button Content="&#xE74D;"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    x:Uid="Backup_DeleteBackupTip" ToolTipService.ToolTip="Delete backup"
                                                    AutomationProperties.Name="Delete backup"
                                                    Foreground="{ThemeResource ErrorBrush}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Tag="{x:Bind Id}"
                                                    Click="OnDeleteBackupClick"
                                                    Padding="8" MinWidth="0" MinHeight="0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </controls:Faceplate>

            <!-- === STATUS === -->
            <TextBlock Grid.Row="6"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource CaptionStyle}" />
        </Grid>
    </ScrollViewer>
</Page>
