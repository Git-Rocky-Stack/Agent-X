<Page
    x:Class="AgentX.App.Views.BackupRestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:StatusToColorConverter x:Key="StatusToColor" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Padding="{StaticResource PaddingPage}" RowSpacing="24" MaxWidth="900">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ PAGE HEADER ═══ -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Backup &amp; Restore"
                           Style="{StaticResource DisplaySmallStyle}" />
                <TextBlock Text="Protect your knowledge base with encrypted backups and one-click restore."
                           Style="{StaticResource BodySecondaryStyle}" />
            </StackPanel>

            <!-- ═══ SIZE ESTIMATE CARD ═══ -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24"
                    Visibility="{x:Bind ViewModel.HasEstimate, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Database Size -->
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Database" Style="{StaticResource CaptionStyle}" Opacity="0.5" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Style="{StaticResource HeadingSmallStyle}" FontWeight="Bold">
                                <Run Text="{x:Bind ViewModel.DatabaseSizeMB, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="MB" Style="{StaticResource CaptionStyle}" Opacity="0.5"
                                       VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Documents Size -->
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Documents" Style="{StaticResource CaptionStyle}" Opacity="0.5" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Style="{StaticResource HeadingSmallStyle}" FontWeight="Bold">
                                <Run Text="{x:Bind ViewModel.DocumentsSizeMB, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="MB" Style="{StaticResource CaptionStyle}" Opacity="0.5"
                                       VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Total Estimate -->
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Total Estimated" Style="{StaticResource CaptionStyle}" Opacity="0.5" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Style="{StaticResource HeadingSmallStyle}" FontWeight="Bold"
                                       Foreground="{StaticResource AccentPrimaryBrush}">
                                <Run Text="{x:Bind ViewModel.EstimatedSizeMB, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="MB" Style="{StaticResource CaptionStyle}" Opacity="0.5"
                                       VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Document Count -->
                    <StackPanel Grid.Column="3" Spacing="4">
                        <TextBlock Text="Documents" Style="{StaticResource CaptionStyle}" Opacity="0.5" />
                        <TextBlock Style="{StaticResource HeadingSmallStyle}" FontWeight="Bold">
                            <Run Text="{x:Bind ViewModel.EstimatedDocCount, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ CREATE BACKUP CARD ═══ -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="24">
                <StackPanel Spacing="20">
                    <TextBlock Text="Create Backup"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <!-- Destination -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Destination Folder" Style="{StaticResource LabelStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ViewModel.BackupDestination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Select backup destination..."
                                     Style="{StaticResource InputTextBoxStyle}" />
                            <Button Grid.Column="1" Content="Browse"
                                    Click="BrowseBackupDestination"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </StackPanel>

                    <!-- Options Row -->
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Encryption -->
                        <StackPanel Grid.Column="0" Spacing="8">
                            <CheckBox Content="Encrypt backup (AES-256)"
                                      IsChecked="{x:Bind ViewModel.UseEncryption, Mode=TwoWay}" />
                            <PasswordBox Password="{x:Bind ViewModel.EncryptionPassword, Mode=TwoWay}"
                                         PlaceholderText="Encryption password"
                                         Visibility="{x:Bind ViewModel.UseEncryption, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- Include Documents -->
                        <StackPanel Grid.Column="1" Spacing="8">
                            <CheckBox Content="Include indexed documents"
                                      IsChecked="{x:Bind ViewModel.IncludeDocuments, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <!-- Notes -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Notes (optional)" Style="{StaticResource LabelStyle}" />
                        <TextBox Text="{x:Bind ViewModel.BackupNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Add a note about this backup..."
                                 Style="{StaticResource InputTextBoxStyle}" />
                    </StackPanel>

                    <!-- Progress -->
                    <StackPanel Spacing="6"
                                Visibility="{x:Bind ViewModel.IsBackingUp, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                     Maximum="100" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Opacity="0.6">
                            <Run Text="{x:Bind ViewModel.ProgressPhase, Mode=OneWay}" />
                            <Run Text=" — " />
                            <Run Text="{x:Bind ViewModel.ProgressItem, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Backup Button -->
                    <Button Content="Create Backup"
                            Command="{x:Bind ViewModel.CreateBackupCommand}"
                            IsEnabled="{x:Bind ViewModel.IsBackingUp, Mode=OneWay, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- ═══ RESTORE CARD ═══ -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="24">
                <StackPanel Spacing="20">
                    <TextBlock Text="Restore from Backup"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Backup File" Style="{StaticResource LabelStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ViewModel.RestoreFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Select .agentxbak file..."
                                     Style="{StaticResource InputTextBoxStyle}" />
                            <Button Grid.Column="1" Content="Browse"
                                    Click="BrowseRestoreFile"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </StackPanel>

                    <!-- Restore Progress -->
                    <StackPanel Spacing="6"
                                Visibility="{x:Bind ViewModel.IsRestoring, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                     Maximum="100" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Opacity="0.6">
                            <Run Text="{x:Bind ViewModel.ProgressPhase, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Restore Result -->
                    <Border Visibility="{x:Bind ViewModel.RestoreCompleted, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource AccentSubtleBrush}"
                            CornerRadius="{StaticResource RadiusSM}"
                            Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Restore Complete"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.RestoreSummary, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7" />
                        </StackPanel>
                    </Border>

                    <Button Content="Restore"
                            Command="{x:Bind ViewModel.RestoreFromBackupCommand}"
                            IsEnabled="{x:Bind ViewModel.IsRestoring, Mode=OneWay, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- ═══ BACKUP HISTORY ═══ -->
            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="24"
                    Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Backup History"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.BackupHistory}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:BackupHistoryItem">
                                <Border Background="{StaticResource CardGradientSubtleBrush}"
                                        CornerRadius="{StaticResource RadiusSM}"
                                        Padding="16">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon -->
                                        <FontIcon Grid.Column="0"
                                                  Glyph="&#xE8F1;"
                                                  FontSize="20"
                                                  Foreground="{StaticResource AccentPrimaryBrush}"
                                                  VerticalAlignment="Center" />

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FileName}"
                                                       Style="{StaticResource BodyStyle}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Style="{StaticResource CaptionStyle}" Opacity="0.5">
                                                    <Run Text="{x:Bind SizeMB}" /><Run Text=" MB" />
                                                </TextBlock>
                                                <TextBlock Text="{x:Bind BackupType}"
                                                           Style="{StaticResource CaptionStyle}"
                                                           Opacity="0.4" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Integrity Badge — label + color bound to real IsValid
                                             state instead of a constant green "Valid". -->
                                        <Border Grid.Column="2"
                                                CornerRadius="{StaticResource RadiusSM}"
                                                Background="{StaticResource AccentSubtleBrush}"
                                                Padding="8,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind IntegrityLabel, Mode=OneWay}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Foreground="{x:Bind IntegrityStatus, Mode=OneWay, Converter={StaticResource StatusToColor}}" />
                                        </Border>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                                    VerticalAlignment="Center">
                                            <Button Content="&#xE72C;"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    ToolTipService.ToolTip="Restore this backup"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Padding="8" MinWidth="0" MinHeight="0" />
                                            <Button Content="&#xE74D;"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    ToolTipService.ToolTip="Delete backup"
                                                    Foreground="{StaticResource ErrorBrush}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Padding="8" MinWidth="0" MinHeight="0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- ═══ STATUS ═══ -->
            <TextBlock Grid.Row="5"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Style="{StaticResource CaptionStyle}"
                       Opacity="0.5" />
        </Grid>
    </ScrollViewer>
</Page>
