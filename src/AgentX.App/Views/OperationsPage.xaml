<Page
    x:Class="AgentX.App.Views.OperationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AgentX.App.Controls"
    xmlns:converters="using:AgentX.App.Converters"
    x:Name="OperationsRoot"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:StatusToColorConverter x:Key="StatusToColor" />
        <DataTemplate x:Key="OperationsPreviewTemplate">
            <Border Style="{StaticResource CardStyle}"
                    Padding="12,10"
                    Margin="0,0,0,8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource BodyStyle}"
                               FontWeight="SemiBold"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock Text="{Binding Status}"
                               Style="{StaticResource CaptionStyle}"
                               Foreground="{ThemeResource TextAccentBrush}"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock Text="{Binding Detail}"
                               Style="{StaticResource CaptionStyle}"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="OperationsConversationPreviewTemplate">
            <Button Command="{Binding ViewModel.OpenConversationPreviewCommand, ElementName=OperationsRoot}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="0"
                    Margin="0,0,0,8"
                    AutomationProperties.LabeledBy="{Binding ElementName=OperationsConversationPreviewTemplateLabel}">
                <Border Style="{StaticResource CardStyle}"
                        Padding="12,10">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="OperationsConversationPreviewTemplateLabel" Text="{Binding Title}"
                                   Style="{StaticResource BodyStyle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="WrapWholeWords" />
                        <Border Style="{StaticResource BadgeDefaultStyle}"
                                HorizontalAlignment="Left"
                                BorderBrush="{Binding Status, Converter={StaticResource StatusToColor}}">
                            <TextBlock Text="{Binding Status}"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" />
                        </Border>
                        <TextBlock Text="{Binding Detail}"
                                   Style="{StaticResource CaptionStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="OperationsInboxPreviewTemplate">
            <Button Command="{Binding ViewModel.OpenInboxPreviewCommand, ElementName=OperationsRoot}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="0"
                    Margin="0,0,0,8"
                    AutomationProperties.LabeledBy="{Binding ElementName=OperationsInboxPreviewTemplateLabel}">
                <Border Style="{StaticResource CardStyle}"
                        Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="OperationsInboxPreviewTemplateLabel" Text="{Binding Title}"
                                   Style="{StaticResource BodyStyle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="WrapWholeWords" />
                        <Border Style="{StaticResource BadgeDefaultStyle}"
                                HorizontalAlignment="Left"
                                BorderBrush="{Binding Status, Converter={StaticResource StatusToColor}}">
                            <TextBlock Text="{Binding Status}"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" />
                        </Border>
                        <TextBlock Text="{Binding Detail}"
                                   Style="{StaticResource CaptionStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="OperationsImportedDocumentPreviewTemplate">
            <Border Style="{StaticResource CardStyle}"
                    Padding="12,10"
                    Margin="0,0,0,8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Command="{Binding ViewModel.OpenImportedDocumentPreviewCommand, ElementName=OperationsRoot}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0"
                            AutomationProperties.LabeledBy="{Binding ElementName=OperationsImportedDocumentPreviewTemplateLabel}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="OperationsImportedDocumentPreviewTemplateLabel" Text="{Binding Title}"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="WrapWholeWords" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <TextBlock Text="{Binding Status}"
                                           Style="{StaticResource CaptionStyle}"
                                           Foreground="{ThemeResource TextAccentBrush}"
                                           TextWrapping="WrapWholeWords"
                                           VerticalAlignment="Center" />
                                <Border Style="{StaticResource BadgeDefaultStyle}"
                                        Visibility="{Binding HasHealthStatus, Converter={StaticResource BoolToVis}}"
                                        BorderBrush="{Binding HealthStatus, Converter={StaticResource StatusToColor}}">
                                    <TextBlock Text="{Binding HealthStatus}"
                                               Style="{StaticResource CaptionStyle}"
                                               Foreground="{Binding HealthStatus, Converter={StaticResource StatusToColor}}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            x:Uid="Ops_RetryIndexBtn" Content="Retry Index"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ViewModel.RetryImportedDocumentIndexingCommand, ElementName=OperationsRoot}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding CanRetryIndexingFromOperations, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="OperationsSyncPreviewTemplate">
            <Button Command="{Binding ViewModel.OpenSyncPreviewCommand, ElementName=OperationsRoot}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="0"
                    Margin="0,0,0,8"
                    AutomationProperties.LabeledBy="{Binding ElementName=OperationsSyncPreviewTemplateLabel}">
                <Border Style="{StaticResource CardStyle}"
                        Padding="12,10">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="OperationsSyncPreviewTemplateLabel" Text="{Binding Title}"
                                   Style="{StaticResource BodyStyle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="WrapWholeWords" />
                        <Border Style="{StaticResource BadgeDefaultStyle}"
                                HorizontalAlignment="Left"
                                BorderBrush="{Binding Status, Converter={StaticResource StatusToColor}}">
                            <TextBlock Text="{Binding Status}"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" />
                        </Border>
                        <TextBlock Text="{Binding Detail}"
                                   Style="{StaticResource CaptionStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="OperationsWorkflowPreviewTemplate">
            <Button Command="{Binding ViewModel.OpenWorkflowRunPreviewCommand, ElementName=OperationsRoot}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="0"
                    Margin="0,0,0,8"
                    AutomationProperties.LabeledBy="{Binding ElementName=OperationsWorkflowPreviewTemplateLabel}">
                <Border Style="{StaticResource CardStyle}"
                        Padding="12,10">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="OperationsWorkflowPreviewTemplateLabel" Text="{Binding Title}"
                                   Style="{StaticResource BodyStyle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="WrapWholeWords" />
                        <Border Style="{StaticResource BadgeDefaultStyle}"
                                HorizontalAlignment="Left"
                                BorderBrush="{Binding Status, Converter={StaticResource StatusToColor}}">
                            <TextBlock Text="{Binding Status}"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" />
                        </Border>
                        <TextBlock Text="{Binding Detail}"
                                   Style="{StaticResource CaptionStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="OperationsConnectorPreviewTemplate">
            <Border Style="{StaticResource CardStyle}"
                    Padding="12,10"
                    Margin="0,0,0,8">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource BodyStyle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="WrapWholeWords" />
                        <Border Style="{StaticResource BadgeDefaultStyle}"
                                HorizontalAlignment="Left"
                                BorderBrush="{Binding Status, Converter={StaticResource StatusToColor}}">
                            <TextBlock Text="{Binding Status}"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" />
                        </Border>
                        <TextBlock Text="{Binding Detail}"
                                   Style="{StaticResource CaptionStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Ops_EnableConnectorBtn" Content="Enable Connector"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding CanEnableFromOperations, Converter={StaticResource BoolToVis}}"
                                Command="{Binding ViewModel.EnableConnectorCommand, ElementName=OperationsRoot}"
                                CommandParameter="{Binding}" />
                        <Button x:Uid="Ops_OpenPluginBtn" Content="Open Plugin"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding ViewModel.OpenConnectorPreviewCommand, ElementName=OperationsRoot}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="OperationsHeaderStatusTileTemplate">
            <Button Command="{Binding ViewModel.OpenOverviewStatusTileCommand, ElementName=OperationsRoot}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="0"
                    AutomationProperties.LabeledBy="{Binding ElementName=OperationsHeaderStatusTileTemplateLabel}">
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="OperationsHeaderStatusTileTemplateLabel" Text="{Binding Title}"
                                   Style="{StaticResource OverlineStyle}" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Headline}"
                                   Style="{StaticResource BodyStyle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="WrapWholeWords" />
                        <Border Grid.Row="2"
                                Style="{StaticResource BadgeDefaultStyle}"
                                HorizontalAlignment="Left"
                                BorderBrush="{Binding Status, Converter={StaticResource StatusToColor}}">
                            <TextBlock Text="{Binding Status}"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" />
                        </Border>
                        <TextBlock Grid.Row="3"
                                   Text="{Binding NavigationLabel}"
                                   Style="{StaticResource CaptionStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="OperationsRecommendedActionTemplate">
            <Border Style="{StaticResource CardInsetStyle}"
                    Padding="16,14">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="36"
                                Height="36"
                                CornerRadius="{StaticResource RadiusMD}"
                                Background="{ThemeResource AccentSubtleBrush}">
                            <FontIcon Glyph="{Binding IconGlyph}"
                                      FontSize="15"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   Margin="12,0,0,0"
                                   Style="{StaticResource BodyStyle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="WrapWholeWords"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="2"
                                Style="{StaticResource BadgeDefaultStyle}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding CategoryLabel}"
                                       Style="{StaticResource BadgeStyle}" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Style="{StaticResource BadgeDefaultStyle}"
                            HorizontalAlignment="Left"
                            BorderBrush="{Binding Status, Converter={StaticResource StatusToColor}}">
                        <TextBlock Text="{Binding Status}"
                                   Style="{StaticResource CaptionStyle}"
                                   Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" />
                    </Border>

                    <TextBlock Grid.Row="2"
                               Text="{Binding Detail}"
                               Style="{StaticResource BodySecondaryStyle}"
                               TextWrapping="WrapWholeWords" />

                    <Button Grid.Row="3"
                            Command="{Binding ViewModel.ExecuteRecommendedActionCommand, ElementName=OperationsRoot}"
                            CommandParameter="{Binding}"
                            Content="{Binding CommandText}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Padding="12,8"
                            FontSize="12" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">

            <Grid Padding="{StaticResource PaddingPage}" RowSpacing="24" MaxWidth="1200" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="Ops_Title" Text="Operations"
                               Style="{StaticResource DisplaySmallStyle}" />
                    <TextBlock x:Uid="Ops_Subtitle" Text="Unified status for conversation intelligence, sync posture, ingestion backlog, workflow activity, and connectors."
                               Style="{StaticResource BodySecondaryStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="1"
                        x:Uid="Ops_DashboardBtn" Content="Dashboard"
                        Style="{StaticResource GhostButtonStyle}"
                        Command="{x:Bind ViewModel.NavigateToDashboardCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0" />

                <Button Grid.Column="2"
                        x:Uid="Ops_RefreshBtn" Content="Refresh"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        VerticalAlignment="Center" />
            </Grid>

            <controls:Faceplate Grid.Row="1" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVis}, Mode=OneWay}" Kicker="MOD - OPS - 01">
                <StackPanel Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Center" Padding="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="20" Height="20"
                                  Foreground="{ThemeResource TextAccentBrush}" />
                    <TextBlock x:Uid="Ops_Loading" Text="Loading operations status..."
                               Style="{StaticResource BodySecondaryStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </controls:Faceplate>

            <controls:Faceplate Grid.Row="2" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" Kicker="MOD - OPS - 02">
                <Grid RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="Ops_CurrentStatusOverline" Text="CURRENT OPERATIONS STATUS"
                                   Style="{StaticResource OverlineStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SummaryHeadline, Mode=OneWay}"
                                   Style="{StaticResource HeadingLargeStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.SummaryDetail, Mode=OneWay}"
                                   Style="{StaticResource BodySecondaryStyle}"
                                   TextWrapping="Wrap"
                                   MaxWidth="780" />
                    </StackPanel>

                    <ItemsRepeater Grid.Row="1"
                                   ItemsSource="{x:Bind ViewModel.OverviewStatusTiles, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="180"
                                               MinItemHeight="132"
                                               MinColumnSpacing="12"
                                               MinRowSpacing="12"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <StaticResource ResourceKey="OperationsHeaderStatusTileTemplate" />
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </controls:Faceplate>

            <StackPanel Grid.Row="3" Spacing="12">
                <controls:Faceplate Visibility="{x:Bind ViewModel.HasError, Converter={StaticResource BoolToVis}, Mode=OneWay}" Kicker="MOD - OPS - 03">
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               Style="{StaticResource BodySecondaryStyle}"
                               TextWrapping="Wrap" />
                </controls:Faceplate>

                <controls:Faceplate Visibility="{x:Bind ViewModel.HasActionMessage, Converter={StaticResource BoolToVis}, Mode=OneWay}" Kicker="MOD - OPS - 04">
                    <TextBlock Text="{x:Bind ViewModel.ActionMessage, Mode=OneWay}"
                               Style="{StaticResource BodySecondaryStyle}"
                               TextWrapping="Wrap" />
                </controls:Faceplate>

                <controls:Faceplate Visibility="{x:Bind ViewModel.HasActionError, Converter={StaticResource BoolToVis}, Mode=OneWay}" Kicker="MOD - OPS - 05">
                    <TextBlock Text="{x:Bind ViewModel.ActionErrorMessage, Mode=OneWay}"
                               Style="{StaticResource BodySecondaryStyle}"
                               TextWrapping="Wrap" />
                </controls:Faceplate>

                <controls:Faceplate Visibility="{x:Bind ViewModel.HasRecommendedActions, Converter={StaticResource BoolToVis}, Mode=OneWay}" Kicker="MOD - OPS - 06">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="Ops_SuggestedFixesTitle" Text="Suggested Fixes"
                                           Style="{StaticResource HeadingMediumStyle}" />
                                <TextBlock x:Uid="Ops_SuggestedFixesSubtitle" Text="The highest-leverage remediation steps based on the current Operations snapshot."
                                           Style="{StaticResource BodySecondaryStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource BadgeDefaultStyle}"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{x:Bind ViewModel.RecommendedActions.Count, Mode=OneWay}"
                                           Style="{StaticResource BadgeStyle}" />
                            </Border>
                        </Grid>

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecommendedActions, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="250"
                                                   MinItemHeight="0"
                                                   MinColumnSpacing="12"
                                                   MinRowSpacing="12"
                                                   ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <StaticResource ResourceKey="OperationsRecommendedActionTemplate" />
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </controls:Faceplate>
            </StackPanel>

            <Grid Grid.Row="4"
                  ColumnSpacing="16"
                  RowSpacing="16"
                  Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:Faceplate Grid.Row="0" Grid.Column="0" MinHeight="212" Kicker="MOD - OPS - 07">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9D2;" FontSize="14"
                                          Foreground="{ThemeResource TextAccentBrush}" />
                                <TextBlock x:Uid="Ops_ConvIntelOverline" Text="CONVERSATION INTELLIGENCE"
                                           Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.ConversationIntelligence.Headline, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ConversationIntelligence.Status, Mode=OneWay}"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.ConversationIntelligence.Detail, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Uid="Ops_RecentSummariesLabel" Text="Recent summaries"
                                       Style="{StaticResource CaptionStyle}"
                                       Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentConversationSummaries, Mode=OneWay}"
                                          ItemTemplate="{StaticResource OperationsConversationPreviewTemplate}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Ops_RefreshSummariesBtn" Content="Refresh Summaries"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.RefreshConversationSummariesCommand}" />
                            <Button x:Uid="Ops_OpenAnalyticsBtn" Content="Open Analytics"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.NavigateToAnalyticsCommand}" />
                        </StackPanel>
                    </Grid>
                </controls:Faceplate>

                <controls:Faceplate Grid.Row="0" Grid.Column="1" MinHeight="212" Kicker="MOD - OPS - 08">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE895;" FontSize="14"
                                          Foreground="{ThemeResource InfoBrush}" />
                                <TextBlock x:Uid="Ops_SyncHealthOverline" Text="SYNC HEALTH"
                                           Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SyncHealth.Headline, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SyncHealth.Status, Mode=OneWay}"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.SyncHealth.Detail, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Uid="Ops_RecentSyncPassesLabel" Text="Recent sync passes"
                                       Style="{StaticResource CaptionStyle}"
                                       Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentSyncPasses, Mode=OneWay}"
                                          ItemTemplate="{StaticResource OperationsSyncPreviewTemplate}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Ops_SyncNowBtn" Content="Sync Now"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.RunManualSyncCommand}" />
                            <Button x:Uid="Ops_OpenSyncBtn" Content="Open Sync"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.NavigateToSyncSettingsCommand}" />
                        </StackPanel>
                    </Grid>
                </controls:Faceplate>

                <controls:Faceplate Grid.Row="1" Grid.Column="0" MinHeight="212" Kicker="MOD - OPS - 09">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"
                                          Foreground="{ThemeResource WarningBrush}" />
                                <TextBlock x:Uid="Ops_IngestionOverline" Text="INGESTION BACKLOG"
                                           Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.IngestionBacklog.Headline, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.IngestionBacklog.Status, Mode=OneWay}"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.IngestionBacklog.Detail, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Uid="Ops_PendingItemsLabel" Text="Pending items"
                                       Style="{StaticResource CaptionStyle}"
                                       Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PendingInboxItems, Mode=OneWay}"
                                          ItemTemplate="{StaticResource OperationsInboxPreviewTemplate}" />
                            <TextBlock x:Uid="Ops_RecentImportedLabel" Text="Recent imported documents"
                                       Style="{StaticResource CaptionStyle}"
                                       Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentImportedDocuments, Mode=OneWay}"
                                          ItemTemplate="{StaticResource OperationsImportedDocumentPreviewTemplate}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Ops_GeneratePreviewsBtn" Content="Generate Previews"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.GenerateInboxPreviewsCommand}" />
                            <Button x:Uid="Ops_OpenInboxBtn" Content="Open Inbox"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.NavigateToInboxCommand}" />
                            <Button x:Uid="Ops_OpenVaultBtn" Content="Open Vault"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.NavigateToKnowledgeVaultCommand}" />
                        </StackPanel>
                    </Grid>
                </controls:Faceplate>

                <controls:Faceplate Grid.Row="1" Grid.Column="1" MinHeight="212" Kicker="MOD - OPS - 10">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C7;" FontSize="14"
                                          Foreground="{ThemeResource SuccessBrush}" />
                                <TextBlock x:Uid="Ops_WorkflowOverline" Text="WORKFLOW ACTIVITY"
                                           Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.WorkflowActivity.Headline, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.WorkflowActivity.Status, Mode=OneWay}"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Style="{StaticResource BadgeDefaultStyle}">
                                    <TextBlock Text="{x:Bind ViewModel.WorkflowActivity.SupportingPrimary, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                </Border>
                                <Border Style="{StaticResource BadgeDefaultStyle}">
                                    <TextBlock Text="{x:Bind ViewModel.WorkflowActivity.SupportingSecondary, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.WorkflowActivity.Detail, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Uid="Ops_RecentRunsLabel" Text="Recent runs"
                                       Style="{StaticResource CaptionStyle}"
                                       Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentWorkflowRuns, Mode=OneWay}"
                                          ItemTemplate="{StaticResource OperationsWorkflowPreviewTemplate}" />
                        </StackPanel>

                        <Button Grid.Row="2"
                                x:Uid="Ops_OpenWorkflowsBtn" Content="Open Workflows"
                                Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.NavigateToWorkflowsCommand}" />
                    </Grid>
                </controls:Faceplate>

                <controls:Faceplate Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" MinHeight="196" Kicker="MOD - OPS - 11">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE943;" FontSize="14"
                                          Foreground="{ThemeResource SuccessBrush}" />
                                <TextBlock x:Uid="Ops_ConnectorsOverline" Text="CONNECTORS &amp; PLUGINS"
                                           Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Connectors.Headline, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Connectors.Status, Mode=OneWay}"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.Connectors.Detail, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Uid="Ops_ConnectorPreviewLabel" Text="Connector preview"
                                       Style="{StaticResource CaptionStyle}"
                                       Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ConnectorPreviews, Mode=OneWay}"
                                          ItemTemplate="{StaticResource OperationsConnectorPreviewTemplate}" />
                        </StackPanel>

                        <Button Grid.Row="2"
                                x:Uid="Ops_OpenPluginManagerBtn" Content="Open Plugin Manager"
                                Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.NavigateToPluginManagerCommand}" />
                    </Grid>
                </controls:Faceplate>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
