<Page
    x:Class="AgentX.App.Views.OperationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:AgentX.App.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">

        <Grid Padding="{StaticResource PaddingPage}" RowSpacing="24" MaxWidth="1200" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Operations"
                               Style="{StaticResource DisplaySmallStyle}" />
                    <TextBlock Text="Unified status for conversation intelligence, sync posture, ingestion backlog, workflow activity, and connectors."
                               Style="{StaticResource BodySecondaryStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Dashboard"
                        Style="{StaticResource GhostButtonStyle}"
                        Command="{x:Bind ViewModel.NavigateToDashboardCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0" />

                <Button Grid.Column="2"
                        Content="Refresh"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Center" Padding="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="20" Height="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                    <TextBlock Text="Loading operations status..."
                               Style="{StaticResource BodySecondaryStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource CardAccentStyle}"
                    Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}">
                <Grid RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="10">
                        <TextBlock Text="CURRENT OPERATIONS STATUS"
                                   Style="{StaticResource OverlineStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SummaryHeadline, Mode=OneWay}"
                                   Style="{StaticResource HeadingLargeStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.SummaryDetail, Mode=OneWay}"
                                   Style="{StaticResource BodySecondaryStyle}"
                                   TextWrapping="Wrap"
                                   MaxWidth="780" />
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource BadgeDefaultStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Conversation"
                                           Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.ConversationIntelligence.Headline, Mode=OneWay}"
                                           Style="{StaticResource BodyStyle}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource BadgeDefaultStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Backlog"
                                           Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.IngestionBacklog.Headline, Mode=OneWay}"
                                           Style="{StaticResource BodyStyle}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource BadgeDefaultStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Workflows"
                                           Style="{StaticResource OverlineStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.WorkflowActivity.Headline, Mode=OneWay}"
                                           Style="{StaticResource BodyStyle}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.HasError, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Style="{StaticResource BodySecondaryStyle}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="4"
                  ColumnSpacing="16"
                  RowSpacing="16"
                  Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" MinHeight="212">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9D2;" FontSize="14"
                                          Foreground="{StaticResource TextAccentBrush}" />
                                <TextBlock Text="CONVERSATION INTELLIGENCE"
                                           Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.ConversationIntelligence.Headline, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ConversationIntelligence.Status, Mode=OneWay}"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.ConversationIntelligence.Detail, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Row="2"
                                Content="Open Analytics"
                                Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.NavigateToAnalyticsCommand}" />
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" MinHeight="212">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE895;" FontSize="14"
                                          Foreground="{StaticResource InfoBrush}" />
                                <TextBlock Text="SYNC HEALTH"
                                           Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SyncHealth.Headline, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SyncHealth.Status, Mode=OneWay}"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.SyncHealth.Detail, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Row="2"
                                Content="Open Sync"
                                Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.NavigateToSyncSettingsCommand}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" MinHeight="212">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"
                                          Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="INGESTION BACKLOG"
                                           Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.IngestionBacklog.Headline, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.IngestionBacklog.Status, Mode=OneWay}"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.IngestionBacklog.Detail, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Row="2"
                                Content="Open Inbox"
                                Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.NavigateToInboxCommand}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" MinHeight="212">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C7;" FontSize="14"
                                          Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="WORKFLOW ACTIVITY"
                                           Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.WorkflowActivity.Headline, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.WorkflowActivity.Status, Mode=OneWay}"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Style="{StaticResource BadgeDefaultStyle}">
                                    <TextBlock Text="{x:Bind ViewModel.WorkflowActivity.SupportingPrimary, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                                <Border Style="{StaticResource BadgeDefaultStyle}">
                                    <TextBlock Text="{x:Bind ViewModel.WorkflowActivity.SupportingSecondary, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.WorkflowActivity.Detail, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Row="2"
                                Content="Open Workflows"
                                Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.NavigateToWorkflowsCommand}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" MinHeight="196">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE943;" FontSize="14"
                                          Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="CONNECTORS &amp; PLUGINS"
                                           Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.Connectors.Headline, Mode=OneWay}"
                                       Style="{StaticResource MetricMediumStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Connectors.Status, Mode=OneWay}"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.Connectors.Detail, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Row="2"
                                Content="Open Plugin Manager"
                                Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.NavigateToPluginManagerCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
