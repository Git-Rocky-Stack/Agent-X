<Page
    x:Class="AgentX.App.Views.ComparisonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             LEFT PANEL: Document Selection
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource CardGradientSubtleBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Padding="20,20,20,12" Spacing="4">
                    <TextBlock Text="Select Documents"
                               Style="{StaticResource HeadingSmallStyle}"
                               FontWeight="Bold" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Opacity="0.5">
                        <Run Text="{x:Bind ViewModel.SelectedDocuments.Count, Mode=OneWay}" />
                        <Run Text="selected" />
                    </TextBlock>
                </StackPanel>

                <!-- Options -->
                <StackPanel Grid.Row="1" Padding="20,0,20,12" Spacing="10">
                    <TextBox Text="{x:Bind ViewModel.FocusQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Focus topic (optional)..."
                             Style="{StaticResource InputTextBoxStyle}" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.DetailLevels}"
                              SelectedItem="{x:Bind ViewModel.DetailLevel, Mode=TwoWay}"
                              Header="Detail Level"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- Document List -->
                <ListView Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.AvailableDocuments}"
                          SelectionMode="None"
                          Padding="8,0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentSelectItem">
                            <Grid Padding="8,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind FileName}"
                                               Style="{StaticResource BodyStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind FileType}"
                                               Style="{StaticResource CaptionStyle}"
                                               Opacity="0.4" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Compare Button -->
                <StackPanel Grid.Row="3" Padding="20,12" Spacing="8">
                    <Button Content="Compare Documents"
                            Command="{x:Bind ViewModel.CompareDocumentsCommand}"
                            IsEnabled="{x:Bind ViewModel.IsComparing, Mode=OneWay, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" />
                    <Button Content="Cancel"
                            Command="{x:Bind ViewModel.CancelComparisonCommand}"
                            Visibility="{x:Bind ViewModel.IsComparing, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             RIGHT PANEL: Comparison Report
             ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Padding="{StaticResource PaddingPage}" RowSpacing="20" MaxWidth="900">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="Comparative Analysis"
                                   Style="{StaticResource DisplaySmallStyle}" />
                        <TextBlock Text="Select 2+ documents to generate a structured side-by-side comparison."
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <!-- Progress -->
                    <Border Grid.Row="1"
                            Style="{StaticResource CardStyle}"
                            Padding="24"
                            Visibility="{x:Bind ViewModel.IsComparing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <ProgressRing IsActive="True" Width="32" Height="32" />
                            <TextBlock Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}"
                                       Style="{StaticResource BodyStyle}"
                                       HorizontalAlignment="Center"
                                       Opacity="0.7" />
                        </StackPanel>
                    </Border>

                    <!-- Summary -->
                    <Border Grid.Row="2"
                            Style="{StaticResource CardStyle}"
                            Padding="24"
                            Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Summary"
                                           Style="{StaticResource HeadingSmallStyle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                    <TextBlock Style="{StaticResource CaptionStyle}" Opacity="0.4">
                                        <Run Text="{x:Bind ViewModel.ReportTokensUsed, Mode=OneWay}" />
                                        <Run Text="tokens" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Opacity="0.4">
                                        <Run Text="{x:Bind ViewModel.ReportDurationMs, Mode=OneWay}" />
                                        <Run Text="ms" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.ReportSummary, Mode=OneWay}"
                                       Style="{StaticResource BodyStyle}"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Border>

                    <!-- Similarities -->
                    <Border Grid.Row="3"
                            Style="{StaticResource CardStyle}"
                            Padding="24"
                            Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Similarities" Style="{StaticResource HeadingSmallStyle}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Similarities}">
                                <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="12"
                                                      Foreground="{StaticResource SuccessBrush}"
                                                      VerticalAlignment="Top" Margin="0,3,0,0" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind}"
                                                       Style="{StaticResource BodyStyle}"
                                                       TextWrapping="Wrap" Opacity="0.8" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!-- Differences -->
                    <Border Grid.Row="4"
                            Style="{StaticResource CardStyle}"
                            Padding="24"
                            Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Differences" Style="{StaticResource HeadingSmallStyle}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Differences}">
                                <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE783;" FontSize="12"
                                                      Foreground="{StaticResource AccentPrimaryBrush}"
                                                      VerticalAlignment="Top" Margin="0,3,0,0" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind}"
                                                       Style="{StaticResource BodyStyle}"
                                                       TextWrapping="Wrap" Opacity="0.8" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!-- Contradictions -->
                    <Border Grid.Row="5"
                            Style="{StaticResource CardStyle}"
                            Padding="24"
                            Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Contradictions" Style="{StaticResource HeadingSmallStyle}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Contradictions}">
                                <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="12"
                                                      Foreground="{StaticResource ErrorBrush}"
                                                      VerticalAlignment="Top" Margin="0,3,0,0" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind}"
                                                       Style="{StaticResource BodyStyle}"
                                                       TextWrapping="Wrap" Opacity="0.8" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!-- Export -->
                    <Border Grid.Row="6"
                            Style="{StaticResource CardStyle}"
                            Padding="24"
                            Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Unique Points by Document"
                                       Style="{StaticResource HeadingSmallStyle}" />

                            <TextBlock Text="No document-specific unique points were identified in this comparison."
                                       Style="{StaticResource BodySecondaryStyle}"
                                       Visibility="{x:Bind ViewModel.HasUniquePoints, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.UniquePoints, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.HasUniquePoints, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UniquePointGroup">
                                        <Border Style="{StaticResource CardInsetStyle}"
                                                Padding="16">
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8">
                                                    <FontIcon Glyph="&#xE8FD;"
                                                              FontSize="14"
                                                              Foreground="{StaticResource TextAccentBrush}" />
                                                    <TextBlock Text="{x:Bind DocumentName}"
                                                               Style="{StaticResource BodyStyle}"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <ItemsRepeater ItemsSource="{x:Bind Points}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="6" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <FontIcon Grid.Column="0"
                                                                          Glyph="&#xE73E;"
                                                                          FontSize="12"
                                                                          Foreground="{StaticResource AccentPrimaryBrush}"
                                                                          VerticalAlignment="Top"
                                                                          Margin="0,3,0,0" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind}"
                                                                           Style="{StaticResource BodyStyle}"
                                                                           TextWrapping="Wrap"
                                                                           Opacity="0.8" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="7"
                                Spacing="8">
                        <Button Content="Export Report"
                                Command="{x:Bind ViewModel.ExportReportCommand}"
                                Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource SecondaryButtonStyle}" />

                        <!-- Status -->
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}"
                                   Opacity="0.5" />
                    </StackPanel>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="2"
                                HorizontalAlignment="Center"
                                Spacing="12"
                                Margin="0,40,0,0"
                                Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <FontIcon Glyph="&#xE9D9;"
                                  FontSize="48"
                                  Foreground="{StaticResource TextTertiaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Select documents and compare"
                                   Style="{StaticResource BodySecondaryStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
