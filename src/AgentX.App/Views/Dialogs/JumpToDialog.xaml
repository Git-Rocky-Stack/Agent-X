<ContentDialog
    x:Class="AgentX.App.Views.Dialogs.JumpToDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    x:Uid="JumpTo_Title"
    Title="Jump To"
    CloseButtonText="Cancel"
    DefaultButton="Close">

    <Grid MinWidth="520" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox
            x:Name="SearchBox"
            PlaceholderText="Jump to page, document, or conversation..."
            TextChanged="SearchBox_TextChanged"
            KeyDown="SearchBox_KeyDown" />

        <ListView
            x:Name="ResultsList"
            Grid.Row="1"
            MaxHeight="420"
            ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
            DoubleTapped="ResultsList_DoubleTapped"
            KeyDown="ResultsList_KeyDown"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:JumpToItem">
                    <Grid Padding="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Glyph="{x:Bind IconGlyph}"
                            FontSize="16"
                            VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                Text="{x:Bind Label}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Subtitle, TargetNullValue=''}"
                                FontSize="12"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
