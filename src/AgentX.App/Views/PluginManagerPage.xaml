<Page
    x:Class="AgentX.App.Views.PluginManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    xmlns:controls="using:AgentX.App.Controls"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>

        <!-- ═══════════════════════════════════════════════════════════
             CONVERTERS
             ═══════════════════════════════════════════════════════════ -->

        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NullToVisibilityConverter x:Key="InverseNullToVis" IsInverted="True" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />

    </Page.Resources>

    <Grid Background="{ThemeResource PageBackgroundBrush}">

        <!-- ═══════ ADAPTIVE LAYOUT (Tier 3) — see Colors.xaml breakpoints ═══════
             Narrow (<960):  sidebar 240   |  Medium (>=960): sidebar 260
             Wide (>=1280):  sidebar 280 (markup default) -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="240" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="260" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <!-- Left panel: Plugin list sidebar (adaptive width — 240/260/280) -->
            <ColumnDefinition x:Name="SidebarColumn" Width="280" />
            <!-- Right panel: Selected plugin detail -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             LEFT PANEL: PLUGIN LIST SIDEBAR
             Scrollable list of installed plugins, each shown as a compact
             card with icon, name, version, author, and status indicator.
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0"
              Background="{ThemeResource SidebarGradientBrush}"
              BorderBrush="{ThemeResource BorderSubtleBrush}"
              BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════
                 SIDEBAR ROW 0: Header — Title + Count + Install + Refresh
                 ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Style="{StaticResource SidebarHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title + plugin count badge -->
                    <StackPanel Orientation="Horizontal" Spacing="10"
                                VerticalAlignment="Center">
                        <TextBlock x:Uid="Plugin_Manager"
                                   Style="{StaticResource HeadingSmallStyle}" />
                        <Border Style="{StaticResource BadgeDefaultStyle}"
                                Padding="6,2,6,2">
                            <TextBlock Style="{StaticResource BadgeStyle}">
                                <Run Text="{x:Bind ViewModel.PluginCount, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Install button -->
                    <Button Grid.Column="1"
                            x:Uid="Plugin_Install"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{x:Bind ViewModel.InstallPluginCommand}">
                        <FontIcon Glyph="&#xE710;" FontSize="14"
                                  Foreground="{ThemeResource TextAccentBrush}" />
                    </Button>

                    <!-- Refresh button -->
                    <Button Grid.Column="2"
                            x:Uid="Plugin_Refresh"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{x:Bind ViewModel.RefreshPluginsCommand}">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"
                                  Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 SIDEBAR ROW 1: Error bar (conditionally visible)
                 ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    Background="{ThemeResource ErrorSubtleBrush}"
                    BorderBrush="{ThemeResource ErrorBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;" FontSize="12"
                              Foreground="{ThemeResource ErrorBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}"
                               Foreground="{ThemeResource ErrorBrush}"
                               VerticalAlignment="Center"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 SIDEBAR ROW 2: Loading indicator (centered overlay)
                 ═══════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="2"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="32" Height="32"
                              Foreground="{ThemeResource AccentPrimaryBrush}" />
                <TextBlock x:Uid="Plugin_Loading"
                           Style="{StaticResource CaptionStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════
                 SIDEBAR ROW 2: Plugin list (visible when NOT loading)
                 ═══════════════════════════════════════════════════════ -->
            <ListView Grid.Row="2"
                      x:Name="PluginListView"
                      ItemsSource="{x:Bind ViewModel.Plugins, Mode=OneWay}"
                      SelectionMode="Single"
                      SelectionChanged="OnPluginSelectionChanged"
                      Padding="8,8,8,8"
                      Background="Transparent"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PluginDisplayItem">
                        <Border Style="{StaticResource CollectionTreeItemStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Plugin type icon in accent container -->
                                <Border Background="{ThemeResource AccentSubtleBrush}"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Width="36" Height="36"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind TypeGlyph}"
                                              FontSize="16"
                                              Foreground="{ThemeResource TextAccentBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>

                                <!-- Name + Author + Version stacked -->
                                <StackPanel Grid.Column="1" Spacing="2"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                               Style="{StaticResource BodyStyle}"
                                               FontWeight="SemiBold"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind Author, Mode=OneWay}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="·"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   Foreground="{ThemeResource TextTertiaryBrush}">
                                            <Run Text="v" /><Run Text="{x:Bind Version, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Style="{StaticResource BadgeAccentStyle}"
                                            Visibility="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Opened from Operations"
                                                   Style="{StaticResource BadgeStyle}"
                                                   Foreground="{ThemeResource TextAccentBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Status dot: green = active, grey = disabled -->
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{ThemeResource SuccessBrush}"
                                             Visibility="{x:Bind IsEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <Ellipse Width="8" Height="8"
                                             Fill="{ThemeResource OfflineBrush}"
                                             Visibility="{x:Bind IsEnabled, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- ═══════════════════════════════════════════════════════
                 SIDEBAR ROW 2 (overlay): Empty state when no plugins
                 Only visible when NOT loading AND plugin count is 0
                 ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Visibility="{x:Bind HasNoPlugins(ViewModel.PluginCount), Mode=OneWay}"
                    Padding="24,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE74C;" FontSize="28"
                              Foreground="{ThemeResource TextTertiaryBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock x:Uid="Plugin_NoPlugins"
                               Style="{StaticResource BodySmallStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Uid="Plugin_NoPluginsHint"
                               Style="{StaticResource CaptionStyle}"
                               TextAlignment="Center"
                               MaxWidth="200"
                               HorizontalAlignment="Center" />
                    <Button Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center"
                            Padding="16,8,16,8"
                            MinHeight="34"
                            Command="{x:Bind ViewModel.InstallPluginCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock x:Uid="Plugin_InstallButton" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 SIDEBAR ROW 3: Footer with status message
                 ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Padding="16,10,16,10"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Small loading spinner in footer -->
                    <ProgressRing Grid.Column="0"
                                  IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="14" Height="14"
                                  Foreground="{ThemeResource AccentPrimaryBrush}"
                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                    <!-- Status text (fallback icon when not loading) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74C;" FontSize="11"
                                  Foreground="{ThemeResource TextTertiaryBrush}"
                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             RIGHT PANEL: SELECTED PLUGIN DETAIL
             Shows full plugin details when a plugin is selected from the
             sidebar list. Otherwise displays an empty/welcome state.
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">

            <!-- ═══════════════════════════════════════════════════════
                 Empty state: No plugin selected (WelcomeCard)
                 ═══════════════════════════════════════════════════════ -->
            <Border x:Name="EmptyStatePanel"
                    Style="{StaticResource WelcomeCardStyle}"
                    Visibility="Visible">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <!-- Accent circle with puzzle icon -->
                    <Border Background="{ThemeResource AccentSubtleBrush}"
                            CornerRadius="{StaticResource RadiusFull}"
                            Width="72" Height="72"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE74C;"
                                  FontSize="32"
                                  Foreground="{ThemeResource TextAccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock x:Uid="Plugin_SelectPlugin"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Uid="Plugin_SelectPluginHint"
                                   Style="{StaticResource BodySecondaryStyle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="380" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 Plugin detail panel (visible when a plugin is selected)
                 ═══════════════════════════════════════════════════════ -->
            <ScrollViewer x:Name="DetailPanel"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Padding="32,24,32,24" RowSpacing="24" MaxWidth="900">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- =======================================================
                         DETAIL ROW 0: PLUGIN HEADER
                         Icon + Name + Author + Action controls
                         ======================================================= -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Large plugin type icon -->
                        <Border x:Name="DetailIcon"
                                Background="{ThemeResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusLG}"
                                Width="56" Height="56"
                                VerticalAlignment="Top"
                                Margin="0,0,16,0">
                            <FontIcon x:Name="DetailIconGlyph"
                                      FontSize="24"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <!-- Name + Author -->
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailName"
                                       Style="{StaticResource HeadingLargeStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Uid="Plugin_ByAuthor"
                                           Style="{StaticResource BodySecondaryStyle}" />
                                <TextBlock x:Name="DetailAuthor"
                                           Style="{StaticResource BodyStyle}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <Border x:Name="DetailOperationsBadge"
                                    Background="{ThemeResource AccentSubtleBrush}"
                                    BorderBrush="{ThemeResource AccentPrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Padding="12,10"
                                    MaxWidth="520"
                                    Visibility="Collapsed">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE8A5;"
                                                  FontSize="14"
                                                  Foreground="{ThemeResource AccentPrimaryBrush}"
                                                  VerticalAlignment="Top" />
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Focused Connector"
                                                       Style="{StaticResource CaptionStyle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AccentPrimaryBrush}" />
                                            <TextBlock x:Name="DetailOperationsBadgeText"
                                                       Style="{StaticResource BodySecondaryStyle}"
                                                       TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="Dismiss"
                                            Command="{x:Bind ViewModel.DismissFocusedPluginLandingCommand}"
                                            Style="{StaticResource GhostButtonStyle}"
                                            VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Enable/Disable toggle + Uninstall icon button -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Top">
                            <ToggleSwitch x:Name="DetailToggle"
                                          x:Uid="Plugin_Active"
                                          Toggled="OnPluginToggled"
                                          VerticalAlignment="Center" />
                            <Button x:Name="DetailUninstallSmall"
                                    x:Uid="Plugin_Uninstall"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="12,8,12,8" MinHeight="34"
                                    Click="OnUninstallPluginClick">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"
                                          Foreground="{ThemeResource ErrorBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- =======================================================
                         DETAIL ROW 1: METADATA BADGES
                         Version, Type, Status, Plugin ID
                         ======================================================= -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                        <!-- Version badge -->
                        <Border Style="{StaticResource BadgeDefaultStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7C3;" FontSize="10"
                                          Foreground="{ThemeResource TextTertiaryBrush}" />
                                <TextBlock x:Name="DetailVersionBadge"
                                           Style="{StaticResource BadgeStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Type badge (accent-tinted) -->
                        <Border Style="{StaticResource BadgeAccentStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon x:Name="DetailTypeBadgeIcon"
                                          FontSize="10"
                                          Foreground="{ThemeResource TextAccentBrush}" />
                                <TextBlock x:Name="DetailTypeBadgeText"
                                           Style="{StaticResource BadgeStyle}"
                                           Foreground="{ThemeResource TextAccentBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Status badge: ACTIVE (green) or DISABLED (red/grey) -->
                        <Border x:Name="DetailStatusBadge"
                                CornerRadius="{StaticResource RadiusRound}"
                                Padding="10,3,10,3">
                            <TextBlock x:Name="DetailStatusText"
                                       FontSize="10" FontWeight="Bold"
                                       CharacterSpacing="60" />
                        </Border>

                        <!-- Plugin ID badge (monospace) -->
                        <Border Style="{StaticResource BadgeDefaultStyle}">
                            <TextBlock x:Name="DetailPluginId"
                                       Style="{StaticResource MonoSmallStyle}"
                                       MaxWidth="180"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>

                    <!-- =======================================================
                         DETAIL ROW 2: DESCRIPTION CARD
                         ======================================================= -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE946;" FontSize="16"
                                          Foreground="{ThemeResource TextAccentBrush}" />
                                <TextBlock x:Uid="Plugin_Description"
                                           Style="{StaticResource HeadingSmallStyle}" />
                            </StackPanel>

                            <TextBlock x:Name="DetailDescription"
                                       Style="{StaticResource BodyStyle}"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       MaxWidth="700" />
                        </StackPanel>
                    </Border>

                    <!-- =======================================================
                         DETAIL ROW 3: DETAILS CARD
                         Install Path, Installed date, Last Activated date
                         ======================================================= -->
                    <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="16">
                            <!-- Section header -->
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE946;" FontSize="16"
                                          Foreground="{ThemeResource TextAccentBrush}" />
                                <TextBlock x:Uid="Plugin_Details"
                                           Style="{StaticResource HeadingSmallStyle}" />
                            </StackPanel>

                            <!-- Install Path -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Uid="Plugin_InstallPath"
                                           Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Background="{ThemeResource InputBackgroundBrush}"
                                        CornerRadius="{StaticResource RadiusSM}"
                                        Padding="10,6,10,6">
                                    <TextBlock x:Name="DetailInstallPath"
                                               Style="{StaticResource MonoSmallStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"
                                               IsTextSelectionEnabled="True" />
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource SeparatorStyle}" Margin="0" />

                            <!-- Installed date -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Uid="Plugin_Installed"
                                           Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE787;" FontSize="12"
                                              Foreground="{ThemeResource TextTertiaryBrush}" />
                                    <TextBlock x:Name="DetailInstalledAt"
                                               Style="{StaticResource BodySmallStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- Last Activated date -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Uid="Plugin_LastActivated"
                                           Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE823;" FontSize="12"
                                              Foreground="{ThemeResource TextTertiaryBrush}" />
                                    <TextBlock x:Name="DetailLastActivated"
                                               Style="{StaticResource BodySmallStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- =======================================================
                         DETAIL ROW 4: CONFIGURATION CARD
                         Only visible when SettingsJson is not null/empty
                         ======================================================= -->
                    <Border Grid.Row="4" Style="{StaticResource CardStyle}"
                            x:Name="DetailSettingsCard"
                            Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE713;" FontSize="16"
                                          Foreground="{ThemeResource TextAccentBrush}" />
                                <TextBlock x:Uid="Plugin_Configuration"
                                           Style="{StaticResource HeadingSmallStyle}" />
                            </StackPanel>

                            <Border Background="{ThemeResource InputBackgroundBrush}"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Padding="16,12"
                                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                                    BorderThickness="1">
                                <TextBlock x:Name="DetailSettingsJson"
                                           Style="{StaticResource MonoSmallStyle}"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           MaxLines="20" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- =======================================================
                         DETAIL ROW 5: DOCUMENTATION CARD
                         README / documentation rendered as Markdown.
                         Only visible when ReadmeContent is not null/empty.
                         ======================================================= -->
                    <Border Grid.Row="5" Style="{StaticResource CardStyle}"
                            x:Name="DetailDocumentationCard"
                            Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE736;" FontSize="16"
                                          Foreground="{ThemeResource AccentPrimaryBrush}" />
                                <TextBlock x:Uid="Plugin_Documentation"
                                           Style="{StaticResource LabelStyle}" />
                            </StackPanel>
                            <controls:MarkdownMessageControl x:Name="DetailReadmeContent" />
                        </StackPanel>
                    </Border>

                    <!-- =======================================================
                         DETAIL ROW 6: DANGER ZONE
                         Prominent uninstall action with warning messaging
                         ======================================================= -->
                    <Border Grid.Row="6"
                            Background="#0DEF4444"
                            BorderBrush="{ThemeResource ErrorSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLG}"
                            Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Uid="Plugin_DangerZone"
                                           Style="{StaticResource HeadingSmallStyle}"
                                           Foreground="{ThemeResource ErrorBrush}" />
                                <TextBlock x:Uid="Plugin_DangerZoneHint"
                                           Style="{StaticResource BodySmallStyle}"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           MaxWidth="480" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    x:Name="DetailUninstallButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnUninstallPluginClick"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"
                                              Foreground="{ThemeResource ErrorBrush}" />
                                    <TextBlock x:Uid="Plugin_UninstallButton"
                                               Foreground="{ThemeResource ErrorBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
