<Page
    x:Class="AgentX.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    xmlns:local="using:AgentX.App.Views"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>

        <!-- =============================================================
             CONVERTERS
             ============================================================= -->

        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />

    </Page.Resources>

    <!-- =============================================================
         ROOT LAYOUT: 2-column grid (results + history sidebar)
         ============================================================= -->

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <!-- Main search area -->
            <ColumnDefinition Width="*" />
            <!-- History sidebar -->
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- =============================================================
             COLUMN 0: MAIN SEARCH AREA
             ============================================================= -->

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <!-- Header + Search bar -->
                <RowDefinition Height="Auto" />
                <!-- Filter chips -->
                <RowDefinition Height="Auto" />
                <!-- Status bar -->
                <RowDefinition Height="Auto" />
                <!-- Results / Empty / No results -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ==========================================================
                 ROW 0: PAGE HEADER + SEARCH BAR
                 ========================================================== -->

            <Border Grid.Row="0"
                    Padding="32,24,32,16">
                <StackPanel Spacing="20" MaxWidth="900">

                    <!-- Page title row -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Search"
                                   Style="{StaticResource DisplaySmallStyle}" />
                        <TextBlock Text="Search across your entire document library using semantic AI, keywords, or both."
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <!-- Search bar -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search TextBox with icon -->
                        <Grid>
                            <TextBox x:Name="SearchInputBox"
                                     Style="{StaticResource ChatInputStyle}"
                                     PlaceholderText="Search your documents..."
                                     Text="{x:Bind ViewModel.QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="SearchInputBox_KeyDown"
                                     AcceptsReturn="False"
                                     MaxHeight="52"
                                     Padding="48,14,18,14" />

                            <!-- Search icon overlay -->
                            <FontIcon Glyph="&#xE721;"
                                      FontSize="18"
                                      Foreground="{StaticResource TextTertiaryBrush}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0"
                                      IsHitTestVisible="False" />
                        </Grid>

                        <!-- Search button -->
                        <Button Grid.Column="1"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="20,12,20,12"
                                MinHeight="52"
                                Command="{x:Bind ViewModel.SearchCommand}"
                                IsEnabled="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource InverseBool}}"
                                ToolTipService.ToolTip="Search (Enter)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <TextBlock Text="Search" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Clear button (visible when there's a query) -->
                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,12,12,12"
                                MinHeight="52"
                                Command="{x:Bind ViewModel.ClearSearchCommand}"
                                Visibility="{x:Bind ViewModel.QueryText, Mode=OneWay, Converter={StaticResource StringToVis}}"
                                ToolTipService.ToolTip="Clear search">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==========================================================
                 ROW 1: SEARCH MODE TOGGLE + FILTER CHIPS
                 ========================================================== -->

            <Border Grid.Row="1"
                    Padding="32,0,32,12">
                <StackPanel Spacing="12" MaxWidth="900">

                    <!-- Search Mode Toggle -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="SEARCH MODE"
                                   Style="{StaticResource OverlineStyle}" />
                        <Border Background="{StaticResource InputBackgroundBrush}"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="3"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <RadioButton x:Name="ModeSemanticBtn"
                                             Content="Semantic"
                                             Tag="Semantic"
                                             GroupName="SearchMode"
                                             IsChecked="True"
                                             Style="{StaticResource TabRadioButtonStyle}"
                                             Checked="OnSearchModeChanged"
                                             MinHeight="32"
                                             Padding="14,6,14,6"
                                             ToolTipService.ToolTip="Vector similarity search using AI embeddings" />
                                <RadioButton x:Name="ModeKeywordBtn"
                                             Content="Keyword"
                                             Tag="Keyword"
                                             GroupName="SearchMode"
                                             Style="{StaticResource TabRadioButtonStyle}"
                                             Checked="OnSearchModeChanged"
                                             MinHeight="32"
                                             Padding="14,6,14,6"
                                             ToolTipService.ToolTip="Full-text keyword search with BM25 ranking" />
                                <RadioButton x:Name="ModeHybridBtn"
                                             Content="Hybrid"
                                             Tag="Hybrid"
                                             GroupName="SearchMode"
                                             Style="{StaticResource TabRadioButtonStyle}"
                                             Checked="OnSearchModeChanged"
                                             MinHeight="32"
                                             Padding="14,6,14,6"
                                             ToolTipService.ToolTip="Combined semantic + keyword search for best results" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- File Type Filters -->
                    <TextBlock Text="FILE TYPE"
                               Style="{StaticResource OverlineStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">

                        <!-- All Types filter -->
                        <Button Content="All Types"
                                Click="OnFilterChipClick" Tag=""
                                Style="{StaticResource FilterChipActiveStyle}"
                                x:Name="FilterAll" />

                        <!-- PDF filter -->
                        <Button Click="OnFilterChipClick" Tag="pdf"
                                Style="{StaticResource FilterChipStyle}"
                                x:Name="FilterPdf">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xEA90;" FontSize="11" />
                                <TextBlock Text="PDF" />
                            </StackPanel>
                        </Button>

                        <!-- DOCX filter -->
                        <Button Click="OnFilterChipClick" Tag="docx"
                                Style="{StaticResource FilterChipStyle}"
                                x:Name="FilterDocx">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8A5;" FontSize="11" />
                                <TextBlock Text="DOCX" />
                            </StackPanel>
                        </Button>

                        <!-- Text filter -->
                        <Button Click="OnFilterChipClick" Tag="txt"
                                Style="{StaticResource FilterChipStyle}"
                                x:Name="FilterTxt">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8A4;" FontSize="11" />
                                <TextBlock Text="Text" />
                            </StackPanel>
                        </Button>

                        <!-- Code filter -->
                        <Button Click="OnFilterChipClick" Tag="code"
                                Style="{StaticResource FilterChipStyle}"
                                x:Name="FilterCode">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE943;" FontSize="11" />
                                <TextBlock Text="Code" />
                            </StackPanel>
                        </Button>

                        <!-- Markdown filter -->
                        <Button Click="OnFilterChipClick" Tag="md"
                                Style="{StaticResource FilterChipStyle}"
                                x:Name="FilterMd">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE943;" FontSize="11" />
                                <TextBlock Text="Markdown" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==========================================================
                 ROW 2: STATUS BAR
                 ========================================================== -->

            <Border Grid.Row="2"
                    Padding="32,0,32,12">
                <Grid MaxWidth="900">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status message -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- Loading spinner (visible during search) -->
                        <ProgressRing IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                                      Width="14" Height="14"
                                      Foreground="{StaticResource AccentPrimaryBrush}"
                                      Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource BodySmallStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Result count badge (visible when results exist) -->
                    <Border Grid.Column="2"
                            Style="{StaticResource BadgeDefaultStyle}"
                            Padding="8,3,8,3"
                            Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource MonoSmallStyle}"
                                   Foreground="{StaticResource TextTertiaryBrush}">
                            <Run Text="{x:Bind ViewModel.TotalResults, Mode=OneWay}" />
                            <Run Text="results" />
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- ==========================================================
                 ROW 3: CONTENT AREA (Results / Empty / No Results)
                 ========================================================== -->

            <Grid Grid.Row="3">

                <!-- ======================================================
                     EMPTY STATE: Initial state before any search
                     ====================================================== -->
                <Border Style="{StaticResource WelcomeCardStyle}"
                        Visibility="{x:Bind ShowEmptyState(ViewModel.HasResults, ViewModel.ShowNoResults, ViewModel.IsSearching), Mode=OneWay}">
                    <StackPanel Spacing="20" HorizontalAlignment="Center">

                        <!-- Icon -->
                        <Border Background="{StaticResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusRound}"
                                Width="72" Height="72"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE721;"
                                      FontSize="32"
                                      Foreground="{StaticResource TextAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="Search Your Documents"
                                       Style="{StaticResource HeadingMediumStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Search across your entire document library using natural language. Vector embeddings find semantically similar content even when the exact words differ."
                                       Style="{StaticResource BodySecondaryStyle}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="420" />
                        </StackPanel>

                        <!-- Keyboard hint badges -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center">
                            <Border Style="{StaticResource BadgeDefaultStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE765;" FontSize="10"
                                              Foreground="{StaticResource TextTertiaryBrush}" />
                                    <TextBlock Text="Enter to search"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource BadgeAccentStyle}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="Semantic AI Search"
                                           Style="{StaticResource CaptionStyle}"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ======================================================
                     NO RESULTS STATE
                     ====================================================== -->
                <Border Style="{StaticResource WelcomeCardStyle}"
                        Visibility="{x:Bind ViewModel.ShowNoResults, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">

                        <Border Background="#1AEF4444"
                                CornerRadius="{StaticResource RadiusRound}"
                                Width="64" Height="64"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE783;"
                                      FontSize="28"
                                      Foreground="{StaticResource ErrorBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="No Results Found"
                                       Style="{StaticResource HeadingMediumStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="380"
                                       HorizontalAlignment="Center">
                                <Run Text="No results found for '" /><Run Text="{x:Bind ViewModel.QueryText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="'. Try different keywords or broaden your filters." />
                            </TextBlock>
                        </StackPanel>

                        <Button Content="Clear Filters"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Center"
                                Click="OnClearFiltersClick" />
                    </StackPanel>
                </Border>

                <!-- ======================================================
                     SEARCH RESULTS LIST
                     ====================================================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ItemsRepeater x:Name="ResultsRepeater"
                                   ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                                   Margin="32,0,32,24">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchResultItem">
                                <Border Style="{StaticResource CardInteractiveStyle}"
                                        Padding="20">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <!-- File type icon -->
                                            <ColumnDefinition Width="Auto" />
                                            <!-- Content area -->
                                            <ColumnDefinition Width="*" />
                                            <!-- Score + Open button -->
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- File type icon -->
                                        <Border Style="{StaticResource FileTypeIconContainerStyle}"
                                                VerticalAlignment="Top">
                                            <FontIcon Glyph="{x:Bind FileTypeIcon}"
                                                      FontSize="22"
                                                      Foreground="{StaticResource TextAccentBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Content area -->
                                        <StackPanel Grid.Column="1" Spacing="8">

                                            <!-- File name + type badge row -->
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind FileName}"
                                                           Style="{StaticResource HeadingSmallStyle}"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis" />

                                                <Border Style="{StaticResource FileTypeBadgeStyle}">
                                                    <TextBlock Text="{x:Bind FileType}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextAccentBrush}"
                                                               CharacterSpacing="40" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Relevance score bar -->
                                            <Grid ColumnSpacing="8" Height="18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Relevance"
                                                           Style="{StaticResource CaptionStyle}"
                                                           VerticalAlignment="Center" />

                                                <!-- Score track background -->
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource InputBackgroundBrush}"
                                                        CornerRadius="{StaticResource RadiusRound}"
                                                        Height="6"
                                                        VerticalAlignment="Center">
                                                    <!-- Score fill bar (width set in code-behind via converter) -->
                                                    <Border CornerRadius="{StaticResource RadiusRound}"
                                                            Height="6"
                                                            HorizontalAlignment="Left"
                                                            Width="{x:Bind local:SearchPage.GetScoreWidth(RelevancePercent)}">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{x:Bind local:SearchPage.GetScoreColorValue(RelevancePercent)}" />
                                                        </Border.Background>
                                                    </Border>
                                                </Border>

                                                <TextBlock Grid.Column="2"
                                                           Style="{StaticResource MonoSmallStyle}"
                                                           VerticalAlignment="Center">
                                                    <Run Text="{x:Bind RelevancePercent}" /><Run Text="%" />
                                                </TextBlock>
                                            </Grid>

                                            <!-- Excerpt text -->
                                            <TextBlock Text="{x:Bind Excerpt}"
                                                       Style="{StaticResource BodySecondaryStyle}"
                                                       MaxLines="3"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Page/chunk info + Collection badges -->
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <!-- Page info (if available) -->
                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                            Visibility="{x:Bind local:SearchPage.PageNumberToVisibility(PageNumber)}">
                                                    <FontIcon Glyph="&#xE8A1;" FontSize="10"
                                                              Foreground="{StaticResource TextTertiaryBrush}" />
                                                    <TextBlock Style="{StaticResource CaptionStyle}">
                                                        <Run Text="Page" />
                                                        <Run Text="{x:Bind PageNumber}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Chunk ID -->
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE943;" FontSize="10"
                                                              Foreground="{StaticResource TextTertiaryBrush}" />
                                                    <TextBlock Style="{StaticResource CaptionStyle}">
                                                        <Run Text="Chunk" />
                                                        <Run Text="{x:Bind ChunkId}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Collection badges -->
                                            <ItemsRepeater ItemsSource="{x:Bind CollectionNames}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Horizontal" Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Style="{StaticResource TagBadgeStyle}">
                                                            <TextBlock Text="{x:Bind}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>

                                        </StackPanel>

                                        <!-- Score + Open button column -->
                                        <StackPanel Grid.Column="2"
                                                    Spacing="8"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Right">

                                            <!-- Open button -->
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Padding="10,6,10,6" MinHeight="32"
                                                    Tag="{x:Bind DocumentId}"
                                                    Click="OnOpenDocumentClick"
                                                    ToolTipService.ToolTip="Open in Explorer">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE8DA;" FontSize="12"
                                                              Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="Open"
                                                               Style="{StaticResource CaptionStyle}"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

            </Grid>

        </Grid>

        <!-- =============================================================
             COLUMN 1: SEARCH HISTORY SIDEBAR
             ============================================================= -->

        <Grid Grid.Column="1"
              Background="{StaticResource SidebarGradientBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Sidebar Header -->
            <Border Grid.Row="0" Style="{StaticResource SidebarHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE81C;" FontSize="14"
                                  Foreground="{StaticResource TextTertiaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Search History"
                                   Style="{StaticResource HeadingSmallStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="8,4,8,4" MinHeight="28"
                            Command="{x:Bind ViewModel.ClearHistoryCommand}"
                            ToolTipService.ToolTip="Clear search history">
                        <TextBlock Text="Clear"
                                   Style="{StaticResource CaptionStyle}"
                                   Foreground="{StaticResource TextAccentBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- History List -->
            <ListView Grid.Row="1"
                      x:Name="HistoryListView"
                      ItemsSource="{x:Bind ViewModel.SearchHistory, Mode=OneWay}"
                      SelectionMode="None"
                      Padding="8,4,8,4"
                      Background="Transparent"
                      IsItemClickEnabled="True"
                      ItemClick="OnHistoryItemClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchHistoryItem">
                        <Border Background="Transparent"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="12,10,12,10"
                                Margin="0,1,0,1">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE721;"
                                          FontSize="11"
                                          Foreground="{StaticResource TextTertiaryBrush}"
                                          VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind QueryText}"
                                               Style="{StaticResource BodySmallStyle}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Style="{StaticResource CaptionStyle}">
                                            <Run Text="{x:Bind ResultCount}" />
                                            <Run Text="results" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind SearchedAgo}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Opacity="0.6" />
                                    </StackPanel>
                                </StackPanel>

                                <FontIcon Grid.Column="2"
                                          Glyph="&#xE72A;"
                                          FontSize="10"
                                          Foreground="{StaticResource TextTertiaryBrush}"
                                          VerticalAlignment="Center"
                                          Opacity="0.5" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Sidebar Footer -->
            <Border Grid.Row="2"
                    Padding="16,10,16,10"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE81C;" FontSize="11"
                              Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Style="{StaticResource CaptionStyle}">
                        <Run Text="{x:Bind ViewModel.SearchHistory.Count, Mode=OneWay}" />
                        <Run Text="recent searches" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>
