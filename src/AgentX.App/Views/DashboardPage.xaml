<Page
    x:Class="AgentX.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    xmlns:controls="using:AgentX.App.Controls"
    x:Name="DashboardRoot"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:DoubleToStringConverter x:Key="DoubleToStringConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">

        <Grid Padding="{StaticResource PaddingPage}" RowSpacing="24" MaxWidth="1200" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==========================================================
                 ROW 0: PAGE HEADER
                 ========================================================== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock x:Uid="Dash_Title" Text="Dashboard"
                               Style="{StaticResource DisplaySmallStyle}" />
                    <TextBlock x:Uid="Dash_Subtitle" Text="Your private AI intelligence center. Everything runs on your machine."
                               Style="{StaticResource BodySecondaryStyle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        x:Uid="Dash_RefreshBtn" Content="Refresh"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- ==========================================================
                 ROW 1: AI CONNECTION STATUS (Hero Card)
                 ========================================================== -->
            <controls:Faceplate Grid.Row="1" Kicker="MOD - LINK - 01">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="10" Height="10"
                                     Fill="{ThemeResource OfflineBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}"
                                       Style="{StaticResource BodyStyle}"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.ActiveModelName, Mode=OneWay}"
                                   Style="{StaticResource HeadingLargeStyle}" />

                        <TextBlock x:Uid="Dash_ConnectOllamaHint" Text="Connect Ollama to unlock AI chat, semantic search, and file intelligence."
                                   Style="{StaticResource BodySecondaryStyle}"
                                   MaxWidth="500"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Uid="Dash_SetupAiBtn" Content="Setup AI"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.SetupAiCommand}" />
                </Grid>
            </controls:Faceplate>

            <!-- ==========================================================
                 ROW 2: QUICK SEARCH BAR
                 ========================================================== -->
            <!-- Quick search: a recessed dark well carved into the chassis -->
            <Border Grid.Row="2" Style="{StaticResource WellStyle}" Padding="16,6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE721;"
                              FontSize="18"
                              Foreground="{ThemeResource InputPlaceholderBrush}"
                              VerticalAlignment="Center" />

                    <TextBox Grid.Column="1"
                             x:Uid="Dash_SearchBox" PlaceholderText="Search your knowledge vault...  (Ctrl+K)"
                             Style="{StaticResource SearchInputStyle}"
                             Text="{x:Bind ViewModel.QuickSearchQuery, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent" />

                    <Border Grid.Column="2"
                            Background="{ThemeResource VoidBrush}"
                            BorderBrush="{ThemeResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusXS}"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="Ctrl+K"
                                   Style="{StaticResource TelemetrySmallStyle}"
                                   Foreground="{ThemeResource WellTextBrush}"
                                   Opacity="0.45" />
                    </Border>
                </Grid>
            </Border>

            <!-- ==========================================================
                 ROW 3: HERO STAT CARDS (4 columns with gradient icons)
                 ========================================================== -->
            <Grid Grid.Row="3" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Documents -->
                <controls:Faceplate Grid.Column="0" Kicker="MOD - DOCS - 02">
                    <Grid>                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F1;" FontSize="14"
                                          Foreground="{ThemeResource TextAccentBrush}" />
                                <TextBlock x:Uid="Dash_DocsOverline" Text="DOCUMENTS"
                                           Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <Border Style="{StaticResource WellStyle}" Padding="12,2" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.TotalDocuments, Mode=OneWay}"
                                           Style="{StaticResource MetricMediumStyle}"
                                           Foreground="{ThemeResource LcdPhosphorBrush}" />
                            </Border>
                            <TextBlock Style="{StaticResource CaptionStyle}">
                                <Run x:Uid="Dash_AcrossRun" Text="across " />
                                <Run Text="{x:Bind ViewModel.TotalCollections, Mode=OneWay}"
                                     FontWeight="SemiBold"
                                     Foreground="{ThemeResource TextSecondaryBrush}" />
                                <Run x:Uid="Dash_CollectionsRun" Text=" collections" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </controls:Faceplate>

                <!-- Card 2: Storage -->
                <controls:Faceplate Grid.Column="1" Kicker="MOD - STOR - 03">
                    <Grid>                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEDA2;" FontSize="14"
                                          Foreground="{ThemeResource InfoBrush}" />
                                <TextBlock x:Uid="Dash_StorageOverline" Text="STORAGE"
                                           Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <Border Style="{StaticResource WellStyle}" Padding="12,2" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.TotalStorageSize, Mode=OneWay}"
                                           Style="{StaticResource MetricMediumStyle}"
                                           Foreground="{ThemeResource LcdPhosphorBrush}" />
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource CaptionStyle}">
                                    <Run Text="{x:Bind ViewModel.IndexedPercent, Mode=OneWay}"
                                         FontWeight="SemiBold"
                                         Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <Run Text="% indexed" />
                                </TextBlock>
                                <controls:SegmentMeter Value="{x:Bind ViewModel.IndexedPercent, Mode=OneWay}"
                                                       Maximum="100"
                                                       AutomationProperties.Name="Indexed percent" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </controls:Faceplate>

                <!-- Card 3: AI Sessions -->
                <controls:Faceplate Grid.Column="2" Kicker="MOD - SESS - 04">
                    <Grid>                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8BD;" FontSize="14"
                                          Foreground="{ThemeResource WarningBrush}" />
                                <TextBlock x:Uid="Dash_AiSessionsOverline" Text="AI SESSIONS"
                                           Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <Border Style="{StaticResource WellStyle}" Padding="12,2" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.TotalConversations, Mode=OneWay}"
                                           Style="{StaticResource MetricMediumStyle}"
                                           Foreground="{ThemeResource LcdPhosphorBrush}" />
                            </Border>
                            <TextBlock Style="{StaticResource CaptionStyle}">
                                <Run Text="{x:Bind ViewModel.TotalTokensUsed, Mode=OneWay}"
                                     FontWeight="SemiBold"
                                     Foreground="{ThemeResource TextSecondaryBrush}" />
                                <Run x:Uid="Dash_TokensUsedRun" Text=" tokens used" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </controls:Faceplate>

                <!-- Card 4: System -->
                <controls:Faceplate Grid.Column="3" Kicker="MOD - SYS - 05">
                    <Grid>                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE964;" FontSize="14"
                                          Foreground="{ThemeResource SuccessBrush}" />
                                <TextBlock x:Uid="Dash_SystemOverline" Text="SYSTEM"
                                           Style="{StaticResource OverlineStyle}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.GpuName, Mode=OneWay}"
                                       Style="{StaticResource HeadingSmallStyle}"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.TotalRamInfo, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.GpuVramInfo, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </controls:Faceplate>
            </Grid>

            <!-- ==========================================================
                 ROW 4: OPERATIONS OVERVIEW
                 ========================================================== -->
            <StackPanel Grid.Row="4" Spacing="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Dash_OpsOverviewTitle" Text="Operations Overview"
                                   Style="{StaticResource HeadingMediumStyle}" />
                        <TextBlock x:Uid="Dash_OpsOverviewSubtitle" Text="Conversation intelligence, sync posture, connectors, ingestion backlog, and workflow activity from one surface."
                                   Style="{StaticResource BodySecondaryStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Uid="Dash_OpenOperationsBtn" Content="Open Operations"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.NavigateToOperationsCommand}"
                            VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:Faceplate Grid.Row="0" Grid.Column="0" MinHeight="196" Kicker="MOD - INTEL - 06">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9D2;" FontSize="14"
                                              Foreground="{ThemeResource TextAccentBrush}" />
                                    <TextBlock x:Uid="Dash_ConvIntelOverline" Text="CONVERSATION INTELLIGENCE"
                                               Style="{StaticResource OverlineStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.ConversationIntelligenceHeadline, Mode=OneWay}"
                                           Style="{StaticResource HeadingSmallStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.ConversationIntelligenceStatus, Mode=OneWay}"
                                           Style="{StaticResource BodyStyle}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.ConversationIntelligenceDetail, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Row="2"
                                    x:Uid="Dash_OpenAnalyticsBtn" Content="Open Analytics"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="8,4"
                                    FontSize="12"
                                    Command="{x:Bind ViewModel.NavigateToAnalyticsCommand}" />
                        </Grid>
                    </controls:Faceplate>

                    <controls:Faceplate Grid.Row="0" Grid.Column="1" MinHeight="196" Kicker="MOD - SYNC - 07">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE895;" FontSize="14"
                                              Foreground="{ThemeResource InfoBrush}" />
                                    <TextBlock x:Uid="Dash_SyncHealthOverline" Text="SYNC HEALTH"
                                               Style="{StaticResource OverlineStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.SyncHealthHeadline, Mode=OneWay}"
                                           Style="{StaticResource HeadingSmallStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SyncHealthStatus, Mode=OneWay}"
                                           Style="{StaticResource BodyStyle}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.SyncHealthDetail, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Row="2"
                                    x:Uid="Dash_OpenSyncBtn" Content="Open Sync"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="8,4"
                                    FontSize="12"
                                    Command="{x:Bind ViewModel.NavigateToSyncSettingsCommand}" />
                        </Grid>
                    </controls:Faceplate>

                    <controls:Faceplate Grid.Row="0" Grid.Column="2" MinHeight="196" Kicker="MOD - PLUG - 08">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE943;" FontSize="14"
                                              Foreground="{ThemeResource SuccessBrush}" />
                                    <TextBlock x:Uid="Dash_ConnectorsOverline" Text="CONNECTORS &amp; PLUGINS"
                                               Style="{StaticResource OverlineStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.ConnectorsHeadline, Mode=OneWay}"
                                           Style="{StaticResource HeadingSmallStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.ConnectorsStatus, Mode=OneWay}"
                                           Style="{StaticResource BodyStyle}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.ConnectorsDetail, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Row="2"
                                    x:Uid="Dash_OpenPluginsBtn" Content="Open Plugins"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="8,4"
                                    FontSize="12"
                                    Command="{x:Bind ViewModel.NavigateToPluginManagerCommand}" />
                        </Grid>
                    </controls:Faceplate>

                    <controls:Faceplate Grid.Row="1" Grid.Column="0" MinHeight="196" Kicker="MOD - INBOX - 09">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14"
                                              Foreground="{ThemeResource WarningBrush}" />
                                    <TextBlock x:Uid="Dash_IngestionOverline" Text="INGESTION BACKLOG"
                                               Style="{StaticResource OverlineStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.InboxHeadline, Mode=OneWay}"
                                           Style="{StaticResource HeadingSmallStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.InboxStatus, Mode=OneWay}"
                                           Style="{StaticResource BodyStyle}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.InboxDetail, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Row="2"
                                    x:Uid="Dash_OpenInboxBtn" Content="Open Inbox"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="8,4"
                                    FontSize="12"
                                    Command="{x:Bind ViewModel.NavigateToInboxCommand}" />
                        </Grid>
                    </controls:Faceplate>

                    <controls:Faceplate Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" MinHeight="196" Kicker="MOD - WFLOW - 10">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C7;" FontSize="14"
                                              Foreground="{ThemeResource SuccessBrush}" />
                                    <TextBlock x:Uid="Dash_WorkflowOverline" Text="WORKFLOW ACTIVITY"
                                               Style="{StaticResource OverlineStyle}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.WorkflowHeadline, Mode=OneWay}"
                                           Style="{StaticResource HeadingSmallStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.WorkflowStatus, Mode=OneWay}"
                                           Style="{StaticResource BodyStyle}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Style="{StaticResource BadgeDefaultStyle}">
                                        <TextBlock Text="{x:Bind ViewModel.WorkflowRecentActivity, Mode=OneWay}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource BadgeDefaultStyle}">
                                        <TextBlock Text="{x:Bind ViewModel.WorkflowAverageDuration, Mode=OneWay}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.WorkflowDetail, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Row="2"
                                    x:Uid="Dash_OpenWorkflowsBtn" Content="Open Workflows"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="8,4"
                                    FontSize="12"
                                    Command="{x:Bind ViewModel.NavigateToWorkflowsCommand}" />
                        </Grid>
                    </controls:Faceplate>
                </Grid>
            </StackPanel>

            <!-- ==========================================================
                 ROW 5: RECENT ACTIVITY (2 columns)
                 ========================================================== -->
            <Grid Grid.Row="5" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Recent Documents -->
                <controls:Faceplate Grid.Column="0" Kicker="MOD - RDOC - 11">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8F1;" FontSize="16"
                                          Foreground="{ThemeResource TextAccentBrush}" />
                                <TextBlock x:Uid="Dash_RecentDocsTitle" Text="Recent Documents"
                                           Style="{StaticResource HeadingSmallStyle}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    x:Uid="Dash_ViewAllDocsBtn" Content="View All"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="8,4"
                                    FontSize="12"
                                    Command="{x:Bind ViewModel.NavigateToVaultCommand}" />
                        </Grid>

                        <!-- Empty state -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasRecentDocuments, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    Padding="0,16">
                            <FontIcon Glyph="&#xE8F1;" FontSize="32"
                                      Foreground="{ThemeResource TextTertiaryBrush}"
                                      HorizontalAlignment="Center"
                                      Opacity="0.4" />
                            <TextBlock x:Uid="Dash_NoDocsTitle" Text="No documents imported yet"
                                       Style="{StaticResource BodySecondaryStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Uid="Dash_NoDocsHint" Text="Import files to start building your knowledge vault"
                                       Style="{StaticResource CaptionStyle}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Document list -->
                        <ItemsRepeater Visibility="{x:Bind ViewModel.HasRecentDocuments, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                       ItemsSource="{x:Bind ViewModel.RecentDocuments, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardRecentDocumentItem">
                                    <Border Background="Transparent"
                                            CornerRadius="{StaticResource RadiusMD}"
                                            Padding="12,10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- File type icon -->
                                            <Border Width="32" Height="32"
                                                    CornerRadius="{StaticResource RadiusMD}"
                                                    Background="{ThemeResource AccentSubtleBrush}">
                                                <FontIcon Glyph="{x:Bind FileTypeIcon}"
                                                          FontSize="14"
                                                          Foreground="{ThemeResource TextAccentBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>

                                            <!-- File name and metadata -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind FileName}"
                                                           Style="{StaticResource BodyStyle}"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource CaptionStyle}">
                                                    <Run Text="{x:Bind FileType}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{x:Bind FileSize}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Time ago -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind ImportedAgo}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </controls:Faceplate>

                <!-- Recent Conversations -->
                <controls:Faceplate Grid.Column="1" Kicker="MOD - RCNV - 12">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8BD;" FontSize="16"
                                          Foreground="{ThemeResource WarningBrush}" />
                                <TextBlock x:Uid="Dash_RecentConvTitle" Text="Recent Conversations"
                                           Style="{StaticResource HeadingSmallStyle}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    x:Uid="Dash_ViewAllConvBtn" Content="View All"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="8,4"
                                    FontSize="12"
                                    Command="{x:Bind ViewModel.NavigateToChatCommand}" />
                        </Grid>

                        <!-- Empty state -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasRecentConversations, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    Padding="0,16">
                            <FontIcon Glyph="&#xE8BD;" FontSize="32"
                                      Foreground="{ThemeResource TextTertiaryBrush}"
                                      HorizontalAlignment="Center"
                                      Opacity="0.4" />
                            <TextBlock x:Uid="Dash_NoConvTitle" Text="No conversations yet"
                                       Style="{StaticResource BodySecondaryStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Uid="Dash_NoConvHint" Text="Start a chat to see your conversations here"
                                       Style="{StaticResource CaptionStyle}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Conversation list -->
                        <ItemsRepeater Visibility="{x:Bind ViewModel.HasRecentConversations, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                       ItemsSource="{x:Bind ViewModel.RecentConversations, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardRecentConversationItem">
                                    <Border Background="Transparent"
                                            CornerRadius="{StaticResource RadiusMD}"
                                            Padding="12,10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Chat icon -->
                                            <Border Width="32" Height="32"
                                                    CornerRadius="{StaticResource RadiusMD}"
                                                    Background="{ThemeResource AccentSubtleBrush}">
                                                <FontIcon Glyph="&#xE8BD;"
                                                          FontSize="14"
                                                          Foreground="{ThemeResource WarningBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Title and preview -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}"
                                                           Style="{StaticResource BodyStyle}"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Preview}"
                                                           Style="{StaticResource CaptionStyle}"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Time ago and message count -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                        HorizontalAlignment="Right" Spacing="2">
                                                <TextBlock Text="{x:Bind TimeAgo}"
                                                           Style="{StaticResource CaptionStyle}"
                                                           HorizontalAlignment="Right" />
                                                <Border Style="{StaticResource BadgeDefaultStyle}"
                                                        Padding="6,2"
                                                        HorizontalAlignment="Right">
                                                    <TextBlock Style="{StaticResource CaptionStyle}" FontSize="10">
                                                        <Run Text="{x:Bind MessageCount}" />
                                                        <Run x:Uid="Dash_MsgsRun" Text=" msgs" />
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </controls:Faceplate>
            </Grid>

            <!-- ==========================================================
                 ROW 6: KNOWLEDGE INSIGHTS (2 columns)
                 ========================================================== -->
            <Grid Grid.Row="6" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- File Type Distribution -->
                <controls:Faceplate Grid.Column="0" Kicker="MOD - TYPE - 13">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9D9;" FontSize="16"
                                      Foreground="{ThemeResource InfoBrush}" />
                            <TextBlock x:Uid="Dash_FileTypesTitle" Text="File Type Distribution"
                                       Style="{StaticResource HeadingSmallStyle}" />
                        </StackPanel>

                        <!-- Empty state -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasFileTypeData, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    Padding="0,16">
                            <FontIcon Glyph="&#xE9D9;" FontSize="28"
                                      Foreground="{ThemeResource TextTertiaryBrush}"
                                      HorizontalAlignment="Center"
                                      Opacity="0.4" />
                            <TextBlock x:Uid="Dash_NoDataYet" Text="No data yet"
                                       Style="{StaticResource BodySecondaryStyle}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- File type bars -->
                        <ItemsRepeater Visibility="{x:Bind ViewModel.HasFileTypeData, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                       ItemsSource="{x:Bind ViewModel.FileTypeBreakdown, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="10" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardFileTypeBreakdownItem">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- File type label -->
                                        <TextBlock Text="{x:Bind FileType}"
                                                   Style="{StaticResource LabelStyle}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />

                                        <!-- Bar track with filled bar using ProgressBar -->
                                        <ProgressBar Grid.Column="1"
                                                     Value="{x:Bind Percentage}"
                                                     Maximum="100"
                                                     MinHeight="18"
                                                     MaxHeight="18"
                                                     CornerRadius="{StaticResource RadiusSM}"
                                                     Background="{ThemeResource CardPressedBrush}"
                                                     Foreground="{ThemeResource AccentPrimaryBrush}" />

                                        <!-- Percentage + Count -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal" Spacing="4"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind PercentageLabel}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind CountLabel}"
                                                       Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </controls:Faceplate>

                <!-- Top Collections -->
                <controls:Faceplate Grid.Column="1" Kicker="MOD - COLL - 14">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xF168;" FontSize="16"
                                      Foreground="{ThemeResource SuccessBrush}" />
                            <TextBlock x:Uid="Dash_TopCollectionsTitle" Text="Top Collections"
                                       Style="{StaticResource HeadingSmallStyle}" />
                        </StackPanel>

                        <!-- Empty state -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasCollectionData, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
                                    Spacing="8"
                                    HorizontalAlignment="Center"
                                    Padding="0,16">
                            <FontIcon Glyph="&#xF168;" FontSize="28"
                                      Foreground="{ThemeResource TextTertiaryBrush}"
                                      HorizontalAlignment="Center"
                                      Opacity="0.4" />
                            <TextBlock x:Uid="Dash_NoCollectionsYet" Text="No collections yet"
                                       Style="{StaticResource BodySecondaryStyle}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Collection bars -->
                        <ItemsRepeater Visibility="{x:Bind ViewModel.HasCollectionData, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                       ItemsSource="{x:Bind ViewModel.TopCollections, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="10" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardTopCollectionItem">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource BodyStyle}"
                                                       FontSize="13"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind CountLabel}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </Grid>

                                        <!-- Bar using ProgressBar for simplicity and theme compliance -->
                                        <ProgressBar Value="{x:Bind BarWidthPercent}"
                                                     Maximum="100"
                                                     MinHeight="8"
                                                     MaxHeight="8"
                                                     CornerRadius="{StaticResource RadiusSM}"
                                                     Background="{ThemeResource CardPressedBrush}"
                                                     Foreground="{ThemeResource SuccessBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </controls:Faceplate>
            </Grid>

            <!-- ==========================================================
                 ROW 7: BELIEF CONFLICTS (Temporal Identity)
                 ========================================================== -->
            <controls:Faceplate Grid.Row="7" Kicker="MOD - TID - 15">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon with subtle glow -->
                    <Grid Width="48" Height="48" VerticalAlignment="Top">
                        <Border CornerRadius="{StaticResource RadiusMD}"
                                Background="{ThemeResource WarningSubtleBrush}"
                                Width="48" Height="48">
                            <FontIcon Glyph="&#xE946;"
                                      FontSize="20"
                                      Foreground="{ThemeResource WarningBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <!-- Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Uid="Dash_BeliefTitle" Text="Your Belief Evolution"
                                           Style="{StaticResource HeadingMediumStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.BeliefConflictsDetail, Mode=OneWay}"
                                           Style="{StaticResource BodySecondaryStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Border Style="{StaticResource BadgeWarningStyle}"
                                        Visibility="{x:Bind ViewModel.HasBeliefConflicts, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{x:Bind ViewModel.BeliefConflictsHeadline, Mode=OneWay}"
                                               Style="{StaticResource BadgeStyle}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Conflicts List -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.BeliefConflicts, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.HasBeliefConflicts, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:BeliefConflictDisplayItem">
                                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="16">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind Topic}"
                                                           Style="{StaticResource BodyStrongStyle}" />

                                                <TextBlock Grid.Column="1"
                                                           Style="{StaticResource CaptionStyle}"
                                                           Foreground="{ThemeResource WarningBrush}">
                                                    <Run x:Uid="Dash_MagnitudeRun" Text="Magnitude: " />
                                                    <Run Text="{x:Bind ConflictMagnitude, Mode=OneWay, Converter={StaticResource DoubleToStringConverter}}" />
                                                </TextBlock>
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                                       Style="{StaticResource BodySecondaryStyle}"
                                                       TextWrapping="Wrap">
                                                <Run x:Uid="Dash_PreviouslyRun" Text="Previously: " />
                                                <Run Text="{x:Bind PreviousStance, Mode=OneWay}"
                                                     Foreground="{ThemeResource TextSecondaryBrush}"
                                                     FontSize="11" />
                                            </TextBlock>

                                            <TextBlock Grid.Row="2"
                                                       Style="{StaticResource BodySecondaryStyle}"
                                                       TextWrapping="Wrap">
                                                <Run x:Uid="Dash_CurrentlyRun" Text="Currently: " />
                                                <Run Text="{x:Bind CurrentStance, Mode=OneWay}"
                                                     Foreground="{ThemeResource TextPrimaryBrush}"
                                                     FontWeight="SemiBold" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Empty State -->
                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind ViewModel.HasBeliefConflicts, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
                                    Padding="0,8">
                            <TextBlock x:Uid="Dash_NoBeliefTitle" Text="No belief evolution detected yet."
                                       Style="{StaticResource BodySecondaryStyle}" />
                            <TextBlock x:Uid="Dash_NoBeliefHint" Text="As you use the app, it will track when your views on topics evolve over time."
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <!-- Action Button -->
                        <Button x:Uid="Dash_ExplorePastSelfBtn" Content="Explore Past Self"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{x:Bind ViewModel.NavigateToPastSelfCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </controls:Faceplate>

            <!-- ==========================================================
                 ROW 8: RECOMMENDED NEXT STEPS + QUICK LAUNCH
                 ========================================================== -->
            <StackPanel Grid.Row="8" Spacing="16">
                <controls:Faceplate Kicker="MOD - NEXT - 16">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="Dash_NextStepsTitle" Text="Recommended Next Steps"
                                           Style="{StaticResource HeadingMediumStyle}" />
                                <TextBlock x:Uid="Dash_NextStepsSubtitle" Text="The highest-leverage actions based on your current AI readiness, intake pressure, sync posture, and workflow momentum."
                                           Style="{StaticResource BodySecondaryStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource BadgeDefaultStyle}"
                                    VerticalAlignment="Top"
                                    Visibility="{x:Bind ViewModel.HasRecommendedActions, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{x:Bind ViewModel.RecommendedActions.Count, Mode=OneWay}"
                                           Style="{StaticResource BadgeStyle}" />
                            </Border>
                        </Grid>

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecommendedActions, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="260"
                                                   MinItemHeight="0"
                                                   MinColumnSpacing="12"
                                                   MinRowSpacing="12"
                                                   ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardRecommendedActionItem">
                                    <Border Style="{StaticResource CardInsetStyle}"
                                            Padding="16,14">
                                        <Grid RowSpacing="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="36"
                                                        Height="36"
                                                        CornerRadius="{StaticResource RadiusMD}"
                                                        Background="{ThemeResource AccentSubtleBrush}">
                                                    <FontIcon Glyph="{x:Bind IconGlyph}"
                                                              FontSize="15"
                                                              Foreground="{ThemeResource TextAccentBrush}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Title}"
                                                           Style="{StaticResource BodyStyle}"
                                                           FontWeight="SemiBold"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="WrapWholeWords" />

                                                <Border Grid.Column="2"
                                                        Style="{StaticResource BadgeDefaultStyle}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind CategoryLabel}"
                                                               Style="{StaticResource BadgeStyle}" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Row="1"
                                                       Text="{x:Bind Detail}"
                                                       Style="{StaticResource BodySecondaryStyle}"
                                                       TextWrapping="WrapWholeWords" />

                                            <Button Grid.Row="2"
                                                    Command="{Binding ViewModel.OpenRecommendedActionCommand, ElementName=DashboardRoot}"
                                                    CommandParameter="{Binding}"
                                                    Content="{x:Bind CommandText}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    HorizontalAlignment="Left"
                                                    Padding="12,8"
                                                    FontSize="12" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </controls:Faceplate>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- New Chat -->
                    <Button Grid.Column="0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="16,14"
                            Command="{x:Bind ViewModel.NavigateToChatCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8BD;" FontSize="16"
                                      Foreground="{ThemeResource TextAccentBrush}" />
                            <TextBlock x:Uid="Dash_NewChatLabel" Text="New Chat"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Import Files -->
                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="16,14"
                            Command="{x:Bind ViewModel.NavigateToVaultCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8B5;" FontSize="16"
                                      Foreground="{ThemeResource InfoBrush}" />
                            <TextBlock x:Uid="Dash_ImportFilesLabel" Text="Import Files"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Search -->
                    <Button Grid.Column="2"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="16,14"
                            Command="{x:Bind ViewModel.NavigateToSearchCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE721;" FontSize="16"
                                      Foreground="{ThemeResource SuccessBrush}" />
                            <TextBlock x:Uid="Dash_SearchLabel" Text="Search"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Ask Files -->
                    <Button Grid.Column="3"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="16,14"
                            Command="{x:Bind ViewModel.NavigateToAskFilesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE9D9;" FontSize="16"
                                      Foreground="{ThemeResource WarningBrush}" />
                            <TextBlock x:Uid="Dash_AskFilesLabel" Text="Ask Files"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- ==========================================================
                 ROW 9: SYSTEM INFO (compact horizontal bar)
                 ========================================================== -->
            <controls:Faceplate Grid.Row="9" StripeVisibility="Collapsed" BoltsVisibility="Collapsed">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- GPU -->
                    <Grid Grid.Column="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE964;" FontSize="14"
                                  Foreground="{ThemeResource TextTertiaryBrush}"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="GPU" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.GpuName, Mode=OneWay}"
                                       Style="{StaticResource BodySmallStyle}"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="1" Width="1"
                            Background="{ThemeResource BorderSubtleBrush}" />

                    <!-- RAM -->
                    <Grid Grid.Column="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE950;" FontSize="14"
                                  Foreground="{ThemeResource TextTertiaryBrush}"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="Dash_AvailableRamLabel" Text="Available RAM" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.AvailableRam, Mode=OneWay}"
                                       Style="{StaticResource BodySmallStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="3" Width="1"
                            Background="{ThemeResource BorderSubtleBrush}" />

                    <!-- Vault Storage -->
                    <Grid Grid.Column="4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEDA2;" FontSize="14"
                                  Foreground="{ThemeResource TextTertiaryBrush}"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="Dash_VaultStorageLabel" Text="Vault Storage" Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalStorageSize, Mode=OneWay}"
                                       Style="{StaticResource BodySmallStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </controls:Faceplate>

            <!-- ==========================================================
                 ROW 10: PRIVACY FOOTER
                 ========================================================== -->
            <!-- Privacy annunciator: a dark module row in both shifts
                 (DESIGN.md annunciator alerts) with an LED dot carrying
                 the posture - green LOCAL, amber when cloud is opted in. -->
            <Border Grid.Row="10"
                    Style="{StaticResource WellStyle}"
                    Padding="20,14">
                <Grid>
                    <!-- Fully local: the strong privacy assurance is accurate. -->
                    <StackPanel Orientation="Horizontal" Spacing="12"
                                Visibility="{x:Bind ViewModel.IsFullyPrivate, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Ellipse Style="{StaticResource LedDotStyle}"
                                 Fill="{ThemeResource LedGoLampBrush}"
                                 VerticalAlignment="Top"
                                 Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource BodySmallStyle}"
                                   Foreground="{ThemeResource WellTextSecondaryBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="{x:Bind ViewModel.PrivacyTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource WellTextBrush}" />
                            <Run Text=" - " />
                            <Run Text="{x:Bind ViewModel.PrivacySummary, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Cloud services active: accurate, itemized disclosure of what leaves the machine. -->
                    <StackPanel Spacing="10"
                                Visibility="{x:Bind ViewModel.IsFullyPrivate, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Ellipse Style="{StaticResource LedDotStyle}"
                                     Fill="{ThemeResource LedHoldLampBrush}"
                                     VerticalAlignment="Top"
                                     Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource BodySmallStyle}"
                                       Foreground="{ThemeResource WellTextSecondaryBrush}"
                                       TextWrapping="Wrap">
                                <Run Text="{x:Bind ViewModel.PrivacyTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource WellTextBrush}" />
                                <Run Text=" - " />
                                <Run Text="{x:Bind ViewModel.PrivacySummary, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.PrivacyDisclosures, Mode=OneWay}"
                                       Margin="26,0,0,0">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardPrivacyDisclosureItem">
                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                               Foreground="{ThemeResource WellTextSecondaryBrush}"
                                               TextWrapping="Wrap">
                                        <Run Text="{x:Bind Surface}" FontWeight="SemiBold" Foreground="{ThemeResource WellTextBrush}" />
                                        <Run Text=" - " />
                                        <Run Text="{x:Bind Detail}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>
