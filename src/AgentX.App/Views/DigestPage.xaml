<Page
    x:Class="AgentX.App.Views.DigestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AgentX.App.Controls"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             COLUMN 0: MAIN CONTENT
             ═══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0">

            <Grid Padding="{StaticResource PaddingPage}" RowSpacing="24" MaxWidth="1200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Row 0: Header -->
                    <RowDefinition Height="Auto" /> <!-- Row 1: Stats bar -->
                    <RowDefinition Height="Auto" /> <!-- Row 2: Main content sections -->
                </Grid.RowDefinitions>

                <!-- ═══════════════════════════════════════════════════════
                     ROW 0: PAGE HEADER
                     ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Digest_WeeklyDigest" Text="Weekly Digest"
                                   Style="{StaticResource DisplaySmallStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">

                        <!-- Period display -->
                        <Border Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource BadgeDefaultStyle}"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE787;" FontSize="12"
                                          Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentReport.PeriodFormatted, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Generate button -->
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.GenerateDigestCommand}"
                                IsEnabled="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                AutomationProperties.LabeledBy="{x:Bind GenerateNewDigestLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsGenerating, Mode=OneWay}"
                                              Width="14" Height="14"
                                              Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <FontIcon Glyph="&#xE9D2;" FontSize="14"
                                          Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBlock x:Name="GenerateNewDigestLabel" x:Uid="Digest_GenerateNewDigest" Text="Generate New Digest" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════
                     ROW 1: STATS BAR (4 columns)
                     ═══════════════════════════════════════════════════════ -->
                <StackPanel Grid.Row="1"
                            Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="12">

                        <!-- New Documents -->
                        <Border Style="{StaticResource StatBadgeStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="{ThemeResource AccentSubtleBrush}"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Width="40" Height="40">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="18"
                                              Foreground="{ThemeResource TextAccentBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource MetricSmallStyle}">
                                        <Run Text="{x:Bind ViewModel.CurrentReport.NewDocumentsCount, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock x:Uid="Digest_NewDocuments" Text="New Documents"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- New Conversations -->
                        <Border Style="{StaticResource StatBadgeStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="{ThemeResource InfoSubtleBrush}"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Width="40" Height="40">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="18"
                                              Foreground="{ThemeResource InfoBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource MetricSmallStyle}">
                                        <Run Text="{x:Bind ViewModel.CurrentReport.NewConversationsCount, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock x:Uid="Digest_Conversations" Text="Conversations"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Searches -->
                        <Border Style="{StaticResource StatBadgeStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="{ThemeResource WarningSubtleBrush}"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Width="40" Height="40">
                                    <FontIcon Glyph="&#xE721;" FontSize="18"
                                              Foreground="{ThemeResource WarningBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource MetricSmallStyle}">
                                        <Run Text="{x:Bind ViewModel.CurrentReport.TotalSearches, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock x:Uid="Digest_Searches" Text="Searches"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Tokens Used -->
                        <Border Style="{StaticResource StatBadgeStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="{ThemeResource SuccessSubtleBrush}"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Width="40" Height="40">
                                    <FontIcon Glyph="&#xE945;" FontSize="18"
                                              Foreground="{ThemeResource SuccessBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentReport.TokensFormatted, Mode=OneWay}"
                                               Style="{StaticResource MetricSmallStyle}" />
                                    <TextBlock x:Uid="Digest_TokensUsed" Text="Tokens Used"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Storage Delta -->
                        <Border Style="{StaticResource StatBadgeStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="{ThemeResource GraphTagSubtleBrush}"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Width="40" Height="40">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="18"
                                              Foreground="{ThemeResource GraphTagBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentReport.StorageDelta, Mode=OneWay}"
                                               Style="{StaticResource MetricSmallStyle}" />
                                    <TextBlock x:Uid="Digest_StorageDelta" Text="Storage Delta"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════
                     ROW 2: MAIN CONTENT SECTIONS
                     ═══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="2">

                    <!-- Loading state -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Center"
                                Spacing="12"
                                Margin="0,48,0,48">
                        <ProgressRing IsActive="True" Width="32" Height="32"
                                      Foreground="{ThemeResource AccentPrimaryBrush}" />
                        <TextBlock x:Uid="Digest_LoadingDigestReports" Text="Loading digest reports..."
                                   Style="{StaticResource BodySecondaryStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Empty state (no reports) -->
                    <controls:Faceplate Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" Padding="48,64" Margin="0,0,0,24" Kicker="MOD - DIG - 01">
                        <StackPanel HorizontalAlignment="Center" Spacing="16">
                            <Border Background="{ThemeResource AccentSubtleBrush}"
                                    CornerRadius="{StaticResource RadiusFull}"
                                    Width="72" Height="72"
                                    HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE9D2;" FontSize="32"
                                          Foreground="{ThemeResource TextAccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Uid="Digest_NoDigestReportsYet" Text="No Digest Reports Yet"
                                       Style="{StaticResource HeadingMediumStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Uid="Digest_GenerateYourFirstWeekly" Text="Generate your first weekly digest to see activity summaries, search trends, and conversation highlights."
                                       Style="{StaticResource BodySecondaryStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="420" />
                            <Button Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.GenerateDigestCommand}"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0"
                                    AutomationProperties.LabeledBy="{x:Bind GenerateFirstDigestLabel}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9D2;" FontSize="14" />
                                    <TextBlock x:Name="GenerateFirstDigestLabel" x:Uid="Digest_GenerateFirstDigest" Text="Generate First Digest" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:Faceplate>

                    <!-- Report content (when a report exists) -->
                    <StackPanel Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Spacing="20">

                        <!-- ─── Row: Top Searches + Top Collections ─── -->
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Top Searches Section -->
                            <controls:Faceplate Grid.Column="0" Kicker="MOD - DIG - 02">
                                <StackPanel Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Background="{ThemeResource WarningSubtleBrush}"
                                                CornerRadius="{StaticResource RadiusMD}"
                                                Width="32" Height="32">
                                            <FontIcon Glyph="&#xE721;" FontSize="14"
                                                      Foreground="{ThemeResource WarningBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Uid="Digest_TopSearches" Text="Top Searches"
                                                   Style="{StaticResource HeadingSmallStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Style="{StaticResource SeparatorStyle}" Margin="0" />

                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.CurrentReport.TopSearches, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TopSearchItem">
                                                <Grid Padding="4,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind Query}"
                                                                   Style="{StaticResource BodyStyle}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind TrendLabel}"
                                                                   Style="{StaticResource CaptionStyle}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource BadgeAccentStyle}"
                                                            Padding="8,2">
                                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                                   Foreground="{ThemeResource TextAccentBrush}">
                                                            <Run Text="{x:Bind Count}" />
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>

                                    <!-- Empty state for no searches -->
                                    <TextBlock x:Uid="Digest_NoSearchesRecordedThis" Text="No searches recorded this period"
                                               Style="{StaticResource CaptionStyle}"
                                               HorizontalAlignment="Center"
                                               Margin="0,8" />
                                </StackPanel>
                            </controls:Faceplate>

                            <!-- Top Collections Section -->
                            <controls:Faceplate Grid.Column="1" Kicker="MOD - DIG - 03">
                                <StackPanel Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Background="{ThemeResource InfoSubtleBrush}"
                                                CornerRadius="{StaticResource RadiusMD}"
                                                Width="32" Height="32">
                                            <FontIcon Glyph="&#xF168;" FontSize="14"
                                                      Foreground="{ThemeResource InfoBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Uid="Digest_TopCollections" Text="Top Collections"
                                                   Style="{StaticResource HeadingSmallStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Style="{StaticResource SeparatorStyle}" Margin="0" />

                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.CurrentReport.TopCollections, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TopCollectionItem">
                                                <Grid Padding="4,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind Name}"
                                                                   Style="{StaticResource BodyStyle}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind TrendLabel}"
                                                                   Style="{StaticResource CaptionStyle}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Style="{StaticResource CaptionStyle}">
                                                        <Run Text="{x:Bind DocumentCount}" />
                                                        <Run x:Uid="Digest_Docs" Text=" docs" />
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>

                                    <!-- Empty state for no collections -->
                                    <TextBlock x:Uid="Digest_NoCollectionsConfiguredYet" Text="No collections configured yet"
                                               Style="{StaticResource CaptionStyle}"
                                               HorizontalAlignment="Center"
                                               Margin="0,8" />
                                </StackPanel>
                            </controls:Faceplate>
                        </Grid>

                        <!-- ─── Row: File Type Breakdown + Conversation Highlights ─── -->
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- File Type Breakdown -->
                            <controls:Faceplate Grid.Column="0" Kicker="MOD - DIG - 04">
                                <StackPanel Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Background="{ThemeResource GraphTagSubtleBrush}"
                                                CornerRadius="{StaticResource RadiusMD}"
                                                Width="32" Height="32">
                                            <FontIcon Glyph="&#xE8F1;" FontSize="14"
                                                      Foreground="{ThemeResource GraphTagBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Uid="Digest_FileTypesImported" Text="File Types Imported"
                                                   Style="{StaticResource HeadingSmallStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Style="{StaticResource SeparatorStyle}" Margin="0" />

                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.CurrentReport.FileTypeBreakdown, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FileTypeItem">
                                                <Grid Padding="4,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{ThemeResource AccentSubtleBrush}"
                                                            CornerRadius="4"
                                                            Padding="8,2"
                                                            Margin="0,0,10,0">
                                                        <TextBlock Text="{x:Bind Type}"
                                                                   Style="{StaticResource CaptionStyle}"
                                                                   Foreground="{ThemeResource TextAccentBrush}"
                                                                   FontWeight="SemiBold"
                                                                   CharacterSpacing="40" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind TrendLabel}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Style="{StaticResource BodyStyle}">
                                                        <Run Text="{x:Bind Count}" />
                                                        <Run x:Uid="Digest_Files" Text=" files" />
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>

                                    <!-- Empty state -->
                                    <TextBlock x:Uid="Digest_NoFilesImportedThis" Text="No files imported this period"
                                               Style="{StaticResource CaptionStyle}"
                                               HorizontalAlignment="Center"
                                               Margin="0,8" />
                                </StackPanel>
                            </controls:Faceplate>

                            <!-- Conversation Highlights -->
                            <controls:Faceplate Grid.Column="1" Kicker="MOD - DIG - 05">
                                <StackPanel Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Background="{ThemeResource SuccessSubtleBrush}"
                                                CornerRadius="{StaticResource RadiusMD}"
                                                Width="32" Height="32">
                                            <FontIcon Glyph="&#xE8BD;" FontSize="14"
                                                      Foreground="{ThemeResource SuccessBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Uid="Digest_ConversationHighlights" Text="Conversation Highlights"
                                                   Style="{StaticResource HeadingSmallStyle}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Style="{StaticResource SeparatorStyle}" Margin="0" />

                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.CurrentReport.Highlights, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="10" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:HighlightItem">
                                                <Border Style="{StaticResource CardInsetStyle}"
                                                        Padding="14,12">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="{x:Bind Title}"
                                                                   Style="{StaticResource BodyStyle}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxLines="1" />
                                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon Glyph="&#xE8BD;" FontSize="10"
                                                                          Foreground="{ThemeResource TextSecondaryBrush}" />
                                                                <TextBlock Style="{StaticResource CaptionStyle}">
                                                                    <Run Text="{x:Bind MessageCount}" />
                                                                    <Run x:Uid="Digest_Messages" Text=" messages" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon Glyph="&#xE945;" FontSize="10"
                                                                          Foreground="{ThemeResource TextSecondaryBrush}" />
                                                                <TextBlock Style="{StaticResource CaptionStyle}">
                                                                    <Run Text="{x:Bind TokensUsed}" />
                                                                    <Run x:Uid="Digest_Tokens" Text=" tokens" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>

                                    <!-- Empty state -->
                                    <TextBlock x:Uid="Digest_NoConversationsThisPeriod" Text="No conversations this period"
                                               Style="{StaticResource CaptionStyle}"
                                               HorizontalAlignment="Center"
                                               Margin="0,8" />
                                </StackPanel>
                            </controls:Faceplate>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════
             COLUMN 1: REPORT HISTORY SIDEBAR
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="1"
                Width="280"
                Background="{ThemeResource PageBackgroundBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}"
                BorderThickness="1,0,0,0"
                Padding="20,32,20,20">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock x:Uid="Digest_ReportHistory" Text="REPORT HISTORY"
                               Style="{StaticResource OverlineStyle}" />
                    <TextBlock x:Uid="Digest_SelectAPreviousReport" Text="Select a previous report to view"
                               Style="{StaticResource CaptionStyle}" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource SeparatorStyle}" Margin="0" />

                <!-- Report History List -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ReportHistory}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:DigestReportDisplay">
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,10"
                                        Tag="{x:Bind}"
                                        Click="OnReportHistoryItemClick"
                                        AutomationProperties.LabeledBy="{Binding ElementName=DigestPageLabel}">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="DigestPageLabel" Text="{x:Bind ShortPeriodFormatted}"
                                                   Style="{StaticResource BodySmallStyle}"
                                                   FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Style="{StaticResource CaptionStyle}">
                                                <Run Text="{x:Bind NewDocumentsCount}" />
                                                <Run x:Uid="Digest_Docs2" Text=" docs" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource CaptionStyle}">
                                                <Run Text="{x:Bind TotalSearches}" />
                                                <Run x:Uid="Digest_Searches2" Text=" searches" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind GeneratedAtFormatted}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
