<Page
    x:Class="AgentX.App.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:controls="using:AgentX.App.Controls"
    xmlns:converters="using:AgentX.App.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>

        <!-- ═══════════════════════════════════════════════════════════
             CONVERTERS
             ═══════════════════════════════════════════════════════════ -->

        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" IsInverted="True" />
        <converters:StatusToColorConverter x:Key="StatusToColor" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />

        <!-- ═══════════════════════════════════════════════════════════
             CONVERSATION LIST ITEM TEMPLATE
             ═══════════════════════════════════════════════════════════ -->

        <DataTemplate x:Key="ConversationItemTemplate" x:DataType="vm:ConversationListItem">
            <Border Background="Transparent"
                    CornerRadius="{StaticResource RadiusMD}"
                    Padding="12,10,12,10"
                    Margin="0,1,0,1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <!-- Title row with optional pin icon -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE840;"
                                      FontSize="10"
                                      Foreground="{StaticResource TextAccentBrush}"
                                      Visibility="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Title}"
                                       Style="{StaticResource BodyStyle}"
                                       FontWeight="SemiBold"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Last message preview -->
                        <TextBlock Text="{x:Bind LastMessage}"
                                   Style="{StaticResource CaptionStyle}"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Folder label -->
                        <TextBlock Text="{x:Bind FolderName}"
                                   Style="{StaticResource CaptionStyle}"
                                   Foreground="{StaticResource TextAccentBrush}"
                                   FontSize="10"
                                   Visibility="{x:Bind FolderName, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>

                    <!-- Right column: time and message count -->
                    <StackPanel Grid.Column="1"
                                Spacing="4"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock Text="{x:Bind FormattedTime}"
                                   Style="{StaticResource CaptionStyle}"
                                   HorizontalAlignment="Right" />
                        <Border Style="{StaticResource BadgeDefaultStyle}"
                                Padding="6,2,6,2"
                                HorizontalAlignment="Right">
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="9">
                                <Run Text="{x:Bind MessageCount}" />
                                <Run Text="msgs" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════
             USER MESSAGE TEMPLATE
             ═══════════════════════════════════════════════════════════ -->

        <DataTemplate x:Key="UserMessageTemplate" x:DataType="vm:ChatMessageItem">
            <StackPanel HorizontalAlignment="Right"
                        Margin="64,4,0,4"
                        MaxWidth="680">
                <!-- Message bubble -->
                <Border Style="{StaticResource UserMessageStyle}">
                    <TextBlock Text="{x:Bind Content, Mode=OneWay}"
                               Style="{StaticResource BodyStyle}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </Border>

                <!-- Timestamp -->
                <TextBlock Text="{x:Bind FormattedTime}"
                           Style="{StaticResource ChatTimestampStyle}"
                           HorizontalAlignment="Right"
                           Margin="0,4,4,0" />
            </StackPanel>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════
             ASSISTANT MESSAGE TEMPLATE
             ═══════════════════════════════════════════════════════════ -->

        <DataTemplate x:Key="AssistantMessageTemplate" x:DataType="vm:ChatMessageItem">
            <StackPanel HorizontalAlignment="Left"
                        Margin="0,4,64,4"
                        MaxWidth="720">
                <!-- Message bubble with accent left border -->
                <Border Style="{StaticResource AssistantMessageStyle}">
                    <Grid ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Red accent bar -->
                        <Border Style="{StaticResource AssistantAccentBorderStyle}" />

                        <!-- Content area: rendered with markdown formatting -->
                        <StackPanel Grid.Column="1" Spacing="4">
                            <controls:MarkdownMessageControl
                                Segments="{x:Bind ContentSegments, Mode=OneWay}" />

                            <!-- Streaming cursor (visible only while streaming) -->
                            <Border Style="{StaticResource StreamingCursorStyle}"
                                    x:Name="StreamingCursor"
                                    Visibility="{x:Bind IsStreaming, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Button Style="{StaticResource GhostButtonStyle}"
                        Padding="0"
                        MinHeight="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Margin="8,6,24,0"
                        Click="OnInspectInlineContextClick"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Inspect the full context used for this response"
                        Visibility="{x:Bind HasInlineContextNote, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="{StaticResource AccentSubtleBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMD}"
                            Padding="10,8,10,8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Context Used"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{StaticResource TextAccentBrush}" />
                            <TextBlock Text="{x:Bind InlineContextStoryText, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="WrapWholeWords" />
                            <ItemsRepeater ItemsSource="{x:Bind InlineContextStorySourceChips, Mode=OneWay}"
                                           ItemTemplate="{StaticResource InlineContextStoryChipTemplate}"
                                           Visibility="{x:Bind HasInlineContextStorySourceChips, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="6" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Meta row: timestamp, tokens, generation time -->
                <Grid Margin="4,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind FormattedTime}"
                                   Style="{StaticResource ChatTimestampStyle}" />
                        <TextBlock Text="{x:Bind FormattedTokens}"
                                   Style="{StaticResource MessageMetaStyle}"
                                   Visibility="{x:Bind FormattedTokens, Converter={StaticResource StringToVisibility}}" />
                        <TextBlock Text="{x:Bind FormattedTokenSpeed}"
                                   Style="{StaticResource MessageMetaStyle}"
                                   Visibility="{x:Bind FormattedTokenSpeed, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════
             SYSTEM PROMPT PICKER ITEM TEMPLATE
             ═══════════════════════════════════════════════════════════ -->

        <DataTemplate x:Key="SystemPromptItemTemplate" x:DataType="vm:SystemPromptItem">
            <Border Style="{StaticResource PromptPickerItemStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="{x:Bind CategoryIcon}"
                              FontSize="14"
                              Foreground="{StaticResource TextTertiaryBrush}"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}"
                                   Style="{StaticResource BodyStyle}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Category}"
                                   Style="{StaticResource CaptionStyle}" />
                    </StackPanel>

                    <FontIcon Grid.Column="2"
                              Glyph="&#xE735;"
                              FontSize="12"
                              Foreground="{StaticResource TextAccentBrush}"
                              Visibility="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                              VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════
             MODEL COMBOBOX ITEM TEMPLATE
             ═══════════════════════════════════════════════════════════ -->

        <DataTemplate x:Key="ModelItemTemplate" x:DataType="vm:ChatMessageItem">
            <TextBlock Style="{StaticResource BodyStyle}" />
        </DataTemplate>

        <DataTemplate x:Key="ContextStoryChipTemplate" x:DataType="vm:ChatContextStorySourceDisplayItem">
            <Border Background="{StaticResource InputBackgroundBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusRound}"
                    Padding="8,4,8,4">
                <TextBlock Text="{x:Bind Label}"
                           Style="{StaticResource CaptionStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InlineContextStoryChipTemplate" x:DataType="x:String">
            <Border Background="{StaticResource InputBackgroundBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusRound}"
                    Padding="7,3,7,3">
                <TextBlock Text="{x:Bind}"
                           Style="{StaticResource CaptionStyle}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" />
            </Border>
        </DataTemplate>

    </Page.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT LAYOUT: 2-column grid (sidebar + chat area)
         ═══════════════════════════════════════════════════════════════ -->

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <!-- Conversation sidebar (collapsible) -->
            <ColumnDefinition x:Name="SidebarColumn"
                              Width="280" />
            <!-- Chat area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             COLUMN 0: CONVERSATION SIDEBAR
             ═══════════════════════════════════════════════════════════ -->

        <Grid Grid.Column="0"
              Background="{StaticResource SidebarGradientBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="0,0,1,0"
              Visibility="{x:Bind ViewModel.IsConversationPaneOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Sidebar Header -->
            <Border Grid.Row="0" Style="{StaticResource SidebarHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Conversations"
                               Style="{StaticResource HeadingSmallStyle}"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="10,6,10,6"
                            MinHeight="32"
                            Command="{x:Bind ViewModel.NewConversationCommand}"
                            ToolTipService.ToolTip="New conversation">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="New" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Search Bar -->
            <Border Grid.Row="1" Padding="12,8,12,8">
                <TextBox Style="{StaticResource SearchInputStyle}"
                         PlaceholderText="Search conversations..."
                         Text="{x:Bind ViewModel.ConversationSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Border>

            <!-- Folder Filter Chips -->
            <Border Grid.Row="2" Padding="12,4,12,4"
                    Visibility="{x:Bind ViewModel.FolderNames.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="All"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="10,4,10,4"
                                MinHeight="28"
                                FontSize="12"
                                Click="OnFolderFilterClick"
                                Tag="" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.FolderNames, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Content="{x:Bind}"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="10,4,10,4"
                                            MinHeight="28"
                                            FontSize="12"
                                            Click="OnFolderFilterClick"
                                            Tag="{x:Bind}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Conversation List -->
            <ListView Grid.Row="3"
                      x:Name="ConversationListView"
                      ItemsSource="{x:Bind ViewModel.Conversations, Mode=OneWay}"
                      ItemTemplate="{StaticResource ConversationItemTemplate}"
                      SelectionMode="Single"
                      Padding="8,0,8,0"
                      Background="Transparent">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Branch Tree Panel -->
            <Expander Grid.Row="4"
                      x:Name="BranchPanel"
                      Header="Branches"
                      IsExpanded="False"
                      Margin="12,4,12,4"
                      Visibility="{x:Bind ViewModel.HasBranches, Mode=OneWay}">
                <TreeView x:Name="BranchTree"
                          ItemsSource="{x:Bind ViewModel.ActiveBranches, Mode=OneWay}"
                          ItemInvoked="BranchTree_ItemInvoked"
                          MinHeight="60"
                          MaxHeight="200">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="{StaticResource TextAccentBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding BranchLabel}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionStyle}" />
                                <Button Grid.Column="2"
                                        ToolTipService.ToolTip="Merge to main"
                                        Click="MergeBranch_Click"
                                        Tag="{Binding Conversation.Id}"
                                        Padding="4,2,4,2"
                                        MinHeight="24"
                                        MinWidth="24">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Button>
                                <Button Grid.Column="3"
                                        ToolTipService.ToolTip="Delete branch"
                                        Click="DeleteBranch_Click"
                                        Tag="{Binding Conversation.Id}"
                                        Padding="4,2,4,2"
                                        MinHeight="24"
                                        MinWidth="24">
                                    <FontIcon Glyph="&#xE74D;" FontSize="10" Foreground="{StaticResource ErrorBrush}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Expander>

            <!-- Sidebar Footer -->
            <Border Grid.Row="5"
                    Padding="16,10,16,10"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8BD;" FontSize="11"
                              Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Style="{StaticResource CaptionStyle}">
                        <Run Text="{x:Bind ViewModel.Conversations.Count, Mode=OneWay}" />
                        <Run Text="conversations" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             COLUMN 1: CHAT AREA
             ═══════════════════════════════════════════════════════════ -->

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top bar -->
                <RowDefinition Height="Auto" />
                <!-- Intelligence strip -->
                <RowDefinition Height="Auto" />
                <!-- Message area -->
                <RowDefinition Height="*" />
                <!-- Input bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════
                 TOP BAR: Model selector, status, controls
                 ═══════════════════════════════════════════════════ -->

            <Border Grid.Row="0" Style="{StaticResource ChatTopBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Toggle sidebar button -->
                    <Button Grid.Column="0"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{x:Bind ViewModel.ToggleConversationPaneCommand}"
                            ToolTipService.ToolTip="Toggle sidebar"
                            AutomationProperties.Name="Toggle sidebar"
                            Margin="0,0,8,0">
                        <FontIcon Glyph="&#xE700;" FontSize="16"
                                  Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>

                    <!-- Model selector -->
                    <ComboBox Grid.Column="1"
                              x:Name="ModelSelector"
                              ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                              DisplayMemberPath="Name"
                              PlaceholderText="Select model..."
                              MinWidth="180"
                              Background="{StaticResource InputBackgroundBrush}"
                              BorderBrush="{StaticResource BorderSubtleBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              VerticalAlignment="Center" />

                    <!-- Connection status -->
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                        <Ellipse Width="8" Height="8"
                                 Fill="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay, Converter={StaticResource StatusToColor}}" />
                        <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- System prompt button -->
                    <Button Grid.Column="4"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="8,6,8,6"
                            MinHeight="32"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            ToolTipService.ToolTip="System prompt">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE771;" FontSize="14"
                                      Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveSystemPromptName, Mode=OneWay, TargetNullValue='Prompt'}"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       MaxWidth="100"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Width="280" Spacing="8">
                                    <TextBlock Text="System Prompt"
                                               Style="{StaticResource HeadingSmallStyle}" />
                                    <TextBlock Text="Set the AI's behavior and personality for this conversation."
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap" />
                                    <Border Style="{StaticResource SeparatorStyle}" Margin="0,4,0,4" />

                                    <!-- Clear prompt option -->
                                    <Button Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{x:Bind ViewModel.SelectSystemPromptCommand}"
                                            Padding="8,6,8,6"
                                            MinHeight="32">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE711;" FontSize="12"
                                                      Foreground="{StaticResource TextTertiaryBrush}" />
                                            <TextBlock Text="No system prompt"
                                                       Style="{StaticResource BodySmallStyle}" />
                                        </StackPanel>
                                    </Button>

                                    <Border Style="{StaticResource SeparatorStyle}" Margin="0,2,0,2" />

                                    <!-- Prompt list -->
                                    <ListView ItemsSource="{x:Bind ViewModel.SystemPrompts, Mode=OneWay}"
                                              ItemTemplate="{StaticResource SystemPromptItemTemplate}"
                                              SelectionMode="None"
                                              MaxHeight="300"
                                              Background="Transparent">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="MinHeight" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Folder assignment button -->
                    <Button Grid.Column="5"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="8,6,8,6"
                            MinHeight="32"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            ToolTipService.ToolTip="Assign folder">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14"
                                      Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveFolderFilter, Mode=OneWay, TargetNullValue='Folder'}"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       MaxWidth="80"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Width="200" Spacing="8">
                                    <TextBlock Text="Move to Folder"
                                               Style="{StaticResource HeadingSmallStyle}" />
                                    <Button Content="None (remove folder)"
                                            Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnSetFolderClick"
                                            Tag="" />
                                    <Button Content="Work"
                                            Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnSetFolderClick"
                                            Tag="Work" />
                                    <Button Content="Research"
                                            Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnSetFolderClick"
                                            Tag="Research" />
                                    <Button Content="Personal"
                                            Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnSetFolderClick"
                                            Tag="Personal" />
                                    <Button Content="Archive"
                                            Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OnSetFolderClick"
                                            Tag="Archive" />
                                    <Border Style="{StaticResource SeparatorStyle}" />
                                    <TextBox x:Name="CustomFolderBox"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             PlaceholderText="Custom folder name..."
                                             KeyDown="OnCustomFolderKeyDown" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Token count badge -->
                    <Border Grid.Column="6"
                            Style="{StaticResource BadgeDefaultStyle}"
                            Padding="8,3,8,3"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Visibility="{x:Bind ViewModel.TokenCount, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8A3;" FontSize="10"
                                      Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Style="{StaticResource MonoSmallStyle}"
                                       Foreground="{StaticResource TextTertiaryBrush}">
                                <Run Text="{x:Bind ViewModel.TokenCount, Mode=OneWay}" />
                                <Run Text="tok" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Compare branches button -->
                    <Button Grid.Column="7"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{x:Bind ViewModel.CompareBranchesCommand}"
                            ToolTipService.ToolTip="Compare branches"
                            AutomationProperties.Name="Compare branches"
                            Margin="0,0,4,0"
                            Visibility="{x:Bind ViewModel.HasBranches, Mode=OneWay}">
                        <FontIcon Glyph="&#xE735;" FontSize="14"
                                  Foreground="{StaticResource TextAccentBrush}" />
                    </Button>

                    <!-- Refresh connection button -->
                    <Button Grid.Column="8"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{x:Bind ViewModel.RefreshConnectionCommand}"
                            ToolTipService.ToolTip="Refresh connection"
                            AutomationProperties.Name="Refresh connection">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"
                                  Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>

                    <!-- Export conversation button -->
                    <Button Grid.Column="9"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Export conversation"
                            AutomationProperties.Name="Export conversation"
                            Click="ExportButton_Click"
                            Margin="4,0,0,0">
                        <FontIcon Glyph="&#xEDE1;" FontSize="14"
                                  Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="24,12,24,0"
                    Padding="12,10,12,10"
                    Background="{StaticResource CardElevatedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLG}"
                    Visibility="{x:Bind ViewModel.HasConversationIntelligenceStrip, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Border Style="{StaticResource BadgeSuccessStyle}"
                                Visibility="{x:Bind ViewModel.ConversationIntelligenceIsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Bind ViewModel.ConversationIntelligenceBadgeText, Mode=OneWay}"
                                       Style="{StaticResource BadgeStyle}"
                                       Foreground="{StaticResource SuccessBrush}" />
                        </Border>

                        <Border Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusRound}"
                                Padding="10,4,10,4"
                                Visibility="{x:Bind ViewModel.ConversationIntelligenceIsStale, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Bind ViewModel.ConversationIntelligenceBadgeText, Mode=OneWay}"
                                       Style="{StaticResource BadgeStyle}"
                                       Foreground="{StaticResource WarningBrush}" />
                        </Border>

                        <Border Style="{StaticResource BadgeDefaultStyle}"
                                Visibility="{x:Bind ViewModel.ConversationIntelligenceIsPending, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Bind ViewModel.ConversationIntelligenceBadgeText, Mode=OneWay}"
                                       Style="{StaticResource BadgeStyle}"
                                       Foreground="{StaticResource InfoBrush}" />
                        </Border>

                        <Border Style="{StaticResource BadgeDefaultStyle}"
                                Visibility="{x:Bind ViewModel.ConversationIntelligenceIsUnavailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Bind ViewModel.ConversationIntelligenceBadgeText, Mode=OneWay}"
                                       Style="{StaticResource BadgeStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.ConversationIntelligenceStatusText, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                        <TextBlock Text="{x:Bind ViewModel.ConversationIntelligenceStoryText, Mode=OneWay}"
                                   Style="{StaticResource CaptionStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2"
                                   Visibility="{x:Bind ViewModel.HasConversationIntelligenceStory, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ConversationIntelligenceStorySourceChips, Mode=OneWay}"
                                       ItemTemplate="{StaticResource ContextStoryChipTemplate}"
                                       Visibility="{x:Bind ViewModel.HasConversationIntelligenceStorySourceChips, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="6" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6">
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{x:Bind ViewModel.RefreshConversationSummaryCommand}"
                                IsEnabled="{x:Bind ViewModel.CanRefreshConversationSummary, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ShowConversationSummaryRefreshAction, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Padding="10,6,10,6"
                                MinHeight="32"
                                ToolTipService.ToolTip="Refresh the durable summary for this conversation">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12"
                                          Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ConversationSummaryRefreshActionText, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{x:Bind ViewModel.ToggleContextInspectorCommand}"
                                Padding="10,6,10,6"
                                MinHeight="32"
                                ToolTipService.ToolTip="Open the full context inspector">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8F1;" FontSize="12"
                                          Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="Inspect Context"
                                           Style="{StaticResource CaptionStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════
                 CENTER: Messages ScrollViewer
                 ═══════════════════════════════════════════════════ -->

            <Grid Grid.Row="2">

                <!-- Empty state: Welcome card (visible when no messages) -->
                <Border Style="{StaticResource WelcomeCardStyle}"
                        Visibility="{x:Bind ViewModel.HasNoMessages, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="20" HorizontalAlignment="Center">

                        <!-- Icon -->
                        <Border Background="{StaticResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusFull}"
                                Width="72" Height="72"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8BD;"
                                      FontSize="32"
                                      Foreground="{StaticResource TextAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="Start a Conversation"
                                       Style="{StaticResource HeadingMediumStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Chat with local AI models powered by Ollama. Your messages stay on this device. No data leaves your machine."
                                       Style="{StaticResource BodySecondaryStyle}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="380" />
                        </StackPanel>

                        <!-- Quick action suggestions -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border Style="{StaticResource BadgeAccentStyle}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="100% Private"
                                           Style="{StaticResource CaptionStyle}"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           FontWeight="SemiBold" />
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Center">
                                <Border Style="{StaticResource BadgeDefaultStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE765;" FontSize="10"
                                                  Foreground="{StaticResource TextTertiaryBrush}" />
                                        <TextBlock Text="Enter to send"
                                                   Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource BadgeDefaultStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE765;" FontSize="10"
                                                  Foreground="{StaticResource TextTertiaryBrush}" />
                                        <TextBlock Text="Shift+Enter for new line"
                                                   Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Messages list (visible when messages exist) -->
                <ScrollViewer x:Name="MessagesScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind ViewModel.HasNoMessages, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsRepeater x:Name="MessagesRepeater"
                                   ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                                   Margin="24,16,24,16">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatMessageItem">
                                <Grid>
                                    <!-- ═══════════════════════════════════════════
                                         USER MESSAGE LAYOUT
                                         ═══════════════════════════════════════════ -->
                                    <StackPanel Visibility="{x:Bind IsUser, Converter={StaticResource BoolToVisibility}}"
                                                HorizontalAlignment="Right"
                                                Margin="64,4,0,4"
                                                MaxWidth="680">

                                        <!-- Normal display mode -->
                                        <Border Style="{StaticResource UserMessageStyle}"
                                                Visibility="{x:Bind IsNotEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{x:Bind Content, Mode=OneWay}"
                                                       Style="{StaticResource BodyStyle}"
                                                       TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True" />
                                        </Border>

                                        <!-- Inline edit mode (#19) -->
                                        <Border Style="{StaticResource UserMessageStyle}"
                                                Visibility="{x:Bind IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Spacing="8">
                                                <TextBox Text="{x:Bind EditContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ChatInputStyle}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         MaxHeight="200"
                                                         MinHeight="44" />
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="6"
                                                            HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Content="Cancel"
                                                            Padding="10,4,10,4"
                                                            MinHeight="28"
                                                            Click="OnCancelEditClick"
                                                            Tag="{x:Bind}" />
                                                    <Button Style="{StaticResource AccentButtonStyle}"
                                                            Content="Save &amp; Resend"
                                                            Padding="10,4,10,4"
                                                            MinHeight="28"
                                                            Click="OnSaveEditClick"
                                                            Tag="{x:Bind}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- User message action bar -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="2"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,4,4,0"
                                                    Visibility="{x:Bind IsNotEditing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{x:Bind FormattedTime}"
                                                       Style="{StaticResource ChatTimestampStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />

                                            <!-- Branch indicator badge (visible when message has branches) -->
                                            <Border
                                                Background="{StaticResource AccentSubtleBrush}"
                                                CornerRadius="4"
                                                Padding="4,2"
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind IsBranchPoint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <FontIcon Glyph="&#xE735;" FontSize="10" Foreground="{StaticResource TextAccentBrush}" />
                                                    <TextBlock Text="{x:Bind BranchCountAtPoint, Mode=OneWay}" FontSize="10" Foreground="{StaticResource TextAccentBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Edit button -->
                                            <Button Style="{StaticResource MessageActionButtonStyle}"
                                                    Click="OnEditMessageClick"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Edit message">
                                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                            </Button>

                                            <!-- Copy button -->
                                            <Button Style="{StaticResource MessageActionButtonStyle}"
                                                    Click="OnCopyMessageClick"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Copy to clipboard">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                            </Button>

                                            <!-- Branch from here button -->
                                            <Button Style="{StaticResource MessageActionButtonStyle}"
                                                    Click="BranchFromMessage_Click"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Branch from here">
                                                <FontIcon Glyph="&#xE735;" FontSize="12" />
                                            </Button>

                                            <!-- Delete button -->
                                            <Button Style="{StaticResource MessageActionButtonStyle}"
                                                    Click="OnDeleteMessageClick"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Delete message">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- ═══════════════════════════════════════════
                                         ASSISTANT MESSAGE LAYOUT
                                         ═══════════════════════════════════════════ -->
                                    <StackPanel Visibility="{x:Bind IsAssistant, Converter={StaticResource BoolToVisibility}}"
                                                HorizontalAlignment="Left"
                                                Margin="0,4,64,4"
                                                MaxWidth="720">
                                        <Border Style="{StaticResource AssistantMessageStyle}">
                                            <Grid ColumnSpacing="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Red accent bar -->
                                                <Border Style="{StaticResource AssistantAccentBorderStyle}" />

                                                <!-- Content: rendered with markdown formatting -->
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <controls:MarkdownMessageControl
                                                        Segments="{x:Bind ContentSegments, Mode=OneWay}" />

                                                    <!-- Streaming cursor -->
                                                    <Border Style="{StaticResource StreamingCursorStyle}"
                                                            x:Name="StreamCursor"
                                                            Visibility="{x:Bind IsStreaming, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                            HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Meta info + action bar -->
                                        <Grid Margin="4,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: timestamps and meta -->
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="10">
                                                <TextBlock Text="{x:Bind FormattedTime}"
                                                           Style="{StaticResource ChatTimestampStyle}" />
                                                <TextBlock Text="{x:Bind FormattedTokens}"
                                                           Style="{StaticResource MessageMetaStyle}"
                                                           Visibility="{x:Bind FormattedTokens, Converter={StaticResource StringToVisibility}}" />
                                                <TextBlock Text="{x:Bind FormattedTokenSpeed}"
                                                           Style="{StaticResource MessageMetaStyle}"
                                                           Visibility="{x:Bind FormattedTokenSpeed, Converter={StaticResource StringToVisibility}}" />
                                            </StackPanel>

                                            <!-- Right: action buttons -->
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="2">

                                                <!-- Thumbs up -->
                                                <Button Style="{StaticResource MessageActionButtonStyle}"
                                                        Click="OnThumbsUpClick"
                                                        Tag="{x:Bind}"
                                                        Opacity="{x:Bind IsThumbsUp, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}"
                                                        ToolTipService.ToolTip="Good response">
                                                    <FontIcon Glyph="&#xE8E1;" FontSize="12" />
                                                </Button>

                                                <!-- Thumbs down -->
                                                <Button Style="{StaticResource MessageActionButtonStyle}"
                                                        Click="OnThumbsDownClick"
                                                        Tag="{x:Bind}"
                                                        Opacity="{x:Bind IsThumbsDown, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}"
                                                        ToolTipService.ToolTip="Poor response">
                                                    <FontIcon Glyph="&#xE8E0;" FontSize="12" />
                                                </Button>

                                                <!-- Copy -->
                                                <Button Style="{StaticResource MessageActionButtonStyle}"
                                                        Click="OnCopyMessageClick"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="Copy to clipboard">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                </Button>

                                                <!-- Regenerate -->
                                                <Button Style="{StaticResource MessageActionButtonStyle}"
                                                        Click="OnRegenerateMessageClick"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="Regenerate response">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                                </Button>

                                                <!-- Delete -->
                                                <Button Style="{StaticResource MessageActionButtonStyle}"
                                                        Click="OnDeleteMessageClick"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="Delete message">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>

            <!-- ═══════════════════════════════════════════════════
                 BOTTOM: Input bar
                 ═══════════════════════════════════════════════════ -->

            <Border Grid.Row="3" Style="{StaticResource ChatInputBarStyle}">
                <Grid MaxWidth="900" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Visibility="{x:Bind ViewModel.IsContextInspectorOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,0,12"
                            Background="{StaticResource CardElevatedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLG}"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Context Inspection"
                                           Style="{StaticResource BodyStyle}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.ContextInspectionStatus, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>

                            <Border Background="{StaticResource InputBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Padding="12"
                                    Visibility="{x:Bind ViewModel.HasContextStory, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Context Story"
                                               Style="{StaticResource CaptionStyle}"
                                               Foreground="{StaticResource TextAccentBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.ContextStoryText, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="WrapWholeWords" />
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ContextStorySourceChips, Mode=OneWay}"
                                                   ItemTemplate="{StaticResource ContextStoryChipTemplate}"
                                                   Visibility="{x:Bind ViewModel.HasContextStorySourceChips, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="6" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{StaticResource InputBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Assembly Overview"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{StaticResource TextAccentBrush}" />
                                        <TextBlock Style="{StaticResource CaptionStyle}">
                                            <Run Text="Mode: " />
                                            <Run Text="{x:Bind ViewModel.ContextAssemblyMode, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionStyle}">
                                            <Run Text="Selected: " />
                                            <Run Text="{x:Bind ViewModel.ContextSelectedMessages, Mode=OneWay}" />
                                            <Run Text=" · Anchors: " />
                                            <Run Text="{x:Bind ViewModel.ContextAnchorMessages, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionStyle}">
                                            <Run Text="Overflow: " />
                                            <Run Text="{x:Bind ViewModel.ContextOverflowMessages, Mode=OneWay}" />
                                            <Run Text=" · Prompt est: " />
                                            <Run Text="{x:Bind ViewModel.ContextEstimatedPromptTokens, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind ViewModel.ContextAssemblyExplanation, Mode=OneWay}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="{StaticResource InputBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Padding="12">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Durable Summary"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Foreground="{StaticResource TextAccentBrush}"
                                                       VerticalAlignment="Center" />

                                            <Button Grid.Column="1"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Command="{x:Bind ViewModel.RefreshConversationSummaryCommand}"
                                                    IsEnabled="{x:Bind ViewModel.CanRefreshConversationSummary, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.HasConversationIntelligenceStrip, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                    Padding="8,4,8,4"
                                                    MinHeight="28"
                                                    ToolTipService.ToolTip="Refresh the durable summary for this conversation">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="11"
                                                              Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.ConversationSummaryRefreshActionText, Mode=OneWay}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <TextBlock Text="{x:Bind ViewModel.ContextSummaryStatus, Mode=OneWay}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="WrapWholeWords" />
                                        <TextBlock Text="{x:Bind ViewModel.ConversationSummaryRefreshStatusText, Mode=OneWay}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="WrapWholeWords"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   Visibility="{x:Bind ViewModel.HasConversationSummaryRefreshStatus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{x:Bind ViewModel.ContextSummaryFreshness, Mode=OneWay}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="WrapWholeWords"
                                                   Visibility="{x:Bind ViewModel.HasContextSummary, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{x:Bind ViewModel.ContextSummaryPreview, Mode=OneWay}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="WrapWholeWords"
                                                   Visibility="{x:Bind ViewModel.HasContextSummary, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ContextSummaryKeyPoints, Mode=OneWay}"
                                                       Visibility="{x:Bind ViewModel.HasContextSummaryKeyPoints, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Vertical" Spacing="4" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                                               TextWrapping="WrapWholeWords">
                                                        <Run Text="• " />
                                                        <Run Text="{x:Bind}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="{StaticResource InputBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Durable Recall"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{StaticResource TextAccentBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ContextRecallStatus, Mode=OneWay}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="WrapWholeWords" />
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ContextRecallItems, Mode=OneWay}"
                                                       Visibility="{x:Bind ViewModel.HasContextRecallItems, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Vertical" Spacing="8" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ChatContextRecallDisplayItem">
                                                    <Border Background="{StaticResource AccentSubtleBrush}"
                                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource RadiusMD}"
                                                            Padding="10">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{x:Bind ConversationLabel}"
                                                                       Style="{StaticResource CaptionStyle}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="WrapWholeWords" />
                                                            <TextBlock Text="{x:Bind PreviewText}"
                                                                       Style="{StaticResource CaptionStyle}"
                                                                       TextWrapping="WrapWholeWords" />
                                                            <TextBlock Style="{StaticResource CaptionStyle}">
                                                                <Run Text="{x:Bind SimilarityLabel}" />
                                                                <Run Text=" · " />
                                                                <Run Text="{x:Bind TimestampLabel}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="{StaticResource InputBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Padding="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Why This Context"
                                               Style="{StaticResource CaptionStyle}"
                                               Foreground="{StaticResource TextAccentBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.ContextCompressionExplanation, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{x:Bind ViewModel.ContextRecallExplanation, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="WrapWholeWords" />
                                    <TextBlock Style="{StaticResource CaptionStyle}">
                                        <Run Text="Captured " />
                                        <Run Text="{x:Bind ViewModel.ContextCapturedAt, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Suggested Follow-up Questions -->
                    <ItemsRepeater Grid.Row="1"
                                   ItemsSource="{x:Bind ViewModel.SuggestedQuestions, Mode=OneWay}"
                                   Margin="0,0,0,8"
                                   Visibility="{x:Bind ViewModel.SuggestedQuestions.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Content="{x:Bind}"
                                        Padding="12,6"
                                        MinHeight="28"
                                        MaxWidth="300"
                                        Click="OnSuggestedQuestionClick"
                                        ToolTipService.ToolTip="{x:Bind}">
                                    <Button.Resources>
                                        <Thickness x:Key="ButtonPadding">12,6,12,6</Thickness>
                                    </Button.Resources>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Active system prompt indicator -->
                    <Border Grid.Row="2"
                            Visibility="{x:Bind ViewModel.HasActiveSystemPrompt, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,0,8">
                        <Border Style="{StaticResource BadgeAccentStyle}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE771;" FontSize="10"
                                          Foreground="{StaticResource TextAccentBrush}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Foreground="{StaticResource TextAccentBrush}">
                                    <Run Text="Prompt:" />
                                    <Run Text="{x:Bind ViewModel.ActiveSystemPromptName, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Input row -->
                    <Grid Grid.Row="3" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Multi-line input TextBox -->
                        <TextBox x:Name="ChatInputBox"
                                 Style="{StaticResource ChatInputStyle}"
                                 PlaceholderText="Message Agent-X..."
                                 Text="{x:Bind ViewModel.UserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="ChatInputBox_KeyDown"
                                 MaxHeight="160"
                                 VerticalAlignment="Bottom" />

                        <!-- Voice input buttons -->
                        <StackPanel Grid.Column="1"
                                    Spacing="4"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,2">

                            <!-- Idle: Microphone button (click to start recording, right-click to pick file) -->
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Padding="12,10,12,10"
                                    MinHeight="44"
                                    MinWidth="44"
                                    Command="{x:Bind ViewModel.ToggleVoiceRecordingCommand}"
                                    Visibility="{x:Bind ViewModel.IsVoiceActive, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"
                                    ToolTipService.ToolTip="Voice input — click to record"
                                    RightTapped="OnMicRightTapped">
                                <FontIcon Glyph="&#xE720;" FontSize="16"
                                          Foreground="{StaticResource TextSecondaryBrush}" />
                            </Button>

                            <!-- Recording: Stop button with red indicator -->
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,10,12,10"
                                    MinHeight="44"
                                    MinWidth="44"
                                    BorderBrush="{StaticResource ErrorBrush}"
                                    Command="{x:Bind ViewModel.ToggleVoiceRecordingCommand}"
                                    Visibility="{x:Bind ViewModel.IsRecording, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    ToolTipService.ToolTip="Stop recording and transcribe">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{StaticResource ErrorBrush}" />
                                    <FontIcon Glyph="&#xE72A;" FontSize="14"
                                              Foreground="{StaticResource ErrorBrush}" />
                                </StackPanel>
                            </Button>

                            <!-- Processing: Transcribing spinner -->
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Padding="12,10,12,10"
                                    MinHeight="44"
                                    MinWidth="44"
                                    IsEnabled="False"
                                    Visibility="{x:Bind ViewModel.IsTranscribing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.VoiceStatusMessage, Mode=OneWay}">
                                <ProgressRing IsActive="True" Width="16" Height="16" />
                            </Button>
                        </StackPanel>

                        <!-- Research Mode toggle -->
                        <ToggleButton Grid.Column="2"
                                      x:Name="ResearchModeToggle"
                                      Style="{StaticResource GhostToggleButtonStyle}"
                                      Padding="10,10,10,10"
                                      MinHeight="44"
                                      MinWidth="44"
                                      IsChecked="{x:Bind ViewModel.IsResearchMode, Mode=TwoWay}"
                                      ToolTipService.ToolTip="{x:Bind ViewModel.ResearchModeTooltip, Mode=OneWay}">
                            <FontIcon Glyph="&#xE774;" FontSize="16"
                                      Foreground="{StaticResource TextSecondaryBrush}" />
                        </ToggleButton>

                        <ToggleButton Grid.Column="3"
                                      Style="{StaticResource GhostToggleButtonStyle}"
                                      Padding="10,10,10,10"
                                      MinHeight="44"
                                      MinWidth="44"
                                      IsChecked="{x:Bind ViewModel.IsContextInspectorOpen, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Inspect the latest assembled chat context">
                            <FontIcon Glyph="&#xE8F1;" FontSize="16"
                                      Foreground="{StaticResource TextSecondaryBrush}" />
                        </ToggleButton>

                        <ComboBox Grid.Column="4"
                                  MinHeight="44"
                                  MinWidth="124"
                                  MaxWidth="148"
                                  SelectedIndex="{x:Bind ViewModel.OrchestrationModeIndex, Mode=TwoWay}"
                                  ToolTipService.ToolTip="{x:Bind ViewModel.OrchestrationModeTooltip, Mode=OneWay}"
                                  VerticalAlignment="Bottom">
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE77B;" FontSize="12"
                                              Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="Solo" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="12"
                                              Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="Multi" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8F2;" FontSize="12"
                                              Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="Debate" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>

                        <!-- Action buttons stack -->
                        <StackPanel Grid.Column="5"
                                    Spacing="4"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,2">

                            <!-- Send button (visible when NOT generating) -->
                            <Button Style="{StaticResource AccentButtonStyle}"
                                    Padding="12,10,12,10"
                                    MinHeight="44"
                                    MinWidth="44"
                                    Command="{x:Bind ViewModel.SendMessageCommand}"
                                    Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"
                                    ToolTipService.ToolTip="Send message (Enter)"
                                    AutomationProperties.Name="Send message">
                                <FontIcon Glyph="&#xE724;" FontSize="16" />
                            </Button>

                            <!-- Stop button (visible when generating) -->
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,10,12,10"
                                    MinHeight="44"
                                    MinWidth="44"
                                    BorderBrush="{StaticResource ErrorBrush}"
                                    Command="{x:Bind ViewModel.StopGenerationCommand}"
                                    Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    ToolTipService.ToolTip="Stop generation"
                                    AutomationProperties.Name="Stop generation">
                                <FontIcon Glyph="&#xE71A;" FontSize="16"
                                          Foreground="{StaticResource ErrorBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</Page>
