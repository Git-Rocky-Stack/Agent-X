<Page
    x:Class="AgentX.App.Views.AnnotationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:views="using:AgentX.App.Views"
    xmlns:converters="using:AgentX.App.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             LEFT PANEL: Filters & Stats
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource CardGradientSubtleBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Padding="20" Spacing="20">
                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Annotations"
                               Style="{StaticResource HeadingSmallStyle}"
                               FontWeight="Bold" />
                    <TextBlock Style="{StaticResource CaptionStyle}">
                        <Run Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" />
                        <Run Text="highlights" />
                    </TextBlock>
                </StackPanel>

                <!-- Search -->
                <TextBox Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Search annotations..."
                         Style="{StaticResource InputTextBoxStyle}" />
                <Button Content="Search"
                        Command="{x:Bind ViewModel.SearchCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Stretch" />

                <!-- Color Filter -->
                <StackPanel Spacing="8">
                    <TextBlock Text="FILTER BY COLOR"
                               Style="{StaticResource OverlineStyle}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ColorOptions}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{x:Bind}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="12,8" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Color Stats -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.HasAnnotations, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="DISTRIBUTION"
                               Style="{StaticResource OverlineStyle}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ColorStats}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ColorStatItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0"
                                             Width="10" Height="10"
                                             Fill="{x:Bind views:AnnotationsPage.ColorToBrush(Color)}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Color}"
                                               Style="{StaticResource CaptionStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind Count}"
                                               Style="{StaticResource CaptionStyle}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Export -->
                <Button Content="Export as Markdown"
                        Command="{x:Bind ViewModel.ExportAnnotationsCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             RIGHT PANEL: Annotation List
             ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Padding="{StaticResource PaddingPage}" RowSpacing="16" MaxWidth="800">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Page Header -->
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="All Annotations"
                                   Style="{StaticResource DisplaySmallStyle}" />
                        <TextBlock Text="Your highlights and notes across all documents."
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <!-- Annotation List -->
                    <ItemsRepeater Grid.Row="1"
                                   ItemsSource="{x:Bind ViewModel.Annotations}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnnotationDisplayItem">
                                <Border Background="{StaticResource CardGradientBrush}"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        Padding="20">
                                    <StackPanel Spacing="10">
                                        <!-- Header Row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Color Dot -->
                                            <Ellipse Grid.Column="0"
                                                     Width="12" Height="12"
                                                     Fill="{x:Bind views:AnnotationsPage.ColorToBrush(Color)}"
                                                     VerticalAlignment="Center" />

                                            <!-- Document Name -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind DocumentName}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Delete Button -->
                                            <Button Grid.Column="2"
                                                    Content="&#xE74D;"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="12"
                                                    Foreground="{StaticResource ErrorBrush}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Padding="6" MinWidth="0" MinHeight="0"
                                                    ToolTipService.ToolTip="Delete annotation" />
                                        </Grid>

                                        <!-- Highlighted Text -->
                                        <Border Background="{StaticResource InputBackgroundBrush}"
                                                CornerRadius="{StaticResource RadiusSM}"
                                                Padding="12,8"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1,1,1,1">
                                            <TextBlock Text="{x:Bind HighlightedText}"
                                                       Style="{StaticResource BodyStyle}"
                                                       TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True"
                                                       FontStyle="Italic"
                                                       MaxLines="6" />
                                        </Border>

                                        <!-- Note -->
                                        <TextBlock Text="{x:Bind NoteText}"
                                                   Style="{StaticResource BodyStyle}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="4" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="2"
                                HorizontalAlignment="Center"
                                Spacing="12"
                                Margin="0,40,0,0"
                                Visibility="{x:Bind ViewModel.HasAnnotations, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <FontIcon Glyph="&#xE7BC;"
                                  FontSize="48"
                                  Foreground="{StaticResource TextTertiaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="No annotations yet"
                                   Style="{StaticResource BodySecondaryStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Highlight text in your documents to create annotations."
                                   Style="{StaticResource CaptionStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Status -->
                    <TextBlock Grid.Row="2"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}"
                               Margin="0,8,0,0" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
