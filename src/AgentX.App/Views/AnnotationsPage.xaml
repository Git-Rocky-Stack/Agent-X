<Page
    x:Class="AgentX.App.Views.AnnotationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:views="using:AgentX.App.Views"
    xmlns:converters="using:AgentX.App.Converters"
    x:Name="AnnotationsRoot"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
    </Page.Resources>

    <Grid>

        <!-- ═══════ ADAPTIVE LAYOUT (Tier 3) — see Colors.xaml breakpoints ═══════
             Narrow (<960):  sidebar 240   |  Medium (>=960): sidebar 260
             Wide (>=1280):  sidebar 280 (markup default) -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="240" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="260" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             LEFT PANEL: Filters & Stats
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{ThemeResource CardGradientSubtleBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Padding="20" Spacing="20">
                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="Annot_Annotations" Text="Annotations"
                               Style="{StaticResource HeadingSmallStyle}"
                               FontWeight="Bold" />
                    <TextBlock Style="{StaticResource CaptionStyle}">
                        <Run Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" />
                        <Run x:Uid="Annot_Highlights" Text="highlights" />
                    </TextBlock>
                </StackPanel>

                <!-- Search -->
                <TextBox Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         x:Uid="Annot_SearchAnnotationsPh" PlaceholderText="Search annotations..."
                         Style="{StaticResource InputTextBoxStyle}" />
                <Button x:Uid="Annot_Search" Content="Search"
                        Command="{x:Bind ViewModel.SearchCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Stretch" />

                <!-- Color Filter -->
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Annot_FilterByColor" Text="FILTER BY COLOR"
                               Style="{StaticResource OverlineStyle}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ColorOptions}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{x:Bind}"
                                        Command="{Binding ViewModel.FilterByColorCommand, ElementName=AnnotationsRoot}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="12,8" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Color Stats -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.HasAnnotations, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock x:Uid="Annot_Distribution" Text="DISTRIBUTION"
                               Style="{StaticResource OverlineStyle}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ColorStats}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ColorStatItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0"
                                             Width="10" Height="10"
                                             Fill="{x:Bind views:AnnotationsPage.ColorToBrush(Color)}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Color}"
                                               Style="{StaticResource CaptionStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind Count}"
                                               Style="{StaticResource CaptionStyle}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Export -->
                <Button x:Uid="Annot_ExportAsMarkdown" Content="Export as Markdown"
                        Command="{x:Bind ViewModel.ExportAnnotationsCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             RIGHT PANEL: Annotation List
             ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Padding="{StaticResource PaddingPage}" RowSpacing="16" MaxWidth="800" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Page Header -->
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock x:Uid="Annot_AllAnnotations" Text="All Annotations"
                                   Style="{StaticResource DisplaySmallStyle}" />
                        <TextBlock x:Uid="Annot_YourHighlightsAndNotes" Text="Your highlights and notes across all documents."
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <!-- Annotation List -->
                    <ItemsRepeater Grid.Row="1"
                                   ItemsSource="{x:Bind ViewModel.Annotations}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnnotationDisplayItem">
                                <Border Background="{ThemeResource CardGradientBrush}"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        Padding="20">
                                    <StackPanel Spacing="10">
                                        <!-- Header Row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Color Dot -->
                                            <Ellipse Grid.Column="0"
                                                     Width="12" Height="12"
                                                     Fill="{x:Bind views:AnnotationsPage.ColorToBrush(Color)}"
                                                     VerticalAlignment="Center" />

                                            <!-- Document Name -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind DocumentName}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Edit / Delete Buttons -->
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                                <Button Content="&#xE70F;"
                                                        Command="{Binding ViewModel.EditAnnotationCommand, ElementName=AnnotationsRoot}"
                                                        CommandParameter="{x:Bind}"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="12"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="6" MinWidth="0" MinHeight="0"
                                                        x:Uid="Annot_EditAnnotationTip" ToolTipService.ToolTip="Edit annotation"
                                                        AutomationProperties.Name="Edit annotation" />
                                                <Button Content="&#xE74D;"
                                                        Command="{Binding ViewModel.DeleteAnnotationCommand, ElementName=AnnotationsRoot}"
                                                        CommandParameter="{x:Bind Id}"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource ErrorBrush}"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="6" MinWidth="0" MinHeight="0"
                                                        x:Uid="Annot_DeleteAnnotationTip" ToolTipService.ToolTip="Delete annotation"
                                                        AutomationProperties.Name="Delete annotation" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Highlighted Text -->
                                        <Border Background="{ThemeResource CardBrush}"
                                                CornerRadius="{StaticResource RadiusSM}"
                                                Padding="12,8"
                                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                                BorderThickness="1,1,1,1">
                                            <TextBlock Text="{x:Bind HighlightedText}"
                                                       Style="{StaticResource BodyStyle}"
                                                       TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True"
                                                       FontStyle="Italic"
                                                       MaxLines="6" />
                                        </Border>

                                        <!-- Note -->
                                        <TextBlock Text="{x:Bind NoteText}"
                                                   Style="{StaticResource BodyStyle}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="4" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="2"
                                HorizontalAlignment="Center"
                                Spacing="12"
                                Margin="0,40,0,0"
                                Visibility="{x:Bind ViewModel.HasAnnotations, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <FontIcon Glyph="&#xE7BC;"
                                  FontSize="48"
                                  Foreground="{ThemeResource TextTertiaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock x:Uid="Annot_NoAnnotationsYet" Text="No annotations yet"
                                   Style="{StaticResource BodySecondaryStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Uid="Annot_HighlightTextInYour" Text="Highlight text in your documents to create annotations."
                                   Style="{StaticResource CaptionStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Status -->
                    <TextBlock Grid.Row="2"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}"
                               Margin="0,8,0,0" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             EDIT ANNOTATION PANEL
             Shown while an annotation is being edited. Spans both columns
             so it reads as a modal layer over the list beneath it.
             ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Background="{ThemeResource OverlayBrush}"
              Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Border Background="{ThemeResource CardGradientBrush}"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMD}"
                    Padding="24"
                    MinWidth="420"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="Annot_EditTitle" Text="Edit Annotation"
                               Style="{StaticResource HeadingSmallStyle}"
                               AutomationProperties.HeadingLevel="Level2" />

                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Annot_EditNoteLabel" Text="Note"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBox Text="{x:Bind ViewModel.EditNoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 x:Uid="Annot_EditNotePh" PlaceholderText="Add a note to this highlight..."
                                 Style="{StaticResource InputTextBoxStyle}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="120" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Annot_EditColorLabel" Text="Color"
                                   Style="{StaticResource LabelStyle}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.EditColorOptions}"
                                  SelectedItem="{x:Bind ViewModel.EditColor, Mode=TwoWay}"
                                  x:Uid="Annot_EditColorBox"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <Button x:Uid="Annot_EditCancel" Content="Cancel"
                                Command="{x:Bind ViewModel.CancelEditCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Uid="Annot_EditSave" Content="Save"
                                Command="{x:Bind ViewModel.SaveAnnotationCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
