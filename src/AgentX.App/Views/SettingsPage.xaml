<Page
    x:Class="AgentX.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    xmlns:controls="using:AgentX.App.Controls"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <Grid Padding="{StaticResource PaddingPage}" RowSpacing="24" MaxWidth="800">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock x:Uid="Settings_Settings" Text="Settings"
                           Style="{StaticResource DisplaySmallStyle}" />
                <TextBlock x:Uid="Settings_ConfigureYourAiProviders" Text="Configure your AI providers, inference parameters, and knowledge vault settings."
                           Style="{StaticResource BodySecondaryStyle}" />
            </StackPanel>

            <!-- ════════════════════════════════════════════════════════
                 AI PROVIDERS
                 ════════════════════════════════════════════════════════ -->
            <controls:Faceplate Grid.Row="1" Kicker="MOD - PROV - 01">
                <StackPanel Spacing="20">
                    <TextBlock x:Uid="Settings_AiProviders" Text="AI Providers"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <!-- Encryption Status -->
                    <InfoBar IsOpen="{x:Bind ViewModel.AreKeysEncrypted, Mode=OneWay}"
                             Severity="Success"
                             x:Uid="Settings_ApiKeysSecured" Title="API Keys Secured"
                             Message="{x:Bind ViewModel.EncryptionStatusDescription, Mode=OneWay}"
                             IsClosable="False" />

                    <!-- Active Provider Selector -->
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Settings_ActiveProvider" Text="Active Provider"
                                   Style="{StaticResource LabelStyle}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.ProviderOptions}"
                                  SelectedIndex="{x:Bind ViewModel.ActiveProviderIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  MinWidth="200" />
                    </StackPanel>

                    <!-- Separator -->
                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- ── Ollama (Local) ─────────────────────────── -->
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="Settings_OllamaLocal" Text="Ollama (Local)"
                                       Style="{StaticResource HeadingSmallStyle}"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource BadgeSuccessStyle}">
                                <TextBlock x:Uid="Settings_Free" Text="FREE"
                                           Style="{StaticResource BadgeStyle}"
                                           Foreground="{ThemeResource SuccessBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="Settings_Endpoint" Text="Endpoint"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{x:Bind ViewModel.OllamaEndpoint, Mode=TwoWay}"
                                     PlaceholderText="http://localhost:11434" />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Settings_DefaultChatModel" Text="Default Chat Model"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{x:Bind ViewModel.DefaultModel, Mode=TwoWay}"
                                         PlaceholderText="llama3.2" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock x:Uid="Settings_EmbeddingModel" Text="Embedding Model"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{x:Bind ViewModel.EmbeddingModel, Mode=TwoWay}"
                                         PlaceholderText="all-minilm" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Uid="Settings_TestConnection" Content="Test Connection"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{x:Bind ViewModel.TestOllamaConnectionCommand}" />
                            <TextBlock Text="{x:Bind ViewModel.OllamaConnectionStatus, Mode=OneWay}"
                                       Style="{StaticResource BodySmallStyle}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.OllamaConnectionStatus, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- ── OpenAI ─────────────────────────────────── -->
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="OpenAI"
                                       Style="{StaticResource HeadingSmallStyle}"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource BadgeDefaultStyle}">
                                <TextBlock x:Uid="Settings_Cloud" Text="CLOUD"
                                           Style="{StaticResource BadgeStyle}"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="Settings_ApiKey" Text="API Key"
                                       Style="{StaticResource LabelStyle}" />
                            <PasswordBox Password="{x:Bind ViewModel.OpenAiApiKey, Mode=TwoWay}"
                                         PlaceholderText="sk-..."
                                         CornerRadius="{StaticResource RadiusXS}"
                                         MinHeight="40" />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Settings_Endpoint2" Text="Endpoint"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{x:Bind ViewModel.OpenAiEndpoint, Mode=TwoWay}"
                                         PlaceholderText="https://api.openai.com/v1/" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock x:Uid="Settings_DefaultModel" Text="Default Model"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{x:Bind ViewModel.OpenAiDefaultModel, Mode=TwoWay}"
                                         PlaceholderText="gpt-4o-mini" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Uid="Settings_TestConnection2" Content="Test Connection"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{x:Bind ViewModel.TestOpenAiConnectionCommand}" />
                            <TextBlock Text="{x:Bind ViewModel.OpenAiConnectionStatus, Mode=OneWay}"
                                       Style="{StaticResource BodySmallStyle}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.OpenAiConnectionStatus, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- ── Anthropic Claude ────────────────────────── -->
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Anthropic Claude"
                                       Style="{StaticResource HeadingSmallStyle}"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource BadgeDefaultStyle}">
                                <TextBlock x:Uid="Settings_Cloud2" Text="CLOUD"
                                           Style="{StaticResource BadgeStyle}"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="Settings_ApiKey2" Text="API Key"
                                       Style="{StaticResource LabelStyle}" />
                            <PasswordBox Password="{x:Bind ViewModel.AnthropicApiKey, Mode=TwoWay}"
                                         PlaceholderText="sk-ant-..."
                                         CornerRadius="{StaticResource RadiusXS}"
                                         MinHeight="40" />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Settings_Endpoint3" Text="Endpoint"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{x:Bind ViewModel.AnthropicEndpoint, Mode=TwoWay}"
                                         PlaceholderText="https://api.anthropic.com/v1/" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock x:Uid="Settings_DefaultModel2" Text="Default Model"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{x:Bind ViewModel.AnthropicDefaultModel, Mode=TwoWay}"
                                         PlaceholderText="claude-sonnet-4-20250514" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Uid="Settings_NoteAnthropicDoesNot" Text="Note: Anthropic does not support embeddings. Use Ollama or OpenAI for document indexing."
                                   Style="{StaticResource CaptionStyle}" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Uid="Settings_TestConnection3" Content="Test Connection"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{x:Bind ViewModel.TestAnthropicConnectionCommand}" />
                            <TextBlock Text="{x:Bind ViewModel.AnthropicConnectionStatus, Mode=OneWay}"
                                       Style="{StaticResource BodySmallStyle}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.AnthropicConnectionStatus, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </controls:Faceplate>

            <!-- ════════════════════════════════════════════════════════
                 APPEARANCE
                 ════════════════════════════════════════════════════════ -->
            <controls:Faceplate Grid.Row="2" Kicker="MOD - SHIFT - 02">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="Settings_Appearance" Text="Appearance"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Settings_Theme" Text="Theme"
                                   Style="{StaticResource LabelStyle}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                  SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  MinWidth="200" />
                        <TextBlock x:Uid="Settings_ChangesApplyImmediatelySystem" Text="Changes apply immediately. 'System Default' follows your Windows theme."
                                   Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </controls:Faceplate>

            <!-- ════════════════════════════════════════════════════════
                 COST TRACKING
                 ════════════════════════════════════════════════════════ -->
            <!-- Multi-Model Routing section -->
            <controls:Faceplate Grid.Row="3" Kicker="MOD - ROUTE - 03">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="Settings_MultiModelRouting" Text="Multi-Model Routing"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <TextBlock x:Uid="Settings_AutomaticallyRoutePromptsTo" Text="Automatically route prompts to the best AI model based on task type. Extraction and chat prefer fast local models; analysis and code prefer quality cloud models."
                               Style="{StaticResource BodySecondaryStyle}"
                               TextWrapping="Wrap" />

                    <ToggleSwitch x:Uid="Settings_EnableAutoRouting" Header="Enable Auto-Routing"
                                  IsOn="{x:Bind ViewModel.EnableModelRouting, Mode=TwoWay}" />

                    <StackPanel Spacing="6"
                                Visibility="{x:Bind ViewModel.EnableModelRouting, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Uid="Settings_RoutingProfile" Text="Routing Profile"
                                   Style="{StaticResource LabelStyle}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.RoutingProfileOptions}"
                                  SelectedIndex="{x:Bind ViewModel.RoutingProfileIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  MinWidth="200"
                                  IsEnabled="{x:Bind ViewModel.EnableModelRouting, Mode=OneWay}" />

                        <StackPanel Spacing="4" Padding="4,0,0,0">
                            <TextBlock x:Uid="Settings_CostOptimizedLocalModels" Text="Cost Optimized — Local models for all tasks, cloud only as fallback"
                                       Style="{StaticResource CaptionStyle}" />
                            <TextBlock x:Uid="Settings_QualityOptimizedCloudModels" Text="Quality Optimized — Cloud models for analysis, code, creative"
                                       Style="{StaticResource CaptionStyle}" />
                            <TextBlock x:Uid="Settings_BalancedLocalForSimple" Text="Balanced — Local for simple tasks, cloud for quality-critical tasks"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </controls:Faceplate>

            <controls:Faceplate Grid.Row="4" Kicker="MOD - COST - 04">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="Settings_CostTracking" Text="Cost Tracking"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <TextBlock x:Uid="Settings_EstimatedApiCostsFor" Text="Estimated API costs for cloud providers. Local Ollama models are free."
                               Style="{StaticResource BodySmallStyle}" />

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Total Cost -->
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="Settings_TotalSpend" Text="TOTAL SPEND"
                                       Style="{StaticResource OverlineStyle}" />
                            <Border Style="{StaticResource WellStyle}" Padding="10,2" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.TotalCostDisplay, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}"
                                           Foreground="{ThemeResource LcdAmberBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Today's Cost -->
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Uid="Settings_Today" Text="TODAY"
                                       Style="{StaticResource OverlineStyle}" />
                            <Border Style="{StaticResource WellStyle}" Padding="10,2" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.TodayCostDisplay, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}"
                                           Foreground="{ThemeResource LcdAmberBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Total Tokens -->
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock x:Uid="Settings_TotalTokens" Text="TOTAL TOKENS"
                                       Style="{StaticResource OverlineStyle}" />
                            <Border Style="{StaticResource WellStyle}" Padding="10,2" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.TotalTokensDisplay, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}"
                                           Foreground="{ThemeResource LcdPhosphorBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </controls:Faceplate>

            <!-- ════════════════════════════════════════════════════════
                 INFERENCE PARAMETERS
                 ════════════════════════════════════════════════════════ -->
            <controls:Faceplate Grid.Row="5" Kicker="MOD - INFER - 05">
                <StackPanel Spacing="20">
                    <TextBlock x:Uid="Settings_Inference" Text="Inference"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock x:Uid="Settings_Temperature" Text="Temperature"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Temperature, Mode=OneWay}"
                                       Style="{StaticResource TelemetryStyle}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="0" Maximum="2" StepFrequency="0.1"
                                Value="{x:Bind ViewModel.Temperature, Mode=TwoWay}" />
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="Settings_MaxTokens" Text="Max Tokens"
                                       Style="{StaticResource LabelStyle}" />
                            <NumberBox Value="{x:Bind ViewModel.MaxTokens, Mode=TwoWay}"
                                       Minimum="256" Maximum="32768" SpinButtonPlacementMode="Compact" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock x:Uid="Settings_ContextWindow" Text="Context Window"
                                       Style="{StaticResource LabelStyle}" />
                            <NumberBox Value="{x:Bind ViewModel.ContextWindow, Mode=TwoWay}"
                                       Minimum="2048" Maximum="131072" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </controls:Faceplate>

            <!-- ════════════════════════════════════════════════════════
                 KNOWLEDGE VAULT
                 ════════════════════════════════════════════════════════ -->
            <controls:Faceplate Grid.Row="6" Kicker="MOD - VAULT - 06">
                <StackPanel Spacing="20">
                    <TextBlock x:Uid="Settings_KnowledgeVault" Text="Knowledge Vault"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="Settings_ChunkSizeTokens" Text="Chunk Size (tokens)"
                                       Style="{StaticResource LabelStyle}" />
                            <NumberBox Value="{x:Bind ViewModel.ChunkSize, Mode=TwoWay}"
                                       Minimum="128" Maximum="2048" SpinButtonPlacementMode="Compact" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock x:Uid="Settings_ChunkOverlap" Text="Chunk Overlap"
                                       Style="{StaticResource LabelStyle}" />
                            <NumberBox Value="{x:Bind ViewModel.ChunkOverlap, Mode=TwoWay}"
                                       Minimum="0" Maximum="256" SpinButtonPlacementMode="Compact" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock x:Uid="Settings_TopKResults" Text="Top-K Results"
                                       Style="{StaticResource LabelStyle}" />
                            <NumberBox Value="{x:Bind ViewModel.TopKResults, Mode=TwoWay}"
                                       Minimum="1" Maximum="20" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </Grid>

                    <ToggleSwitch x:Uid="Settings_AutoIndexWatchFolders" Header="Auto-index watch folders"
                                  IsOn="{x:Bind ViewModel.AutoIndexWatchFolders, Mode=TwoWay}" />
                </StackPanel>
            </controls:Faceplate>

            <!-- ════════════════════════════════════════════════════════
                 LICENSE
                 ════════════════════════════════════════════════════════ -->
            <controls:Faceplate Grid.Row="7" Kicker="MOD - RSRCH - 07">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="Settings_ResearchMode" Text="Research Mode"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <TextBlock x:Uid="Settings_AugmentAiAnswersWith" Text="Augment AI answers with live web sources. When enabled, queries will search the web and blend results with your local Knowledge Vault."
                               Style="{StaticResource BodySecondaryStyle}"
                               TextWrapping="Wrap" />

                    <ToggleSwitch x:Uid="Settings_EnableResearchMode" Header="Enable Research Mode"
                                  IsOn="{x:Bind ViewModel.EnableResearchMode, Mode=TwoWay}"
                                  OffContent="Local vault only"
                                  OnContent="Local vault + web search" />

                    <StackPanel Spacing="12"
                                Visibility="{x:Bind ViewModel.EnableResearchMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="Settings_SearchProvider" Text="Search Provider"
                                       Style="{StaticResource LabelStyle}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.WebSearchProviders, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedWebSearchProvider, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      MinWidth="200" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="Settings_SearchApiKey" Text="Search API Key"
                                       Style="{StaticResource LabelStyle}" />
                            <PasswordBox Password="{x:Bind ViewModel.WebSearchApiKey, Mode=TwoWay}"
                                         x:Uid="Settings_EnterYourSearchApiPh" PlaceholderText="Enter your search API key"
                                         CornerRadius="{StaticResource RadiusXS}"
                                         MinHeight="40" />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Settings_MaxSearchResults" Text="Max Search Results"
                                           Style="{StaticResource LabelStyle}" />
                                <NumberBox Value="{x:Bind ViewModel.MaxSearchResults, Mode=TwoWay}"
                                           Minimum="1" Maximum="20" SpinButtonPlacementMode="Compact" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock x:Uid="Settings_CacheDurationMinutes" Text="Cache Duration (minutes)"
                                           Style="{StaticResource LabelStyle}" />
                                <NumberBox Value="{x:Bind ViewModel.SearchCacheTtlMinutes, Mode=TwoWay}"
                                           Minimum="5" Maximum="1440" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </controls:Faceplate>

            <!-- ════════════════════════════════════════════════════════
                 STORAGE
                 ════════════════════════════════════════════════════════ -->
            <controls:Faceplate Grid.Row="8" Kicker="MOD - STOR - 08">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Settings_Storage" Text="Storage"
                               Style="{StaticResource HeadingSmallStyle}" />
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Settings_DataLocation" Text="Data Location"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.StoragePath, Mode=OneWay}"
                                   Style="{StaticResource MonoSmallStyle}"
                                   IsTextSelectionEnabled="True" />
                    </StackPanel>
                </StackPanel>
            </controls:Faceplate>

            <!-- ════════════════════════════════════════════════════════
                 DATABASE ENCRYPTION
                 ════════════════════════════════════════════════════════ -->
            <controls:Faceplate Grid.Row="9" Kicker="MOD - CRYPT - 09">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Encryption_SectionHeader"
                               Text="Database Encryption"
                               Style="{StaticResource HeadingSmallStyle}" />
                    <TextBlock x:Uid="Encryption_Description"
                               Text="Encrypt your knowledge vault with AES-256 (SQLCipher). The key is managed automatically and tied to your Windows account."
                               Style="{StaticResource BodySecondaryStyle}"
                               TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="EncryptionToggle"
                                  x:Uid="Settings_Encrypted" OnContent="Encrypted"
                                  OffContent="Not encrypted"
                                  IsOn="{x:Bind ViewModel.EncryptionEnabled, Mode=TwoWay}"
                                  Toggled="EncryptionToggle_Toggled" />
                    <TextBlock Text="{x:Bind ViewModel.EncryptionStatus, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </controls:Faceplate>

            <!-- ════════════════════════════════════════════════════════
                 CONNECTIONS (Local REST API / Browser Extension)
                 ════════════════════════════════════════════════════════ -->
            <controls:Faceplate Grid.Row="10" Kicker="MOD - API - 10">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="Settings_Connections" Text="Connections"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <TextBlock Text="The local API lets the AgentX browser extension clip web pages into your Smart Inbox. It runs on http://localhost:9846 and requires the token below — paste it into the extension popup to pair. Only the AgentX extension can use it; web pages are blocked."
                               Style="{StaticResource BodySecondaryStyle}"
                               TextWrapping="Wrap" />

                    <ToggleSwitch x:Uid="Settings_EnableLocalApi" Header="Enable Local API"
                                  IsOn="{x:Bind ViewModel.LocalApiEnabled, Mode=TwoWay}"
                                  OffContent="Disabled"
                                  OnContent="Enabled (authenticated)" />

                    <StackPanel Spacing="6"
                                Visibility="{x:Bind ViewModel.LocalApiEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Uid="Settings_ApiToken" Text="API Token"
                                   Style="{StaticResource LabelStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{x:Bind ViewModel.LocalApiToken, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="{StaticResource FontMono}"
                                     x:Uid="Settings_NoTokenYetClickPh" PlaceholderText="No token yet — click Regenerate" />

                            <Button Grid.Column="1"
                                    x:Uid="Settings_Copy" Content="Copy"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{x:Bind ViewModel.CopyApiTokenCommand}" />

                            <Button Grid.Column="2"
                                    x:Uid="Settings_Regenerate" Content="Regenerate"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{x:Bind ViewModel.RegenerateApiTokenCommand}" />
                        </Grid>
                        <TextBlock x:Uid="Settings_KeepThisTokenSecret" Text="Keep this token secret. Regenerating it unpairs existing clients until you paste the new token. Toggle changes apply on next launch."
                                   Style="{StaticResource CaptionStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </controls:Faceplate>

            <!-- ════════════════════════════════════════════════════════
                 ACTIONS
                 ════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="11" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Uid="Settings_SaveSettings" Content="Save Settings"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveSettingsCommand}" />

                <Button Grid.Column="1"
                        x:Uid="Settings_ResetToDefaults" Content="Reset to Defaults"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnResetToDefaultsClick" />

                <TextBlock Grid.Column="3"
                           Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center">
                    <Run Text="Agent-X v" />
                    <Run Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" />
                </TextBlock>
            </Grid>

        </Grid>
    </ScrollViewer>
</Page>
