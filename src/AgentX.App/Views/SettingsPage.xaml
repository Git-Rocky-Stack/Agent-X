<Page
    x:Class="AgentX.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <Grid Padding="{StaticResource PaddingPage}" RowSpacing="24" MaxWidth="800">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Settings"
                           Style="{StaticResource DisplaySmallStyle}" />
                <TextBlock Text="Configure your AI providers, inference parameters, and knowledge vault settings."
                           Style="{StaticResource BodySecondaryStyle}" />
            </StackPanel>

            <!-- ════════════════════════════════════════════════════════
                 AI PROVIDERS
                 ════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <TextBlock Text="AI Providers"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <!-- Encryption Status -->
                    <InfoBar IsOpen="{x:Bind ViewModel.AreKeysEncrypted, Mode=OneWay}"
                             Severity="Success"
                             Title="API Keys Secured"
                             Message="{x:Bind ViewModel.EncryptionStatusDescription, Mode=OneWay}"
                             IsClosable="False" />

                    <!-- Active Provider Selector -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Active Provider"
                                   Style="{StaticResource LabelStyle}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.ProviderOptions}"
                                  SelectedIndex="{x:Bind ViewModel.ActiveProviderIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  MinWidth="200" />
                    </StackPanel>

                    <!-- Separator -->
                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- ── Ollama (Local) ─────────────────────────── -->
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Ollama (Local)"
                                       Style="{StaticResource HeadingSmallStyle}"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource BadgeSuccessStyle}">
                                <TextBlock Text="FREE"
                                           Style="{StaticResource BadgeStyle}"
                                           Foreground="{ThemeResource SuccessBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Endpoint"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{x:Bind ViewModel.OllamaEndpoint, Mode=TwoWay}"
                                     PlaceholderText="http://localhost:11434" />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Default Chat Model"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{x:Bind ViewModel.DefaultModel, Mode=TwoWay}"
                                         PlaceholderText="llama3.2" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Embedding Model"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{x:Bind ViewModel.EmbeddingModel, Mode=TwoWay}"
                                         PlaceholderText="all-minilm" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Test Connection"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{x:Bind ViewModel.TestOllamaConnectionCommand}" />
                            <TextBlock Text="{x:Bind ViewModel.OllamaConnectionStatus, Mode=OneWay}"
                                       Style="{StaticResource BodySmallStyle}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.OllamaConnectionStatus, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- ── OpenAI ─────────────────────────────────── -->
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="OpenAI"
                                       Style="{StaticResource HeadingSmallStyle}"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource BadgeDefaultStyle}">
                                <TextBlock Text="CLOUD"
                                           Style="{StaticResource BadgeStyle}"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="API Key"
                                       Style="{StaticResource LabelStyle}" />
                            <PasswordBox Password="{x:Bind ViewModel.OpenAiApiKey, Mode=TwoWay}"
                                         PlaceholderText="sk-..."
                                         CornerRadius="{StaticResource RadiusMD}"
                                         MinHeight="40" />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Endpoint"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{x:Bind ViewModel.OpenAiEndpoint, Mode=TwoWay}"
                                         PlaceholderText="https://api.openai.com/v1/" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Default Model"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{x:Bind ViewModel.OpenAiDefaultModel, Mode=TwoWay}"
                                         PlaceholderText="gpt-4o-mini" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Test Connection"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{x:Bind ViewModel.TestOpenAiConnectionCommand}" />
                            <TextBlock Text="{x:Bind ViewModel.OpenAiConnectionStatus, Mode=OneWay}"
                                       Style="{StaticResource BodySmallStyle}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.OpenAiConnectionStatus, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- ── Anthropic Claude ────────────────────────── -->
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Anthropic Claude"
                                       Style="{StaticResource HeadingSmallStyle}"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource BadgeDefaultStyle}">
                                <TextBlock Text="CLOUD"
                                           Style="{StaticResource BadgeStyle}"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="API Key"
                                       Style="{StaticResource LabelStyle}" />
                            <PasswordBox Password="{x:Bind ViewModel.AnthropicApiKey, Mode=TwoWay}"
                                         PlaceholderText="sk-ant-..."
                                         CornerRadius="{StaticResource RadiusMD}"
                                         MinHeight="40" />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Endpoint"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{x:Bind ViewModel.AnthropicEndpoint, Mode=TwoWay}"
                                         PlaceholderText="https://api.anthropic.com/v1/" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Default Model"
                                           Style="{StaticResource LabelStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{x:Bind ViewModel.AnthropicDefaultModel, Mode=TwoWay}"
                                         PlaceholderText="claude-sonnet-4-20250514" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Note: Anthropic does not support embeddings. Use Ollama or OpenAI for document indexing."
                                   Style="{StaticResource CaptionStyle}" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Test Connection"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{x:Bind ViewModel.TestAnthropicConnectionCommand}" />
                            <TextBlock Text="{x:Bind ViewModel.AnthropicConnectionStatus, Mode=OneWay}"
                                       Style="{StaticResource BodySmallStyle}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.AnthropicConnectionStatus, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════
                 APPEARANCE
                 ════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Appearance"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Theme"
                                   Style="{StaticResource LabelStyle}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                  SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  MinWidth="200" />
                        <TextBlock Text="Changes apply immediately. 'System Default' follows your Windows theme."
                                   Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════
                 COST TRACKING
                 ════════════════════════════════════════════════════════ -->
            <!-- Multi-Model Routing section -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Multi-Model Routing"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <TextBlock Text="Automatically route prompts to the best AI model based on task type. Extraction and chat prefer fast local models; analysis and code prefer quality cloud models."
                               Style="{StaticResource BodySecondaryStyle}"
                               TextWrapping="Wrap" />

                    <ToggleSwitch Header="Enable Auto-Routing"
                                  IsOn="{x:Bind ViewModel.EnableModelRouting, Mode=TwoWay}" />

                    <StackPanel Spacing="6"
                                Visibility="{x:Bind ViewModel.EnableModelRouting, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Routing Profile"
                                   Style="{StaticResource LabelStyle}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.RoutingProfileOptions}"
                                  SelectedIndex="{x:Bind ViewModel.RoutingProfileIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  MinWidth="200"
                                  IsEnabled="{x:Bind ViewModel.EnableModelRouting, Mode=OneWay}" />

                        <StackPanel Spacing="4" Padding="4,0,0,0">
                            <TextBlock Text="Cost Optimized — Local models for all tasks, cloud only as fallback"
                                       Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="Quality Optimized — Cloud models for analysis, code, creative"
                                       Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="Balanced — Local for simple tasks, cloud for quality-critical tasks"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Cost Tracking"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <TextBlock Text="Estimated API costs for cloud providers. Local Ollama models are free."
                               Style="{StaticResource BodySmallStyle}" />

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Total Cost -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="TOTAL SPEND"
                                       Style="{StaticResource OverlineStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalCostDisplay, Mode=OneWay}"
                                       Style="{StaticResource MetricSmallStyle}" />
                        </StackPanel>

                        <!-- Today's Cost -->
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="TODAY"
                                       Style="{StaticResource OverlineStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TodayCostDisplay, Mode=OneWay}"
                                       Style="{StaticResource MetricSmallStyle}" />
                        </StackPanel>

                        <!-- Total Tokens -->
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="TOTAL TOKENS"
                                       Style="{StaticResource OverlineStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalTokensDisplay, Mode=OneWay}"
                                       Style="{StaticResource MetricSmallStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════
                 INFERENCE PARAMETERS
                 ════════════════════════════════════════════════════════ -->
            <Border Grid.Row="5" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <TextBlock Text="Inference"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Temperature"
                                       Style="{StaticResource LabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Temperature, Mode=OneWay}"
                                       Style="{StaticResource MonoSmallStyle}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="0" Maximum="2" StepFrequency="0.1"
                                Value="{x:Bind ViewModel.Temperature, Mode=TwoWay}" />
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Max Tokens"
                                       Style="{StaticResource LabelStyle}" />
                            <NumberBox Value="{x:Bind ViewModel.MaxTokens, Mode=TwoWay}"
                                       Minimum="256" Maximum="32768" SpinButtonPlacementMode="Compact" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Context Window"
                                       Style="{StaticResource LabelStyle}" />
                            <NumberBox Value="{x:Bind ViewModel.ContextWindow, Mode=TwoWay}"
                                       Minimum="2048" Maximum="131072" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════
                 KNOWLEDGE VAULT
                 ════════════════════════════════════════════════════════ -->
            <Border Grid.Row="6" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <TextBlock Text="Knowledge Vault"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Chunk Size (tokens)"
                                       Style="{StaticResource LabelStyle}" />
                            <NumberBox Value="{x:Bind ViewModel.ChunkSize, Mode=TwoWay}"
                                       Minimum="128" Maximum="2048" SpinButtonPlacementMode="Compact" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Chunk Overlap"
                                       Style="{StaticResource LabelStyle}" />
                            <NumberBox Value="{x:Bind ViewModel.ChunkOverlap, Mode=TwoWay}"
                                       Minimum="0" Maximum="256" SpinButtonPlacementMode="Compact" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Top-K Results"
                                       Style="{StaticResource LabelStyle}" />
                            <NumberBox Value="{x:Bind ViewModel.TopKResults, Mode=TwoWay}"
                                       Minimum="1" Maximum="20" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </Grid>

                    <ToggleSwitch Header="Auto-index watch folders"
                                  IsOn="{x:Bind ViewModel.AutoIndexWatchFolders, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════
                 LICENSE
                 ════════════════════════════════════════════════════════ -->
            <Border Grid.Row="7" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Research Mode"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <TextBlock Text="Augment AI answers with live web sources. When enabled, queries will search the web and blend results with your local Knowledge Vault."
                               Style="{StaticResource BodySecondaryStyle}"
                               TextWrapping="Wrap" />

                    <ToggleSwitch Header="Enable Research Mode"
                                  IsOn="{x:Bind ViewModel.EnableResearchMode, Mode=TwoWay}"
                                  OffContent="Local vault only"
                                  OnContent="Local vault + web search" />

                    <StackPanel Spacing="12"
                                Visibility="{x:Bind ViewModel.EnableResearchMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Search Provider"
                                       Style="{StaticResource LabelStyle}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.WebSearchProviders, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedWebSearchProvider, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      MinWidth="200" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Search API Key"
                                       Style="{StaticResource LabelStyle}" />
                            <PasswordBox Password="{x:Bind ViewModel.WebSearchApiKey, Mode=TwoWay}"
                                         PlaceholderText="Enter your search API key"
                                         CornerRadius="{StaticResource RadiusMD}"
                                         MinHeight="40" />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Max Search Results"
                                           Style="{StaticResource LabelStyle}" />
                                <NumberBox Value="{x:Bind ViewModel.MaxSearchResults, Mode=TwoWay}"
                                           Minimum="1" Maximum="20" SpinButtonPlacementMode="Compact" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Cache Duration (minutes)"
                                           Style="{StaticResource LabelStyle}" />
                                <NumberBox Value="{x:Bind ViewModel.SearchCacheTtlMinutes, Mode=TwoWay}"
                                           Minimum="5" Maximum="1440" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════
                 STORAGE
                 ════════════════════════════════════════════════════════ -->
            <Border Grid.Row="8" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Storage"
                               Style="{StaticResource HeadingSmallStyle}" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="Data Location"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.StoragePath, Mode=OneWay}"
                                   Style="{StaticResource MonoSmallStyle}"
                                   IsTextSelectionEnabled="True" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════
                 DATABASE ENCRYPTION
                 ════════════════════════════════════════════════════════ -->
            <Border Grid.Row="9" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Encryption_SectionHeader"
                               Text="Database Encryption"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="Encryption_Description"
                               Text="Encrypt your knowledge vault with AES-256 (SQLCipher). The key is managed automatically and tied to your Windows account."
                               TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="EncryptionToggle"
                                  OnContent="Encrypted"
                                  OffContent="Not encrypted"
                                  IsOn="{x:Bind ViewModel.EncryptionEnabled, Mode=TwoWay}"
                                  Toggled="EncryptionToggle_Toggled" />
                    <TextBlock Text="{x:Bind ViewModel.EncryptionStatus, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════
                 CONNECTIONS (Local REST API / Browser Extension)
                 ════════════════════════════════════════════════════════ -->
            <Border Grid.Row="10" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Connections"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <TextBlock Text="The local API lets the AgentX browser extension clip web pages into your Smart Inbox. It runs on http://localhost:9846 and requires the token below — paste it into the extension popup to pair. Only the AgentX extension can use it; web pages are blocked."
                               Style="{StaticResource BodySecondaryStyle}"
                               TextWrapping="Wrap" />

                    <ToggleSwitch Header="Enable Local API"
                                  IsOn="{x:Bind ViewModel.LocalApiEnabled, Mode=TwoWay}"
                                  OffContent="Disabled"
                                  OnContent="Enabled (authenticated)" />

                    <StackPanel Spacing="6"
                                Visibility="{x:Bind ViewModel.LocalApiEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="API Token"
                                   Style="{StaticResource LabelStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{x:Bind ViewModel.LocalApiToken, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     PlaceholderText="No token yet — click Regenerate" />

                            <Button Grid.Column="1"
                                    Content="Copy"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{x:Bind ViewModel.CopyApiTokenCommand}" />

                            <Button Grid.Column="2"
                                    Content="Regenerate"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{x:Bind ViewModel.RegenerateApiTokenCommand}" />
                        </Grid>
                        <TextBlock Text="Keep this token secret. Regenerating it unpairs existing clients until you paste the new token. Toggle changes apply on next launch."
                                   Style="{StaticResource CaptionStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════
                 ACTIONS
                 ════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="11" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="Save Settings"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveSettingsCommand}" />

                <Button Grid.Column="1"
                        Content="Reset to Defaults"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnResetToDefaultsClick" />

                <TextBlock Grid.Column="3"
                           Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center">
                    <Run Text="Agent-X v" />
                    <Run Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" />
                </TextBlock>
            </Grid>

        </Grid>
    </ScrollViewer>
</Page>
