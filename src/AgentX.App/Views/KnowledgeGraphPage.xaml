<Page
    x:Class="AgentX.App.Views.KnowledgeGraphPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:AgentX.App.Converters"
    xmlns:local="using:AgentX.App.Views"
    Background="Transparent"
    NavigationCacheMode="Disabled">

    <Page.Resources>

        <!-- =============================================================
             CONVERTERS
             ============================================================= -->

        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NullToVisibilityConverter x:Key="InverseNullToVis" IsInverted="True" />

    </Page.Resources>

    <!-- =============================================================
         ROOT LAYOUT: 2-column grid (graph canvas + detail sidebar)
         ============================================================= -->

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <!-- Main graph area -->
            <ColumnDefinition Width="*" />
            <!-- Detail sidebar (visible when node selected) -->
            <ColumnDefinition x:Name="DetailColumnDef" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- =============================================================
             COLUMN 0: MAIN GRAPH AREA
             ============================================================= -->

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto" />
                <!-- Graph canvas -->
                <RowDefinition Height="*" />
                <!-- Legend + Filters footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==========================================================
                 ROW 0: PAGE HEADER
                 ========================================================== -->

            <Border Grid.Row="0"
                    Padding="32,24,32,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Title + Description -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Node Search -->
                        <ColumnDefinition Width="*" />
                        <!-- Stat badges + Refresh button -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title block -->
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Knowledge Graph"
                                   Style="{StaticResource DisplaySmallStyle}" />
                        <TextBlock Text="Visualize relationships between documents, collections, and tags."
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <!-- Node Search -->
                    <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="24,0,24,0" MinWidth="220" MaxWidth="340">
                        <TextBox x:Name="GraphSearchBox"
                                 PlaceholderText="Search nodes..."
                                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="36,8,12,8"
                                 CornerRadius="{StaticResource RadiusMD}" />
                        <FontIcon Glyph="&#xE721;" FontSize="14"
                                  Foreground="{StaticResource TextTertiaryBrush}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Margin="12,0,0,0" IsHitTestVisible="False" />
                        <!-- Search match count badge -->
                        <Border Background="{StaticResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusSM}"
                                Padding="6,2,6,2"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Visibility="{x:Bind ViewModel.HasSearchResults, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource MonoSmallStyle}"
                                       Foreground="{StaticResource TextAccentBrush}"
                                       Text="{x:Bind local:KnowledgeGraphPage.FormatMatchCount(ViewModel.SearchMatchCount), Mode=OneWay}" />
                        </Border>
                    </Grid>

                    <!-- Stats + Refresh -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">

                        <!-- Document count badge -->
                        <Border Style="{StaticResource StatBadgeStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="#3B82F6" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{x:Bind ViewModel.DocumentCount, Mode=OneWay}" />
                                    <Run Text="Docs" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Collection count badge -->
                        <Border Style="{StaticResource StatBadgeStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="#8B5CF6" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{x:Bind ViewModel.CollectionCount, Mode=OneWay}" />
                                    <Run Text="Collections" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Tag count badge -->
                        <Border Style="{StaticResource StatBadgeStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="#F59E0B" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{x:Bind ViewModel.TagCount, Mode=OneWay}" />
                                    <Run Text="Tags" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Connections count badge -->
                        <Border Style="{StaticResource BadgeDefaultStyle}">
                            <TextBlock Style="{StaticResource MonoSmallStyle}"
                                       Foreground="{StaticResource TextTertiaryBrush}">
                                <Run Text="{x:Bind ViewModel.EdgeCount, Mode=OneWay}" />
                                <Run Text="connections" />
                            </TextBlock>
                        </Border>

                        <!-- Refresh button -->
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,8,12,8"
                                MinHeight="36"
                                Command="{x:Bind ViewModel.RefreshGraphCommand}"
                                ToolTipService.ToolTip="Rebuild the knowledge graph">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Refresh" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==========================================================
                 ROW 1: GRAPH CANVAS AREA
                 ========================================================== -->

            <Grid Grid.Row="1" Margin="32,0,32,0">

                <!-- Graph canvas container with card styling -->
                <Border Style="{StaticResource CardInsetStyle}"
                        Padding="0"
                        CornerRadius="{StaticResource RadiusLG}">

                    <!-- The Canvas for programmatic graph rendering -->
                    <Canvas x:Name="GraphCanvas"
                            Background="Transparent"
                            SizeChanged="GraphCanvas_SizeChanged"
                            PointerPressed="GraphCanvas_PointerPressed"
                            PointerWheelChanged="GraphCanvas_PointerWheelChanged" />
                </Border>

                <!-- Loading overlay -->
                <Border Background="{StaticResource PageBackgroundBrush}"
                        Opacity="0.85"
                        CornerRadius="{StaticResource RadiusLG}"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <ProgressRing IsActive="True"
                                      Width="40" Height="40"
                                      Foreground="{StaticResource AccentPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource BodySecondaryStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Zoom Controls Overlay (bottom-right) -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,16,16"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="{StaticResource RadiusMD}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        Padding="4">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Padding="8,6,8,6" MinHeight="32" MinWidth="32"
                                Command="{x:Bind ViewModel.ZoomOutCommand}"
                                ToolTipService.ToolTip="Zoom Out">
                            <FontIcon Glyph="&#xE738;" FontSize="14" />
                        </Button>

                        <TextBlock Style="{StaticResource MonoSmallStyle}"
                                   VerticalAlignment="Center"
                                   MinWidth="40" TextAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{x:Bind local:KnowledgeGraphPage.FormatZoom(ViewModel.ZoomLevel), Mode=OneWay}" />

                        <Button Style="{StaticResource GhostButtonStyle}"
                                Padding="8,6,8,6" MinHeight="32" MinWidth="32"
                                Command="{x:Bind ViewModel.ZoomInCommand}"
                                ToolTipService.ToolTip="Zoom In">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>

                        <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="2,4,2,4" />

                        <Button Style="{StaticResource GhostButtonStyle}"
                                Padding="8,6,8,6" MinHeight="32" MinWidth="32"
                                Command="{x:Bind ViewModel.ResetZoomCommand}"
                                ToolTipService.ToolTip="Reset Zoom">
                            <FontIcon Glyph="&#xE9A6;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Hover Tooltip -->
                <Border x:Name="NodeTooltip"
                        Visibility="Collapsed"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="{StaticResource RadiusMD}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        Padding="12,8,12,8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TooltipLabel"
                                   Style="{StaticResource BodySmallStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="TooltipTypeIndicator" Width="8" Height="8" VerticalAlignment="Center" />
                            <TextBlock x:Name="TooltipType"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="TooltipConnections"
                                   Style="{StaticResource CaptionStyle}"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Empty state overlay (no nodes) -->
                <Border Visibility="{x:Bind ShowEmptyState(ViewModel.IsLoading, ViewModel.GraphData), Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <Border Background="{StaticResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusRound}"
                                Width="72" Height="72"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE9D9;"
                                      FontSize="32"
                                      Foreground="{StaticResource TextAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="No Graph Data"
                                       Style="{StaticResource HeadingMediumStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Import documents and organize them into collections to see relationships visualized here."
                                       Style="{StaticResource BodySecondaryStyle}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="380" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==========================================================
                 ROW 2: LEGEND + FILTER TOGGLES
                 ========================================================== -->

            <Border Grid.Row="2"
                    Padding="32,12,32,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Legend -->
                        <ColumnDefinition Width="*" />
                        <!-- Filter toggles -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Legend -->
                    <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">

                        <TextBlock Text="LEGEND"
                                   Style="{StaticResource OverlineStyle}"
                                   VerticalAlignment="Center" />

                        <!-- Document legend item -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="10" Height="10" Fill="#3B82F6" VerticalAlignment="Center" />
                            <TextBlock Text="Document"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Collection legend item -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="10" Height="10" Fill="#8B5CF6" VerticalAlignment="Center" />
                            <TextBlock Text="Collection"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Tag legend item -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="10" Height="10" Fill="#F59E0B" VerticalAlignment="Center" />
                            <TextBlock Text="Tag"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Status message -->
                        <Border Style="{StaticResource BadgeDefaultStyle}"
                                Padding="8,3,8,3"
                                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       Style="{StaticResource MonoSmallStyle}"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                        </Border>

                        <!-- Cluster highlight indicator -->
                        <Border Background="{StaticResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusRound}"
                                Padding="10,4,6,4"
                                Visibility="{x:Bind ViewModel.IsClusterHighlighted, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Cluster Active"
                                           Style="{StaticResource CaptionStyle}"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Padding="4,2,4,2" MinHeight="20" MinWidth="20"
                                        Command="{x:Bind ViewModel.ClearClusterHighlightCommand}"
                                        ToolTipService.ToolTip="Clear cluster highlight">
                                    <FontIcon Glyph="&#xE711;" FontSize="10"
                                              Foreground="{StaticResource TextAccentBrush}" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Filter Toggles -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">

                        <TextBlock Text="SHOW"
                                   Style="{StaticResource OverlineStyle}"
                                   VerticalAlignment="Center" />

                        <CheckBox x:Name="ShowDocsToggle"
                                  Content="Documents"
                                  IsChecked="{x:Bind ViewModel.ShowDocuments, Mode=TwoWay}"
                                  Checked="OnFilterToggleChanged"
                                  Unchecked="OnFilterToggleChanged"
                                  MinWidth="0"
                                  MinHeight="0"
                                  Padding="4,0,0,0" />

                        <CheckBox x:Name="ShowCollectionsToggle"
                                  Content="Collections"
                                  IsChecked="{x:Bind ViewModel.ShowCollections, Mode=TwoWay}"
                                  Checked="OnFilterToggleChanged"
                                  Unchecked="OnFilterToggleChanged"
                                  MinWidth="0"
                                  MinHeight="0"
                                  Padding="4,0,0,0" />

                        <CheckBox x:Name="ShowTagsToggle"
                                  Content="Tags"
                                  IsChecked="{x:Bind ViewModel.ShowTags, Mode=TwoWay}"
                                  Checked="OnFilterToggleChanged"
                                  Unchecked="OnFilterToggleChanged"
                                  MinWidth="0"
                                  MinHeight="0"
                                  Padding="4,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- =============================================================
             COLUMN 1: NODE DETAIL SIDEBAR
             ============================================================= -->

        <Grid x:Name="DetailSidebar"
              Grid.Column="1"
              Background="{StaticResource SidebarGradientBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="1,0,0,0"
              Visibility="{x:Bind ViewModel.SelectedNode, Mode=OneWay, Converter={StaticResource NullToVis}}">

            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto" />
                <!-- Content -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Sidebar Header -->
            <Border Grid.Row="0"
                    Style="{StaticResource SidebarHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="14"
                                  Foreground="{StaticResource TextTertiaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Node Details"
                                   Style="{StaticResource HeadingSmallStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="8,4,8,4" MinHeight="28"
                            Command="{x:Bind ViewModel.ClearSelectionCommand}"
                            ToolTipService.ToolTip="Close details panel">
                        <FontIcon Glyph="&#xE711;" FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Sidebar Content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="16,12,16,16">
                <StackPanel Spacing="16">

                    <!-- Node Type Badge -->
                    <Border x:Name="NodeTypeBadge"
                            CornerRadius="{StaticResource RadiusRound}"
                            Padding="12,5,12,5"
                            HorizontalAlignment="Left">
                        <TextBlock x:Name="NodeTypeText"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   CharacterSpacing="60" />
                    </Border>

                    <!-- Node Label -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="NAME"
                                   Style="{StaticResource OverlineStyle}" />
                        <TextBlock x:Name="NodeLabelText"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Subtitle -->
                    <StackPanel Spacing="4"
                                x:Name="SubtitlePanel">
                        <TextBlock Text="TYPE"
                                   Style="{StaticResource OverlineStyle}" />
                        <TextBlock x:Name="NodeSubtitleText"
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- Connection count -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="CONNECTIONS"
                                   Style="{StaticResource OverlineStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="NodeConnectionCountText"
                                       Style="{StaticResource MetricSmallStyle}" />
                            <TextBlock Text="edges"
                                       Style="{StaticResource CaptionStyle}"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,4" />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- Position info -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="POSITION"
                                   Style="{StaticResource OverlineStyle}" />
                        <TextBlock x:Name="NodePositionText"
                                   Style="{StaticResource MonoSmallStyle}" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</Page>
