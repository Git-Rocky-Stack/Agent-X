<Page
    x:Class="AgentX.App.Views.PrivacyPolicyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AgentX.App.Controls"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">

        <Grid Padding="{StaticResource PaddingPage}"
              RowSpacing="20"
              MaxWidth="760"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Row 0: Header -->
                <RowDefinition Height="Auto" />  <!-- Row 1: Local-First Banner -->
                <RowDefinition Height="Auto" />  <!-- Row 2: Our Commitment -->
                <RowDefinition Height="Auto" />  <!-- Row 3: Information We Collect -->
                <RowDefinition Height="Auto" />  <!-- Row 4: How Data Is Stored -->
                <RowDefinition Height="Auto" />  <!-- Row 5: Third-Party Services -->
                <RowDefinition Height="Auto" />  <!-- Row 6: GDPR Rights -->
                <RowDefinition Height="Auto" />  <!-- Row 7: CCPA Rights -->
                <RowDefinition Height="Auto" />  <!-- Row 8: Data Security -->
                <RowDefinition Height="Auto" />  <!-- Row 9: Children's Privacy -->
                <RowDefinition Height="Auto" />  <!-- Row 10: Changes -->
                <RowDefinition Height="Auto" />  <!-- Row 11: Contact Us -->
                <RowDefinition Height="Auto" />  <!-- Row 12: Footer -->
            </Grid.RowDefinitions>


            <!-- ==========================================================
                 ROW 0: PAGE HEADER
                 ========================================================== -->
            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock x:Uid="Privacy_PrivacyPolicy" Text="Privacy Policy"
                           Style="{StaticResource DisplaySmallStyle}"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource BodySecondaryStyle}">
                    <Run x:Uid="Privacy_EffectiveDateFebruary26" Text="Effective Date: February 26, 2026" />
                </TextBlock>
                <TextBlock x:Uid="Privacy_StrategiaXWeUs" Text="Strategia-X ('we', 'us', 'our') operates Agent-X. This Privacy Policy explains how we handle your information when you use our desktop application."
                           Style="{StaticResource BodyStyle}"
                           Margin="0,4,0,0" />
            </StackPanel>


            <!-- ==========================================================
                 ROW 1: LOCAL-FIRST PRIVACY BANNER
                 ========================================================== -->
            <controls:Faceplate Grid.Row="1" Kicker="MOD - PRIV - 01">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Shield Icon -->
                    <Border Grid.Column="0"
                            Background="{ThemeResource AccentSubtleBrush}"
                            CornerRadius="{StaticResource RadiusMD}"
                            Width="44" Height="44"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEA18;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{ThemeResource TextAccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <!-- Banner Text -->
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Uid="Privacy_LocalFirstPrivacy" Text="Local-First Privacy"
                                   Style="{StaticResource HeadingSmallStyle}"
                                   Foreground="{ThemeResource TextAccentBrush}" />
                        <TextBlock x:Uid="Privacy_YourDataNeverLeaves" Text="Your data never leaves your device. All AI processing, document storage, and conversations remain entirely on your machine."
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <!-- Badge -->
                    <Border Grid.Column="2"
                            Style="{StaticResource BadgeAccentStyle}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="10"
                                      Foreground="{ThemeResource TextAccentBrush}" />
                            <TextBlock x:Uid="Privacy_Verified" Text="VERIFIED"
                                       Style="{StaticResource BadgeStyle}"
                                       Foreground="{ThemeResource TextAccentBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </controls:Faceplate>


            <!-- ==========================================================
                 ROW 2: OUR COMMITMENT TO PRIVACY
                 ========================================================== -->
            <controls:Faceplate Grid.Row="2" Kicker="MOD - PRIV - 02">
                <StackPanel Spacing="16">

                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{ThemeResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusSM}"
                                Width="32" Height="32">
                            <FontIcon Glyph="&#xE72E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Uid="Privacy_OurCommitmentToPrivacy" Text="Our Commitment to Privacy"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Privacy_AgentXIsDesigned" Text="Agent-X is designed with privacy as a core principle. All your data &#x2014; documents, conversations, embeddings, and settings &#x2014; is stored locally on your device. We do not operate cloud servers that process or store your personal data." />

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               x:Uid="Privacy_OurLocalFirstArchitecture" Text="Our local-first architecture means you retain full ownership and control of every piece of information you create or import into Agent-X. There are no accounts to create, no data syncing, and no telemetry being transmitted." />
                </StackPanel>
            </controls:Faceplate>


            <!-- ==========================================================
                 ROW 3: INFORMATION WE COLLECT
                 ========================================================== -->
            <controls:Faceplate Grid.Row="3" Kicker="MOD - PRIV - 03">
                <StackPanel Spacing="20">

                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{ThemeResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusSM}"
                                Width="32" Height="32">
                            <FontIcon Glyph="&#xE9D5;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Uid="Privacy_InformationWeCollect" Text="Information We Collect"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>

                    <!-- Sub-section: Information You Provide -->
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="Privacy_InformationYouProvide" Text="Information You Provide"
                                   Style="{StaticResource HeadingSmallStyle}" />
                        <TextBlock x:Uid="Privacy_WhenYouUseAgent" Text="When you use Agent-X, the following information is created and stored locally on your device:"
                                   Style="{StaticResource BodySecondaryStyle}" />
                        <StackPanel Spacing="8" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x2022;"
                                           Style="{StaticResource BodyStyle}"
                                           Foreground="{ThemeResource TextAccentBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock x:Uid="Privacy_DocumentsYouImportInto" Text="Documents you import into the Knowledge Vault"
                                           Style="{StaticResource BodyStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x2022;"
                                           Style="{StaticResource BodyStyle}"
                                           Foreground="{ThemeResource TextAccentBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock x:Uid="Privacy_ConversationsWithAiModels" Text="Conversations with AI models"
                                           Style="{StaticResource BodyStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x2022;"
                                           Style="{StaticResource BodyStyle}"
                                           Foreground="{ThemeResource TextAccentBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock x:Uid="Privacy_SettingsAndPreferencesYou" Text="Settings and preferences you configure"
                                           Style="{StaticResource BodyStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x2022;"
                                           Style="{StaticResource BodyStyle}"
                                           Foreground="{ThemeResource TextAccentBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock x:Uid="Privacy_CollectionNamesAndOrganization" Text="Collection names and organizational tags"
                                           Style="{StaticResource BodyStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- Sub-section: Automatically Collected Information -->
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="Privacy_AutomaticallyCollectedInformat" Text="Automatically Collected Information"
                                   Style="{StaticResource HeadingSmallStyle}" />
                        <TextBlock x:Uid="Privacy_AgentXMayAutomatically" Text="Agent-X may automatically gather the following, all of which remains stored locally and is never transmitted:"
                                   Style="{StaticResource BodySecondaryStyle}" />
                        <StackPanel Spacing="8" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x2022;"
                                           Style="{StaticResource BodyStyle}"
                                           Foreground="{ThemeResource TextAccentBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock x:Uid="Privacy_ApplicationLogsStoredLocally" Text="Application logs (stored locally only)"
                                           Style="{StaticResource BodyStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x2022;"
                                           Style="{StaticResource BodyStyle}"
                                           Foreground="{ThemeResource TextAccentBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock x:Uid="Privacy_HardwareCapabilityInformationF" Text="Hardware capability information (for model recommendations)"
                                           Style="{StaticResource BodyStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x2022;"
                                           Style="{StaticResource BodyStyle}"
                                           Foreground="{ThemeResource TextAccentBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock x:Uid="Privacy_UsageStatisticsStoredLocally" Text="Usage statistics (stored locally, never transmitted)"
                                           Style="{StaticResource BodyStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- Sub-section: Information We Do NOT Collect -->
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="Privacy_InformationWeDoNot" Text="Information We Do NOT Collect"
                                   Style="{StaticResource HeadingSmallStyle}" />
                        <StackPanel Spacing="8" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE711;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="10"
                                          Foreground="{ThemeResource ErrorBrush}"
                                          VerticalAlignment="Top"
                                          Margin="0,5,0,0" />
                                <TextBlock x:Uid="Privacy_WeDoNotCollect" Text="We do not collect personal identification information"
                                           Style="{StaticResource BodyStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE711;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="10"
                                          Foreground="{ThemeResource ErrorBrush}"
                                          VerticalAlignment="Top"
                                          Margin="0,5,0,0" />
                                <TextBlock x:Uid="Privacy_WeDoNotTransmit" Text="We do not transmit data to external servers"
                                           Style="{StaticResource BodyStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE711;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="10"
                                          Foreground="{ThemeResource ErrorBrush}"
                                          VerticalAlignment="Top"
                                          Margin="0,5,0,0" />
                                <TextBlock x:Uid="Privacy_WeDoNotUse" Text="We do not use cookies or tracking technologies"
                                           Style="{StaticResource BodyStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE711;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="10"
                                          Foreground="{ThemeResource ErrorBrush}"
                                          VerticalAlignment="Top"
                                          Margin="0,5,0,0" />
                                <TextBlock x:Uid="Privacy_WeDoNotCollect2" Text="We do not collect payment information through the app"
                                           Style="{StaticResource BodyStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </controls:Faceplate>


            <!-- ==========================================================
                 ROW 4: HOW YOUR DATA IS STORED
                 ========================================================== -->
            <controls:Faceplate Grid.Row="4" Kicker="MOD - PRIV - 04">
                <StackPanel Spacing="16">

                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{ThemeResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusSM}"
                                Width="32" Height="32">
                            <FontIcon Glyph="&#xEDA2;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Uid="Privacy_HowYourDataIs" Text="How Your Data Is Stored"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               x:Uid="Privacy_AllDataGeneratedAnd" Text="All data generated and managed by Agent-X is stored locally on your device. There is no cloud component." />

                    <StackPanel Spacing="8" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#x2022;"
                                       Style="{StaticResource BodyStyle}"
                                       Foreground="{ThemeResource TextAccentBrush}"
                                       VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run x:Uid="Privacy_AllDataStoredIn" Text="All data stored in local SQLite databases on your device" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#x2022;"
                                       Style="{StaticResource BodyStyle}"
                                       Foreground="{ThemeResource TextAccentBrush}"
                                       VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run x:Uid="Privacy_DocumentEmbeddingsStoredIn" Text="Document embeddings stored in local vector database (sqlite-vec)" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#x2022;"
                                       Style="{StaticResource BodyStyle}"
                                       Foreground="{ThemeResource TextAccentBrush}"
                                       VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run x:Uid="Privacy_ApplicationLogsStoredIn" Text="Application logs stored in " />
                                <Run Text="%LOCALAPPDATA%\AgentX\Logs\"
                                     FontFamily="{StaticResource FontMono}"
                                     Foreground="{ThemeResource TextSecondaryBrush}"
                                     FontSize="12" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#x2022;"
                                       Style="{StaticResource BodyStyle}"
                                       Foreground="{ThemeResource TextAccentBrush}"
                                       VerticalAlignment="Top" />
                            <TextBlock x:Uid="Privacy_SettingsStoredLocallyNever" Text="Settings stored locally &#x2014; never synced to cloud"
                                       Style="{StaticResource BodyStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#x2022;"
                                       Style="{StaticResource BodyStyle}"
                                       Foreground="{ThemeResource TextAccentBrush}"
                                       VerticalAlignment="Top" />
                            <TextBlock x:Uid="Privacy_YouHaveFullControl" Text="You have full control: all data can be deleted by removing the application data folder"
                                       Style="{StaticResource BodyStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </controls:Faceplate>


            <!-- ==========================================================
                 ROW 5: THIRD-PARTY SERVICES
                 ========================================================== -->
            <controls:Faceplate Grid.Row="5" Kicker="MOD - PRIV - 05">
                <StackPanel Spacing="16">

                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{ThemeResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusSM}"
                                Width="32" Height="32">
                            <FontIcon Glyph="&#xE71B;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Uid="Privacy_ThirdPartyServices" Text="Third-Party Services"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>

                    <!-- Ollama Sub-section -->
                    <Border Style="{StaticResource CardInsetStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Privacy_OllamaLocalAiRuntime" Text="Ollama (Local AI Runtime)"
                                       Style="{StaticResource HeadingSmallStyle}" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Privacy_AgentXConnectsTo" Text="Agent-X connects to Ollama running locally on your machine. Ollama processes AI inference locally. No data is sent to external servers unless you explicitly configure a remote Ollama endpoint." />
                            <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                       x:Uid="Privacy_IfYouConfigureA" Text="If you configure a remote endpoint, data sent to that endpoint is governed by the remote server's privacy policy. We recommend using local inference for maximum privacy." />
                        </StackPanel>
                    </Border>

                    <!-- No Analytics -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="{ThemeResource SuccessBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Uid="Privacy_NoAnalyticsServices" Text="No Analytics Services"
                                       Style="{StaticResource AccentBodyStyle}"
                                       Foreground="{ThemeResource SuccessBrush}" />
                        </StackPanel>
                        <TextBlock x:Uid="Privacy_WeDoNotUse2" Text="We do not use Google Analytics, Mixpanel, or any third-party analytics services. No usage data is collected or transmitted."
                                   Style="{StaticResource BodySecondaryStyle}"
                                   Margin="22,0,0,0" />
                    </StackPanel>

                    <!-- No Advertising -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="{ThemeResource SuccessBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Uid="Privacy_NoAdvertising" Text="No Advertising"
                                       Style="{StaticResource AccentBodyStyle}"
                                       Foreground="{ThemeResource SuccessBrush}" />
                        </StackPanel>
                        <TextBlock x:Uid="Privacy_WeDoNotDisplay" Text="We do not display ads or share data with advertisers. Agent-X is a paid product; our users are our customers, not our product."
                                   Style="{StaticResource BodySecondaryStyle}"
                                   Margin="22,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </controls:Faceplate>


            <!-- ==========================================================
                 ROW 6: YOUR RIGHTS UNDER GDPR
                 ========================================================== -->
            <controls:Faceplate Grid.Row="6" Kicker="MOD - PRIV - 06">
                <StackPanel Spacing="16">

                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{ThemeResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusSM}"
                                Width="32" Height="32">
                            <FontIcon Glyph="&#xE909;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Uid="Privacy_YourRightsUnderGdpr" Text="Your Rights Under GDPR"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               x:Uid="Privacy_IfYouAreLocated" Text="If you are located in the European Economic Area (EEA), you have certain data protection rights under the General Data Protection Regulation (GDPR)." />

                    <!-- GDPR Rights Grid -->
                    <StackPanel Spacing="12">

                        <!-- Right to Access -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,4,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Privacy_RightToAccess" Text="Right to Access"
                                           Style="{StaticResource LabelStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock x:Uid="Privacy_YouCanAccessAll" Text="You can access all your data directly on your device. No request to us is needed."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Right to Rectification -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,4,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Privacy_RightToRectification" Text="Right to Rectification"
                                           Style="{StaticResource LabelStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock x:Uid="Privacy_YouCanModifyYour" Text="You can modify your data at any time through the application interface."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Right to Erasure -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,4,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Privacy_RightToErasureRight" Text="Right to Erasure ('Right to be Forgotten')"
                                           Style="{StaticResource LabelStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock x:Uid="Privacy_DeleteDocumentsConversationsAn" Text="Delete documents, conversations, and all data through the app or by removing the application data folder."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Right to Data Portability -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,4,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Privacy_RightToDataPortability" Text="Right to Data Portability"
                                           Style="{StaticResource LabelStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock x:Uid="Privacy_YourDataIsStored" Text="Your data is stored in standard SQLite format and can be exported or moved freely."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Right to Restrict Processing -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,4,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Privacy_RightToRestrictProcessing" Text="Right to Restrict Processing"
                                           Style="{StaticResource LabelStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock x:Uid="Privacy_YouControlAllProcessing" Text="You control all processing &#x2014; simply close the application to stop all data processing."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Right to Object -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,4,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Privacy_RightToObject" Text="Right to Object"
                                           Style="{StaticResource LabelStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock x:Uid="Privacy_YouCanStopUsing" Text="You can stop using the application at any time. Uninstalling removes all processing."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- Summary Note -->
                    <Border Style="{StaticResource CardInsetStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE946;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Privacy_SinceAllDataIs" Text="Since all data is stored locally on your device, you exercise these rights directly without needing to contact us. You are the sole controller of your data." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:Faceplate>


            <!-- ==========================================================
                 ROW 7: YOUR RIGHTS UNDER CCPA
                 ========================================================== -->
            <controls:Faceplate Grid.Row="7" Kicker="MOD - PRIV - 07">
                <StackPanel Spacing="16">

                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{ThemeResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusSM}"
                                Width="32" Height="32">
                            <FontIcon Glyph="&#xE8A3;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Uid="Privacy_YourRightsUnderCcpa" Text="Your Rights Under CCPA"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               x:Uid="Privacy_IfYouAreA" Text="If you are a California resident, you have specific rights under the California Consumer Privacy Act (CCPA)." />

                    <!-- CCPA Rights -->
                    <StackPanel Spacing="12">

                        <!-- Right to Know -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,4,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Privacy_RightToKnow" Text="Right to Know"
                                           Style="{StaticResource LabelStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock x:Uid="Privacy_WhatPersonalInformationIs" Text="What personal information is collected &#x2014; see 'Information We Collect' above for a complete enumeration."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Right to Delete -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,4,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Privacy_RightToDelete" Text="Right to Delete"
                                           Style="{StaticResource LabelStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock x:Uid="Privacy_RemoveAllDataBy" Text="Remove all data by uninstalling the app or deleting the application data directory."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Right to Opt-Out of Sale -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,4,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Privacy_RightToOptOut" Text="Right to Opt-Out of Sale"
                                           Style="{StaticResource LabelStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                           x:Uid="Privacy_WeDoNotSell" Text="We do not sell your personal information. We never have and never will." />
                            </StackPanel>
                        </Grid>

                        <!-- Right to Non-Discrimination -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,4,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Uid="Privacy_RightToNonDiscrimination" Text="Right to Non-Discrimination"
                                           Style="{StaticResource LabelStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock x:Uid="Privacy_WeDoNotDiscriminate" Text="We do not discriminate against users who exercise their privacy rights."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- Categories of Personal Information -->
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="Privacy_CategoriesOfPersonalInformatio" Text="Categories of Personal Information"
                                   Style="{StaticResource HeadingSmallStyle}" />
                        <StackPanel Spacing="8" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x2022;"
                                           Style="{StaticResource BodyStyle}"
                                           Foreground="{ThemeResource TextAccentBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock x:Uid="Privacy_DocumentsAndFilesYou" Text="Documents and files you import"
                                           Style="{StaticResource BodyStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x2022;"
                                           Style="{StaticResource BodyStyle}"
                                           Foreground="{ThemeResource TextAccentBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock x:Uid="Privacy_AiConversationHistory" Text="AI conversation history"
                                           Style="{StaticResource BodyStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#x2022;"
                                           Style="{StaticResource BodyStyle}"
                                           Foreground="{ThemeResource TextAccentBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock x:Uid="Privacy_ApplicationPreferences" Text="Application preferences"
                                           Style="{StaticResource BodyStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- No Sale of Data Callout -->
                    <Border Style="{StaticResource CardInsetStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE72E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{ThemeResource SuccessBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0" />
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="Privacy_NoSaleOfData" Text="No Sale of Data"
                                           Style="{StaticResource LabelStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock x:Uid="Privacy_StrategiaXDoesNot" Text="Strategia-X does not sell, rent, or trade any user data. Your information is yours alone."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:Faceplate>


            <!-- ==========================================================
                 ROW 8: DATA SECURITY
                 ========================================================== -->
            <controls:Faceplate Grid.Row="8" Kicker="MOD - PRIV - 08">
                <StackPanel Spacing="16">

                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{ThemeResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusSM}"
                                Width="32" Height="32">
                            <FontIcon Glyph="&#xE72E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Uid="Privacy_DataSecurity" Text="Data Security"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Privacy_YourDataSecurityDepends" Text="Your data security depends on your device's security. Since all data remains local, you benefit from your operating system's built-in protections." />

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               x:Uid="Privacy_WeRecommendTheFollowing" Text="We recommend the following practices to keep your data secure:" />

                    <StackPanel Spacing="8" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="11"
                                      Foreground="{ThemeResource SuccessBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,4,0,0" />
                            <TextBlock x:Uid="Privacy_KeepYourOperatingSystem" Text="Keep your operating system and software updated"
                                       Style="{StaticResource BodyStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="11"
                                      Foreground="{ThemeResource SuccessBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,4,0,0" />
                            <TextBlock x:Uid="Privacy_UseStrongDevicePasswords" Text="Use strong device passwords and biometric locks where available"
                                       Style="{StaticResource BodyStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="11"
                                      Foreground="{ThemeResource SuccessBrush}"
                                      VerticalAlignment="Top"
                                      Margin="0,4,0,0" />
                            <TextBlock x:Uid="Privacy_EncryptYourHardDrive" Text="Encrypt your hard drive (e.g., BitLocker on Windows)"
                                       Style="{StaticResource BodyStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Style="{StaticResource SeparatorStyle}" />

                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Privacy_AgentXDoesNot" Text="Agent-X does not implement additional encryption beyond what your operating system provides."
                                   Style="{StaticResource BodySecondaryStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <FontIcon Glyph="&#xE946;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource AccentBodyStyle}"
                                       x:Uid="Privacy_NetworkSecurityByDefault" Text="Network security: by default, all AI processing is local. No data leaves your network." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </controls:Faceplate>


            <!-- ==========================================================
                 ROW 9: CHILDREN'S PRIVACY
                 ========================================================== -->
            <controls:Faceplate Grid.Row="9" Kicker="MOD - PRIV - 09">
                <StackPanel Spacing="12">

                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{ThemeResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusSM}"
                                Width="32" Height="32">
                            <FontIcon Glyph="&#xE7EF;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Uid="Privacy_ChildrenSPrivacy" Text="Children's Privacy"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Privacy_AgentXIsNot" Text="Agent-X is not directed at children under the age of 13. We do not knowingly collect personal information from children under 13. If you are a parent or guardian and believe your child has provided information through the application, please contact us so we can assist." />
                </StackPanel>
            </controls:Faceplate>


            <!-- ==========================================================
                 ROW 10: CHANGES TO THIS PRIVACY POLICY
                 ========================================================== -->
            <controls:Faceplate Grid.Row="10" Kicker="MOD - PRIV - 10">
                <StackPanel Spacing="12">

                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{ThemeResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusSM}"
                                Width="32" Height="32">
                            <FontIcon Glyph="&#xE70F;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Uid="Privacy_ChangesToThisPrivacy" Text="Changes to This Privacy Policy"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Privacy_WeMayUpdateThis" Text="We may update this Privacy Policy from time to time. When we make changes, we will revise the effective date at the top of this page. Changes will be reflected in the application with an updated effective date." />

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               x:Uid="Privacy_WeEncourageYouTo" Text="We encourage you to review this Privacy Policy periodically to stay informed about how we protect your information." />
                </StackPanel>
            </controls:Faceplate>


            <!-- ==========================================================
                 ROW 11: CONTACT US
                 ========================================================== -->
            <controls:Faceplate Grid.Row="11" Kicker="MOD - PRIV - 11">
                <StackPanel Spacing="16">

                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{ThemeResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusSM}"
                                Width="32" Height="32">
                            <FontIcon Glyph="&#xE715;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Uid="Privacy_ContactUs" Text="Contact Us"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Privacy_IfYouHaveAny" Text="If you have any questions, concerns, or requests regarding this Privacy Policy or our data practices, please reach out to us." />

                    <!-- Contact Details -->
                    <Border Style="{StaticResource CardInsetStyle}">
                        <StackPanel Spacing="12">

                            <!-- Company -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE731;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="14"
                                          Foreground="{ThemeResource TextAccentBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Uid="Privacy_Company" Text="Company"
                                               Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="Strategia-X"
                                               Style="{StaticResource BodyStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- Separator -->
                            <Border Style="{StaticResource SeparatorStyle}" Margin="0" />

                            <!-- Email -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE715;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="14"
                                          Foreground="{ThemeResource TextAccentBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Uid="Privacy_PrivacyQuestions" Text="Privacy Questions"
                                               Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="support@strategia-x.com"
                                               Style="{StaticResource BodyStyle}"
                                               Foreground="{ThemeResource TextLinkBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Separator -->
                            <Border Style="{StaticResource SeparatorStyle}" Margin="0" />

                            <!-- GDPR Contact -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE909;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="14"
                                          Foreground="{ThemeResource TextAccentBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Uid="Privacy_GdprDataProtectionContact" Text="GDPR Data Protection Contact"
                                               Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:Uid="Privacy_ForGdprInquiriesOur" Text="For GDPR inquiries, our Data Protection contact can be reached at support@strategia-x.com"
                                               Style="{StaticResource BodySecondaryStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- Separator -->
                            <Border Style="{StaticResource SeparatorStyle}" Margin="0" />

                            <!-- CCPA Contact -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A3;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="14"
                                          Foreground="{ThemeResource TextAccentBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Uid="Privacy_CcpaRequestsCaliforniaResident" Text="CCPA Requests (California Residents)"
                                               Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:Uid="Privacy_CaliforniaResidentsMayContact" Text="California residents may contact us at support@strategia-x.com for any CCPA-related requests."
                                               Style="{StaticResource BodySecondaryStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:Faceplate>


            <!-- ==========================================================
                 ROW 12: FOOTER
                 ========================================================== -->
            <StackPanel Grid.Row="12"
                        HorizontalAlignment="Center"
                        Spacing="4"
                        Margin="0,8,0,24">
                <TextBlock Style="{StaticResource CaptionStyle}"
                           HorizontalAlignment="Center">
                    <Run x:Uid="Privacy_2026RockyElsalaymehFree" Text="&#x00A9; 2026 Rocky Elsalaymeh. Free and open-source under the MIT License." />
                </TextBlock>
                <TextBlock x:Uid="Privacy_AgentXLocalFirst" Text="Agent-X &#x2014; Local-First AI Personal Intelligence Hub"
                           Style="{StaticResource CaptionStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>
