<Page
    x:Class="AgentX.App.Views.WorkflowBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AgentX.App.Controls"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:views="using:AgentX.App.Views"
    xmlns:converters="using:AgentX.App.Converters"
    x:Name="WorkflowPage"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
    </Page.Resources>

    <Grid>

        <!-- ═══════ ADAPTIVE LAYOUT (Tier 3) — see Colors.xaml breakpoints ═══════
             Narrow (<960):  sidebar 260   |  Medium (>=960): sidebar 300
             Wide (>=1280):  sidebar 320 (markup default) -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="260" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="300" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             LEFT PANEL: Workflow List
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{ThemeResource CardGradientSubtleBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Padding="20,20,20,12" Spacing="4">
                    <TextBlock x:Uid="WfBuilder_Workflows" Text="Workflows"
                               Style="{StaticResource HeadingSmallStyle}"
                               FontWeight="Bold" />
                    <TextBlock x:Uid="WfBuilder_MultiStepAiPipelines" Text="Multi-step AI pipelines"
                               Style="{StaticResource CaptionStyle}" />
                </StackPanel>

                <!-- Workflow Actions -->
                <Grid Grid.Row="1"
                      Margin="16,0,16,12"
                      ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Uid="WfBuilder_NewWorkflow" Content="New Workflow"
                            Command="{x:Bind ViewModel.CreateWorkflowCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" />

                    <Button Grid.Column="1"
                            x:Uid="WfBuilder_ImportWorkflow" Content="Import Workflow"
                            Click="ImportWorkflow_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>

                <!-- Workflow List -->
                <ListView Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.Workflows}"
                          SelectedItem="{x:Bind ViewModel.SelectedWorkflow, Mode=TwoWay}"
                          SelectionMode="Single"
                          Padding="8,0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkflowListItem">
                            <Grid Padding="12,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        Width="36" Height="36"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Background="{ThemeResource AccentSubtleBrush}">
                                    <FontIcon Glyph="{x:Bind Icon}"
                                              FontSize="16"
                                              Foreground="{ThemeResource AccentPrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>

                                <!-- Name + Category -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind Name}"
                                               Style="{StaticResource BodyStyle}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Description}"
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               Visibility="{x:Bind Description, Mode=OneWay, Converter={StaticResource StringToVis}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Category}"
                                                   Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Style="{StaticResource CaptionStyle}">
                                            <Run Text="{x:Bind StepCount}" />
                                            <Run x:Uid="WfBuilder_Steps" Text=" steps" />
                                        </TextBlock>
                                        <Border CornerRadius="{StaticResource RadiusSM}"
                                                Background="{ThemeResource AccentSubtleBrush}"
                                                Padding="8,2"
                                                Visibility="{x:Bind IsBuiltIn, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <TextBlock x:Uid="WfBuilder_Template" Text="Template"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Foreground="{ThemeResource AccentPrimaryBrush}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   Visibility="{x:Bind views:WorkflowBuilderPage.IntToVisibility(RunCount)}">
                                            <Run Text="{x:Bind RunCount}" />
                                            <Run x:Uid="WfBuilder_Runs" Text=" runs" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Spacing="6">
                                    <Button x:Uid="WfBuilder_UseTemplate" Content="Use Template"
                                            Command="{Binding ViewModel.UseTemplateCommand, ElementName=WorkflowPage}"
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Visibility="{x:Bind IsBuiltIn, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6"
                                                Visibility="{x:Bind IsBuiltIn, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                                        <Button x:Uid="WfBuilder_Edit" Content="Edit"
                                                Command="{Binding ViewModel.EditWorkflowCommand, ElementName=WorkflowPage}"
                                                CommandParameter="{Binding Id}"
                                                Style="{StaticResource GhostButtonStyle}" />
                                        <Button x:Uid="WfBuilder_Delete" Content="Delete"
                                                Command="{Binding ViewModel.DeleteWorkflowCommand, ElementName=WorkflowPage}"
                                                CommandParameter="{Binding Id}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Foreground="{ThemeResource ErrorBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             RIGHT PANEL: Editor / Runner
             ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Padding="{StaticResource PaddingPage}" RowSpacing="24" MaxWidth="900">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ═══ PAGE HEADER ═══ -->
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock x:Uid="WfBuilder_PageTitle" Text="Prompt Workflows"
                                   Style="{StaticResource DisplaySmallStyle}" />
                        <TextBlock x:Uid="WfBuilder_BuildMultiStepAi" Text="Build multi-step AI pipelines. Each step's output feeds the next."
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <!-- ═══ EDITOR SECTION ═══ -->
                    <controls:Faceplate Grid.Row="1" Padding="24" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVis}}" Kicker="MOD - WFLW - 01">
                        <StackPanel Spacing="20">
                            <TextBlock x:Uid="WfBuilder_WorkflowEditor" Text="Workflow Editor"
                                       Style="{StaticResource HeadingSmallStyle}" />

                            <!-- Name -->
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="WfBuilder_Name" Text="Name" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{x:Bind ViewModel.EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         x:Uid="WfBuilder_MyWorkflowPh" PlaceholderText="My Workflow"
                                         Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <!-- Description -->
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="WfBuilder_Description" Text="Description" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{x:Bind ViewModel.EditDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         x:Uid="WfBuilder_WhatDoesThisWorkflowPh" PlaceholderText="What does this workflow do?"
                                         Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <!-- Category -->
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="WfBuilder_Category" Text="Category" Style="{StaticResource LabelStyle}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.Categories}"
                                          SelectedItem="{x:Bind ViewModel.EditCategory, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Steps Header + Add Button -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="WfBuilder_Steps2" Text="Steps"
                                           Style="{StaticResource HeadingSmallStyle}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        x:Uid="WfBuilder_AddStep" Content="Add Step"
                                        Command="{x:Bind ViewModel.AddStepCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>

                            <!-- Steps List -->
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.EditSteps}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkflowStepItem">
                                        <Border Background="{ThemeResource CardGradientBrush}"
                                                CornerRadius="{StaticResource RadiusMD}"
                                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                Padding="16">
                                            <StackPanel Spacing="12">
                                                <!-- Step Header -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Step Number Badge -->
                                                    <Border Width="28" Height="28"
                                                            CornerRadius="{StaticResource RadiusFull}"
                                                            Background="{ThemeResource AccentGradientBrush}">
                                                        <TextBlock Text="{x:Bind StepOrder, Mode=OneWay}"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="{ThemeResource TextPrimaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Step Name -->
                                                    <TextBox Grid.Column="1"
                                                             Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             x:Uid="WfBuilder_StepNamePh" PlaceholderText="Step name"
                                                             Margin="12,0,0,0"
                                                             Style="{StaticResource InputTextBoxStyle}" />

                                                    <!-- Move / Delete Buttons -->
                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                Spacing="4">
                                                        <Button Content="&#xE70E;"
                                                                Command="{Binding ViewModel.MoveStepUpCommand, ElementName=WorkflowPage}"
                                                                CommandParameter="{x:Bind}"
                                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                                FontSize="12"
                                                                Padding="6"
                                                                MinWidth="0" MinHeight="0"
                                                                x:Uid="WfBuilder_MoveUpTip" ToolTipService.ToolTip="Move Up"
                                                                Style="{StaticResource GhostButtonStyle}" />
                                                        <Button Content="&#xE70D;"
                                                                Command="{Binding ViewModel.MoveStepDownCommand, ElementName=WorkflowPage}"
                                                                CommandParameter="{x:Bind}"
                                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                                FontSize="12"
                                                                Padding="6"
                                                                MinWidth="0" MinHeight="0"
                                                                x:Uid="WfBuilder_MoveDownTip" ToolTipService.ToolTip="Move Down"
                                                                Style="{StaticResource GhostButtonStyle}" />
                                                        <Button Content="&#xE74D;"
                                                                Command="{Binding ViewModel.RemoveStepCommand, ElementName=WorkflowPage}"
                                                                CommandParameter="{x:Bind}"
                                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                                FontSize="12"
                                                                Padding="6"
                                                                MinWidth="0" MinHeight="0"
                                                                Foreground="{ThemeResource ErrorBrush}"
                                                                x:Uid="WfBuilder_RemoveStepTip" ToolTipService.ToolTip="Remove Step"
                                                                Style="{StaticResource GhostButtonStyle}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Step Type -->
                                                <ComboBox ItemsSource="{Binding ViewModel.StepTypes, ElementName=WorkflowPage}"
                                                          SelectedItem="{x:Bind StepType, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          x:Uid="WfBuilder_StepType" Header="Step Type" />

                                                <!-- Prompt Template -->
                                                <TextBox Text="{x:Bind PromptTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         x:Uid="WfBuilder_EnterPromptUseInputPh" PlaceholderText="Enter prompt... Use {{input}} for original input, {{previous_output}} for last step's output"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         MinHeight="80"
                                                         MaxHeight="200"
                                                         Header="Prompt Template"
                                                         Style="{StaticResource InputTextBoxStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                                <Button x:Uid="WfBuilder_Cancel" Content="Cancel"
                                        Command="{x:Bind ViewModel.CancelEditCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button x:Uid="WfBuilder_SaveWorkflow" Content="Save Workflow"
                                        Command="{x:Bind ViewModel.SaveWorkflowCommand}"
                                        Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </controls:Faceplate>

                    <!-- ═══ RUNNER SECTION ═══ -->
                    <controls:Faceplate Grid.Row="2" Padding="24" Visibility="{x:Bind ViewModel.ShowWorkflowRunnerSection, Mode=OneWay, Converter={StaticResource BoolToVis}}" Kicker="MOD - WFLW - 02">
                        <StackPanel Spacing="20">
                            <Border Background="{ThemeResource AccentSubtleBrush}"
                                    BorderBrush="{ThemeResource AccentPrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Padding="16,14"
                                    Visibility="{x:Bind ViewModel.HasFocusedWorkflowRunLanding, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="6">
                                        <TextBlock x:Uid="WfBuilder_FocusedWorkflowRun" Text="Focused Workflow Run"
                                                   Style="{StaticResource BodyStyle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.FocusedWorkflowRunSourceLabel, Mode=OneWay}"
                                                   Style="{StaticResource BodySecondaryStyle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Uid="WfBuilder_TheMatchingWorkflowAnd" Text="The matching workflow and stored result were brought to the top of the page for review."
                                                   Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            x:Uid="WfBuilder_Dismiss" Content="Dismiss"
                                            Command="{x:Bind ViewModel.DismissFocusedWorkflowRunLandingCommand}"
                                            Style="{StaticResource GhostButtonStyle}"
                                            VerticalAlignment="Top" />
                                </Grid>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="WfBuilder_RunWorkflow" Text="Run Workflow"
                                               Style="{StaticResource HeadingSmallStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedWorkflowName, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        x:Uid="WfBuilder_ExportJson" Content="Export JSON"
                                        Click="ExportWorkflowToClipboard_Click"
                                        Tag="{x:Bind ViewModel.SelectedWorkflowId, Mode=OneWay}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <!-- Template Guide -->
                            <Border Background="{ThemeResource CardGradientSubtleBrush}"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    Padding="18"
                                    Visibility="{x:Bind ViewModel.HasSelectedTemplateGuide, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="WfBuilder_TemplateGuide" Text="Template Guide"
                                                   Style="{StaticResource HeadingSmallStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedTemplateGuideSummary, Mode=OneWay}"
                                                   Style="{StaticResource BodySecondaryStyle}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="6">
                                            <TextBlock x:Uid="WfBuilder_BestFor" Text="Best For"
                                                       Style="{StaticResource LabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedTemplateGuideBestFor, Mode=OneWay}"
                                                       Style="{StaticResource BodyStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock x:Uid="WfBuilder_YouLlGet" Text="You'll Get"
                                                       Style="{StaticResource LabelStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedTemplateGuideOutcome, Mode=OneWay}"
                                                       Style="{StaticResource BodyStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="8"
                                                Visibility="{x:Bind ViewModel.HasSelectedTemplateGuideExamples, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <TextBlock x:Uid="WfBuilder_TryItWith" Text="Try It With"
                                                   Style="{StaticResource LabelStyle}" />
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedTemplateGuideExamples, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="8" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WorkflowTemplateGuideExampleItem">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE8FD;"
                                                                  FontSize="12"
                                                                  Foreground="{ThemeResource AccentPrimaryBrush}"
                                                                  VerticalAlignment="Top"
                                                                  Margin="0,3,0,0" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{x:Bind Text}"
                                                                   Style="{StaticResource BodyStyle}"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>

                                    <TextBlock x:Uid="WfBuilder_RunTheTemplateAs" Text="Run the template as-is if it already fits. Use Template if you want to customize the steps before saving your own version."
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Input -->
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="WfBuilder_Input" Text="Input" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{x:Bind ViewModel.RunInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         x:Uid="WfBuilder_PasteOrTypeThePh" PlaceholderText="Paste or type the content you want to process..."
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="120"
                                         MaxHeight="300"
                                         Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <!-- Run / Cancel Buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Uid="WfBuilder_Run" Content="Run"
                                        Command="{x:Bind ViewModel.RunWorkflowCommand}"
                                        CommandParameter="{x:Bind ViewModel.SelectedWorkflowId, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanRunSelectedWorkflow, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Uid="WfBuilder_Cancel2" Content="Cancel"
                                        Command="{x:Bind ViewModel.CancelRunCommand}"
                                        Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>

                            <!-- Progress -->
                            <StackPanel Spacing="8"
                                        Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <ProgressBar Value="{x:Bind ViewModel.RunProgress, Mode=OneWay}"
                                             Maximum="{x:Bind ViewModel.RunTotalSteps, Mode=OneWay}"
                                             IsIndeterminate="False" />
                                <TextBlock Style="{StaticResource CaptionStyle}">
                                    <Run x:Uid="WfBuilder_Running" Text="Running:" />
                                    <Run Text="{x:Bind ViewModel.CurrentStepName, Mode=OneWay}" />
                                    <Run Text="(" /><Run Text="{x:Bind ViewModel.RunProgress, Mode=OneWay}" />
                                    <Run Text="/" /><Run Text="{x:Bind ViewModel.RunTotalSteps, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </controls:Faceplate>

                    <!-- ═══ RECENT RUNS ═══ -->
                    <controls:Faceplate Grid.Row="3" Padding="24" Visibility="{x:Bind ViewModel.HasSelectedWorkflow, Mode=OneWay, Converter={StaticResource BoolToVis}}" Kicker="MOD - WFLW - 03">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="WfBuilder_RecentRuns" Text="Recent Runs"
                                           Style="{StaticResource HeadingSmallStyle}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.SelectedWorkflowName, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock x:Uid="WfBuilder_StoredWorkflowResultsYou" Text="Stored workflow results you can reopen without rerunning."
                                       Style="{StaticResource CaptionStyle}" />

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecentRuns, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.HasRecentRuns, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="10" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkflowRunHistoryDisplayItem">
                                        <Border Background="{ThemeResource CardGradientSubtleBrush}"
                                                CornerRadius="{StaticResource RadiusSM}"
                                                Padding="16"
                                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                                BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <Border Background="{ThemeResource AccentSubtleBrush}"
                                                        CornerRadius="{StaticResource RadiusSM}"
                                                        Padding="10,4"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{x:Bind IsFocused, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock x:Uid="WfBuilder_OpenedFromOperations" Text="Opened from Operations"
                                                               Style="{StaticResource CaptionStyle}"
                                                               Foreground="{ThemeResource AccentPrimaryBrush}"
                                                               FontWeight="SemiBold" />
                                                </Border>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind StatusText}"
                                                                   Style="{StaticResource BodyStyle}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind StartedAtText}"
                                                                   Style="{StaticResource CaptionStyle}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1"
                                                                Spacing="8">
                                                        <Button x:Uid="WfBuilder_OpenResult" Content="Open Result"
                                                                Command="{Binding ViewModel.OpenHistoricalRunCommand, ElementName=WorkflowPage}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SecondaryButtonStyle}" />
                                                        <Button x:Uid="WfBuilder_SaveAsDocument" Content="Save as Document"
                                                                Command="{Binding ViewModel.SaveHistoricalRunToVaultCommand, ElementName=WorkflowPage}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource GhostButtonStyle}" />
                                                        <Button x:Uid="WfBuilder_ExportResult" Content="Export Result"
                                                                Click="ExportHistoricalRun_Click"
                                                                Tag="{x:Bind}"
                                                                Style="{StaticResource GhostButtonStyle}" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{x:Bind DetailText}"
                                                           Style="{StaticResource CaptionStyle}" />

                                                <TextBlock Text="{x:Bind PreviewText}"
                                                           Style="{StaticResource BodyStyle}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="3"
                                                           Visibility="{x:Bind HasPreview, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                                                <TextBlock Text="{x:Bind ErrorMessage}"
                                                           Style="{StaticResource CaptionStyle}"
                                                           Foreground="{ThemeResource ErrorBrush}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <TextBlock x:Uid="WfBuilder_NoRunsRecordedYet" Text="No runs recorded yet for the selected workflow."
                                       Style="{StaticResource BodySecondaryStyle}"
                                       Visibility="{x:Bind ViewModel.ShowRecentRunsEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </controls:Faceplate>

                    <!-- ═══ STEP OUTPUTS ═══ -->
                    <controls:Faceplate Grid.Row="4" Padding="24" Visibility="{x:Bind ViewModel.HasStepOutputs, Mode=OneWay, Converter={StaticResource BoolToVis}}" Kicker="MOD - WFLW - 04">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="WfBuilder_StepOutputs" Text="Step Outputs"
                                               Style="{StaticResource HeadingSmallStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.RunResultContextText, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}"
                                               Visibility="{x:Bind ViewModel.HasRunResultContextText, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="16">
                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                               VerticalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.RunTotalTokens, Mode=OneWay}" />
                                        <Run x:Uid="WfBuilder_Tokens" Text="tokens" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                               VerticalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.RunDurationMs, Mode=OneWay}" />
                                        <Run Text="ms" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.StepOutputs}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StepOutputItem">
                                        <Border Background="{ThemeResource CardGradientSubtleBrush}"
                                                CornerRadius="{StaticResource RadiusSM}"
                                                Padding="16">
                                            <StackPanel Spacing="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24"
                                                            CornerRadius="{StaticResource RadiusFull}"
                                                            Background="{ThemeResource AccentSubtleBrush}">
                                                        <TextBlock Text="{x:Bind StepOrder}"
                                                                   FontSize="11" FontWeight="Bold"
                                                                   Foreground="{ThemeResource AccentPrimaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind StepName}"
                                                               Style="{StaticResource BodyStyle}"
                                                               FontWeight="SemiBold"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Style="{StaticResource CaptionStyle}"
                                                               VerticalAlignment="Center">
                                                        <Run Text="{x:Bind TokensUsed}" /><Run x:Uid="WfBuilder_Tok" Text=" tok" />
                                                    </TextBlock>
                                                </Grid>
                                                <TextBlock Text="{x:Bind Output}"
                                                           Style="{StaticResource BodyStyle}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="10"
                                                           IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </controls:Faceplate>

                    <!-- ═══ FINAL OUTPUT ═══ -->
                    <controls:Faceplate Grid.Row="5" Padding="24" Visibility="{x:Bind ViewModel.HasRunOutputOrError, Mode=OneWay, Converter={StaticResource BoolToVis}}" Kicker="MOD - WFLW - 05">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="WfBuilder_FinalOutput" Text="Final Output"
                                       Style="{StaticResource HeadingSmallStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.RunErrorMessage, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{ThemeResource ErrorBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.RunErrorMessage, Mode=OneWay, Converter={StaticResource StringToVis}}" />
                            <TextBox Text="{x:Bind ViewModel.RunOutput, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="120"
                                     Style="{StaticResource InputTextBoxStyle}" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12">
                                <Button x:Uid="WfBuilder_CopyToClipboard" Content="Copy to Clipboard"
                                        Click="CopyOutputToClipboard"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button x:Uid="WfBuilder_SaveAsDocument2" Content="Save as Document"
                                        Command="{x:Bind ViewModel.SaveCurrentResultToVaultCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanSaveCurrentResultToVault, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Uid="WfBuilder_ExportResult2" Content="Export Result"
                                        Click="ExportCurrentResult_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button x:Uid="WfBuilder_OpenVault" Content="Open Vault"
                                        Command="{x:Bind ViewModel.OpenKnowledgeVaultCommand}"
                                        Style="{StaticResource GhostButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </controls:Faceplate>

                    <!-- ═══ STATUS MESSAGE ═══ -->
                    <TextBlock Grid.Row="6"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}"
                               Margin="0,8,0,0"
                               Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToVis}}" />

                    <!-- ═══ EMPTY STATE ═══ -->
                    <controls:Faceplate Grid.Row="2" Padding="28" Visibility="{x:Bind ViewModel.ShowWorkflowStarterEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}" Kicker="MOD - WFLW - 06">
                        <StackPanel Spacing="20">
                            <StackPanel Spacing="8">
                                <FontIcon Glyph="&#xE945;"
                                          FontSize="42"
                                          Foreground="{ThemeResource AccentPrimaryBrush}" />
                                <TextBlock x:Uid="WfBuilder_StartWithATemplate" Text="Start with a template"
                                           Style="{StaticResource DisplaySmallStyle}" />
                                <TextBlock x:Uid="WfBuilder_WorkflowsHelpYouTurn" Text="Workflows help you turn one block of input into a repeatable multi-step result. Pick a starter template below, then run it as-is or customize it later."
                                           Style="{StaticResource BodySecondaryStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.WorkflowStarterTemplates, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.HasWorkflowStarterTemplates, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkflowStarterTemplateDisplayItem">
                                        <Border Background="{ThemeResource CardGradientSubtleBrush}"
                                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusMD}"
                                                Padding="18">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="6">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind Name}"
                                                                       Style="{StaticResource HeadingSmallStyle}" />
                                                            <Border Background="{ThemeResource AccentSubtleBrush}"
                                                                    CornerRadius="{StaticResource RadiusSM}"
                                                                    Padding="8,2">
                                                                <TextBlock Text="{x:Bind Category}"
                                                                           Style="{StaticResource CaptionStyle}"
                                                                           Foreground="{ThemeResource AccentPrimaryBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind Summary}"
                                                                   Style="{StaticResource BodyStyle}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            x:Uid="WfBuilder_SelectTemplate" Content="Select Template"
                                                            Command="{Binding ViewModel.SelectTemplateCommand, ElementName=WorkflowPage}"
                                                            CommandParameter="{Binding Id}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            VerticalAlignment="Top" />
                                                </Grid>

                                                <TextBlock Style="{StaticResource CaptionStyle}"
                                                           TextWrapping="Wrap">
                                                    <Run x:Uid="WfBuilder_BestFor2" Text="Best for: " />
                                                    <Run Text="{x:Bind BestFor}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <TextBlock x:Uid="WfBuilder_NoStarterTemplatesAre" Text="No starter templates are available right now."
                                       Style="{StaticResource BodySecondaryStyle}"
                                       Visibility="{x:Bind ViewModel.HasWorkflowStarterTemplates, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />

                            <StackPanel Orientation="Horizontal"
                                        Spacing="12">
                                <Button x:Uid="WfBuilder_CreateBlankWorkflow" Content="Create Blank Workflow"
                                        Command="{x:Bind ViewModel.CreateWorkflowCommand}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <TextBlock x:Uid="WfBuilder_YouCanAlsoBuild" Text="You can also build a workflow from scratch if none of the starters fit."
                                           Style="{StaticResource CaptionStyle}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </controls:Faceplate>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
