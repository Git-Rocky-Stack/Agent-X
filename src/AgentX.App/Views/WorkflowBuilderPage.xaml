<Page
    x:Class="AgentX.App.Views.WorkflowBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:views="using:AgentX.App.Views"
    xmlns:converters="using:AgentX.App.Converters"
    x:Name="WorkflowPage"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             LEFT PANEL: Workflow List
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource CardGradientSubtleBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Padding="20,20,20,12" Spacing="4">
                    <TextBlock Text="Workflows"
                               Style="{StaticResource HeadingSmallStyle}"
                               FontWeight="Bold" />
                    <TextBlock Text="Multi-step AI pipelines"
                               Style="{StaticResource CaptionStyle}"
                               Opacity="0.5" />
                </StackPanel>

                <!-- New Workflow Button -->
                <Button Grid.Row="1"
                        Content="New Workflow"
                        Command="{x:Bind ViewModel.CreateWorkflowCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Margin="16,0,16,12" />

                <!-- Workflow List -->
                <ListView Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.Workflows}"
                          SelectedItem="{x:Bind ViewModel.SelectedWorkflow, Mode=TwoWay}"
                          SelectionMode="Single"
                          Padding="8,0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkflowListItem">
                            <Grid Padding="12,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        Width="36" Height="36"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Background="{StaticResource AccentSubtleBrush}">
                                    <FontIcon Glyph="{x:Bind Icon}"
                                              FontSize="16"
                                              Foreground="{StaticResource AccentPrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>

                                <!-- Name + Category -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}"
                                               Style="{StaticResource BodyStyle}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Category}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Opacity="0.5" />
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   Opacity="0.4">
                                            <Run Text="{x:Bind StepCount}" />
                                            <Run Text="steps" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Run Count Badge -->
                                <Border Grid.Column="2"
                                        CornerRadius="{StaticResource RadiusSM}"
                                        Background="{StaticResource InputBackgroundBrush}"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind views:WorkflowBuilderPage.IntToVisibility(RunCount)}">
                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                               Opacity="0.5">
                                        <Run Text="{x:Bind RunCount}" />
                                        <Run Text="runs" />
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             RIGHT PANEL: Editor / Runner
             ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Padding="{StaticResource PaddingPage}" RowSpacing="24" MaxWidth="900">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ═══ PAGE HEADER ═══ -->
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                                   Style="{StaticResource DisplaySmallStyle}" />
                        <TextBlock Text="Build multi-step AI pipelines. Each step's output feeds the next."
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <!-- ═══ EDITOR SECTION ═══ -->
                    <Border Grid.Row="1"
                            Style="{StaticResource CardStyle}"
                            Padding="24"
                            Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="20">
                            <TextBlock Text="Workflow Editor"
                                       Style="{StaticResource HeadingSmallStyle}" />

                            <!-- Name -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Name" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{x:Bind ViewModel.EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="My Workflow"
                                         Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <!-- Description -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Description" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{x:Bind ViewModel.EditDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="What does this workflow do?"
                                         Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <!-- Category -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Category" Style="{StaticResource LabelStyle}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.Categories}"
                                          SelectedItem="{x:Bind ViewModel.EditCategory, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Steps Header + Add Button -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Steps"
                                           Style="{StaticResource HeadingSmallStyle}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="Add Step"
                                        Command="{x:Bind ViewModel.AddStepCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>

                            <!-- Steps List -->
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.EditSteps}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkflowStepItem">
                                        <Border Background="{StaticResource CardGradientBrush}"
                                                CornerRadius="{StaticResource RadiusMD}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                Padding="16">
                                            <StackPanel Spacing="12">
                                                <!-- Step Header -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Step Number Badge -->
                                                    <Border Width="28" Height="28"
                                                            CornerRadius="{StaticResource RadiusRound}"
                                                            Background="{StaticResource AccentGradientBrush}">
                                                        <TextBlock Text="{x:Bind StepOrder, Mode=OneWay}"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Step Name -->
                                                    <TextBox Grid.Column="1"
                                                             Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             PlaceholderText="Step name"
                                                             Margin="12,0,0,0"
                                                             Style="{StaticResource InputTextBoxStyle}" />

                                                    <!-- Move / Delete Buttons -->
                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                Spacing="4">
                                                        <Button Content="&#xE70E;"
                                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                                FontSize="12"
                                                                Padding="6"
                                                                MinWidth="0" MinHeight="0"
                                                                ToolTipService.ToolTip="Move Up"
                                                                Style="{StaticResource GhostButtonStyle}" />
                                                        <Button Content="&#xE70D;"
                                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                                FontSize="12"
                                                                Padding="6"
                                                                MinWidth="0" MinHeight="0"
                                                                ToolTipService.ToolTip="Move Down"
                                                                Style="{StaticResource GhostButtonStyle}" />
                                                        <Button Content="&#xE74D;"
                                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                                FontSize="12"
                                                                Padding="6"
                                                                MinWidth="0" MinHeight="0"
                                                                Foreground="{StaticResource ErrorBrush}"
                                                                ToolTipService.ToolTip="Remove Step"
                                                                Style="{StaticResource GhostButtonStyle}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Step Type -->
                                                <ComboBox ItemsSource="{Binding ViewModel.StepTypes, ElementName=WorkflowPage}"
                                                          SelectedItem="{x:Bind StepType, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          Header="Step Type" />

                                                <!-- Prompt Template -->
                                                <TextBox Text="{x:Bind PromptTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="Enter prompt... Use {{input}} for original input, {{previous_output}} for last step's output"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         MinHeight="80"
                                                         MaxHeight="200"
                                                         Header="Prompt Template"
                                                         Style="{StaticResource InputTextBoxStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                                <Button Content="Cancel"
                                        Command="{x:Bind ViewModel.CancelEditCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Content="Save Workflow"
                                        Command="{x:Bind ViewModel.SaveWorkflowCommand}"
                                        Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ═══ RUNNER SECTION ═══ -->
                    <Border Grid.Row="2"
                            Style="{StaticResource CardStyle}"
                            Padding="24"
                            Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Spacing="20">
                            <TextBlock Text="Run Workflow"
                                       Style="{StaticResource HeadingSmallStyle}" />

                            <!-- Input -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Input" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{x:Bind ViewModel.RunInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Paste or type the content you want to process..."
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="120"
                                         MaxHeight="300"
                                         Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <!-- Run / Cancel Buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Run"
                                        IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InverseBool}}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="Cancel"
                                        Command="{x:Bind ViewModel.CancelRunCommand}"
                                        Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>

                            <!-- Progress -->
                            <StackPanel Spacing="8"
                                        Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <ProgressBar Value="{x:Bind ViewModel.RunProgress, Mode=OneWay}"
                                             Maximum="{x:Bind ViewModel.RunTotalSteps, Mode=OneWay}"
                                             IsIndeterminate="False" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Opacity="0.6">
                                    <Run Text="Running:" />
                                    <Run Text="{x:Bind ViewModel.CurrentStepName, Mode=OneWay}" />
                                    <Run Text="(" /><Run Text="{x:Bind ViewModel.RunProgress, Mode=OneWay}" />
                                    <Run Text="/" /><Run Text="{x:Bind ViewModel.RunTotalSteps, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ═══ STEP OUTPUTS ═══ -->
                    <Border Grid.Row="3"
                            Style="{StaticResource CardStyle}"
                            Padding="24"
                            Visibility="{x:Bind ViewModel.RunCompleted, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Step Outputs"
                                           Style="{StaticResource HeadingSmallStyle}" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="16">
                                    <TextBlock Style="{StaticResource CaptionStyle}" Opacity="0.5"
                                               VerticalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.RunTotalTokens, Mode=OneWay}" />
                                        <Run Text="tokens" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Opacity="0.5"
                                               VerticalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.RunDurationMs, Mode=OneWay}" />
                                        <Run Text="ms" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.StepOutputs}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StepOutputItem">
                                        <Border Background="{StaticResource CardGradientSubtleBrush}"
                                                CornerRadius="{StaticResource RadiusSM}"
                                                Padding="16">
                                            <StackPanel Spacing="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24"
                                                            CornerRadius="{StaticResource RadiusRound}"
                                                            Background="{StaticResource AccentSubtleBrush}">
                                                        <TextBlock Text="{x:Bind StepOrder}"
                                                                   FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind StepName}"
                                                               Style="{StaticResource BodyStyle}"
                                                               FontWeight="SemiBold"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Style="{StaticResource CaptionStyle}"
                                                               Opacity="0.4"
                                                               VerticalAlignment="Center">
                                                        <Run Text="{x:Bind TokensUsed}" /><Run Text=" tok" />
                                                    </TextBlock>
                                                </Grid>
                                                <TextBlock Text="{x:Bind Output}"
                                                           Style="{StaticResource BodyStyle}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="10"
                                                           IsTextSelectionEnabled="True"
                                                           Opacity="0.8" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!-- ═══ FINAL OUTPUT ═══ -->
                    <Border Grid.Row="4"
                            Style="{StaticResource CardStyle}"
                            Padding="24"
                            Visibility="{x:Bind ViewModel.RunCompleted, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Final Output"
                                       Style="{StaticResource HeadingSmallStyle}" />
                            <TextBox Text="{x:Bind ViewModel.RunOutput, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="120"
                                     Style="{StaticResource InputTextBoxStyle}" />
                            <Button Content="Copy to Clipboard"
                                    Click="CopyOutputToClipboard"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- ═══ STATUS MESSAGE ═══ -->
                    <TextBlock Grid.Row="4"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}"
                               Opacity="0.5"
                               Margin="0,8,0,0"
                               Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToVis}}" />

                    <!-- ═══ EMPTY STATE ═══ -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12"
                                Margin="0,60,0,0"
                                Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <FontIcon Glyph="&#xE945;"
                                  FontSize="48"
                                  Foreground="{StaticResource TextTertiaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Select a workflow to run or create a new one"
                                   Style="{StaticResource BodySecondaryStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
