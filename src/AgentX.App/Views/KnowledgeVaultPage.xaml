<Page
    x:Class="AgentX.App.Views.KnowledgeVaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>

        <!-- ═══════════════════════════════════════════════════════════
             CONVERTERS
             ═══════════════════════════════════════════════════════════ -->

        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NullToVisibilityConverter x:Key="InverseNullToVis" IsInverted="True" />

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">

        <Grid Padding="{StaticResource PaddingPage}" RowSpacing="24" MaxWidth="1200">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 0: PAGE HEADER
                 ═══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                               Style="{StaticResource DisplaySmallStyle}" />
                    <TextBlock Text="Import, organize, and index your documents for AI-powered search."
                               Style="{StaticResource BodySecondaryStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">

                    <!-- Import Files button -->
                    <Button Style="{StaticResource AccentButtonStyle}"
                            Click="OnImportFilesClick"
                            IsEnabled="{x:Bind ViewModel.IsImporting, Mode=OneWay, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                            <TextBlock Text="Import Files" />
                        </StackPanel>
                    </Button>

                    <!-- Import Folder button -->
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Click="OnImportFolderClick"
                            IsEnabled="{x:Bind ViewModel.IsImporting, Mode=OneWay, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                            <TextBlock Text="Import Folder" />
                        </StackPanel>
                    </Button>

                    <!-- Refresh button -->
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            ToolTipService.ToolTip="Refresh documents">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 1: STATS BAR
                 3 inline stat badges + import progress bar
                 ═══════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="1" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12">

                    <!-- Document count stat -->
                    <Border Style="{StaticResource StatBadgeStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="{StaticResource AccentSubtleBrush}"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Width="40" Height="40">
                                <FontIcon Glyph="&#xE8F1;" FontSize="18"
                                          Foreground="{StaticResource TextAccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource MetricSmallStyle}">
                                    <Run Text="{x:Bind ViewModel.TotalDocuments, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="Documents"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Storage size stat -->
                    <Border Style="{StaticResource StatBadgeStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="#1A3B82F6"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Width="40" Height="40">
                                <FontIcon Glyph="&#xEDA2;" FontSize="18"
                                          Foreground="{StaticResource InfoBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.TotalStorageFormatted, Mode=OneWay}"
                                           Style="{StaticResource MetricSmallStyle}" />
                                <TextBlock Text="Storage Used"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Indexing queue stat -->
                    <Border Style="{StaticResource StatBadgeStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="#1AF59E0B"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Width="40" Height="40">
                                <FontIcon Glyph="&#xE915;" FontSize="18"
                                          Foreground="{StaticResource WarningBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource MetricSmallStyle}">
                                    <Run Text="{x:Bind ViewModel.IndexingQueueLength, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="In Queue"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Import progress bar (visible during import) -->
                <Border Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource CardGradientBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMD}"
                        Padding="20,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing IsActive="True" Width="18" Height="18"
                                          Foreground="{StaticResource AccentPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ImportStatus, Mode=OneWay}"
                                       Style="{StaticResource BodySmallStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ProgressBar Value="{x:Bind ViewModel.ImportProgress, Mode=OneWay}"
                                     Maximum="100"
                                     Style="{StaticResource AccentProgressBarStyle}"
                                     MinHeight="4"
                                     MaxHeight="4" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 2: TOOLBAR / FILTER BAR
                 ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Style="{StaticResource CardInsetStyle}">
                <StackPanel Spacing="12">

                    <!-- File type filter chips -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="FILE TYPE"
                                   Style="{StaticResource OverlineStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="All"
                                    Click="OnFilterTypeClick" Tag=""
                                    Style="{StaticResource FilterChipActiveStyle}" x:Name="FilterTypeAll" />
                            <Button Click="OnFilterTypeClick" Tag="pdf"
                                    Style="{StaticResource FilterChipStyle}" x:Name="FilterTypePdf">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xEA90;" FontSize="11" />
                                    <TextBlock Text="PDF" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnFilterTypeClick" Tag="docx"
                                    Style="{StaticResource FilterChipStyle}" x:Name="FilterTypeDocx">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="11" />
                                    <TextBlock Text="Documents" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnFilterTypeClick" Tag="txt"
                                    Style="{StaticResource FilterChipStyle}" x:Name="FilterTypeTxt">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8D2;" FontSize="11" />
                                    <TextBlock Text="Text" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnFilterTypeClick" Tag="code"
                                    Style="{StaticResource FilterChipStyle}" x:Name="FilterTypeCode">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE943;" FontSize="11" />
                                    <TextBlock Text="Code" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnFilterTypeClick" Tag="image"
                                    Style="{StaticResource FilterChipStyle}" x:Name="FilterTypeImage">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="11" />
                                    <TextBlock Text="Images" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status filter chips -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="STATUS"
                                   Style="{StaticResource OverlineStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="All"
                                    Click="OnFilterStatusClick" Tag=""
                                    Style="{StaticResource FilterChipActiveStyle}" x:Name="FilterStatusAll" />
                            <Button Click="OnFilterStatusClick" Tag="completed"
                                    Style="{StaticResource FilterChipStyle}" x:Name="FilterStatusCompleted">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" />
                                    <TextBlock Text="Completed" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnFilterStatusClick" Tag="processing"
                                    Style="{StaticResource FilterChipStyle}" x:Name="FilterStatusProcessing">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource WarningBrush}" />
                                    <TextBlock Text="Processing" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnFilterStatusClick" Tag="pending"
                                    Style="{StaticResource FilterChipStyle}" x:Name="FilterStatusPending">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource InfoBrush}" />
                                    <TextBlock Text="Pending" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnFilterStatusClick" Tag="failed"
                                    Style="{StaticResource FilterChipStyle}" x:Name="FilterStatusFailed">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource ErrorBrush}" />
                                    <TextBlock Text="Failed" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Search + Clear row -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE721;"
                                  FontSize="16"
                                  Foreground="{StaticResource TextTertiaryBrush}"
                                  VerticalAlignment="Center" />

                        <TextBox Grid.Column="1"
                                 Style="{StaticResource SearchInputStyle}"
                                 PlaceholderText="Search documents by name, content, or tags..."
                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent" />

                        <Button Grid.Column="2"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{x:Bind ViewModel.ClearFiltersCommand}"
                                Visibility="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                ToolTipService.ToolTip="Clear all filters">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE711;" FontSize="12"
                                          Foreground="{StaticResource TextAccentBrush}" />
                                <TextBlock Text="Clear"
                                           Style="{StaticResource CaptionStyle}"
                                           Foreground="{StaticResource TextAccentBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 3: ERROR MESSAGE (conditional)
                 ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    Background="#1AEF4444"
                    BorderBrush="#33EF4444"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMD}"
                    Padding="16,12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE7BA;" FontSize="16"
                              Foreground="{StaticResource ErrorBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               Style="{StaticResource BodySmallStyle}"
                               Foreground="{StaticResource ErrorBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 4: DROP ZONE
                 Visible when no documents exist or always as
                 an inviting import area.
                 ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="4"
                    x:Name="DropZoneBorder"
                    Style="{StaticResource DropZoneStyle}"
                    Visibility="{x:Bind ViewModel.ShowDropZone, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    DragLeave="DropZone_DragLeave"
                    Drop="DropZone_Drop">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <!-- Upload icon -->
                    <Border Background="{StaticResource AccentSubtleBrush}"
                            CornerRadius="{StaticResource RadiusRound}"
                            Width="72" Height="72"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE898;"
                                  FontSize="32"
                                  Foreground="{StaticResource TextAccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="Drag and drop files here"
                                   Style="{StaticResource HeadingSmallStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="or click Import to browse your files"
                                   Style="{StaticResource BodySecondaryStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Supported formats -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                HorizontalAlignment="Center">
                        <Border Style="{StaticResource BadgeDefaultStyle}">
                            <TextBlock Text="PDF" Style="{StaticResource BadgeStyle}" />
                        </Border>
                        <Border Style="{StaticResource BadgeDefaultStyle}">
                            <TextBlock Text="DOCX" Style="{StaticResource BadgeStyle}" />
                        </Border>
                        <Border Style="{StaticResource BadgeDefaultStyle}">
                            <TextBlock Text="TXT" Style="{StaticResource BadgeStyle}" />
                        </Border>
                        <Border Style="{StaticResource BadgeDefaultStyle}">
                            <TextBlock Text="MD" Style="{StaticResource BadgeStyle}" />
                        </Border>
                        <Border Style="{StaticResource BadgeDefaultStyle}">
                            <TextBlock Text="CSV" Style="{StaticResource BadgeStyle}" />
                        </Border>
                        <Border Style="{StaticResource BadgeDefaultStyle}">
                            <TextBlock Text="JSON" Style="{StaticResource BadgeStyle}" />
                        </Border>
                        <Border Style="{StaticResource BadgeDefaultStyle}">
                            <TextBlock Text="HTML" Style="{StaticResource BadgeStyle}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 5: DOCUMENTS GRID
                 ═══════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="5" Spacing="16">

                <!-- Loading indicator -->
                <StackPanel Spacing="12"
                            HorizontalAlignment="Center"
                            Margin="0,24,0,24"
                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="40" Height="40"
                                  Foreground="{StaticResource AccentPrimaryBrush}" />
                    <TextBlock Text="Loading documents..."
                               Style="{StaticResource BodySecondaryStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Documents grid -->
                <ItemsRepeater x:Name="DocumentsRepeater"
                               ItemsSource="{x:Bind ViewModel.Documents, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="320"
                                           MinItemHeight="280"
                                           MinColumnSpacing="16"
                                           MinRowSpacing="16"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentDisplayItem">
                            <Border Style="{StaticResource DocumentGridItemStyle}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: File type icon + name + badges -->
                                    <Grid Grid.Row="0" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- File type icon container -->
                                        <Border Style="{StaticResource FileTypeIconContainerStyle}">
                                            <FontIcon Glyph="{x:Bind FileTypeIcon}"
                                                      FontSize="22"
                                                      Foreground="{StaticResource TextAccentBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <!-- File name -->
                                            <TextBlock Text="{x:Bind FileName}"
                                                       Style="{StaticResource HeadingSmallStyle}"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Type + Status badges -->
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <!-- File type badge -->
                                                <Border Style="{StaticResource FileTypeBadgeStyle}">
                                                    <TextBlock Text="{x:Bind FileTypeLabel}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextAccentBrush}"
                                                               CharacterSpacing="40" />
                                                </Border>

                                                <!-- Status badge -->
                                                <Border CornerRadius="{StaticResource RadiusRound}"
                                                        Padding="8,3,8,3">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{StaticResource StatusSuccess}" Opacity="0.1" />
                                                    </Border.Background>
                                                    <TextBlock Text="{x:Bind IndexingStatusLabel}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               CharacterSpacing="40">
                                                        <TextBlock.Foreground>
                                                            <SolidColorBrush Color="{StaticResource StatusSuccess}" />
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 1: Extracted title (if available) -->
                                    <TextBlock Grid.Row="1"
                                               Text="{x:Bind ExtractedTitle}"
                                               Style="{StaticResource BodySecondaryStyle}"
                                               Visibility="{x:Bind ExtractedTitle, Converter={StaticResource StringToVis}}"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Row 2: Stats row (pages, words, chunks) -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE8A1;" FontSize="10"
                                                      Foreground="{StaticResource TextTertiaryBrush}" />
                                            <TextBlock Style="{StaticResource CaptionStyle}">
                                                <Run Text="{x:Bind PageCount}" />
                                                <Run Text="pages" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE8C1;" FontSize="10"
                                                      Foreground="{StaticResource TextTertiaryBrush}" />
                                            <TextBlock Style="{StaticResource CaptionStyle}">
                                                <Run Text="{x:Bind WordCountFormatted}" />
                                                <Run Text="words" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE943;" FontSize="10"
                                                      Foreground="{StaticResource TextTertiaryBrush}" />
                                            <TextBlock Style="{StaticResource CaptionStyle}">
                                                <Run Text="{x:Bind ChunkCount}" />
                                                <Run Text="chunks" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Row 3: Size + date -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xEDA2;" FontSize="10"
                                                      Foreground="{StaticResource TextTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind FileSizeFormatted}"
                                                       Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE787;" FontSize="10"
                                                      Foreground="{StaticResource TextTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind ImportedAtFormatted}"
                                                       Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Row 4: Tags row -->
                                    <ItemsRepeater Grid.Row="4"
                                                   ItemsSource="{x:Bind Tags}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Style="{StaticResource TagBadgeStyle}">
                                                    <TextBlock Text="{x:Bind}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>

                                    <!-- Row 5: Action buttons -->
                                    <StackPanel Grid.Row="5"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                HorizontalAlignment="Right">
                                        <!-- View Detail -->
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Padding="8,6,8,6" MinHeight="32"
                                                Tag="{x:Bind Id}"
                                                Click="OnViewDetailClick"
                                                ToolTipService.ToolTip="View details">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="12"
                                                          Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="Detail"
                                                           Style="{StaticResource CaptionStyle}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Re-index -->
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Padding="8,6,8,6" MinHeight="32"
                                                Tag="{x:Bind Id}"
                                                Click="OnReindexClick"
                                                ToolTipService.ToolTip="Re-index document">
                                            <FontIcon Glyph="&#xE72C;" FontSize="12"
                                                      Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Button>

                                        <!-- Open in Explorer -->
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Padding="8,6,8,6" MinHeight="32"
                                                Tag="{x:Bind FilePath}"
                                                Click="OnOpenInExplorerClick"
                                                ToolTipService.ToolTip="Open file location">
                                            <FontIcon Glyph="&#xE8DA;" FontSize="12"
                                                      Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Button>

                                        <!-- Delete -->
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Padding="8,6,8,6" MinHeight="32"
                                                Tag="{x:Bind Id}"
                                                Click="OnDeleteDocumentClick"
                                                ToolTipService.ToolTip="Delete document">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12"
                                                      Foreground="{StaticResource ErrorBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Empty state (visible when no documents and not loading) -->
                <Border Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                    <Border Style="{StaticResource DropZoneStyle}"
                            Visibility="{x:Bind HasNoDocumentsVisible(ViewModel.TotalDocuments, ViewModel.ShowDropZone), Mode=OneWay}"
                            AllowDrop="True"
                            DragOver="DropZone_DragOver"
                            DragLeave="DropZone_DragLeave"
                            Drop="DropZone_Drop">
                        <StackPanel Spacing="20" HorizontalAlignment="Center">
                            <!-- Icon -->
                            <Border Background="{StaticResource AccentSubtleBrush}"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Width="80" Height="80"
                                    HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8F1;"
                                          FontSize="36"
                                          Foreground="{StaticResource TextAccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="No documents yet"
                                           Style="{StaticResource HeadingMediumStyle}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Import your first documents to start building your knowledge vault. PDFs, Word files, Markdown, text files, and more are supported."
                                           Style="{StaticResource BodySecondaryStyle}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="420"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button Style="{StaticResource AccentButtonStyle}"
                                    Click="OnImportFilesClick"
                                    HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="Import Your First Files" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Border>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 6: INDEXING STATUS BAR
                 Visible when indexing is active.
                 ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="6"
                    Style="{StaticResource IndexingStatusBarStyle}"
                    Visibility="{x:Bind ViewModel.IsIndexing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing IsActive="True" Width="16" Height="16"
                                      Foreground="{StaticResource AccentPrimaryBrush}" />
                        <TextBlock Text="Indexing in progress..."
                                   Style="{StaticResource BodySmallStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ProgressBar Grid.Column="1"
                                 IsIndeterminate="True"
                                 Style="{StaticResource AccentProgressBarStyle}"
                                 VerticalAlignment="Center"
                                 Margin="16,0" />

                    <Border Grid.Column="2"
                            Style="{StaticResource BadgeDefaultStyle}"
                            Padding="8,3,8,3">
                        <TextBlock Style="{StaticResource MonoSmallStyle}"
                                   Foreground="{StaticResource TextTertiaryBrush}">
                            <Run Text="{x:Bind ViewModel.IndexingQueueLength, Mode=OneWay}" />
                            <Run Text="remaining" />
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>
