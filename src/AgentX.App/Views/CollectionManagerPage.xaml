<Page
    x:Class="AgentX.App.Views.CollectionManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    x:Name="CollectionsRoot"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>

        <!-- ═══════════════════════════════════════════════════════════
             CONVERTERS
             ═══════════════════════════════════════════════════════════ -->

        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NullToVisibilityConverter x:Key="InverseNullToVis" IsInverted="True" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />

    </Page.Resources>

    <Grid Background="{ThemeResource PageBackgroundBrush}">

        <!-- ═══════ ADAPTIVE LAYOUT (Tier 3) — see Colors.xaml breakpoints ═══════
             Narrow (<960):  sidebar 260   |  Medium (>=960): sidebar 300
             Wide (>=1280):  sidebar 320 (markup default) -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="260" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="300" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <!-- Left panel: Collection tree (adaptive width — 260/300/320) -->
            <ColumnDefinition x:Name="SidebarColumn" Width="320" />
            <!-- Right panel: Selected collection detail -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             LEFT PANEL: COLLECTION TREE
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0"
              Background="{ThemeResource SidebarGradientBrush}"
              BorderBrush="{ThemeResource BorderSubtleBrush}"
              BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: Title + count + Refresh -->
            <Border Grid.Row="0" Style="{StaticResource SidebarHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10"
                                VerticalAlignment="Center">
                        <TextBlock x:Uid="CollMgr_Collections" Text="Collections"
                                   Style="{StaticResource HeadingSmallStyle}" />
                        <Border Style="{StaticResource BadgeDefaultStyle}"
                                Padding="6,2,6,2">
                            <TextBlock Style="{StaticResource BadgeStyle}">
                                <Run Text="{x:Bind ViewModel.TotalCollections, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{x:Bind ViewModel.ToggleMultiSelectCommand}"
                                x:Uid="CollMgr_MultiSelectTip" ToolTipService.ToolTip="Select multiple collections"
                                AutomationProperties.Name="Select multiple collections">
                            <FontIcon Glyph="&#xE762;" FontSize="14"
                                      Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{x:Bind ViewModel.RefreshCommand}"
                                x:Uid="CollMgr_RefreshCollectionsTip" ToolTipService.ToolTip="Refresh collections"
                                AutomationProperties.Name="Refresh collections">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"
                                      Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- New collection input area -->
            <Border Grid.Row="1"
                    Padding="16,12,16,12"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Spacing="8">
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             x:Uid="CollMgr_NewCollectionNamePh" PlaceholderText="New collection name..."
                             Text="{x:Bind ViewModel.NewCollectionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             x:Uid="CollMgr_DescriptionOptionalPh" PlaceholderText="Description (optional)"
                             Text="{x:Bind ViewModel.NewCollectionDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.CreateCollectionCommand}"
                            AutomationProperties.LabeledBy="{x:Bind CreateCollectionLabel}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock x:Name="CreateCollectionLabel" x:Uid="CollMgr_CreateCollection" Text="Create Collection" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Bulk action bar: only present while multi-select is active, so the
                 default list stays uncluttered. -->
            <Border Grid.Row="1"
                    VerticalAlignment="Bottom"
                    Padding="16,10,16,10"
                    Background="{ThemeResource AccentSubtleBrush}"
                    BorderBrush="{ThemeResource AccentPrimaryBrush}"
                    BorderThickness="0,1,0,1"
                    Visibility="{x:Bind ViewModel.IsMultiSelectMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource CaptionStyle}"
                               VerticalAlignment="Center">
                        <Run Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" />
                        <Run x:Uid="CollMgr_SelectedRun" Text="selected" />
                    </TextBlock>

                    <Button Grid.Column="1"
                            x:Uid="CollMgr_SelectAll" Content="Select All"
                            Command="{x:Bind ViewModel.SelectAllCollectionsCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            FontSize="12" />

                    <Button Grid.Column="2"
                            x:Uid="CollMgr_BulkDelete" Content="Delete Selected"
                            Click="OnBulkDeleteCollectionsClick"
                            Style="{StaticResource GhostButtonStyle}"
                            Foreground="{ThemeResource ErrorBrush}"
                            FontSize="12" />
                </Grid>
            </Border>

            <!-- Loading indicator -->
            <StackPanel Grid.Row="2"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="32" Height="32"
                              Foreground="{ThemeResource AccentPrimaryBrush}" />
                <TextBlock x:Uid="CollMgr_Loading" Text="Loading..."
                           Style="{StaticResource CaptionStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Collection list -->
            <ListView Grid.Row="2"
                      x:Name="CollectionListView"
                      ItemsSource="{x:Bind ViewModel.Collections, Mode=OneWay}"
                      SelectionMode="None"
                      Padding="8,8,8,8"
                      Background="Transparent"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CollectionDisplayItem">
                        <StackPanel>
                            <!-- Root collection item -->
                            <Border Style="{StaticResource CollectionTreeItemStyle}"
                                    PointerPressed="OnCollectionItemClick"
                                    Tag="{x:Bind}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Multi-select checkbox -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                              Command="{Binding ViewModel.ToggleCollectionSelectionCommand, ElementName=CollectionsRoot}"
                                              CommandParameter="{x:Bind Id}"
                                              MinWidth="0"
                                              Margin="0"
                                              VerticalAlignment="Center"
                                              x:Uid="CollMgr_SelectCollectionBox"
                                              AutomationProperties.Name="Select collection"
                                              Visibility="{Binding ViewModel.IsMultiSelectMode, ElementName=CollectionsRoot, Converter={StaticResource BoolToVis}}" />

                                    <!-- Folder icon -->
                                    <FontIcon Grid.Column="1"
                                              Glyph="{x:Bind IconGlyph, TargetNullValue='&#xF168;'}"
                                              FontSize="16"
                                              Foreground="{ThemeResource TextAccentBrush}"
                                              VerticalAlignment="Center" />

                                    <!-- Name -->
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                   Style="{StaticResource BodyStyle}"
                                                   FontWeight="SemiBold"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Description}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Visibility="{x:Bind Description, Converter={StaticResource StringToVis}}"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Document count badge -->
                                    <Border Grid.Column="3"
                                            Style="{StaticResource BadgeDefaultStyle}"
                                            Padding="6,2,6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                                   FontSize="10">
                                            <Run Text="{x:Bind DocumentCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>

                                    <!-- Rename button -->
                                    <Button Grid.Column="4"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="4" MinHeight="28" MinWidth="28"
                                            Width="28" Height="28"
                                            Command="{Binding ViewModel.BeginRenameCollectionCommand, ElementName=CollectionsRoot}"
                                            CommandParameter="{x:Bind}"
                                            x:Uid="CollMgr_RenameCollectionTip" ToolTipService.ToolTip="Rename collection"
                                            AutomationProperties.Name="Rename collection"
                                            Opacity="0.5">
                                        <FontIcon Glyph="&#xE70F;" FontSize="11"
                                                  Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </Button>

                                    <!-- Export button -->
                                    <Button Grid.Column="5"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="4" MinHeight="28" MinWidth="28"
                                            Width="28" Height="28"
                                            Tag="{x:Bind Id}"
                                            Click="OnExportCollectionClick"
                                            x:Uid="CollMgr_ExportCollectionTip" ToolTipService.ToolTip="Export collection"
                                            AutomationProperties.Name="Export collection"
                                            Opacity="0.5">
                                        <FontIcon Glyph="&#xEDE1;" FontSize="11"
                                                  Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </Button>

                                    <!-- Delete button -->
                                    <Button Grid.Column="6"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="4" MinHeight="28" MinWidth="28"
                                            Width="28" Height="28"
                                            Tag="{x:Bind Id}"
                                            Click="OnDeleteCollectionClick"
                                            x:Uid="CollMgr_DeleteCollectionTip" ToolTipService.ToolTip="Delete collection"
                                            AutomationProperties.Name="Delete collection"
                                            Opacity="0.5">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11"
                                                  Foreground="{ThemeResource ErrorBrush}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Child collections (indented) -->
                            <ItemsRepeater ItemsSource="{x:Bind Children}"
                                           Margin="24,0,0,0">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="0" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CollectionDisplayItem">
                                        <Border Style="{StaticResource CollectionTreeItemStyle}"
                                                PointerPressed="OnCollectionItemClick"
                                                Tag="{x:Bind}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Sub-folder icon -->
                                                <FontIcon Glyph="{x:Bind IconGlyph, TargetNullValue='&#xF168;'}"
                                                          FontSize="14"
                                                          Foreground="{ThemeResource TextSecondaryBrush}"
                                                          VerticalAlignment="Center" />

                                                <!-- Name -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Name}"
                                                           Style="{StaticResource BodySmallStyle}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis" />

                                                <!-- Document count -->
                                                <Border Grid.Column="2"
                                                        Style="{StaticResource BadgeDefaultStyle}"
                                                        Padding="6,2,6,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                                               Foreground="{ThemeResource TextTertiaryBrush}"
                                                               FontSize="10">
                                                        <Run Text="{x:Bind DocumentCount, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>

                                                <!-- Delete button -->
                                                <Button Grid.Column="3"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="4" MinHeight="24" MinWidth="24"
                                                        Width="24" Height="24"
                                                        Tag="{x:Bind Id}"
                                                        Click="OnDeleteCollectionClick"
                                                        x:Uid="CollMgr_DeleteCollectionTip2" ToolTipService.ToolTip="Delete collection"
                                                        AutomationProperties.Name="Delete collection"
                                                        Opacity="0.5">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="10"
                                                              Foreground="{ThemeResource ErrorBrush}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Sidebar footer -->
            <Border Grid.Row="3"
                    Padding="16,10,16,10"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xF168;" FontSize="11"
                              Foreground="{ThemeResource TextTertiaryBrush}" />
                    <TextBlock Style="{StaticResource CaptionStyle}">
                        <Run Text="{x:Bind ViewModel.TotalCollections, Mode=OneWay}" />
                        <Run x:Uid="CollMgr_Collections2" Text="collections" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             RIGHT PANEL: SELECTED COLLECTION DETAIL
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">

            <!-- Empty state: No collection selected -->
            <Border Visibility="{x:Bind ViewModel.SelectedCollection, Mode=OneWay, Converter={StaticResource InverseNullToVis}}"
                    Style="{StaticResource WelcomeCardStyle}">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <!-- Icon -->
                    <Border Background="{ThemeResource AccentSubtleBrush}"
                            CornerRadius="{StaticResource RadiusFull}"
                            Width="72" Height="72"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xF168;"
                                  FontSize="32"
                                  Foreground="{ThemeResource TextAccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock x:Uid="CollMgr_SelectACollection" Text="Select a Collection"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Uid="CollMgr_ChooseACollectionFrom" Text="Choose a collection from the left panel to view its documents. Collections help you organize your knowledge vault into focused groups."
                                   Style="{StaticResource BodySecondaryStyle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="380" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Collection detail (visible when a collection is selected) -->
            <ScrollViewer Visibility="{x:Bind ViewModel.SelectedCollection, Mode=OneWay, Converter={StaticResource NullToVis}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Padding="32,24,32,24" RowSpacing="24" MaxWidth="1000">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Collection header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="{x:Bind ViewModel.SelectedCollection.IconGlyph, Mode=OneWay, TargetNullValue='&#xF168;'}"
                                          FontSize="28"
                                          Foreground="{ThemeResource TextAccentBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedCollection.Name, Mode=OneWay}"
                                           Style="{StaticResource HeadingLargeStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.SelectedCollection.Description, Mode=OneWay}"
                                       Style="{StaticResource BodySecondaryStyle}"
                                       Visibility="{x:Bind ViewModel.SelectedCollection.Description, Mode=OneWay, Converter={StaticResource StringToVis}}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnAddDocumentsClick"
                                VerticalAlignment="Top"
                                AutomationProperties.LabeledBy="{x:Bind AddDocumentsLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock x:Name="AddDocumentsLabel" x:Uid="CollMgr_AddDocuments" Text="Add Documents" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Row 1: Stats badges -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                        <Border Style="{StaticResource BadgeDefaultStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8F1;" FontSize="11"
                                          Foreground="{ThemeResource TextAccentBrush}" />
                                <TextBlock Style="{StaticResource BadgeStyle}">
                                    <Run Text="{x:Bind ViewModel.SelectedCollection.DocumentCount, Mode=OneWay}" />
                                    <Run x:Uid="CollMgr_Documents" Text=" documents" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource BadgeDefaultStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE787;" FontSize="11"
                                          Foreground="{ThemeResource TextTertiaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedCollection.CreatedAtFormatted, Mode=OneWay}"
                                           Style="{StaticResource BadgeStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource BadgeDefaultStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="11"
                                          Foreground="{ThemeResource TextTertiaryBrush}" />
                                <TextBlock Style="{StaticResource BadgeStyle}">
                                    <Run x:Uid="CollMgr_Updated" Text="Updated " />
                                    <Run Text="{x:Bind ViewModel.SelectedCollection.UpdatedAtFormatted, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource SeparatorStyle}" />

                    <!-- Row 3: Error message -->
                    <Border Grid.Row="3"
                            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            Background="{ThemeResource ErrorSubtleBrush}"
                            BorderBrush="{ThemeResource ErrorBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMD}"
                            Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE7BA;" FontSize="16"
                                      Foreground="{ThemeResource ErrorBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                       Style="{StaticResource BodySmallStyle}"
                                       Foreground="{ThemeResource ErrorBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Row 4: Documents in this collection -->
                    <StackPanel Grid.Row="4" Spacing="16">
                        <TextBlock x:Uid="CollMgr_DocumentsInThisCollection" Text="Documents in this Collection"
                                   Style="{StaticResource HeadingSmallStyle}" />

                        <!-- Documents grid -->
                        <ItemsRepeater x:Name="CollectionDocumentsRepeater"
                                       ItemsSource="{x:Bind ViewModel.SelectedCollectionDocuments, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DocumentDisplayItem">
                                    <Border Style="{StaticResource DocumentSimpleCardStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- File type icon -->
                                            <Border Style="{StaticResource FileTypeIconContainerStyle}"
                                                    Width="40" Height="40">
                                                <FontIcon Glyph="{x:Bind FileTypeIcon}"
                                                          FontSize="18"
                                                          Foreground="{ThemeResource TextAccentBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>

                                            <!-- File info -->
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FileName}"
                                                           Style="{StaticResource BodyStyle}"
                                                           FontWeight="SemiBold"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Border Style="{StaticResource FileTypeBadgeStyle}">
                                                        <TextBlock Text="{x:Bind FileTypeLabel}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="{ThemeResource TextAccentBrush}"
                                                                   CharacterSpacing="40" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind FileSizeFormatted}"
                                                               Style="{StaticResource CaptionStyle}" />
                                                    <TextBlock Text="{x:Bind ImportedAtFormatted}"
                                                               Style="{StaticResource CaptionStyle}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Tags -->
                                            <ItemsRepeater Grid.Column="2"
                                                           ItemsSource="{x:Bind Tags}"
                                                           VerticalAlignment="Center">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Horizontal" Spacing="4" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Style="{StaticResource TagBadgeStyle}">
                                                            <TextBlock Text="{x:Bind}"
                                                                       FontSize="9"
                                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>

                                            <!-- Remove button -->
                                            <Button Grid.Column="3"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Padding="6" MinHeight="32" MinWidth="32"
                                                    Tag="{x:Bind Id}"
                                                    Click="OnRemoveDocumentFromCollectionClick"
                                                    x:Uid="CollMgr_RemoveFromCollectionTip" ToolTipService.ToolTip="Remove from collection"
                                                    AutomationProperties.Name="Remove from collection">
                                                <FontIcon Glyph="&#xE738;" FontSize="12"
                                                          Foreground="{ThemeResource TextTertiaryBrush}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Empty state: No documents in this collection -->
                        <Border Style="{StaticResource CardInsetStyle}"
                                Padding="40,32"
                                Visibility="{x:Bind ViewModel.HasSelectedCollectionDocuments, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8F1;" FontSize="32"
                                          Foreground="{ThemeResource TextTertiaryBrush}"
                                          HorizontalAlignment="Center" />
                                <TextBlock x:Uid="CollMgr_NoDocumentsInThis" Text="No documents in this collection"
                                           Style="{StaticResource BodySecondaryStyle}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Uid="CollMgr_ClickAddDocumentsTo" Text="Click 'Add Documents' to assign files from your Knowledge Vault to this collection."
                                           Style="{StaticResource CaptionStyle}"
                                           TextAlignment="Center"
                                           MaxWidth="320"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             RENAME COLLECTION PANEL
             Spans both panels so it reads as a modal layer over the page.
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Background="{ThemeResource OverlayBrush}"
              Visibility="{x:Bind ViewModel.IsRenaming, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Border Background="{ThemeResource CardGradientBrush}"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMD}"
                    Padding="24"
                    MinWidth="380"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="CollMgr_RenameTitle" Text="Rename Collection"
                               Style="{StaticResource HeadingSmallStyle}"
                               AutomationProperties.HeadingLevel="Level2" />

                    <TextBox Text="{x:Bind ViewModel.RenameName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             x:Uid="CollMgr_RenamePh" PlaceholderText="Collection name"
                             Style="{StaticResource InputTextBoxStyle}" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <Button x:Uid="CollMgr_RenameCancel" Content="Cancel"
                                Command="{x:Bind ViewModel.CancelRenameCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Uid="CollMgr_RenameSave" Content="Rename"
                                Command="{x:Bind ViewModel.RenameCollectionCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
