            </Border>


            <!-- ══════════════════════════════════════════════════════════
                 ROW 2: DESCRIPTION OF SERVICE
                 ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE946;"
                                  FontSize="18"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="2. Description of Service"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Agent-X is a local-first AI personal intelligence hub for Windows. It provides the following capabilities:" />

                    <!-- Feature list -->
                    <StackPanel Spacing="8" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="12"
                                      Foreground="{StaticResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       Text="Local AI chat via Ollama integration" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="12"
                                      Foreground="{StaticResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       Text="Document management and indexing" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="12"
                                      Foreground="{StaticResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       Text="Retrieval-augmented generation (RAG)" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="12"
                                      Foreground="{StaticResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       Text="Semantic search across your documents" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="12"
                                      Foreground="{StaticResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       Text="Model management" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="12"
                                      Foreground="{StaticResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       Text="Hardware capability analysis" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Margin="0,4,0,0"
                               Text="All processing occurs locally on your device. Agent-X does not transmit your data to external servers for AI inference." />
                </StackPanel>
