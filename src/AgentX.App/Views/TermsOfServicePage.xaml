<Page
    x:Class="AgentX.App.Views.TermsOfServicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║                 AGENT-X TERMS OF SERVICE PAGE                    ║
    ║                                                                  ║
    ║  Comprehensive legal terms for Agent-X desktop application.      ║
    ║  Effective Date: February 26, 2026                               ║
    ║  Company: Strategia-X                                            ║
    ╚══════════════════════════════════════════════════════════════════╝
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">

        <Grid Padding="{StaticResource PaddingPage}"
              RowSpacing="20"
              MaxWidth="760"
              HorizontalAlignment="Center">

            <Grid.RowDefinitions>
                <!-- Row 0:  Page Header -->
                <RowDefinition Height="Auto" />
                <!-- Row 1:  Acceptance of Terms -->
                <RowDefinition Height="Auto" />
                <!-- Row 2:  Description of Service -->
                <RowDefinition Height="Auto" />
                <!-- Row 3:  License Grant -->
                <RowDefinition Height="Auto" />
                <!-- Row 4:  User Responsibilities -->
                <RowDefinition Height="Auto" />
                <!-- Row 5:  Intellectual Property -->
                <RowDefinition Height="Auto" />
                <!-- Row 6:  Third-Party Software -->
                <RowDefinition Height="Auto" />
                <!-- Row 7:  Privacy -->
                <RowDefinition Height="Auto" />
                <!-- Row 8:  Disclaimer of Warranties (warning card) -->
                <RowDefinition Height="Auto" />
                <!-- Row 9:  Limitation of Liability (warning card) -->
                <RowDefinition Height="Auto" />
                <!-- Row 10: AI-Generated Content Disclaimer -->
                <RowDefinition Height="Auto" />
                <!-- Row 11: Indemnification -->
                <RowDefinition Height="Auto" />
                <!-- Row 12: Termination -->
                <RowDefinition Height="Auto" />
                <!-- Row 13: Modifications to Terms -->
                <RowDefinition Height="Auto" />
                <!-- Row 14: Governing Law -->
                <RowDefinition Height="Auto" />
                <!-- Row 15: Severability -->
                <RowDefinition Height="Auto" />
                <!-- Row 16: Entire Agreement -->
                <RowDefinition Height="Auto" />
                <!-- Row 17: Contact Information -->
                <RowDefinition Height="Auto" />
                <!-- Row 18: Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!-- ══════════════════════════════════════════════════════════
                 ROW 0: PAGE HEADER
                 ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,8">

                <!-- Overline label -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;"
                              FontSize="14"
                              Foreground="{StaticResource TextAccentBrush}" />
                    <TextBlock Text="LEGAL"
                               Style="{StaticResource OverlineStyle}"
                               Foreground="{StaticResource TextAccentBrush}" />
                </StackPanel>

                <!-- Title -->
                <TextBlock Text="Terms of Service"
                           Style="{StaticResource DisplaySmallStyle}"
                           AutomationProperties.HeadingLevel="Level1" />

                <!-- Effective date -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE787;"
                              FontSize="12"
                              Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Text="Effective Date: February 26, 2026"
                               Style="{StaticResource CaptionStyle}" />
                </StackPanel>

                <!-- Intro paragraph -->
                <TextBlock Style="{StaticResource BodySecondaryStyle}"
                           Margin="0,4,0,0"
                           Text="Please read these Terms of Service ('Terms') carefully before using Agent-X, a desktop application developed by Strategia-X ('Company', 'we', 'us', 'our'). By installing or using Agent-X, you agree to be bound by these Terms." />
            </StackPanel>


            <!-- ══════════════════════════════════════════════════════════
                 ROW 1: ACCEPTANCE OF TERMS
                 ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8FB;"
                                  FontSize="18"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="1. Acceptance of Terms"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="By downloading, installing, or using Agent-X, you acknowledge that you have read, understood, and agree to be bound by these Terms. If you do not agree to these Terms, you must not use Agent-X. Your continued use of the application constitutes your ongoing acceptance of any updated Terms." />
