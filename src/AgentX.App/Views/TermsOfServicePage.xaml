            <Border Grid.Row="8"
                    CornerRadius="{StaticResource RadiusLG}"
                    Padding="{StaticResource PaddingCard}"
                    BorderThickness="1"
                    BorderBrush="{StaticResource WarningBrush}"
                    Opacity="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1AF59E0B" Offset="0.0" />
                        <GradientStop Color="{StaticResource Surface1}" Offset="0.35" />
                        <GradientStop Color="{StaticResource Surface0}" Offset="1.0" />
