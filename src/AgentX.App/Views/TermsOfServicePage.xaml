<Page
    x:Class="AgentX.App.Views.TermsOfServicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AgentX.App.Controls"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║                 AGENT-X TERMS OF SERVICE PAGE                    ║
    ║                                                                  ║
    ║  Comprehensive legal terms for Agent-X desktop application.      ║
    ║  Effective Date: February 26, 2026                               ║
    ║  Company: Strategia-X                                            ║
    ╚══════════════════════════════════════════════════════════════════╝
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">

        <Grid Padding="{StaticResource PaddingPage}"
              RowSpacing="20"
              MaxWidth="760"
              HorizontalAlignment="Center">

            <Grid.RowDefinitions>
                <!-- Row 0:  Page Header -->
                <RowDefinition Height="Auto" />
                <!-- Row 1:  Acceptance of Terms -->
                <RowDefinition Height="Auto" />
                <!-- Row 2:  Description of Service -->
                <RowDefinition Height="Auto" />
                <!-- Row 3:  License Grant -->
                <RowDefinition Height="Auto" />
                <!-- Row 4:  User Responsibilities -->
                <RowDefinition Height="Auto" />
                <!-- Row 5:  Intellectual Property -->
                <RowDefinition Height="Auto" />
                <!-- Row 6:  Third-Party Software -->
                <RowDefinition Height="Auto" />
                <!-- Row 7:  Privacy -->
                <RowDefinition Height="Auto" />
                <!-- Row 8:  Disclaimer of Warranties (warning card) -->
                <RowDefinition Height="Auto" />
                <!-- Row 9:  Limitation of Liability (warning card) -->
                <RowDefinition Height="Auto" />
                <!-- Row 10: AI-Generated Content Disclaimer -->
                <RowDefinition Height="Auto" />
                <!-- Row 11: Indemnification -->
                <RowDefinition Height="Auto" />
                <!-- Row 12: Termination -->
                <RowDefinition Height="Auto" />
                <!-- Row 13: Modifications to Terms -->
                <RowDefinition Height="Auto" />
                <!-- Row 14: Governing Law -->
                <RowDefinition Height="Auto" />
                <!-- Row 15: Severability -->
                <RowDefinition Height="Auto" />
                <!-- Row 16: Entire Agreement -->
                <RowDefinition Height="Auto" />
                <!-- Row 17: Contact Information -->
                <RowDefinition Height="Auto" />
                <!-- Row 18: Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!-- ══════════════════════════════════════════════════════════
                 ROW 0: PAGE HEADER
                 ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,8">

                <!-- Overline label -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;"
                              FontSize="14"
                              Foreground="{ThemeResource TextAccentBrush}" />
                    <TextBlock x:Uid="Terms_Legal" Text="LEGAL"
                               Style="{StaticResource OverlineStyle}"
                               Foreground="{ThemeResource TextAccentBrush}" />
                </StackPanel>

                <!-- Title -->
                <TextBlock x:Uid="Terms_TermsOfService" Text="Terms of Service"
                           Style="{StaticResource DisplaySmallStyle}"
                           AutomationProperties.HeadingLevel="Level1" />

                <!-- Effective date -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE787;"
                              FontSize="12"
                              Foreground="{ThemeResource TextTertiaryBrush}" />
                    <TextBlock x:Uid="Terms_EffectiveDateFebruary26" Text="Effective Date: February 26, 2026"
                               Style="{StaticResource CaptionStyle}" />
                </StackPanel>

                <!-- Intro paragraph -->
                <TextBlock Style="{StaticResource BodySecondaryStyle}"
                           Margin="0,4,0,0"
                           x:Uid="Terms_PleaseReadTheseTerms" Text="Please read these Terms of Service ('Terms') carefully before using Agent-X, a desktop application developed by Strategia-X ('Company', 'we', 'us', 'our'). By installing or using Agent-X, you agree to be bound by these Terms." />
            </StackPanel>


            <!-- ══════════════════════════════════════════════════════════
                 ROW 1: ACCEPTANCE OF TERMS
                 ══════════════════════════════════════════════════════════ -->
            <controls:Faceplate Grid.Row="1" Kicker="MOD - TOS - 01">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8FB;"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextAccentBrush}" />
                        <TextBlock x:Uid="Terms_1AcceptanceOfTerms" Text="1. Acceptance of Terms"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Terms_ByDownloadingInstallingOr" Text="By downloading, installing, or using Agent-X, you acknowledge that you have read, understood, and agree to be bound by these Terms. If you do not agree to these Terms, you must not use Agent-X. Your continued use of the application constitutes your ongoing acceptance of any updated Terms." />
                </StackPanel>
            </controls:Faceplate>


            <!-- ══════════════════════════════════════════════════════════
                 ROW 2: DESCRIPTION OF SERVICE
                 ══════════════════════════════════════════════════════════ -->
            <controls:Faceplate Grid.Row="2" Kicker="MOD - TOS - 02">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE946;"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextAccentBrush}" />
                        <TextBlock x:Uid="Terms_2DescriptionOfService" Text="2. Description of Service"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Terms_AgentXIsA" Text="Agent-X is a local-first AI personal intelligence hub for Windows. It provides the following capabilities:" />

                    <!-- Feature list -->
                    <StackPanel Spacing="8" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_LocalAiChatVia" Text="Local AI chat via Ollama integration" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_DocumentManagementAndIndexing" Text="Document management and indexing" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_RetrievalAugmentedGenerationRa" Text="Retrieval-augmented generation (RAG)" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_SemanticSearchAcrossYour" Text="Semantic search across your documents" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_ModelManagement" Text="Model management" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_HardwareCapabilityAnalysis" Text="Hardware capability analysis" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Margin="0,4,0,0"
                               x:Uid="Terms_AllProcessingOccursLocally" Text="All processing occurs locally on your device. Agent-X does not transmit your data to external servers for AI inference." />
                </StackPanel>
            </controls:Faceplate>


            <!-- ══════════════════════════════════════════════════════════
                 ROW 3: LICENSE GRANT
                 ══════════════════════════════════════════════════════════ -->
            <controls:Faceplate Grid.Row="3" Kicker="MOD - TOS - 03">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8D7;"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextAccentBrush}" />
                        <TextBlock x:Uid="Terms_3LicenseGrant" Text="3. License Grant"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Agent-X is free and open-source software released under the MIT License. You are granted a perpetual, worldwide, royalty-free right to use, copy, modify, merge, publish, distribute, sublicense, and even sell copies of the software, subject only to the terms of the MIT License. The complete source code and MIT License are available at https://github.com/Git-Rocky-Stack/Agent-X." />

                    <TextBlock Style="{StaticResource HeadingSmallStyle}"
                               x:Uid="Terms_UnderTheMitLicense" Text="Under the MIT License you may freely:"
                               Margin="0,4,0,0" />

                    <StackPanel Spacing="8" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_UseAgentXFor" Text="Use Agent-X for any purpose — personal, commercial, or otherwise" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_StudyModifyAndBuild" Text="Study, modify, and build upon the source code" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_DistributeAndSublicenseCopies" Text="Distribute and sublicense copies, with or without modification" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_IncludeAgentXIn" Text="Include Agent-X in your own projects, free of charge" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Margin="0,4,0,0"
                               x:Uid="Terms_TheOnlyConditionIs" Text="The only condition is that the MIT copyright notice and permission notice be included in all copies or substantial portions of the software." />
                </StackPanel>
            </controls:Faceplate>


            <!-- ══════════════════════════════════════════════════════════
                 ROW 4: USER RESPONSIBILITIES
                 ══════════════════════════════════════════════════════════ -->
            <controls:Faceplate Grid.Row="4" Kicker="MOD - TOS - 04">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE77B;"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextAccentBrush}" />
                        <TextBlock x:Uid="Terms_4UserResponsibilities" Text="4. User Responsibilities"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Terms_YouAreResponsibleFor" Text="You are responsible for:" />

                    <StackPanel Spacing="8" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xEA3C;"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_EnsuringYourSystemMeets" Text="Ensuring your system meets the minimum hardware and software requirements for Agent-X" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xEA3C;"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_InstallingAndMaintainingOllama" Text="Installing and maintaining Ollama separately, as it is not bundled with Agent-X" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xEA3C;"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_TheContentOfAny" Text="The content of any documents you import into or process through Agent-X" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xEA3C;"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_ComplianceWithAllApplicable" Text="Compliance with all applicable laws and regulations regarding your use of the application" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xEA3C;"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_MaintainingTheSecurityOf" Text="Maintaining the security of your device and any credentials stored locally" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xEA3C;"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_BackingUpYourData" Text="Backing up your data regularly, as Strategia-X is not responsible for data loss" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </controls:Faceplate>


            <!-- ══════════════════════════════════════════════════════════
                 ROW 5: INTELLECTUAL PROPERTY
                 ══════════════════════════════════════════════════════════ -->
            <controls:Faceplate Grid.Row="5" Kicker="MOD - TOS - 05">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE82D;"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextAccentBrush}" />
                        <TextBlock x:Uid="Terms_5IntellectualProperty" Text="5. Intellectual Property"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Terms_AgentXIsOpen" Text="Agent-X is open-source software. The source code, documentation, and other materials are made available under the MIT License, and copyright is retained by the original authors and contributors as noted in that license. You are free to use and build upon these materials in accordance with the MIT License terms." />
                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Terms_YourDocumentsAndData" Text="Your documents and data remain your property at all times. We claim no ownership of content you process through Agent-X. You retain all rights to your intellectual property." />
                </StackPanel>
            </controls:Faceplate>


            <!-- ══════════════════════════════════════════════════════════
                 ROW 6: THIRD-PARTY SOFTWARE
                 ══════════════════════════════════════════════════════════ -->
            <controls:Faceplate Grid.Row="6" Kicker="MOD - TOS - 06">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE71B;"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextAccentBrush}" />
                        <TextBlock x:Uid="Terms_6ThirdPartySoftware" Text="6. Third-Party Software"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Terms_AgentXIntegratesWith" Text="Agent-X integrates with Ollama, an open-source project developed by Ollama, Inc. Ollama is subject to its own license terms and conditions, which are separate from these Terms. You are responsible for reviewing and complying with Ollama's terms of service." />
                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Terms_AgentXAlsoUses" Text="Agent-X also uses various open-source libraries, each governed by their respective licenses. These licenses are included in the application distribution. Your use of Agent-X constitutes acceptance of these third-party license terms." />
                </StackPanel>
            </controls:Faceplate>


            <!-- ══════════════════════════════════════════════════════════
                 ROW 7: PRIVACY
                 ══════════════════════════════════════════════════════════ -->
            <controls:Faceplate Grid.Row="7" Kicker="MOD - TOS - 07">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE72E;"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextAccentBrush}" />
                        <TextBlock x:Uid="Terms_7Privacy" Text="7. Privacy"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Terms_YourUseOfAgent" Text="Your use of Agent-X is also governed by our Privacy Policy, which is accessible within the application. The Privacy Policy describes how we handle data, what information (if any) is collected, and your rights regarding your personal data." />
                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Terms_ByUsingAgentX" Text="By using Agent-X, you acknowledge and agree to our data practices as described in the Privacy Policy. The Privacy Policy is incorporated into these Terms by reference." />
                </StackPanel>
            </controls:Faceplate>


            <!-- ══════════════════════════════════════════════════════════
                 ROW 8: DISCLAIMER OF WARRANTIES (Warning-style card)
                 ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="8"
                    Background="{ThemeResource CardElevatedBrush}"
                    CornerRadius="{StaticResource ROverlay}"
                    Padding="{StaticResource PaddingCard}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource WarningBrush}">

                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7BA;"
                                  FontSize="18"
                                  Foreground="{ThemeResource WarningBrush}" />
                        <TextBlock x:Uid="Terms_8DisclaimerOfWarranties" Text="8. Disclaimer of Warranties"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>

                    <!-- Uppercase legal disclaimer block -->
                    <Border Background="{ThemeResource CardBrush}"
                            CornerRadius="{StaticResource RadiusMD}"
                            Padding="16"
                            BorderBrush="{ThemeResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <TextBlock Style="{StaticResource BodyStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   x:Uid="Terms_AgentXIsProvided" Text="AGENT-X IS PROVIDED &quot;AS IS&quot; AND &quot;AS AVAILABLE&quot; WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED. TO THE FULLEST EXTENT PERMITTED BY LAW, STRATEGIA-X DISCLAIMS ALL WARRANTIES INCLUDING, BUT NOT LIMITED TO, IMPLIED WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, AND NON-INFRINGEMENT." />
                    </Border>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Terms_WeDoNotWarrant" Text="We do not warrant that:" />

                    <StackPanel Spacing="8" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE711;"
                                      FontSize="11"
                                      Foreground="{ThemeResource WarningBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_TheApplicationWillBe" Text="The application will be error-free or uninterrupted" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE711;"
                                      FontSize="11"
                                      Foreground="{ThemeResource WarningBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_AiGeneratedResponsesWill" Text="AI-generated responses will be accurate, complete, or reliable" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE711;"
                                      FontSize="11"
                                      Foreground="{ThemeResource WarningBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_TheApplicationWillMeet" Text="The application will meet your specific requirements" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE711;"
                                      FontSize="11"
                                      Foreground="{ThemeResource WarningBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_DefectsInTheApplication" Text="Defects in the application will be corrected in a timely manner" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- ══════════════════════════════════════════════════════════
                 ROW 9: LIMITATION OF LIABILITY (Warning-style card)
                 ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="9"
                    Background="{ThemeResource CardElevatedBrush}"
                    CornerRadius="{StaticResource ROverlay}"
                    Padding="{StaticResource PaddingCard}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource WarningBrush}">

                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7BA;"
                                  FontSize="18"
                                  Foreground="{ThemeResource WarningBrush}" />
                        <TextBlock x:Uid="Terms_9LimitationOfLiability" Text="9. Limitation of Liability"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>

                    <!-- Uppercase legal disclaimer block -->
                    <Border Background="{ThemeResource CardBrush}"
                            CornerRadius="{StaticResource RadiusMD}"
                            Padding="16"
                            BorderBrush="{ThemeResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <TextBlock Style="{StaticResource BodyStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   x:Uid="Terms_ToTheMaximumExtent" Text="TO THE MAXIMUM EXTENT PERMITTED BY APPLICABLE LAW, STRATEGIA-X SHALL NOT BE LIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR PUNITIVE DAMAGES, INCLUDING BUT NOT LIMITED TO LOSS OF DATA OR DOCUMENTS, LOSS OF PROFITS OR REVENUE, DAMAGE TO HARDWARE OR SOFTWARE, BUSINESS INTERRUPTION, OR ANY OTHER INTANGIBLE LOSSES ARISING FROM YOUR USE OF OR INABILITY TO USE AGENT-X." />
                    </Border>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Terms_ThisLimitationAppliesRegardles" Text="This limitation applies regardless of the legal theory on which the claim is based, whether we have been advised of the possibility of such damages, and even if a remedy fails of its essential purpose." />

                    <TextBlock Style="{StaticResource BodyStyle}"
                               FontWeight="SemiBold"
                               x:Uid="Terms_AgentXIsProvided2" Text="Agent-X is provided to you free of charge under the MIT License. To the fullest extent permitted by law, the authors and copyright holders shall have no liability to you for any claims arising from or relating to Agent-X." />
                </StackPanel>
            </Border>


            <!-- ══════════════════════════════════════════════════════════
                 ROW 10: AI-GENERATED CONTENT DISCLAIMER
                 ══════════════════════════════════════════════════════════ -->
            <controls:Faceplate Grid.Row="10" Kicker="MOD - TOS - 08">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE99A;"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextAccentBrush}" />
                        <TextBlock x:Uid="Terms_10AiGeneratedContent" Text="10. AI-Generated Content Disclaimer"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyStyle}"
                               x:Uid="Terms_AgentXUsesLocally" Text="Agent-X uses locally-running AI models to generate responses and perform analysis. It is important that you understand the following:" />

                    <StackPanel Spacing="8" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE946;"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_AiOutputMayContain" Text="AI output may contain inaccuracies, errors, or biases inherent in the underlying models" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE946;"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_YouShouldIndependentlyVerify" Text="You should independently verify any important information generated by AI before relying on it" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE946;"
                                      FontSize="11"
                                      Foreground="{ThemeResource TextAccentBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       x:Uid="Terms_StrategiaXIsNot" Text="Strategia-X is not responsible for any decisions made based on AI-generated content" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
