<Page
    x:Class="AgentX.App.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    Background="Transparent"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:StatusToColorConverter x:Key="StatusToColor" />
    </Page.Resources>

    <Grid>
        <!-- Removed: ambient radial red glow. Wizard now sits cleanly on the
             flat page background; brand presence comes from the AX mark in
             the header and the red accent on the active step. -->

        <!-- Main Wizard Layout -->
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 0: STEP INDICATOR (5 dots with connectors)
                 ═══════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        Margin="0,40,0,0">

                <!-- Step 0 Dot -->
                <Grid Width="32" Height="32">
                    <Ellipse Width="10" Height="10"
                             Fill="{ThemeResource AccentPrimaryBrush}"
                             Visibility="{x:Bind ViewModel.IsStep0Visible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Ellipse Width="8" Height="8"
                             Fill="{ThemeResource TextTertiaryBrush}"
                             Opacity="0.4"
                             Visibility="{x:Bind ViewModel.IsStep0Visible, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>

                <Border Width="24" Height="1" Background="{ThemeResource BorderSubtleBrush}" VerticalAlignment="Center" />

                <!-- Step 1 Dot -->
                <Grid Width="32" Height="32">
                    <Ellipse Width="10" Height="10"
                             Fill="{ThemeResource AccentPrimaryBrush}"
                             Visibility="{x:Bind ViewModel.IsStep1Visible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Ellipse Width="8" Height="8"
                             Fill="{ThemeResource TextTertiaryBrush}"
                             Opacity="0.4"
                             Visibility="{x:Bind ViewModel.IsStep1Visible, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>

                <Border Width="24" Height="1" Background="{ThemeResource BorderSubtleBrush}" VerticalAlignment="Center" />

                <!-- Step 2 Dot -->
                <Grid Width="32" Height="32">
                    <Ellipse Width="10" Height="10"
                             Fill="{ThemeResource AccentPrimaryBrush}"
                             Visibility="{x:Bind ViewModel.IsStep2Visible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Ellipse Width="8" Height="8"
                             Fill="{ThemeResource TextTertiaryBrush}"
                             Opacity="0.4"
                             Visibility="{x:Bind ViewModel.IsStep2Visible, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>

                <Border Width="24" Height="1" Background="{ThemeResource BorderSubtleBrush}" VerticalAlignment="Center" />

                <!-- Step 3 Dot -->
                <Grid Width="32" Height="32">
                    <Ellipse Width="10" Height="10"
                             Fill="{ThemeResource AccentPrimaryBrush}"
                             Visibility="{x:Bind ViewModel.IsStep3Visible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Ellipse Width="8" Height="8"
                             Fill="{ThemeResource TextTertiaryBrush}"
                             Opacity="0.4"
                             Visibility="{x:Bind ViewModel.IsStep3Visible, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>

                <Border Width="24" Height="1" Background="{ThemeResource BorderSubtleBrush}" VerticalAlignment="Center" />

                <!-- Step 4 Dot -->
                <Grid Width="32" Height="32">
                    <Ellipse Width="10" Height="10"
                             Fill="{ThemeResource AccentPrimaryBrush}"
                             Visibility="{x:Bind ViewModel.IsStep4Visible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Ellipse Width="8" Height="8"
                             Fill="{ThemeResource TextTertiaryBrush}"
                             Opacity="0.4"
                             Visibility="{x:Bind ViewModel.IsStep4Visible, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 1: CONTENT AREA — All Steps
                 ═══════════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0">

                <Grid HorizontalAlignment="Center"
                      MaxWidth="700"
                      Padding="32,40,32,32">

                    <!-- ════════════════════════════════════════════
                         STEP 0: WELCOME
                         ════════════════════════════════════════════ -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsStep0Visible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Spacing="32"
                                HorizontalAlignment="Center">

                        <!-- AX Logo Mark -->
                        <Grid Width="80" Height="80"
                              HorizontalAlignment="Center"
                              Margin="0,16,0,0">
                            <Border CornerRadius="{StaticResource RadiusLG}"
                                    Background="{ThemeResource AccentGradientBrush}">
                                <TextBlock Text="AX"
                                           FontFamily="{StaticResource FontDisplay}"
                                           FontSize="32"
                                           FontWeight="Black"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           CharacterSpacing="-30" />
                            </Border>
                        </Grid>

                        <!-- Hero Text -->
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <TextBlock x:Uid="Onb_WelcomeTitle" Text="Welcome to Agent-X"
                                       Style="{StaticResource DisplayLargeStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <TextBlock x:Uid="Onb_WelcomeSubtitle" Text="Your Local-First AI Intelligence Hub"
                                       Style="{StaticResource HeadingMediumStyle}"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       FontWeight="Normal" />
                        </StackPanel>

                        <!-- Value Propositions -->
                        <StackPanel Spacing="16" Margin="0,8,0,0">

                            <!-- Private & Secure -->
                            <Border Style="{StaticResource CardStyle}" Padding="20">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44"
                                            CornerRadius="{StaticResource RadiusMD}"
                                            Background="{ThemeResource AccentSubtleBrush}">
                                        <FontIcon Glyph="&#xE72E;"
                                                  FontSize="20"
                                                  Foreground="{ThemeResource AccentPrimaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Uid="Onb_PrivateTitle" Text="Private &amp; Secure"
                                                   Style="{StaticResource HeadingSmallStyle}" />
                                        <TextBlock x:Uid="Onb_PrivateDesc" Text="Everything runs locally on your machine. Your data never leaves your device."
                                                   Style="{StaticResource BodySecondaryStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Unlimited & Free -->
                            <Border Style="{StaticResource CardStyle}" Padding="20">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44"
                                            CornerRadius="{StaticResource RadiusMD}"
                                            Background="{ThemeResource AccentSubtleBrush}">
                                        <FontIcon Glyph="&#xE734;"
                                                  FontSize="20"
                                                  Foreground="{ThemeResource AccentPrimaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Uid="Onb_FreeTitle" Text="Unlimited &amp; Free"
                                                   Style="{StaticResource HeadingSmallStyle}" />
                                        <TextBlock x:Uid="Onb_FreeDesc" Text="Powered by local open-source AI models via Ollama. Optionally connect to OpenAI or Anthropic Claude for cloud-based models."
                                                   Style="{StaticResource BodySecondaryStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Your Data, Your Rules -->
                            <Border Style="{StaticResource CardStyle}" Padding="20">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44"
                                            CornerRadius="{StaticResource RadiusMD}"
                                            Background="{ThemeResource AccentSubtleBrush}">
                                        <FontIcon Glyph="&#xE8F1;"
                                                  FontSize="20"
                                                  Foreground="{ThemeResource AccentPrimaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Uid="Onb_DataTitle" Text="Your Data, Your Rules"
                                                   Style="{StaticResource HeadingSmallStyle}" />
                                        <TextBlock x:Uid="Onb_DataDesc" Text="Index your documents, search semantically, and chat with your files. Use local AI for full privacy, or optional cloud providers for additional model choices."
                                                   Style="{StaticResource BodySecondaryStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ════════════════════════════════════════════
                         STEP 1: OLLAMA CONNECTION
                         ════════════════════════════════════════════ -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsStep1Visible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Spacing="24"
                                HorizontalAlignment="Stretch">

                        <!-- Header -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock x:Uid="Onb_OllamaTitle" Text="Connect to Ollama"
                                       Style="{StaticResource DisplayMediumStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <TextBlock x:Uid="Onb_OllamaDesc" Text="Agent-X uses Ollama to run AI models locally on your machine. Ollama is a free, open-source tool that manages and serves AI models. You can also configure OpenAI or Anthropic providers later in Settings."
                                       Style="{StaticResource BodySecondaryStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="560" />
                        </StackPanel>

                        <!-- Endpoint Input Card -->
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,8,0,0">
                            <StackPanel Spacing="16">
                                <TextBlock x:Uid="Onb_EndpointOverline" Text="OLLAMA ENDPOINT"
                                           Style="{StaticResource OverlineStyle}" />
                                <TextBox Text="{x:Bind ViewModel.OllamaEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         PlaceholderText="http://localhost:11434" />

                                <!-- Test Connection Button & Spinner -->
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Uid="Onb_TestConnBtn" Content="Test Connection"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Command="{x:Bind ViewModel.TestConnectionCommand}" />

                                    <ProgressRing Grid.Column="1"
                                                  IsActive="{x:Bind ViewModel.IsTestingConnection, Mode=OneWay}"
                                                  Visibility="{x:Bind ViewModel.IsTestingConnection, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                  Width="24" Height="24"
                                                  Foreground="{ThemeResource AccentPrimaryBrush}"
                                                  VerticalAlignment="Center" />
                                </Grid>

                                <!-- Connection Status Result -->
                                <Border Visibility="{x:Bind ViewModel.ShowConnectionStatus, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        Padding="16,12"
                                        Background="{ThemeResource InputBackgroundBrush}"
                                        Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <!-- Dot color reflects the actual connection-test
                                             result (connected/failed/untested) rather than a
                                             constant green default. -->
                                        <Ellipse Width="8" Height="8"
                                                 VerticalAlignment="Center"
                                                 Fill="{x:Bind ViewModel.ConnectionStatusTone, Mode=OneWay, Converter={StaticResource StatusToColor}}" />
                                        <TextBlock Text="{x:Bind ViewModel.ConnectionStatusText, Mode=OneWay}"
                                                   Style="{StaticResource BodyStyle}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Help Text & Skip -->
                        <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center">
                                <Run x:Uid="Onb_OllamaHelpRun1" Text="Don't have Ollama? Visit" />
                                <Run Text="ollama.com" Foreground="{ThemeResource TextAccentBrush}" FontWeight="SemiBold" />
                                <Run x:Uid="Onb_OllamaHelpRun2" Text="to install it." />
                            </TextBlock>

                            <Button x:Uid="Onb_SkipBtn" Content="Skip for now — I'll set it up later"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.SkipOllamaSetupCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ════════════════════════════════════════════
                         STEP 2: MODEL SELECTION
                         ════════════════════════════════════════════ -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsStep2Visible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Spacing="24"
                                HorizontalAlignment="Stretch">

                        <!-- Header -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock x:Uid="Onb_ModelsTitle" Text="Choose Your Models"
                                       Style="{StaticResource DisplayMediumStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <TextBlock x:Uid="Onb_ModelsDesc" Text="Select a default chat model and an embedding model for semantic search."
                                       Style="{StaticResource BodySecondaryStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="560" />
                        </StackPanel>

                        <!-- Hardware Info Badge -->
                        <Border Style="{StaticResource BadgeDefaultStyle}"
                                HorizontalAlignment="Center"
                                Visibility="{x:Bind ViewModel.HardwareInfo, Mode=OneWay, Converter={StaticResource StringToVis}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE950;" FontSize="12"
                                          Foreground="{ThemeResource TextTertiaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.HardwareInfo, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Loading Indicator -->
                        <StackPanel Visibility="{x:Bind ViewModel.IsLoadingModels, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Center"
                                    Spacing="12" Margin="0,24,0,0">
                            <ProgressRing IsActive="True"
                                          Width="32" Height="32"
                                          Foreground="{ThemeResource AccentPrimaryBrush}" />
                            <TextBlock x:Uid="Onb_LoadingModels" Text="Loading available models..."
                                       Style="{StaticResource BodySecondaryStyle}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Models Available State -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasModels, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Spacing="20">

                            <!-- Chat Model Selection -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8BD;" FontSize="16"
                                                  Foreground="{ThemeResource AccentPrimaryBrush}" />
                                        <TextBlock x:Uid="Onb_ChatModelOverline" Text="CHAT MODEL"
                                                   Style="{StaticResource OverlineStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Uid="Onb_ChatModelDesc" Text="Select the model used for AI conversations and text generation."
                                               Style="{StaticResource BodySecondaryStyle}" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                                              SelectedValue="{x:Bind ViewModel.SelectedChatModel, Mode=TwoWay}"
                                              SelectedValuePath="ModelId"
                                              DisplayMemberPath="DisplayName"
                                              HorizontalAlignment="Stretch"
                                              Background="{ThemeResource InputBackgroundBrush}"
                                              BorderBrush="{ThemeResource InputBorderBrush}"
                                              CornerRadius="{StaticResource RadiusMD}" />
                                </StackPanel>
                            </Border>

                            <!-- Embedding Model Selection -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE773;" FontSize="16"
                                                  Foreground="{ThemeResource AccentPrimaryBrush}" />
                                        <TextBlock x:Uid="Onb_EmbModelOverline" Text="EMBEDDING MODEL"
                                                   Style="{StaticResource OverlineStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Uid="Onb_EmbModelDesc" Text="Select the model used for semantic search and document indexing."
                                               Style="{StaticResource BodySecondaryStyle}" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                                              SelectedValue="{x:Bind ViewModel.SelectedEmbeddingModel, Mode=TwoWay}"
                                              SelectedValuePath="ModelId"
                                              DisplayMemberPath="DisplayName"
                                              HorizontalAlignment="Stretch"
                                              Background="{ThemeResource InputBackgroundBrush}"
                                              BorderBrush="{ThemeResource InputBorderBrush}"
                                              CornerRadius="{StaticResource RadiusMD}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- No Models / Not Connected State -->
                        <Border Visibility="{x:Bind ViewModel.HasModels, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
                                Style="{StaticResource CardStyle}"
                                Margin="0,8,0,0">
                            <StackPanel Spacing="12" HorizontalAlignment="Center" Padding="20">
                                <FontIcon Glyph="&#xE946;" FontSize="36"
                                          Foreground="{ThemeResource TextTertiaryBrush}"
                                          HorizontalAlignment="Center" />
                                <TextBlock x:Uid="Onb_NoModelsTitle" Text="No models available"
                                           Style="{StaticResource HeadingSmallStyle}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Uid="Onb_NoModelsDesc" Text="Ollama is not connected, so models cannot be listed. You can configure models later in Settings or the Model Manager."
                                           Style="{StaticResource BodySecondaryStyle}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           MaxWidth="420" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0">
                                    <Run x:Uid="Onb_DefaultChatRun" Text="Default chat model:" />
                                    <Run Text="llama3.2" Foreground="{ThemeResource TextAccentBrush}" FontWeight="SemiBold" />
                                    <Run x:Uid="Onb_DefaultEmbRun" Text="  |  Default embedding model:" />
                                    <Run Text="all-minilm" Foreground="{ThemeResource TextAccentBrush}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════════════════════════════════
                         STEP 3: BUILT-IN AI & CLOUD API KEYS
                         ════════════════════════════════════════════ -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsStep3Visible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Spacing="24"
                                HorizontalAlignment="Stretch">

                        <!-- Header -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock x:Uid="Onb_ReadyTitle" Text="Your AI is Ready"
                                       Style="{StaticResource DisplayMediumStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <TextBlock x:Uid="Onb_ReadyDesc" Text="Agent-X includes a built-in AI model for fully offline operation. Optionally add cloud API keys for additional models."
                                       Style="{StaticResource BodySecondaryStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="560" />
                        </StackPanel>

                        <!-- Built-in Model Status Card -->
                        <Border Style="{StaticResource CardAccentStyle}"
                                Margin="0,8,0,0">
                            <StackPanel Spacing="16">
                                <TextBlock x:Uid="Onb_BuiltinOverline" Text="BUILT-IN LOCAL MODEL"
                                           Style="{StaticResource OverlineStyle}" />

                                <!-- Model Name & Status -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40"
                                            CornerRadius="{StaticResource RadiusFull}"
                                            Background="{ThemeResource AccentSubtleBrush}">
                                        <FontIcon Glyph="&#xE99A;"
                                                  FontSize="18"
                                                  Foreground="{ThemeResource AccentPrimaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.LocalModelName, Mode=OneWay}"
                                                   Style="{StaticResource BodyStyle}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Uid="Onb_QuantCaption" Text="Q4_K_M quantization  |  ~2 GB  |  Runs entirely on your device"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            CornerRadius="12"
                                            Padding="12,6"
                                            Background="{ThemeResource SuccessSubtleBrush}"
                                            Visibility="{x:Bind ViewModel.IsLocalModelAvailable, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{x:Bind ViewModel.LocalModelStatusText, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource SuccessBrush}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <!-- First-run download zone (SLIM installer ships without the model) -->
                                <StackPanel Spacing="12"
                                            Visibility="{x:Bind ViewModel.IsLocalModelAvailable, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="{x:Bind ViewModel.LocalModelStatusText, Mode=OneWay}"
                                               Style="{StaticResource BodySecondaryStyle}"
                                               TextWrapping="Wrap" />

                                    <Button x:Uid="Onb_DownloadModelBtn" Content="Download built-in model (~1.9 GB)"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Left"
                                            Command="{x:Bind ViewModel.DownloadLocalModelCommand}"
                                            Visibility="{x:Bind ViewModel.CanDownloadLocalModel, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                                    <StackPanel Spacing="6"
                                                Visibility="{x:Bind ViewModel.IsDownloadingLocalModel, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <ProgressBar Minimum="0" Maximum="100"
                                                     Value="{x:Bind ViewModel.LocalModelDownloadProgress, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.LocalModelDownloadStatus, Mode=OneWay}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Style="{StaticResource SeparatorStyle}" />

                                <!-- GPU Acceleration Info -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F4;"
                                              FontSize="16"
                                              Foreground="{ThemeResource TextSecondaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.GpuAccelerationInfo, Mode=OneWay}"
                                               Style="{StaticResource BodySecondaryStyle}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Cloud API Keys (Optional) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="Onb_CloudOverline" Text="CLOUD PROVIDERS (OPTIONAL)"
                                               Style="{StaticResource OverlineStyle}" />
                                    <TextBlock x:Uid="Onb_CloudDesc" Text="Connect cloud AI providers for access to GPT-4o, Claude, and other advanced models."
                                               Style="{StaticResource CaptionStyle}"
                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                                </StackPanel>

                                <!-- OpenAI API Key -->
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="OpenAI"
                                                   Style="{StaticResource LabelStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="GPT-4o, GPT-4o-mini"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBox Text="{x:Bind ViewModel.OpenAiApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="sk-..."
                                             MaxWidth="600"
                                             HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <Border Style="{StaticResource SeparatorStyle}" />

                                <!-- Anthropic API Key -->
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Anthropic"
                                                   Style="{StaticResource LabelStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="Claude Sonnet, Claude Opus"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBox Text="{x:Bind ViewModel.AnthropicApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="sk-ant-..."
                                             MaxWidth="600"
                                             HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <!-- Note -->
                                <TextBlock x:Uid="Onb_ApiKeysNote" Text="API keys are stored locally on your device and never sent anywhere except the respective provider."
                                           Style="{StaticResource CaptionStyle}"
                                           Foreground="{ThemeResource TextTertiaryBrush}"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════════════════════════════════
                         STEP 4: ALL SET!
                         ════════════════════════════════════════════ -->
                    <StackPanel Visibility="{x:Bind ViewModel.IsStep4Visible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Spacing="32"
                                HorizontalAlignment="Center">

                        <!-- Success Icon -->
                        <Grid Width="80" Height="80"
                              HorizontalAlignment="Center"
                              Margin="0,16,0,0">
                            <Border CornerRadius="{StaticResource RadiusRound}"
                                    Background="{ThemeResource AccentSubtleBrush}">
                                <FontIcon Glyph="&#xE73E;"
                                          FontSize="36"
                                          Foreground="{ThemeResource SuccessBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- Hero Text -->
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <TextBlock x:Uid="Onb_AllSetTitle" Text="You're All Set!"
                                       Style="{StaticResource DisplayLargeStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <TextBlock x:Uid="Onb_AllSetDesc" Text="Agent-X is configured and ready to use. All settings can be changed anytime from the Settings page."
                                       Style="{StaticResource HeadingMediumStyle}"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       FontWeight="Normal" />
                        </StackPanel>

                        <!-- Configuration Summary -->
                        <Border Style="{StaticResource CardStyle}"
                                MinWidth="480">
                            <StackPanel Spacing="16">
                                <TextBlock x:Uid="Onb_SummaryOverline" Text="CONFIGURATION SUMMARY"
                                           Style="{StaticResource OverlineStyle}" />

                                <!-- Ollama Status -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="Onb_OllamaStatusLabel" Text="Ollama Status"
                                               Style="{StaticResource BodySecondaryStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.SummaryOllamaStatus, Mode=OneWay}"
                                               Style="{StaticResource BodyStyle}"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <Border Style="{StaticResource SeparatorStyle}" />

                                <!-- Chat Model -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="Onb_ChatModelLabel" Text="Chat Model"
                                               Style="{StaticResource BodySecondaryStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.SummaryChatModel, Mode=OneWay}"
                                               Style="{StaticResource BodyStyle}"
                                               Foreground="{ThemeResource TextAccentBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <Border Style="{StaticResource SeparatorStyle}" />

                                <!-- Embedding Model -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="Onb_EmbModelLabel" Text="Embedding Model"
                                               Style="{StaticResource BodySecondaryStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.SummaryEmbeddingModel, Mode=OneWay}"
                                               Style="{StaticResource BodyStyle}"
                                               Foreground="{ThemeResource TextAccentBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <Border Style="{StaticResource SeparatorStyle}" />

                                <!-- Local Model -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="Onb_BuiltinModelLabel" Text="Built-in Model"
                                               Style="{StaticResource BodySecondaryStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.SummaryLocalModel, Mode=OneWay}"
                                               Style="{StaticResource BodyStyle}"
                                               Foreground="{ThemeResource SuccessBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <Border Style="{StaticResource SeparatorStyle}" />

                                <!-- Cloud Providers -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="Onb_CloudProvidersLabel" Text="Cloud Providers"
                                               Style="{StaticResource BodySecondaryStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.SummaryCloudProviders, Mode=OneWay}"
                                               Style="{StaticResource BodyStyle}"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <Border Style="{StaticResource SeparatorStyle}" />

                                <!-- Storage -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="Onb_StorageLabel" Text="Data Storage"
                                               Style="{StaticResource BodySecondaryStyle}" />
                                    <TextBlock Grid.Column="1"
                                               x:Uid="Onb_StorageValue" Text="Local (%LOCALAPPDATA%\AgentX)"
                                               Style="{StaticResource MonoSmallStyle}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 2: NAVIGATION BUTTONS
                 ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{ThemeResource PageBackgroundBrush}"
                    Padding="32,16,32,24">

                <Grid MaxWidth="700" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Back Button (hidden on first step) -->
                    <Button x:Uid="Onb_BackBtn" Content="Back"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.PreviousStepCommand}"
                            Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Center" />

                    <!-- Step-specific primary actions -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="12">

                        <!-- "Get Started" — Only on Step 0 -->
                        <Button x:Uid="Onb_GetStartedBtn" Content="Get Started"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.NextStepCommand}"
                                Visibility="{x:Bind ViewModel.IsStep0Visible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Padding="32,12,32,12" />

                        <!-- "Next" — Steps 1, 2, 3 (not 0 or 4) -->
                        <Button x:Uid="Onb_NextBtn" Content="Next"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.NextStepCommand}"
                                Visibility="{x:Bind ViewModel.ShowNextButton, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Padding="32,12,32,12" />

                        <!-- "Launch Agent-X" — Only on Step 4 -->
                        <Button x:Uid="Onb_LaunchBtn" Content="Launch Agent-X"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.CompleteOnboardingCommand}"
                                Visibility="{x:Bind ViewModel.IsStep4Visible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Padding="32,12,32,12" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
