<Page
    x:Class="AgentX.App.Views.WorkspaceProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AgentX.App.Controls"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>

        <!-- ===============================================================
             CONVERTERS
             =============================================================== -->

        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NullToVisibilityConverter x:Key="InverseNullToVis" IsInverted="True" />

    </Page.Resources>

    <Grid Background="{ThemeResource PageBackgroundBrush}">

        <!-- ═══════ ADAPTIVE LAYOUT (Tier 3) — see Colors.xaml breakpoints ═══════
             Narrow (<960):  sidebar 240   |  Medium (>=960): sidebar 260
             Wide (>=1280):  sidebar 280 (markup default) -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="240" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="260" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <!-- Left panel: Profile list (adaptive width — 240/260/280) -->
            <ColumnDefinition x:Name="SidebarColumn" Width="280" />
            <!-- Right panel: Profile editor -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===============================================================
             LEFT PANEL: PROFILE LIST SIDEBAR
             =============================================================== -->
        <Grid Grid.Column="0"
              Background="{ThemeResource SidebarGradientBrush}"
              BorderBrush="{ThemeResource BorderSubtleBrush}"
              BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Sidebar Header -->
            <Border Grid.Row="0" Style="{StaticResource SidebarHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10"
                                VerticalAlignment="Center">
                        <TextBlock x:Uid="Workspace_Profiles" Text="Profiles"
                                   Style="{StaticResource HeadingSmallStyle}" />
                        <Border Style="{StaticResource BadgeDefaultStyle}"
                                Padding="6,2,6,2">
                            <TextBlock Style="{StaticResource BadgeStyle}">
                                <Run Text="{x:Bind ViewModel.Profiles.Count, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{x:Bind ViewModel.LoadProfilesCommand}"
                            x:Uid="Workspace_RefreshProfilesTip" ToolTipService.ToolTip="Refresh profiles">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"
                                  Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Row 1: Create New Profile Input -->
            <Border Grid.Row="1"
                    Padding="16,12,16,12"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Spacing="8">
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             x:Uid="Workspace_NewProfileNamePh" PlaceholderText="New profile name..."
                             Text="{x:Bind ViewModel.NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             x:Uid="Workspace_DescriptionOptionalPh" PlaceholderText="Description (optional)"
                             Text="{x:Bind ViewModel.NewProfileDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.CreateProfileCommand}"
                            AutomationProperties.LabeledBy="{x:Bind CreateProfileLabel}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock x:Name="CreateProfileLabel" x:Uid="Workspace_CreateProfile" Text="Create Profile" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Row 2: Loading Indicator -->
            <StackPanel Grid.Row="2"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="32" Height="32"
                              Foreground="{ThemeResource AccentPrimaryBrush}" />
                <TextBlock x:Uid="Workspace_LoadingProfiles" Text="Loading profiles..."
                           Style="{StaticResource CaptionStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Row 2: Profile List -->
            <ListView Grid.Row="2"
                      x:Name="ProfileListView"
                      ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                      SelectionMode="None"
                      Padding="8,8,8,8"
                      Background="Transparent"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProfileDisplayItem">
                        <Border Style="{StaticResource CollectionTreeItemStyle}"
                                PointerPressed="OnProfileItemClick"
                                Tag="{x:Bind}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Profile icon -->
                                <Border Background="{ThemeResource AccentSubtleBrush}"
                                        CornerRadius="{StaticResource RadiusSM}"
                                        Width="32" Height="32"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE77B;"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextAccentBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>

                                <!-- Name + subtitle -->
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                   Style="{StaticResource BodyStyle}"
                                                   FontWeight="SemiBold"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Default badge -->
                                        <Border Background="{ThemeResource SuccessSubtleBrush}"
                                                CornerRadius="{StaticResource RadiusRound}"
                                                Padding="6,2,6,2"
                                                Visibility="{x:Bind IsDefault, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <TextBlock x:Uid="Workspace_Default" Text="DEFAULT"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="{ThemeResource SuccessBrush}"
                                                       CharacterSpacing="60" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Timestamp -->
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind CreatedAtFormatted, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Row 2: Empty state (no profiles) -->
            <StackPanel Grid.Row="2"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="16"
                        Visibility="{x:Bind HasNoProfiles(ViewModel.Profiles.Count, ViewModel.IsLoading), Mode=OneWay}">
                <FontIcon Glyph="&#xE77B;" FontSize="32"
                          Foreground="{ThemeResource TextTertiaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock x:Uid="Workspace_NoProfilesYet" Text="No profiles yet"
                           Style="{StaticResource BodySecondaryStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Uid="Workspace_CreateOneAboveTo" Text="Create one above to save your workspace configuration."
                           Style="{StaticResource CaptionStyle}"
                           TextAlignment="Center"
                           MaxWidth="200"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Row 3: Sidebar Footer -->
            <Border Grid.Row="3"
                    Padding="16,10,16,10"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE77B;" FontSize="11"
                              Foreground="{ThemeResource TextTertiaryBrush}" />
                    <TextBlock Style="{StaticResource CaptionStyle}">
                        <Run Text="{x:Bind ViewModel.Profiles.Count, Mode=OneWay}" />
                        <Run x:Uid="Workspace_Profiles2" Text="profiles" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===============================================================
             RIGHT PANEL: PROFILE EDITOR / EMPTY STATE
             =============================================================== -->
        <Grid Grid.Column="1">

            <!-- Empty state: No profile selected -->
            <Border Visibility="{x:Bind ViewModel.SelectedProfile, Mode=OneWay, Converter={StaticResource InverseNullToVis}}"
                    Style="{StaticResource WelcomeCardStyle}">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <!-- Icon -->
                    <Border Background="{ThemeResource AccentSubtleBrush}"
                            CornerRadius="{StaticResource RadiusFull}"
                            Width="72" Height="72"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE77B;"
                                  FontSize="32"
                                  Foreground="{ThemeResource TextAccentBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock x:Uid="Workspace_SelectAProfile" Text="Select a Profile"
                                   Style="{StaticResource HeadingMediumStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Uid="Workspace_ChooseAWorkspaceProfile" Text="Choose a workspace profile from the left panel to view and edit its configuration. Profiles let you save model, collection, and settings presets."
                                   Style="{StaticResource BodySecondaryStyle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="380" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Profile editor (visible when a profile is selected) -->
            <ScrollViewer Visibility="{x:Bind ViewModel.SelectedProfile, Mode=OneWay, Converter={StaticResource NullToVis}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Padding="32,24,32,24" RowSpacing="24" MaxWidth="800">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- Header -->
                        <RowDefinition Height="Auto" />   <!-- Status / Error -->
                        <RowDefinition Height="Auto" />   <!-- Metadata badges -->
                        <RowDefinition Height="Auto" />   <!-- Separator -->
                        <RowDefinition Height="Auto" />   <!-- Editor form -->
                        <RowDefinition Height="Auto" />   <!-- Action buttons -->
                    </Grid.RowDefinitions>

                    <!-- =======================================================
                         ROW 0: PROFILE HEADER
                         ======================================================= -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE77B;" FontSize="24"
                                          Foreground="{ThemeResource TextAccentBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedProfile.Name, Mode=OneWay}"
                                           Style="{StaticResource DisplaySmallStyle}"
                                           VerticalAlignment="Center" />

                                <!-- Default badge in header -->
                                <Border Background="{ThemeResource SuccessSubtleBrush}"
                                        CornerRadius="{StaticResource RadiusRound}"
                                        Padding="10,3,10,3"
                                        Visibility="{x:Bind ViewModel.SelectedProfile.IsDefault, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Uid="Workspace_Default2" Text="DEFAULT"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{ThemeResource SuccessBrush}"
                                               CharacterSpacing="60" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.SelectedProfile.Description, Mode=OneWay}"
                                       Style="{StaticResource BodySecondaryStyle}"
                                       Margin="36,0,0,0" />
                        </StackPanel>

                        <!-- Duplicate button in header -->
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{x:Bind ViewModel.DuplicateProfileCommand}"
                                VerticalAlignment="Top"
                                AutomationProperties.LabeledBy="{x:Bind DuplicateLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock x:Name="DuplicateLabel" x:Uid="Workspace_Duplicate" Text="Duplicate" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- =======================================================
                         ROW 1: STATUS AND ERROR MESSAGES
                         ======================================================= -->
                    <StackPanel Grid.Row="1" Spacing="8">
                        <!-- Success / Status message -->
                        <Border Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Background="{ThemeResource SuccessSubtleBrush}"
                                BorderBrush="{ThemeResource SuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE73E;" FontSize="16"
                                          Foreground="{ThemeResource SuccessBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                           Style="{StaticResource BodySmallStyle}"
                                           Foreground="{ThemeResource SuccessBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Error message -->
                        <Border Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Background="{ThemeResource ErrorSubtleBrush}"
                                BorderBrush="{ThemeResource ErrorBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusMD}"
                                Padding="16,12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE7BA;" FontSize="16"
                                          Foreground="{ThemeResource ErrorBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                           Style="{StaticResource BodySmallStyle}"
                                           Foreground="{ThemeResource ErrorBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- =======================================================
                         ROW 2: METADATA BADGES
                         ======================================================= -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                        <!-- Created date badge -->
                        <Border Style="{StaticResource BadgeDefaultStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE787;" FontSize="11"
                                          Foreground="{ThemeResource TextTertiaryBrush}" />
                                <TextBlock Style="{StaticResource BadgeStyle}">
                                    <Run x:Uid="Workspace_Created" Text="Created " />
                                    <Run Text="{x:Bind ViewModel.SelectedProfile.CreatedAtFormatted, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Updated date badge -->
                        <Border Style="{StaticResource BadgeDefaultStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="11"
                                          Foreground="{ThemeResource TextTertiaryBrush}" />
                                <TextBlock Style="{StaticResource BadgeStyle}">
                                    <Run x:Uid="Workspace_Updated" Text="Updated " />
                                    <Run Text="{x:Bind ViewModel.SelectedProfile.UpdatedAtFormatted, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Model badge (if configured) -->
                        <Border Style="{StaticResource BadgeAccentStyle}"
                                Visibility="{x:Bind ViewModel.SelectedProfile.ActiveModelId, Mode=OneWay, Converter={StaticResource NullToVis}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE964;" FontSize="11"
                                          Foreground="{ThemeResource TextAccentBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedProfile.ActiveModelId, Mode=OneWay}"
                                           Style="{StaticResource BadgeStyle}"
                                           Foreground="{ThemeResource TextAccentBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- =======================================================
                         ROW 3: SEPARATOR
                         ======================================================= -->
                    <Border Grid.Row="3" Style="{StaticResource SeparatorStyle}" />

                    <!-- =======================================================
                         ROW 4: EDITOR FORM
                         ======================================================= -->
                    <controls:Faceplate Grid.Row="4" Kicker="MOD - PROF - 01">
                        <StackPanel Spacing="24">
                            <!-- Section heading -->
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE70F;" FontSize="18"
                                              Foreground="{ThemeResource TextAccentBrush}" />
                                    <TextBlock x:Uid="Workspace_ProfileConfiguration" Text="Profile Configuration"
                                               Style="{StaticResource HeadingMediumStyle}" />
                                </StackPanel>
                                <TextBlock x:Uid="Workspace_EditThisProfileS" Text="Edit this profile's workspace settings. Changes are saved when you click Save."
                                           Style="{StaticResource BodySecondaryStyle}"
                                           Margin="28,0,0,0" />
                            </StackPanel>

                            <!-- Name field -->
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Workspace_ProfileName" Text="PROFILE NAME"
                                           Style="{StaticResource OverlineStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         x:Uid="Workspace_EnterADisplayNamePh" PlaceholderText="Enter a display name for this profile"
                                         Text="{x:Bind ViewModel.EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Description field -->
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Workspace_Description" Text="DESCRIPTION"
                                           Style="{StaticResource OverlineStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         x:Uid="Workspace_OptionalDescriptionOfThisPh" PlaceholderText="Optional description of this profile's purpose"
                                         Text="{x:Bind ViewModel.EditDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MaxHeight="120" />
                            </StackPanel>

                            <!-- Active Model ID field -->
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Workspace_ActiveModelId" Text="ACTIVE MODEL ID"
                                           Style="{StaticResource OverlineStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         x:Uid="Workspace_EGLlama32Ph" PlaceholderText="e.g., llama3.2, mistral, phi3"
                                         Text="{x:Bind ViewModel.EditActiveModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock x:Uid="Workspace_TheOllamaModelIdentifier" Text="The Ollama model identifier to activate when this profile is loaded."
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>

                            <!-- Active Collection IDs field -->
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Workspace_ActiveCollectionIds" Text="ACTIVE COLLECTION IDS"
                                           Style="{StaticResource OverlineStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         x:Uid="Workspace_EG13Ph" PlaceholderText="e.g., 1,3,7 (comma-separated)"
                                         Text="{x:Bind ViewModel.EditActiveCollectionIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock x:Uid="Workspace_CommaSeparatedListOf" Text="Comma-separated list of collection IDs to enable when this profile is loaded."
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>

                            <!-- Custom Settings field -->
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Workspace_CustomSettings" Text="CUSTOM SETTINGS"
                                           Style="{StaticResource OverlineStyle}" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         x:Uid="Workspace_JsonOrKeyValuePh" PlaceholderText="JSON or key=value pairs for additional configuration"
                                         Text="{x:Bind ViewModel.EditCustomSettings, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MaxHeight="160"
                                         FontFamily="{StaticResource FontMono}"
                                         FontSize="13" />
                                <TextBlock x:Uid="Workspace_FreeFormSettingsStored" Text="Free-form settings stored with this profile. Use JSON or any structured format."
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>

                            <!-- Default toggle -->
                            <Border Background="{ThemeResource CardBrush}"
                                    CornerRadius="{StaticResource RadiusMD}"
                                    Padding="16,12"
                                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock x:Uid="Workspace_DefaultProfile" Text="Default Profile"
                                                   Style="{StaticResource BodyStyle}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Uid="Workspace_ThisProfileWillBe" Text="This profile will be loaded automatically when the app starts."
                                                   Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>

                                    <ToggleSwitch Grid.Column="1"
                                                  IsOn="{x:Bind ViewModel.EditIsDefault, Mode=TwoWay}"
                                                  OnContent=""
                                                  OffContent=""
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </controls:Faceplate>

                    <!-- =======================================================
                         ROW 5: ACTION BUTTONS
                         ======================================================= -->
                    <Grid Grid.Row="5" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Save button -->
                        <Button Grid.Column="0"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SaveProfileCommand}"
                                AutomationProperties.LabeledBy="{x:Bind SaveProfileLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                <TextBlock x:Name="SaveProfileLabel" x:Uid="Workspace_SaveProfile" Text="Save Profile" />
                            </StackPanel>
                        </Button>

                        <!-- Set as Default button -->
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{x:Bind ViewModel.SetDefaultCommand}"
                                IsEnabled="{x:Bind ViewModel.EditIsDefault, Mode=OneWay, Converter={StaticResource InverseBool}}"
                                AutomationProperties.LabeledBy="{x:Bind SetAsDefaultLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE735;" FontSize="14" />
                                <TextBlock x:Name="SetAsDefaultLabel" x:Uid="Workspace_SetAsDefault" Text="Set as Default" />
                            </StackPanel>
                        </Button>

                        <!-- Delete button (right-aligned) -->
                        <Button Grid.Column="3"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{x:Bind ViewModel.DeleteProfileCommand}"
                                AutomationProperties.LabeledBy="{x:Bind DeleteProfileLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"
                                          Foreground="{ThemeResource ErrorBrush}" />
                                <TextBlock x:Name="DeleteProfileLabel" x:Uid="Workspace_DeleteProfile" Text="Delete Profile"
                                           Foreground="{ThemeResource ErrorBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
