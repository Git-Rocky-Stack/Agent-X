<Page
    x:Class="AgentX.App.Views.QuickActionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AgentX.App.Controls"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    x:Name="QuickActionsRoot"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Padding="{StaticResource PaddingPage}" RowSpacing="24" MaxWidth="1200" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ==========================================================
                     ROW 0: PAGE HEADER
                     ========================================================== -->
                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock x:Uid="QuickAct_QuickActions" Text="Quick Actions"
                               Style="{StaticResource DisplaySmallStyle}" />
                    <TextBlock x:Uid="QuickAct_AiPoweredDocumentIntelligence" Text="AI-powered document intelligence tools. Summarize, translate, detect duplicates, and organize."
                               Style="{StaticResource BodySecondaryStyle}" />
                </StackPanel>

                <!-- ==========================================================
                     ROW 1: CONTEXTUAL ACTIONS
                     ========================================================== -->
                <controls:Faceplate Grid.Row="1" Visibility="{x:Bind ViewModel.HasRecommendedActions, Mode=OneWay, Converter={StaticResource BoolToVis}}" Kicker="MOD - QACT - 01">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="QuickAct_RecommendedForThisContext" Text="Recommended For This Context"
                                           Style="{StaticResource HeadingMediumStyle}" />
                                <TextBlock x:Uid="QuickAct_UseTheSelectedDocument" Text="Use the selected document and current intake state to jump straight to the most useful next action."
                                           Style="{StaticResource BodySecondaryStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource BadgeDefaultStyle}"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{x:Bind ViewModel.RecommendedActions.Count, Mode=OneWay}"
                                           Style="{StaticResource BadgeStyle}" />
                            </Border>
                        </Grid>

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecommendedActions, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="250"
                                                   MinItemHeight="0"
                                                   MinColumnSpacing="12"
                                                   MinRowSpacing="12"
                                                   ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:QuickActionRecommendedItem">
                                    <Border Style="{StaticResource CardInsetStyle}"
                                            Padding="16,14">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="36"
                                                        Height="36"
                                                        CornerRadius="{StaticResource RadiusMD}"
                                                        Background="{ThemeResource AccentSubtleBrush}">
                                                    <FontIcon Glyph="{x:Bind IconGlyph}"
                                                              FontSize="15"
                                                              Foreground="{ThemeResource TextAccentBrush}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Title}"
                                                           Margin="12,0,0,0"
                                                           Style="{StaticResource BodyStyle}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="WrapWholeWords"
                                                           VerticalAlignment="Center" />

                                                <Border Grid.Column="2"
                                                        Style="{StaticResource BadgeDefaultStyle}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind CategoryLabel}"
                                                               Style="{StaticResource BadgeStyle}" />
                                                </Border>
                                            </Grid>

                                            <Border Grid.Row="1"
                                                    Style="{StaticResource BadgeDefaultStyle}"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind StatusLabel}"
                                                           Style="{StaticResource CaptionStyle}" />
                                            </Border>

                                            <TextBlock Grid.Row="2"
                                                       Text="{x:Bind Detail}"
                                                       Style="{StaticResource BodySecondaryStyle}"
                                                       TextWrapping="WrapWholeWords" />

                                            <Button Grid.Row="3"
                                                    Command="{Binding ViewModel.ExecuteRecommendedActionCommand, ElementName=QuickActionsRoot}"
                                                    CommandParameter="{Binding}"
                                                    Content="{x:Bind CommandText}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    HorizontalAlignment="Left"
                                                    Padding="12,8"
                                                    FontSize="12" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </controls:Faceplate>

                <!-- ==========================================================
                     ROW 2: TAB NAVIGATION
                     ========================================================== -->
                <controls:Faceplate Grid.Row="2" Padding="4" Kicker="MOD - QACT - 02">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="TabSummarize"
                                     Grid.Column="0"
                                     GroupName="QuickActionTabs"
                                     IsChecked="True"
                                     Checked="Tab_Summarize_Checked"
                                     Style="{StaticResource TabRadioButtonStyle}"
                                     AutomationProperties.LabeledBy="{x:Bind TabSummarizeLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock x:Name="TabSummarizeLabel" x:Uid="QuickAct_Summarize" Text="Summarize" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TabKeyPoints"
                                     Grid.Column="1"
                                     GroupName="QuickActionTabs"
                                     Checked="Tab_KeyPoints_Checked"
                                     Style="{StaticResource TabRadioButtonStyle}"
                                     AutomationProperties.LabeledBy="{x:Bind TabKeyPointsLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                                <TextBlock x:Name="TabKeyPointsLabel" x:Uid="QuickAct_KeyPoints" Text="Key Points" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TabTranslate"
                                     Grid.Column="2"
                                     GroupName="QuickActionTabs"
                                     Checked="Tab_Translate_Checked"
                                     Style="{StaticResource TabRadioButtonStyle}"
                                     AutomationProperties.LabeledBy="{x:Bind TabTranslateLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8C1;" FontSize="14" />
                                <TextBlock x:Name="TabTranslateLabel" x:Uid="QuickAct_Translate" Text="Translate" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TabDuplicates"
                                     Grid.Column="3"
                                     GroupName="QuickActionTabs"
                                     Checked="Tab_Duplicates_Checked"
                                     Style="{StaticResource TabRadioButtonStyle}"
                                     AutomationProperties.LabeledBy="{x:Bind TabDuplicatesLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8C6;" FontSize="14" />
                                <TextBlock x:Name="TabDuplicatesLabel" x:Uid="QuickAct_Duplicates" Text="Duplicates" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TabOrganize"
                                     Grid.Column="4"
                                     GroupName="QuickActionTabs"
                                     Checked="Tab_Organize_Checked"
                                     Style="{StaticResource TabRadioButtonStyle}"
                                     AutomationProperties.LabeledBy="{x:Bind TabOrganizeLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock x:Name="TabOrganizeLabel" x:Uid="QuickAct_Organize" Text="Organize" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </controls:Faceplate>

                <!-- ==========================================================
                     ROW 3: TAB CONTENT PANELS
                     ========================================================== -->
                <Grid Grid.Row="3">

                    <!-- ======================================================
                         SUMMARIZE TAB
                         ====================================================== -->
                    <StackPanel x:Name="PanelSummarize" Visibility="Visible" Spacing="16">

                        <!-- Document Picker -->
                        <controls:Faceplate Kicker="MOD - QACT - 03">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="QuickAct_GenerateASectionAware" Text="Generate a section-aware summary"
                                               Style="{StaticResource HeadingSmallStyle}" />
                                    <TextBlock x:Uid="QuickAct_BuildsAConciseBrief" Text="Builds a concise brief by synthesizing indexed chunks into section summaries first, then a final overview."
                                               Style="{StaticResource BodySecondaryStyle}" />
                                </StackPanel>

                                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableDocuments, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedDocument, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayLabel"
                                          HorizontalAlignment="Stretch"
                                          x:Uid="QuickAct_ChooseADocumentPh" PlaceholderText="Choose a document..."
                                          CornerRadius="{StaticResource RadiusMD}" />

                                <Button x:Uid="QuickAct_GenerateLayeredSummary" Content="Generate Layered Summary"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.SummarizeCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                        </controls:Faceplate>

                        <!-- Processing indicator -->
                        <StackPanel Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Spacing="8" HorizontalAlignment="Center" Padding="16">
                            <ProgressRing IsActive="True" Width="32" Height="32" />
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       Style="{StaticResource BodySecondaryStyle}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Summary Result -->
                        <controls:Faceplate Visibility="{x:Bind ViewModel.HasSummaryResult, Mode=OneWay, Converter={StaticResource BoolToVis}}" Kicker="MOD - QACT - 04">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="16"
                                                  Foreground="{ThemeResource TextAccentBrush}" />
                                        <TextBlock x:Uid="QuickAct_Summary" Text="Summary"
                                                   Style="{StaticResource HeadingSmallStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Style="{StaticResource BadgeDefaultStyle}">
                                        <TextBlock x:Uid="QuickAct_Layered" Text="Layered"
                                                   Style="{StaticResource BadgeStyle}" />
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource SeparatorStyle}" />
                                <TextBlock x:Uid="QuickAct_SynthesizedFromIndexedSections" Text="Synthesized from indexed sections before final reduction."
                                           Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SummaryResult, Mode=OneWay}"
                                           Style="{StaticResource BodyStyle}"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </controls:Faceplate>
                    </StackPanel>

                    <!-- ======================================================
                         KEY POINTS TAB
                         ====================================================== -->
                    <StackPanel x:Name="PanelKeyPoints" Visibility="Collapsed" Spacing="16">

                        <!-- Document Picker -->
                        <controls:Faceplate Kicker="MOD - QACT - 05">
                            <StackPanel Spacing="16">
                                <TextBlock x:Uid="QuickAct_SelectADocumentTo" Text="Select a document to extract key points"
                                           Style="{StaticResource HeadingSmallStyle}" />

                                <ComboBox ItemsSource="{x:Bind ViewModel.AvailableDocuments, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedDocument, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayLabel"
                                          HorizontalAlignment="Stretch"
                                          x:Uid="QuickAct_ChooseADocumentPh2" PlaceholderText="Choose a document..."
                                          CornerRadius="{StaticResource RadiusMD}" />

                                <Button x:Uid="QuickAct_ExtractKeyPoints" Content="Extract Key Points"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.ExtractKeyPointsCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                        </controls:Faceplate>

                        <!-- Processing indicator -->
                        <StackPanel Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Spacing="8" HorizontalAlignment="Center" Padding="16">
                            <ProgressRing IsActive="True" Width="32" Height="32" />
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       Style="{StaticResource BodySecondaryStyle}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Key Points Result -->
                        <controls:Faceplate Visibility="{x:Bind ViewModel.HasKeyPoints, Mode=OneWay, Converter={StaticResource BoolToVis}}" Kicker="MOD - QACT - 06">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="16"
                                              Foreground="{ThemeResource TextAccentBrush}" />
                                    <TextBlock x:Uid="QuickAct_KeyPoints2" Text="Key Points"
                                               Style="{StaticResource HeadingSmallStyle}" />
                                </StackPanel>
                                <Border Style="{StaticResource SeparatorStyle}" />

                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.KeyPoints, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Style="{StaticResource CardInteractiveStyle}"
                                                    Padding="14,10">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <FontIcon Glyph="&#xE73E;" FontSize="12"
                                                              Foreground="{ThemeResource SuccessBrush}"
                                                              VerticalAlignment="Top"
                                                              Margin="0,3,0,0" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind}"
                                                               Style="{StaticResource BodyStyle}"
                                                               TextWrapping="Wrap"
                                                               IsTextSelectionEnabled="True" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </controls:Faceplate>
                    </StackPanel>

                    <!-- ======================================================
                         TRANSLATE TAB
                         ====================================================== -->
                    <StackPanel x:Name="PanelTranslate" Visibility="Collapsed" Spacing="16">

                        <controls:Faceplate Kicker="MOD - QACT - 07">
                            <StackPanel Spacing="16">
                                <TextBlock x:Uid="QuickAct_TranslateTextWithAi" Text="Translate text with AI"
                                           Style="{StaticResource HeadingSmallStyle}" />

                                <!-- Input -->
                                <StackPanel Spacing="8">
                                    <TextBlock x:Uid="QuickAct_InputText" Text="Input Text" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{x:Bind ViewModel.TranslationInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="100"
                                             MaxHeight="200"
                                             x:Uid="QuickAct_EnterOrPasteTextPh" PlaceholderText="Enter or paste text to translate..." />
                                </StackPanel>

                                <!-- Language Picker -->
                                <StackPanel Spacing="8">
                                    <TextBlock x:Uid="QuickAct_TargetLanguage" Text="Target Language" Style="{StaticResource LabelStyle}" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableLanguages, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              CornerRadius="{StaticResource RadiusMD}" />
                                </StackPanel>

                                <Button x:Uid="QuickAct_Translate2" Content="Translate"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.TranslateCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                        </controls:Faceplate>

                        <!-- Processing indicator -->
                        <StackPanel Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Spacing="8" HorizontalAlignment="Center" Padding="16">
                            <ProgressRing IsActive="True" Width="32" Height="32" />
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       Style="{StaticResource BodySecondaryStyle}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Translation Output -->
                        <controls:Faceplate Visibility="{x:Bind ViewModel.HasTranslationOutput, Mode=OneWay, Converter={StaticResource BoolToVis}}" Kicker="MOD - QACT - 08">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8C1;" FontSize="16"
                                              Foreground="{ThemeResource TextAccentBrush}" />
                                    <TextBlock x:Uid="QuickAct_Translation" Text="Translation"
                                               Style="{StaticResource HeadingSmallStyle}" />
                                </StackPanel>
                                <Border Style="{StaticResource SeparatorStyle}" />
                                <TextBox Text="{x:Bind ViewModel.TranslationOutput, Mode=OneWay}"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="100"
                                         MaxHeight="300" />
                            </StackPanel>
                        </controls:Faceplate>
                    </StackPanel>

                    <!-- ======================================================
                         DUPLICATES TAB
                         ====================================================== -->
                    <StackPanel x:Name="PanelDuplicates" Visibility="Collapsed" Spacing="16">

                        <controls:Faceplate Kicker="MOD - QACT - 09">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="QuickAct_DuplicateDetection" Text="Duplicate Detection"
                                               Style="{StaticResource HeadingSmallStyle}" />
                                    <TextBlock x:Uid="QuickAct_RunExactHashScans" Text="Run exact hash scans for identical files or semantic scans for near-duplicates using stored embeddings."
                                               Style="{StaticResource BodySecondaryStyle}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="12">
                                    <Button x:Uid="QuickAct_ScanExactDuplicates" Content="Scan Exact Duplicates"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Command="{x:Bind ViewModel.FindDuplicatesCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                                    <Button x:Uid="QuickAct_ScanSemanticNearDuplicates" Content="Scan Semantic Near-Duplicates"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{x:Bind ViewModel.FindNearDuplicatesCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                                </StackPanel>
                            </StackPanel>
                        </controls:Faceplate>

                        <!-- Processing indicator -->
                        <StackPanel Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Spacing="8" HorizontalAlignment="Center" Padding="16">
                            <ProgressRing IsActive="True" Width="32" Height="32" />
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       Style="{StaticResource BodySecondaryStyle}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Duplicate Results -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasDuplicateResults, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Spacing="12">

                            <!-- Status message when no duplicates -->
                            <Border Style="{StaticResource CardInsetStyle}"
                                    Padding="16,12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE946;" FontSize="16"
                                              Foreground="{ThemeResource InfoBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                               Style="{StaticResource BodyStyle}" />
                                </StackPanel>
                            </Border>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DuplicateGroups, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:QuickActionDuplicateGroupItem">
                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel Spacing="12">
                                                <!-- Group header -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="2">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="8">
                                                            <TextBlock Text="{x:Bind GroupLabel}"
                                                                       Style="{StaticResource BodyStyle}"
                                                                       FontWeight="SemiBold" />
                                                            <Border Style="{StaticResource BadgeDefaultStyle}"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind MatchLabel}"
                                                                           Style="{StaticResource BadgeStyle}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind DetailLabel}"
                                                                   Style="{StaticResource CaptionStyle}" />
                                                    </StackPanel>

                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource BadgeAccentStyle}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                                   Foreground="{ThemeResource TextAccentBrush}">
                                                            <Run Text="{x:Bind WastedStorage}" />
                                                            <Run x:Uid="QuickAct_Wasted" Text=" wasted" />
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>

                                                <Border Style="{StaticResource SeparatorStyle}" />

                                                <!-- Document list in group -->
                                                <ItemsRepeater ItemsSource="{x:Bind Documents}">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="6" />
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:QuickActionDuplicateDocItem">
                                                            <Border Style="{StaticResource CardInteractiveStyle}"
                                                                    Padding="12,8">
                                                                <Grid ColumnSpacing="12">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <FontIcon Glyph="&#xE7C3;" FontSize="14"
                                                                              Foreground="{ThemeResource TextTertiaryBrush}"
                                                                              VerticalAlignment="Center" />

                                                                    <StackPanel Grid.Column="1" Spacing="2"
                                                                                VerticalAlignment="Center">
                                                                        <TextBlock Text="{x:Bind FileName}"
                                                                                   Style="{StaticResource BodyStyle}"
                                                                                   MaxLines="1"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Style="{StaticResource CaptionStyle}">
                                                                            <Run Text="{x:Bind FileSize}" />
                                                                            <Run x:Uid="QuickAct_Imported" Text=" · Imported " />
                                                                            <Run Text="{x:Bind ImportedAt}" />
                                                                        </TextBlock>
                                                                        <TextBlock Text="{x:Bind EvidenceLabel}"
                                                                                   Style="{StaticResource CaptionStyle}"
                                                                                   Visibility="{x:Bind HasEvidence, Converter={StaticResource BoolToVis}}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>

                    <!-- ======================================================
                         ORGANIZE TAB
                         ====================================================== -->
                    <StackPanel x:Name="PanelOrganize" Visibility="Collapsed" Spacing="16">

                        <controls:Faceplate Kicker="MOD - QACT - 10">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="QuickAct_AiOrganizationAssistant" Text="AI Organization Assistant"
                                               Style="{StaticResource HeadingSmallStyle}" />
                                    <TextBlock x:Uid="QuickAct_AnalyzesUncategorizedDocuments" Text="Analyzes uncategorized documents and suggests collections and tags based on content."
                                               Style="{StaticResource BodySecondaryStyle}" />
                                </StackPanel>

                                <Button x:Uid="QuickAct_AnalyzeSuggest" Content="Analyze &amp; Suggest"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.SuggestOrganizationCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                        </controls:Faceplate>

                        <!-- Processing indicator -->
                        <StackPanel Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Spacing="8" HorizontalAlignment="Center" Padding="16">
                            <ProgressRing IsActive="True" Width="32" Height="32" />
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       Style="{StaticResource BodySecondaryStyle}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Suggestion Results -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasSuggestionResults, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Spacing="12">

                            <Border Style="{StaticResource CardInsetStyle}" Padding="16,12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE946;" FontSize="16"
                                              Foreground="{ThemeResource InfoBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                               Style="{StaticResource BodyStyle}" />
                                </StackPanel>
                            </Border>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:QuickActionOrganizationItem">
                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel Spacing="12">
                                                <!-- Document name -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <FontIcon Glyph="&#xE7C3;" FontSize="16"
                                                                  Foreground="{ThemeResource TextAccentBrush}" />
                                                        <TextBlock Text="{x:Bind FileName}"
                                                                   Style="{StaticResource BodyStyle}"
                                                                   FontWeight="SemiBold"
                                                                   MaxLines="1"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Confidence badge -->
                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource BadgeDefaultStyle}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource CaptionStyle}" FontWeight="SemiBold">
                                                            <Run Text="{x:Bind ConfidenceLabel}" />
                                                            <Run Text=" (" /><Run Text="{x:Bind ConfidencePercent}" /><Run Text="%)" />
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>

                                                <Border Style="{StaticResource SeparatorStyle}" />

                                                <!-- Suggested collection -->
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="QuickAct_Collection" Text="Collection:"
                                                               Style="{StaticResource LabelStyle}"
                                                               VerticalAlignment="Center" />
                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource BadgeAccentStyle}"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{x:Bind SuggestedCollection}"
                                                                   Style="{StaticResource CaptionStyle}"
                                                                   Foreground="{ThemeResource TextAccentBrush}"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>

                                                <!-- Suggested tags -->
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Uid="QuickAct_Tags" Text="Tags:"
                                                               Style="{StaticResource LabelStyle}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind TagsDisplay}"
                                                               Style="{StaticResource BodySmallStyle}" />
                                                </Grid>

                                                <!-- Confidence bar -->
                                                <ProgressBar Value="{x:Bind ConfidencePercent}"
                                                             Maximum="100"
                                                             Style="{StaticResource AccentProgressBarStyle}" />

                                                <!-- Reasoning -->
                                                <Border Style="{StaticResource CardInsetStyle}" Padding="12,8">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock x:Uid="QuickAct_Reasoning" Text="Reasoning"
                                                                   Style="{StaticResource LabelStyle}"
                                                                   FontSize="10" />
                                                        <TextBlock Text="{x:Bind Reasoning}"
                                                                   Style="{StaticResource CaptionStyle}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ==========================================================
             STATUS BAR (Bottom)
             ========================================================== -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressRing Grid.Column="0"
                              IsActive="{x:Bind ViewModel.IsProcessing, Mode=OneWay}"
                              Width="16" Height="16"
                              Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Style="{StaticResource BodySmallStyle}"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="2"
                           Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center">
                    <Run Text="{x:Bind ViewModel.AvailableDocuments.Count, Mode=OneWay}" />
                    <Run x:Uid="QuickAct_DocumentsAvailable" Text=" documents available" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Page>
