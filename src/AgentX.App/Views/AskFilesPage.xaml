<Page
    x:Class="AgentX.App.Views.AskFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    xmlns:local="using:AgentX.App.Views"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>

        <!-- =============================================================
             CONVERTERS
             ============================================================= -->

        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

    </Page.Resources>

    <!-- =============================================================
         ROOT LAYOUT: 2-column grid (chat area + citations sidebar)
         ============================================================= -->

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <!-- Chat area -->
            <ColumnDefinition Width="*" />
            <!-- Citations sidebar -->
            <ColumnDefinition x:Name="CitationsSidebarColumn" Width="320" />
        </Grid.ColumnDefinitions>

        <!-- =============================================================
             COLUMN 0: MAIN CHAT AREA
             ============================================================= -->

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <!-- Header bar -->
                <RowDefinition Height="Auto" />
                <!-- Chat messages / Empty state -->
                <RowDefinition Height="*" />
                <!-- Input bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==========================================================
                 ROW 0: HEADER BAR
                 ========================================================== -->

            <Border Grid.Row="0" Style="{StaticResource ChatTopBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Ask Your Files"
                                   Style="{StaticResource HeadingSmallStyle}" />
                        <TextBlock Text="AI-powered answers grounded in your documents."
                                   Style="{StaticResource CaptionStyle}" />
                    </StackPanel>

                    <!-- Collection scope dropdown -->
                    <ComboBox Grid.Column="1"
                              x:Name="CollectionScopeCombo"
                              ItemsSource="{x:Bind ViewModel.AvailableCollections, Mode=OneWay}"
                              DisplayMemberPath="Name"
                              PlaceholderText="All Collections"
                              MinWidth="180"
                              Background="{StaticResource InputBackgroundBrush}"
                              BorderBrush="{StaticResource BorderSubtleBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              VerticalAlignment="Center"
                              SelectionChanged="OnCollectionSelectionChanged" />

                    <!-- Indexed chunk count badge -->
                    <Border Grid.Column="2"
                            Style="{StaticResource BadgeDefaultStyle}"
                            Padding="10,4,10,4"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE943;" FontSize="10"
                                      Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.IndexStatusMessage, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Clear conversation button -->
                    <Button Grid.Column="3"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="8,4,8,4" MinHeight="32"
                            Command="{x:Bind ViewModel.ClearConversationCommand}"
                            ToolTipService.ToolTip="Clear conversation"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE711;" FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Clear"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ==========================================================
                 ROW 1: CHAT MESSAGES / EMPTY STATE
                 ========================================================== -->

            <Grid Grid.Row="1">

                <!-- ======================================================
                     EMPTY STATE
                     ====================================================== -->
                <Border Style="{StaticResource WelcomeCardStyle}"
                        Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="24" HorizontalAlignment="Center">

                        <!-- Brain / Document icon -->
                        <Border Background="{StaticResource AccentSubtleBrush}"
                                CornerRadius="{StaticResource RadiusRound}"
                                Width="80" Height="80"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8D4;"
                                      FontSize="36"
                                      Foreground="{StaticResource TextAccentBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="Ask Questions About Your Documents"
                                       Style="{StaticResource HeadingMediumStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="440"
                                       HorizontalAlignment="Center">
                                <Run Text="Your AI will search through " /><Run Text="{x:Bind ViewModel.IndexedChunkCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" knowledge chunks to find answers, citing its sources." />
                            </TextBlock>
                        </StackPanel>

                        <!-- Feature badge -->
                        <Border Style="{StaticResource BadgeAccentStyle}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="RAG-Powered Answers with Citations"
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{StaticResource TextAccentBrush}"
                                       FontWeight="SemiBold" />
                        </Border>

                        <!-- Example question cards -->
                        <StackPanel Spacing="8" MaxWidth="440">
                            <TextBlock Text="TRY ASKING"
                                       Style="{StaticResource OverlineStyle}"
                                       HorizontalAlignment="Center" />

                            <Border Style="{StaticResource CardInsetStyle}"
                                    Padding="14,10"
                                    PointerPressed="OnExampleQuestionClick"
                                    Tag="What are the key findings in my research?">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="12"
                                              Foreground="{StaticResource TextTertiaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="What are the key findings in my research?"
                                               Style="{StaticResource BodySmallStyle}"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardInsetStyle}"
                                    Padding="14,10"
                                    PointerPressed="OnExampleQuestionClick"
                                    Tag="Summarize the main points from my meeting notes">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="12"
                                              Foreground="{StaticResource TextTertiaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Summarize the main points from my meeting notes"
                                               Style="{StaticResource BodySmallStyle}"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardInsetStyle}"
                                    Padding="14,10"
                                    PointerPressed="OnExampleQuestionClick"
                                    Tag="Compare the approaches discussed in my papers">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="12"
                                              Foreground="{StaticResource TextTertiaryBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Compare the approaches discussed in my papers"
                                               Style="{StaticResource BodySmallStyle}"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Keyboard hint -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center">
                            <Border Style="{StaticResource BadgeDefaultStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE765;" FontSize="10"
                                              Foreground="{StaticResource TextTertiaryBrush}" />
                                    <TextBlock Text="Enter to send"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ======================================================
                     CHAT MESSAGES ScrollViewer
                     ====================================================== -->
                <ScrollViewer x:Name="MessagesScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                    <ItemsRepeater x:Name="MessagesRepeater"
                                   ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                                   Margin="24,16,24,16">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AskFilesMessage">
                                <Grid>

                                    <!-- ==========================================
                                         USER MESSAGE (right-aligned)
                                         ========================================== -->
                                    <StackPanel Visibility="{x:Bind IsUser, Converter={StaticResource BoolToVis}}"
                                                HorizontalAlignment="Right"
                                                Margin="64,4,0,4"
                                                MaxWidth="680">
                                        <Border Style="{StaticResource UserMessageStyle}">
                                            <TextBlock Text="{x:Bind Content, Mode=OneWay}"
                                                       Style="{StaticResource BodyStyle}"
                                                       TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True" />
                                        </Border>
                                        <TextBlock Text="{x:Bind FormattedTime}"
                                                   Style="{StaticResource ChatTimestampStyle}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,4,0" />
                                    </StackPanel>

                                    <!-- ==========================================
                                         AI ASSISTANT MESSAGE (left-aligned)
                                         ========================================== -->
                                    <StackPanel Visibility="{x:Bind IsAssistant, Converter={StaticResource BoolToVis}}"
                                                HorizontalAlignment="Left"
                                                Margin="0,4,64,4"
                                                MaxWidth="720">

                                        <!-- Message bubble with accent left border -->
                                        <Border Style="{StaticResource AssistantMessageStyle}">
                                            <Grid ColumnSpacing="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Red accent bar -->
                                                <Border Style="{StaticResource AssistantAccentBorderStyle}" />

                                                <!-- Content area -->
                                                <StackPanel Grid.Column="1" Spacing="8">
                                                    <TextBlock Text="{x:Bind Content, Mode=OneWay}"
                                                               Style="{StaticResource BodyStyle}"
                                                               TextWrapping="Wrap"
                                                               IsTextSelectionEnabled="True" />

                                                    <!-- Streaming cursor (visible while generating) -->
                                                    <Border Style="{StaticResource StreamingCursorStyle}"
                                                            Visibility="{x:Bind IsStreaming, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                            HorizontalAlignment="Left" />

                                                    <!-- Inline citation badges (visible after generation) -->
                                                    <ItemsRepeater ItemsSource="{x:Bind Citations}"
                                                                   Visibility="{x:Bind local:AskFilesPage.HasCitationsVisibility(Citations)}">
                                                        <ItemsRepeater.Layout>
                                                            <StackLayout Orientation="Horizontal" Spacing="4" />
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:CitationItem">
                                                                <Border Style="{StaticResource BadgeAccentStyle}"
                                                                        Padding="6,2,6,2">
                                                                    <TextBlock Text="{x:Bind Label}"
                                                                               FontSize="10"
                                                                               Foreground="{StaticResource TextAccentBrush}"
                                                                               FontWeight="SemiBold" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Timestamp -->
                                        <TextBlock Text="{x:Bind FormattedTime}"
                                                   Style="{StaticResource ChatTimestampStyle}"
                                                   Margin="4,4,0,0" />
                                    </StackPanel>

                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

            </Grid>

            <!-- ==========================================================
                 ROW 2: INPUT BAR
                 ========================================================== -->

            <Border Grid.Row="2" Style="{StaticResource ChatInputBarStyle}">
                <Grid MaxWidth="900" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Question TextBox -->
                    <TextBox x:Name="QuestionInputBox"
                             Style="{StaticResource ChatInputStyle}"
                             PlaceholderText="Ask a question about your documents..."
                             Text="{x:Bind ViewModel.QuestionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="QuestionInputBox_KeyDown"
                             AcceptsReturn="False"
                             MaxHeight="120"
                             VerticalAlignment="Bottom" />

                    <!-- Send / Stop button stack -->
                    <StackPanel Grid.Column="1"
                                Spacing="4"
                                VerticalAlignment="Bottom"
                                Margin="8,0,0,2">

                        <!-- Send button (visible when NOT generating) -->
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Padding="12,10,12,10"
                                MinHeight="44"
                                MinWidth="44"
                                Command="{x:Bind ViewModel.AskCommand}"
                                Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
                                ToolTipService.ToolTip="Send question (Enter)">
                            <FontIcon Glyph="&#xE724;" FontSize="16" />
                        </Button>

                        <!-- Generating indicator (visible during generation) -->
                        <Border Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Padding="10">
                            <ProgressRing IsActive="True" Width="24" Height="24"
                                          Foreground="{StaticResource AccentPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

        <!-- =============================================================
             COLUMN 1: CITATIONS SIDEBAR
             ============================================================= -->

        <Grid Grid.Column="1"
              Background="{StaticResource SidebarGradientBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Sidebar Header -->
            <Border Grid.Row="0" Style="{StaticResource SidebarHeaderStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE82D;" FontSize="14"
                              Foreground="{StaticResource TextAccentBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="Sources"
                               Style="{StaticResource HeadingSmallStyle}"
                               VerticalAlignment="Center" />

                    <!-- Citation count badge -->
                    <Border Style="{StaticResource BadgeAccentStyle}"
                            Padding="6,2,6,2"
                            Visibility="{x:Bind ViewModel.HasCitations, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Foreground="{StaticResource TextAccentBrush}"
                                   FontWeight="SemiBold">
                            <Run Text="{x:Bind ViewModel.ActiveCitations.Count, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Citations List -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0">

                <Grid>

                    <!-- Empty citations state -->
                    <StackPanel Spacing="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="24"
                                Visibility="{x:Bind ViewModel.HasCitations, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <FontIcon Glyph="&#xE82D;"
                                  FontSize="28"
                                  Foreground="{StaticResource TextTertiaryBrush}"
                                  HorizontalAlignment="Center"
                                  Opacity="0.4" />
                        <TextBlock Text="No citations yet"
                                   Style="{StaticResource BodySecondaryStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Ask a question and sources will appear here."
                                   Style="{StaticResource CaptionStyle}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="220"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Citations repeater -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ActiveCitations, Mode=OneWay}"
                                   Margin="8,8,8,8"
                                   Visibility="{x:Bind ViewModel.HasCitations, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:CitationItem">
                                <Border Style="{StaticResource CardInteractiveStyle}"
                                        Padding="14,12">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Citation number + file name -->
                                        <Grid Grid.Row="0" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Citation number badge -->
                                            <Border Style="{StaticResource BadgeAccentStyle}"
                                                    Padding="6,2,6,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextAccentBrush}">
                                                    <Run Text="[" /><Run Text="{x:Bind Number}" /><Run Text="]" />
                                                </TextBlock>
                                            </Border>

                                            <!-- Document name -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind FileName}"
                                                       Style="{StaticResource BodySmallStyle}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <!-- Open button -->
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Padding="6,4,6,4" MinHeight="24"
                                                    Tag="{x:Bind FilePath}"
                                                    Click="OnOpenCitationClick"
                                                    ToolTipService.ToolTip="Open source document">
                                                <FontIcon Glyph="&#xE8DA;" FontSize="10"
                                                          Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Button>
                                        </Grid>

                                        <!-- Page / relevance info -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="4"
                                                        Visibility="{x:Bind local:AskFilesPage.PageNumberToVisibility(PageNumber)}">
                                                <FontIcon Glyph="&#xE8A1;" FontSize="9"
                                                          Foreground="{StaticResource TextTertiaryBrush}" />
                                                <TextBlock Style="{StaticResource CaptionStyle}">
                                                    <Run Text="Page" />
                                                    <Run Text="{x:Bind PageNumber}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE9D9;" FontSize="9"
                                                          Foreground="{StaticResource TextTertiaryBrush}" />
                                                <TextBlock Style="{StaticResource CaptionStyle}">
                                                    <Run Text="{x:Bind RelevancePercent}" /><Run Text="% match" />
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Excerpt -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{x:Bind Excerpt}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   MaxLines="3"
                                                   TextTrimming="CharacterEllipsis" />

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                </Grid>

            </ScrollViewer>

            <!-- Sidebar Footer -->
            <Border Grid.Row="2"
                    Padding="16,10,16,10"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE946;" FontSize="11"
                              Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Text="All answers are grounded in your documents."
                               Style="{StaticResource CaptionStyle}" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>
