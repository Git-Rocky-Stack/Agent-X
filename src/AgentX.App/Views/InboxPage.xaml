<Page
    x:Class="AgentX.App.Views.InboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <!-- Referenced by the focused-landing visibility hint below; without this
             page-level definition the StaticResource lookup fails at page load. -->
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
    </Page.Resources>

    <Grid>

        <!-- ═══════ ADAPTIVE LAYOUT (Tier 3) — see Colors.xaml breakpoints ═══════
             Narrow (<960):  sidebar 220   |  Medium (>=960): sidebar 240
             Wide (>=1280):  sidebar 260 (markup default) -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="220" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="240" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             LEFT PANEL: Filters & Actions
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{ThemeResource CardGradientSubtleBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Padding="20" Spacing="20">
                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="Inbox_Title" Text="Smart Inbox"
                               Style="{StaticResource HeadingSmallStyle}"
                               FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border CornerRadius="{StaticResource RadiusRound}"
                                Background="{ThemeResource AccentSubtleBrush}"
                                Padding="10,2">
                            <TextBlock Foreground="{ThemeResource AccentPrimaryBrush}"
                                       Style="{StaticResource CaptionStyle}" FontWeight="SemiBold">
                                <Run Text="{x:Bind ViewModel.PendingCount, Mode=OneWay}" />
                                <Run x:Uid="Inbox_PendingRun" Text="pending" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Status Filters -->
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Inbox_StatusOverline" Text="STATUS"
                               Style="{StaticResource OverlineStyle}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.StatusFilters}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{x:Bind}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="12,8" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Collection Target -->
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="Inbox_TargetCollectionOverline" Text="TARGET COLLECTION"
                               Style="{StaticResource OverlineStyle}" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.Collections}"
                              SelectedItem="{x:Bind ViewModel.SelectedCollection, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              x:Uid="Inbox_AutoSuggestPlaceholder" PlaceholderText="Auto-suggest"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- Batch Actions -->
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Inbox_ActionsOverline" Text="ACTIONS"
                               Style="{StaticResource OverlineStyle}" />
                    <Button x:Uid="Inbox_AcceptAllBtn" Content="Accept All Pending"
                            Command="{x:Bind ViewModel.AcceptAllCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" />
                    <Button x:Uid="Inbox_GeneratePreviewsBtn" Content="Generate AI Previews"
                            Command="{x:Bind ViewModel.GeneratePreviewsCommand}"
                            IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch" />
                    <Button x:Uid="Inbox_CleanupBtn" Content="Clean Up Processed"
                            Command="{x:Bind ViewModel.CleanupProcessedCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             RIGHT PANEL: Inbox Items
             ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Padding="{StaticResource PaddingPage}" RowSpacing="16" MaxWidth="900">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock x:Uid="Inbox_TriageTitle" Text="Document Triage"
                                   Style="{StaticResource DisplaySmallStyle}" />
                        <TextBlock x:Uid="Inbox_TriageSubtitle" Text="Review new files before they enter your knowledge base. AI suggests collections and tags."
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Visibility="{x:Bind ViewModel.HasFocusedInboxLanding, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            Background="{ThemeResource AccentSubtleBrush}"
                            BorderBrush="{ThemeResource AccentPrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMD}"
                            Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="Inbox_FocusedTitle" Text="Focused Inbox Item"
                                           Style="{StaticResource BodyStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.FocusedInboxSourceLabel, Mode=OneWay}"
                                           Style="{StaticResource BodySecondaryStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.FocusedInboxVisibilityHint, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}"
                                           TextWrapping="Wrap"
                                           Visibility="{x:Bind ViewModel.FocusedInboxVisibilityHint, Mode=OneWay, Converter={StaticResource StringToVis}}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    x:Uid="Inbox_FocusedDismissBtn" Content="Dismiss"
                                    Command="{x:Bind ViewModel.DismissFocusedInboxLandingCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    VerticalAlignment="Top" />
                        </Grid>
                    </Border>

                    <!-- Inbox Item List -->
                    <ItemsRepeater Grid.Row="2" ItemsSource="{x:Bind ViewModel.InboxItems}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:InboxDisplayItem">
                                <Border Background="{ThemeResource CardGradientBrush}"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        Padding="20">
                                    <StackPanel Spacing="12">
                                        <Border Visibility="{x:Bind IsFocused, Converter={StaticResource BoolToVis}}"
                                                CornerRadius="{StaticResource RadiusSM}"
                                                Background="{ThemeResource AccentSubtleBrush}"
                                                Padding="10,4"
                                                HorizontalAlignment="Left">
                                            <TextBlock x:Uid="Inbox_OpenedFromOpsBadge" Text="Opened from Operations"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Foreground="{ThemeResource AccentPrimaryBrush}"
                                                       FontWeight="SemiBold" />
                                        </Border>

                                        <!-- File Header Row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- File Icon -->
                                            <Border Grid.Column="0"
                                                    Width="40" Height="40"
                                                    CornerRadius="{StaticResource RadiusMD}"
                                                    Background="{ThemeResource AccentSubtleBrush}">
                                                <FontIcon Glyph="&#xE7C3;"
                                                          FontSize="18"
                                                          Foreground="{ThemeResource AccentPrimaryBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>

                                            <!-- File Info -->
                                            <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FileName}"
                                                           Style="{StaticResource BodyStyle}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{x:Bind FileType}"
                                                               Style="{StaticResource CaptionStyle}" />
                                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                                               Text="{x:Bind Status}" />
                                                    <!-- Web Clip badge — visible only for browser-extension items -->
                                                    <Border Visibility="{x:Bind IsBrowserClip, Converter={StaticResource BoolToVis}}"
                                                            CornerRadius="4"
                                                            Background="{ThemeResource InfoBrush}"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE774;"
                                                                      FontSize="10"
                                                                      Foreground="#FFFFFFFF"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                            <TextBlock x:Uid="Inbox_WebClipBadge" Text="Web Clip"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#FFFFFFFF"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                <Button Content="&#xE73E;"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="14"
                                                        Foreground="{ThemeResource SuccessBrush}"
                                                        x:Uid="Inbox_AcceptBtn" ToolTipService.ToolTip="Accept"
                                                        AutomationProperties.Name="Accept"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="8" MinWidth="0" MinHeight="0" />
                                                <Button Content="&#xE768;"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="14"
                                                        x:Uid="Inbox_DeferBtn" ToolTipService.ToolTip="Defer"
                                                        AutomationProperties.Name="Defer"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="8" MinWidth="0" MinHeight="0" />
                                                <Button Content="&#xE711;"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="14"
                                                        Foreground="{ThemeResource ErrorBrush}"
                                                        x:Uid="Inbox_RejectBtn" ToolTipService.ToolTip="Reject"
                                                        AutomationProperties.Name="Reject"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="8" MinWidth="0" MinHeight="0" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- AI Preview -->
                                        <Border Visibility="{x:Bind HasPreview, Converter={StaticResource BoolToVis}}"
                                                Background="{ThemeResource CardBrush}"
                                                CornerRadius="{StaticResource RadiusSM}"
                                                Padding="12,8"
                                                BorderBrush="{ThemeResource BorderSubtleBrush}"
                                                BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock x:Uid="Inbox_AiPreviewLabel" Text="AI Preview"
                                                           Style="{StaticResource CaptionStyle}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Preview}"
                                                           Style="{StaticResource BodyStyle}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="4" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Suggested Tags -->
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock x:Uid="Inbox_SuggestedLabel" Text="Suggested:"
                                                       Style="{StaticResource CaptionStyle}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind SuggestedCollectionName}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Foreground="{ThemeResource AccentPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind SuggestedTags}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="2"
                                HorizontalAlignment="Center"
                                Spacing="12"
                                Margin="0,40,0,0"
                                Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <FontIcon Glyph="&#xE8B7;"
                                  FontSize="48"
                                  Foreground="{ThemeResource TextTertiaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock x:Uid="Inbox_EmptyTitle" Text="Inbox is empty"
                                   Style="{StaticResource BodySecondaryStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Uid="Inbox_EmptyHint" Text="New files from watch folders will appear here for triage."
                                   Style="{StaticResource CaptionStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Status -->
                    <TextBlock Grid.Row="3"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}"
                               Margin="0,8,0,0" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
