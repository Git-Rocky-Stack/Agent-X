<Page
    x:Class="AgentX.App.Views.InboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:converters="using:AgentX.App.Converters"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" IsInverted="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             LEFT PANEL: Filters & Actions
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource CardGradientSubtleBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Padding="20" Spacing="20">
                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Smart Inbox"
                               Style="{StaticResource HeadingSmallStyle}"
                               FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border CornerRadius="{StaticResource RadiusRound}"
                                Background="{StaticResource AccentSubtleBrush}"
                                Padding="10,2">
                            <TextBlock Foreground="{StaticResource AccentPrimaryBrush}"
                                       Style="{StaticResource CaptionStyle}" FontWeight="SemiBold">
                                <Run Text="{x:Bind ViewModel.PendingCount, Mode=OneWay}" />
                                <Run Text="pending" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Status Filters -->
                <StackPanel Spacing="8">
                    <TextBlock Text="STATUS"
                               Style="{StaticResource OverlineStyle}"
                               Opacity="0.5" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.StatusFilters}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{x:Bind}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="12,8" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Collection Target -->
                <StackPanel Spacing="6">
                    <TextBlock Text="TARGET COLLECTION"
                               Style="{StaticResource OverlineStyle}"
                               Opacity="0.5" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.Collections}"
                              SelectedItem="{x:Bind ViewModel.SelectedCollection, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              PlaceholderText="Auto-suggest"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- Batch Actions -->
                <StackPanel Spacing="8">
                    <TextBlock Text="ACTIONS"
                               Style="{StaticResource OverlineStyle}"
                               Opacity="0.5" />
                    <Button Content="Accept All Pending"
                            Command="{x:Bind ViewModel.AcceptAllCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" />
                    <Button Content="Generate AI Previews"
                            Command="{x:Bind ViewModel.GeneratePreviewsCommand}"
                            IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch" />
                    <Button Content="Clean Up Processed"
                            Command="{x:Bind ViewModel.CleanupProcessedCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             RIGHT PANEL: Inbox Items
             ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Padding="{StaticResource PaddingPage}" RowSpacing="16" MaxWidth="900">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="Document Triage"
                                   Style="{StaticResource DisplaySmallStyle}" />
                        <TextBlock Text="Review new files before they enter your knowledge base. AI suggests collections and tags."
                                   Style="{StaticResource BodySecondaryStyle}" />
                    </StackPanel>

                    <!-- Inbox Item List -->
                    <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.InboxItems}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:InboxDisplayItem">
                                <Border Background="{StaticResource CardGradientBrush}"
                                        CornerRadius="{StaticResource RadiusMD}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        Padding="20">
                                    <StackPanel Spacing="12">
                                        <Border Visibility="{x:Bind IsFocused, Converter={StaticResource BoolToVis}}"
                                                CornerRadius="{StaticResource RadiusSM}"
                                                Background="{StaticResource AccentSubtleBrush}"
                                                Padding="10,4"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="Opened from Operations"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Foreground="{StaticResource AccentPrimaryBrush}"
                                                       FontWeight="SemiBold" />
                                        </Border>

                                        <!-- File Header Row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- File Icon -->
                                            <Border Grid.Column="0"
                                                    Width="40" Height="40"
                                                    CornerRadius="{StaticResource RadiusMD}"
                                                    Background="{StaticResource AccentSubtleBrush}">
                                                <FontIcon Glyph="&#xE7C3;"
                                                          FontSize="18"
                                                          Foreground="{StaticResource AccentPrimaryBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>

                                            <!-- File Info -->
                                            <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FileName}"
                                                           Style="{StaticResource BodyStyle}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{x:Bind FileType}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               Opacity="0.5" />
                                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                                               Opacity="0.4"
                                                               Text="{x:Bind Status}" />
                                                    <!-- Web Clip badge — visible only for browser-extension items -->
                                                    <Border Visibility="{x:Bind IsBrowserClip, Converter={StaticResource BoolToVis}}"
                                                            CornerRadius="4"
                                                            Background="#1A4FC3"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE774;"
                                                                      FontSize="10"
                                                                      Foreground="#FFFFFFFF"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                            <TextBlock Text="Web Clip"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#FFFFFFFF"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                <Button Content="&#xE73E;"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="14"
                                                        Foreground="{StaticResource SuccessBrush}"
                                                        ToolTipService.ToolTip="Accept"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="8" MinWidth="0" MinHeight="0" />
                                                <Button Content="&#xE768;"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="14"
                                                        ToolTipService.ToolTip="Defer"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="8" MinWidth="0" MinHeight="0" />
                                                <Button Content="&#xE711;"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="14"
                                                        Foreground="{StaticResource ErrorBrush}"
                                                        ToolTipService.ToolTip="Reject"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="8" MinWidth="0" MinHeight="0" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- AI Preview -->
                                        <Border Visibility="{x:Bind HasPreview, Converter={StaticResource BoolToVis}}"
                                                Background="{StaticResource InputBackgroundBrush}"
                                                CornerRadius="{StaticResource RadiusSM}"
                                                Padding="12,8"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="AI Preview"
                                                           Style="{StaticResource CaptionStyle}"
                                                           Opacity="0.5"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Preview}"
                                                           Style="{StaticResource BodyStyle}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="4"
                                                           Opacity="0.7" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Suggested Tags -->
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Suggested:"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Opacity="0.4"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind SuggestedCollectionName}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Foreground="{StaticResource AccentPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind SuggestedTags}"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Opacity="0.5"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="2"
                                HorizontalAlignment="Center"
                                Spacing="12"
                                Margin="0,40,0,0"
                                Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <FontIcon Glyph="&#xE8B7;"
                                  FontSize="48"
                                  Foreground="{StaticResource TextTertiaryBrush}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Inbox is empty"
                                   Style="{StaticResource BodySecondaryStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="New files from watch folders will appear here for triage."
                                   Style="{StaticResource CaptionStyle}"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Status -->
                    <TextBlock Grid.Row="2"
                               Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Style="{StaticResource CaptionStyle}"
                               Opacity="0.5"
                               Margin="0,8,0,0" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
