                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">VRAM analysis</Run>
                                <Run Text=" — Reports total and available video memory, which directly determines the maximum model size you can run." />
