<Page
    x:Class="AgentX.App.Views.UserGuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">
        <Grid Padding="{StaticResource PaddingPage}" MaxWidth="760" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Page Header -->
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
                <TextBlock x:Uid="UserGuide_PageHeaderTitle"
                           Style="{StaticResource DisplaySmallStyle}"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Uid="UserGuide_PageHeaderDescription"
                           Style="{StaticResource BodySecondaryStyle}" />
            </StackPanel>

            <!-- Sections rendered via ItemsControl + DataTemplateSelector -->
            <ItemsControl Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}"
                          ItemTemplateSelector="{StaticResource SectionSelector}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="20" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</Page>
