                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Performance tips</Run>
                                <Run Text=" — Actionable recommendations for maximizing inference speed, such as using quantized models, reducing context length, or offloading layers to GPU." />
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </StackPanel>
