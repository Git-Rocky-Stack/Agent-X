<Page
    x:Class="AgentX.App.Views.UserGuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">
        <Grid Padding="{StaticResource PaddingPage}" MaxWidth="900" HorizontalAlignment="Center">
            <!-- Page Header -->
            <StackPanel Spacing="4" Margin="0,0,0,20">
                <TextBlock x:Uid="UserGuide_PageHeaderTitle"
                           Style="{StaticResource DisplaySmallStyle}" />
                <TextBlock x:Uid="UserGuide_PageHeaderDescription"
                           Style="{StaticResource BodySecondaryStyle}" />
            </StackPanel>

            <!-- Sections rendered via ItemsControl + DataTemplateSelector -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}"
                          ItemTemplateSelector="{StaticResource SectionSelector}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="20" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</Page>
