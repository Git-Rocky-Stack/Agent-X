                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Grid.Column="1" Text="Collections"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </Grid>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Collections let you organize your documents into logical groups. Think of them as folders or tags for your Knowledge Vault — a single document can belong to multiple collections." />

                    <!-- Using Collections -->
                    <TextBlock Text="Working with Collections"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Creating collections</Run>
                                <Run Text=" — Navigate to the Collections page and click New Collection. Give it a descriptive name and optional description." />
                            </TextBlock>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Adding documents</Run>
                                <Run Text=" — Open a collection and use the Add Documents button to select files from your Knowledge Vault. Documents can belong to multiple collections simultaneously." />
                            </TextBlock>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Collection-scoped search</Run>
                                <Run Text=" — When using Semantic Search or Ask Your Files, you can scope your query to a specific collection to narrow results to only the relevant documents." />
                            </TextBlock>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Managing collections</Run>
                                <Run Text=" — Rename, edit descriptions, remove documents, or delete entire collections. Deleting a collection does not delete the documents themselves — only the grouping." />
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 9: KNOWLEDGE GRAPH
                 ========================================================== -->
            <Border Grid.Row="9" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9D9;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Grid.Column="1" Text="Knowledge Graph"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </Grid>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="The Knowledge Graph provides an interactive, force-directed graph visualization showing the relationships between your documents, collections, and tags. It transforms your Knowledge Vault into a visual network you can explore." />

                    <!-- Features -->
                    <TextBlock Text="Graph Elements"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Document Nodes</Run>
                                <Run Text=" — Represented as blue circles, each document in your vault appears as a node in the graph, sized proportionally to its content volume." />
                            </TextBlock>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Collection Nodes</Run>
                                <Run Text=" — Represented as purple circles, collections act as hub nodes connecting all their member documents visually." />
                            </TextBlock>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Tag Nodes</Run>
                                <Run Text=" — Represented as amber circles, tags show semantic connections between documents that share common topics or themes." />
                            </TextBlock>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Edge Connections</Run>
                                <Run Text=" — Lines between nodes represent relationships such as collection membership and tag associations, revealing how your documents are interconnected." />
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <TextBlock Text="Interaction"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Click to Navigate</Run>
                                <Run Text=" — Click any document or collection node to navigate directly to that item, seamlessly bridging visual exploration and detailed content access." />
                            </TextBlock>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
