                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}" VerticalAlignment="Center">
                                <Run FontWeight="SemiBold">AI-generated answer</Run>
                                <Run Text=" — The retrieved passages are fed to the chat model as context, and the AI generates a comprehensive answer with citations referencing the source document and chunk." />
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- Citations -->
                    <TextBlock Text="The Citation System"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Every RAG answer includes numbered citations that map directly to the source chunks used to generate the response. Each citation shows the document name, page or chunk number, and a preview of the retrieved passage. You can click any citation to view the full context of that source passage." />
