<Page
    x:Class="AgentX.App.Views.UserGuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">

        <Grid Padding="{StaticResource PaddingPage}" RowSpacing="20" MaxWidth="900" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <!-- Row 0:  Page Header -->
                <RowDefinition Height="Auto" />
                <!-- Row 1:  Welcome to Agent-X -->
                <RowDefinition Height="Auto" />
                <!-- Row 2:  Getting Started -->
                <RowDefinition Height="Auto" />
                <!-- Row 3:  Dashboard -->
                <RowDefinition Height="Auto" />
                <!-- Row 4:  AI Chat -->
                <RowDefinition Height="Auto" />
                <!-- Row 5:  Ask Your Files (RAG) -->
                <RowDefinition Height="Auto" />
                <!-- Row 6:  Quick Actions -->
                <RowDefinition Height="Auto" />
                <!-- Row 7:  Knowledge Vault -->
                <RowDefinition Height="Auto" />
                <!-- Row 8:  Collections -->
                <RowDefinition Height="Auto" />
                <!-- Row 9:  Semantic Search -->
                <RowDefinition Height="Auto" />
                <!-- Row 10: Model Manager -->
                <RowDefinition Height="Auto" />
                <!-- Row 11: Hardware Advisor -->
                <RowDefinition Height="Auto" />
                <!-- Row 12: Settings -->
                <RowDefinition Height="Auto" />
                <!-- Row 13: Keyboard Shortcuts -->
                <RowDefinition Height="Auto" />
                <!-- Row 14: Command Palette -->
                <RowDefinition Height="Auto" />
                <!-- Row 15: Supported File Formats -->
                <RowDefinition Height="Auto" />
                <!-- Row 16: Troubleshooting -->
                <RowDefinition Height="Auto" />
                <!-- Row 17: Privacy & Security -->
                <RowDefinition Height="Auto" />
                <!-- Row 18: Getting Help -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!-- ==========================================================
                 ROW 0: PAGE HEADER
                 ========================================================== -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="User Guide"
                           Style="{StaticResource DisplaySmallStyle}" />
                <TextBlock Text="Everything you need to know to get the most out of Agent-X."
                           Style="{StaticResource BodySecondaryStyle}" />
            </StackPanel>


            <!-- ==========================================================
                 ROW 1: WELCOME TO AGENT-X
                 ========================================================== -->
            <Border Grid.Row="1" Style="{StaticResource CardAccentStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE80F;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="22"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Welcome to Agent-X"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Agent-X is your local-first AI personal intelligence hub. All processing happens on your machine — your data never leaves your device." />

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Powered by Ollama, Agent-X lets you chat with open-source AI models, ask questions about your own documents using Retrieval-Augmented Generation (RAG), manage a local knowledge vault, run pre-built AI actions, and search your files using semantic vector search — all without an internet connection or cloud dependency." />

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Text="This guide covers every feature in detail so you can unlock the full power of your local AI setup." />
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 2: GETTING STARTED
                 ========================================================== -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7B5;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Getting Started"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <!-- Prerequisites -->
                    <TextBlock Text="Prerequisites"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="10">
                        <!-- Prereq 1 -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="1"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyStyle}">
                                    <Run FontWeight="SemiBold">Install Ollama</Run>
                                    <Run Text=" — Download and install Ollama from" />
                                    <Run Text="ollama.com" Foreground="{StaticResource TextAccentBrush}" />
                                    <Run Text=". Ollama is the local AI runtime that powers all inference in Agent-X." />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- Prereq 2 -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="2"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyStyle}">
                                    <Run FontWeight="SemiBold">Pull at least one model</Run>
                                    <Run Text=" — Open a terminal and run" />
                                </TextBlock>
                                <Border Background="{StaticResource InputBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSM}"
                                        Padding="12,6" Margin="0,4,0,0">
                                    <TextBlock Text="ollama pull llama3.2"
                                               Style="{StaticResource MonoStyle}" />
                                </Border>
                                <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                           Text="This downloads a chat model. For document embeddings, also pull an embedding model:"
                                           Margin="0,4,0,0" />
                                <Border Background="{StaticResource InputBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSM}"
                                        Padding="12,6" Margin="0,4,0,0">
                                    <TextBlock Text="ollama pull all-minilm"
                                               Style="{StaticResource MonoStyle}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Prereq 3 -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="3"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyStyle}">
                                    <Run FontWeight="SemiBold">Ensure Ollama is running</Run>
                                    <Run Text=" — Ollama must be actively serving before launching Agent-X. You can verify by running" />
                                </TextBlock>
                                <Border Background="{StaticResource InputBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSM}"
                                        Padding="12,6" Margin="0,4,0,0">
                                    <TextBlock Text="ollama serve"
                                               Style="{StaticResource MonoStyle}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- First Launch -->
                    <TextBlock Text="First Launch &amp; Onboarding"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="When you first open Agent-X, the onboarding wizard will guide you through initial setup. It will automatically detect your Ollama installation, verify the connection, help you select default chat and embedding models, and optionally import your first documents into the Knowledge Vault." />

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Text="You can re-run the setup at any time from the Dashboard using the Setup AI button." />
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 3: DASHBOARD
                 ========================================================== -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE80F;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Dashboard"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="The Dashboard is your home base in Agent-X. It provides a high-level overview of your entire system at a glance." />

                    <!-- Feature list -->
                    <TextBlock Text="What you will find on the Dashboard:"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">System Status Cards</Run>
                                <Run Text=" — Live indicators showing whether Ollama is connected, your active chat and embedding models, and total indexed documents." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Document Statistics</Run>
                                <Run Text=" — Total documents imported, total chunks indexed, and storage usage metrics for your Knowledge Vault." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Recent Activity</Run>
                                <Run Text=" — A timeline of your latest actions: recent chats, document imports, search queries, and quick action results." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">AI Connection Status</Run>
                                <Run Text=" — A real-time health check showing Ollama connectivity, the loaded model, and response latency." />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <TextBlock Text="Quick-Action Buttons"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="The Dashboard features four prominent quick-action buttons for the most common workflows:" />

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardInsetStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Setup AI" Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock Text="Re-run the onboarding wizard to reconfigure Ollama and models."
                                           Style="{StaticResource BodySmallStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardInsetStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Import Documents" Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock Text="Add files to your Knowledge Vault for AI-powered analysis."
                                           Style="{StaticResource BodySmallStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardInsetStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Start Chat" Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock Text="Open a new AI conversation with your selected model."
                                           Style="{StaticResource BodySmallStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardInsetStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Semantic Search" Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock Text="Search your documents by meaning, not just keywords."
                                           Style="{StaticResource BodySmallStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 4: AI CHAT
                 ========================================================== -->
            <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8BD;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="AI Chat"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="The AI Chat page lets you have natural language conversations with locally-running open-source language models. It functions like a private, offline version of ChatGPT." />

                    <!-- How to use -->
                    <TextBlock Text="Using AI Chat"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="1"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource BodyStyle}" VerticalAlignment="Center">
                                <Run FontWeight="SemiBold">Select a model</Run>
                                <Run Text=" — Choose from your installed Ollama models using the model selector dropdown at the top of the chat. Different models have different capabilities and sizes." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="2"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource BodyStyle}" VerticalAlignment="Center">
                                <Run FontWeight="SemiBold">Type your message</Run>
                                <Run Text=" — Enter your prompt in the input field at the bottom. Press Enter to send, or Shift+Enter for a new line." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="3"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource BodyStyle}" VerticalAlignment="Center">
                                <Run FontWeight="SemiBold">Watch the response stream</Run>
                                <Run Text=" — Responses stream in token-by-token in real time, rendered with full Markdown formatting including headings, lists, code blocks, and inline code." />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <TextBlock Text="Conversation Management"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       Text="Conversations are automatically saved to a local SQLite database on your device. You can return to any previous conversation from the sidebar history." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       Text="Use Ctrl+N to start a new chat at any time. Each conversation maintains its own context window, so the AI remembers what was discussed within the same session." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       Text="You can delete individual conversations or clear your entire chat history from the conversation sidebar." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 5: ASK YOUR FILES (RAG)
                 ========================================================== -->
            <Border Grid.Row="5" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE82D;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Ask Your Files (RAG)"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Retrieval-Augmented Generation (RAG) is the core intelligence feature of Agent-X. It allows you to ask natural language questions about your own documents and receive AI-generated answers grounded in your actual data." />

                    <!-- How RAG Works -->
                    <TextBlock Text="How It Works"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="1"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource BodyStyle}" VerticalAlignment="Center">
                                <Run FontWeight="SemiBold">Select documents</Run>
                                <Run Text=" — Choose one or more documents from your Knowledge Vault to query against. You can select individual files or entire collections." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="2"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource BodyStyle}" VerticalAlignment="Center">
                                <Run FontWeight="SemiBold">Ask a question</Run>
                                <Run Text=" — Type a natural language question about the content of your selected documents." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="3"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource BodyStyle}" VerticalAlignment="Center">
                                <Run FontWeight="SemiBold">Semantic retrieval</Run>
                                <Run Text=" — Agent-X converts your question into a vector embedding, then searches the indexed chunks of your documents for the most semantically relevant passages." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="4"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource BodyStyle}" VerticalAlignment="Center">
                                <Run FontWeight="SemiBold">AI-generated answer</Run>
                                <Run Text=" — The retrieved passages are fed to the chat model as context, and the AI generates a comprehensive answer with citations referencing the source document and chunk." />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- Citations -->
                    <TextBlock Text="The Citation System"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Every RAG answer includes numbered citations that map directly to the source chunks used to generate the response. Each citation shows the document name, page or chunk number, and a preview of the retrieved passage. You can click any citation to view the full context of that source passage." />
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 6: QUICK ACTIONS
                 ========================================================== -->
            <Border Grid.Row="6" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE945;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Quick Actions"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Quick Actions are pre-built AI workflows that perform common document intelligence tasks with a single click. Select one or more documents, choose an action, and Agent-X handles the rest." />

                    <!-- Actions List -->
                    <TextBlock Text="Available Actions"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="10">
                        <Border Style="{StaticResource CardInsetStyle}" Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                          Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Summarize" Style="{StaticResource AccentBodyStyle}" />
                                    <TextBlock Text="Generate a concise summary of the selected document, capturing the key themes, arguments, and conclusions."
                                               Style="{StaticResource BodySecondaryStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardInsetStyle}" Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                          Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Extract Key Points" Style="{StaticResource AccentBodyStyle}" />
                                    <TextBlock Text="Pull out the most important facts, figures, arguments, and takeaways as structured bullet points."
                                               Style="{StaticResource BodySecondaryStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardInsetStyle}" Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8C1;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                          Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Translate" Style="{StaticResource AccentBodyStyle}" />
                                    <TextBlock Text="Translate the document content into another language while preserving meaning and formatting."
                                               Style="{StaticResource BodySecondaryStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardInsetStyle}" Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                          Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Rewrite" Style="{StaticResource AccentBodyStyle}" />
                                    <TextBlock Text="Rewrite the document content in a different tone, style, or complexity level — simplify, formalize, or make it more concise."
                                               Style="{StaticResource BodySecondaryStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardInsetStyle}" Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                          Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Explain" Style="{StaticResource AccentBodyStyle}" />
                                    <TextBlock Text="Get a clear, detailed explanation of complex topics, technical jargon, or dense material within the document."
                                               Style="{StaticResource BodySecondaryStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardInsetStyle}" Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE9CE;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                          Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Q&amp;A Generation" Style="{StaticResource AccentBodyStyle}" />
                                    <TextBlock Text="Automatically generate question-and-answer pairs from the document — ideal for study guides, quizzes, or knowledge checks."
                                               Style="{StaticResource BodySecondaryStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Text="To use a Quick Action, navigate to the Quick Actions page, select one or more documents from your Knowledge Vault, choose the desired action tab, and click Run. The output appears in the results panel and can be copied to the clipboard." />
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 7: KNOWLEDGE VAULT
                 ========================================================== -->
            <Border Grid.Row="7" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8F1;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Knowledge Vault"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="The Knowledge Vault is your centralized document repository. All files imported into Agent-X are stored, indexed, and made searchable through the Knowledge Vault." />

                    <!-- Importing -->
                    <TextBlock Text="Importing Documents"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="There are three ways to add documents to your Knowledge Vault:" />

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Drag and drop</Run>
                                <Run Text=" — Drag files or folders directly onto the Knowledge Vault page. Agent-X will import all supported file types." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">File picker</Run>
                                <Run Text=" — Click the Import button and select individual files from the system file picker dialog." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Folder import</Run>
                                <Run Text=" — Select an entire folder to recursively import all supported files. Subfolders are scanned automatically." />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- Managing Documents -->
                    <TextBlock Text="Managing Documents"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Each document in the vault shows its file name, format, size, import date, chunk count, and indexing status. You can:" />

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       Text="View document details including full text preview, metadata, and chunk breakdown." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       Text="Re-index a document if you change embedding models or chunking settings." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       Text="Delete documents you no longer need. This removes the file and all associated embeddings from the local database." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 8: COLLECTIONS
                 ========================================================== -->
            <Border Grid.Row="8" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8B7;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Collections"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Collections let you organize your documents into logical groups. Think of them as folders or tags for your Knowledge Vault — a single document can belong to multiple collections." />

                    <!-- Using Collections -->
                    <TextBlock Text="Working with Collections"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Creating collections</Run>
                                <Run Text=" — Navigate to the Collections page and click New Collection. Give it a descriptive name and optional description." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Adding documents</Run>
                                <Run Text=" — Open a collection and use the Add Documents button to select files from your Knowledge Vault. Documents can belong to multiple collections simultaneously." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Collection-scoped search</Run>
                                <Run Text=" — When using Semantic Search or Ask Your Files, you can scope your query to a specific collection to narrow results to only the relevant documents." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Managing collections</Run>
                                <Run Text=" — Rename, edit descriptions, remove documents, or delete entire collections. Deleting a collection does not delete the documents themselves — only the grouping." />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 9: SEMANTIC SEARCH
                 ========================================================== -->
            <Border Grid.Row="9" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE721;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Semantic Search"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Semantic Search goes beyond traditional keyword matching. Instead of searching for exact words, it understands the meaning behind your query and finds passages with similar concepts — even if they use completely different vocabulary." />

                    <!-- How it works -->
                    <TextBlock Text="How Vector Search Works"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="When you import a document, Agent-X splits it into chunks and converts each chunk into a high-dimensional vector embedding using your selected embedding model. When you search, your query is also converted into an embedding, and the system finds the chunks whose embeddings are most similar using cosine similarity scoring." />

                    <Border Style="{StaticResource SeparatorStyle}" />

                    <!-- Using search -->
                    <TextBlock Text="Using Semantic Search"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Natural language queries</Run>
                                <Run Text=" — Type your question or topic naturally, such as &quot;How does the authentication system work?&quot; or &quot;Annual revenue figures for 2024.&quot;" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Similarity scoring</Run>
                                <Run Text=" — Each result displays a relevance score from 0 to 1, indicating how closely the passage matches your query semantically." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Filtering</Run>
                                <Run Text=" — Narrow results by collection, tag, or file type to focus on the most relevant subset of your Knowledge Vault." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Result previews</Run>
                                <Run Text=" — Each search result shows a text snippet with the matching passage highlighted, along with the source document name and chunk location." />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 10: MODEL MANAGER
                 ========================================================== -->
            <Border Grid.Row="10" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE74C;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Model Manager"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="The Model Manager provides a visual interface for managing all Ollama models installed on your system. You can browse, download, inspect, and remove models without using the command line." />

                    <!-- Capabilities -->
                    <TextBlock Text="Capabilities"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">View installed models</Run>
                                <Run Text=" — See all models currently available on your system with their name, size, parameter count, and quantization level (e.g., Q4_0, Q5_K_M)." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Model details</Run>
                                <Run Text=" — Click any model to see detailed information: family, format, parameter size, quantization type, context window, license, and system prompt template." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Pull new models</Run>
                                <Run Text=" — Enter a model name (e.g., mistral, codellama, phi3) and click Pull to download it directly. A real-time progress bar tracks the download." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Delete models</Run>
                                <Run Text=" — Remove models you no longer need to free up disk space. Agent-X will confirm before deletion." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Set default models</Run>
                                <Run Text=" — Assign a default chat model and a default embedding model. These are used as the system-wide defaults in Chat, RAG, and Quick Actions." />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 11: HARDWARE ADVISOR
                 ========================================================== -->
            <Border Grid.Row="11" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7F4;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Hardware Advisor"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="The Hardware Advisor scans your system to determine your AI capabilities and recommends the best models for your specific hardware configuration." />

                    <!-- Features -->
                    <TextBlock Text="What It Detects"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">GPU detection</Run>
                                <Run Text=" — Identifies your graphics card(s), whether NVIDIA (CUDA), AMD (ROCm), or Intel (oneAPI), and reports the GPU model name." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">VRAM analysis</Run>
                                <Run Text=" — Reports total and available video memory, which directly determines the maximum model size you can run." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Recommended model sizes</Run>
                                <Run Text=" — Based on your available VRAM and system RAM, the advisor suggests which model sizes (3B, 7B, 13B, 30B, 70B) will run well on your machine." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="{StaticResource TextAccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Performance tips</Run>
                                <Run Text=" — Actionable recommendations for maximizing inference speed, such as using quantized models, reducing context length, or offloading layers to GPU." />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 12: SETTINGS
                 ========================================================== -->
            <Border Grid.Row="12" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE713;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Settings"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="The Settings page gives you fine-grained control over every aspect of Agent-X. All settings are persisted locally." />

                    <!-- Settings Groups -->
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardInsetStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="AI Provider" Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock Text="Ollama endpoint URL (default: http://localhost:11434), default chat model, and default embedding model."
                                           Style="{StaticResource BodySmallStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardInsetStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Inference" Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock Text="Temperature (creativity), max tokens (response length), and context window size for conversation memory."
                                           Style="{StaticResource BodySmallStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardInsetStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Knowledge Vault" Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock Text="Chunk size, chunk overlap, and top-K results for retrieval. Controls how documents are split and how many chunks are retrieved per query."
                                           Style="{StaticResource BodySmallStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardInsetStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="License" Style="{StaticResource AccentBodyStyle}" />
                                <TextBlock Text="View your license tier, activate a license key, check document limits, and manage your subscription status."
                                           Style="{StaticResource BodySmallStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Text="Use Ctrl+, to quickly jump to Settings from anywhere in the app." />
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 13: KEYBOARD SHORTCUTS
                 ========================================================== -->
            <Border Grid.Row="13" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE765;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Keyboard Shortcuts"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Agent-X supports keyboard shortcuts for rapid navigation and common actions. Master these to dramatically speed up your workflow." />

                    <!-- Shortcuts Table -->
                    <StackPanel Spacing="0">

                        <!-- Table Header -->
                        <Border Background="{StaticResource InputBackgroundBrush}"
                                CornerRadius="8,8,0,0"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SHORTCUT"
                                           Style="{StaticResource OverlineStyle}" />
                                <TextBlock Grid.Column="1" Text="ACTION"
                                           Style="{StaticResource OverlineStyle}" />
                            </Grid>
                        </Border>

                        <!-- Ctrl+K -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Background="{StaticResource CardElevatedBrush}"
                                            BorderBrush="{StaticResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="Ctrl" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="+" Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <Border Background="{StaticResource CardElevatedBrush}"
                                            BorderBrush="{StaticResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="K" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Open Command Palette"
                                           Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Ctrl+N -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Background="{StaticResource CardElevatedBrush}"
                                            BorderBrush="{StaticResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="Ctrl" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="+" Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <Border Background="{StaticResource CardElevatedBrush}"
                                            BorderBrush="{StaticResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="N" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="New Chat"
                                           Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Ctrl+I -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Background="{StaticResource CardElevatedBrush}"
                                            BorderBrush="{StaticResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="Ctrl" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="+" Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <Border Background="{StaticResource CardElevatedBrush}"
                                            BorderBrush="{StaticResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="I" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Knowledge Vault"
                                           Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Ctrl+F -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Background="{StaticResource CardElevatedBrush}"
                                            BorderBrush="{StaticResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="Ctrl" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="+" Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <Border Background="{StaticResource CardElevatedBrush}"
                                            BorderBrush="{StaticResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="F" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Semantic Search"
                                           Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Ctrl+Shift+F -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Background="{StaticResource CardElevatedBrush}"
                                            BorderBrush="{StaticResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="Ctrl" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="+" Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <Border Background="{StaticResource CardElevatedBrush}"
                                            BorderBrush="{StaticResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="Shift" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="+" Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <Border Background="{StaticResource CardElevatedBrush}"
                                            BorderBrush="{StaticResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="F" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Search (alternate)"
                                           Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Ctrl+, -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Background="{StaticResource CardElevatedBrush}"
                                            BorderBrush="{StaticResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="Ctrl" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="+" Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <Border Background="{StaticResource CardElevatedBrush}"
                                            BorderBrush="{StaticResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="," Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Settings"
                                           Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Escape (last row, closed bottom corners) -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="0,0,8,8"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Background="{StaticResource CardElevatedBrush}"
                                            BorderBrush="{StaticResource BorderMediumBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSM}"
                                            Padding="8,4">
                                        <TextBlock Text="Esc" Style="{StaticResource MonoSmallStyle}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Close Command Palette"
                                           Style="{StaticResource BodyStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 14: COMMAND PALETTE
                 ========================================================== -->
            <Border Grid.Row="14" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE773;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Command Palette"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="The Command Palette is the fastest way to navigate Agent-X. Inspired by VS Code and Spotlight, it provides instant access to every page and action through a single search interface." />

                    <TextBlock Text="How to Use"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="1"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource BodyStyle}" VerticalAlignment="Center">
                                <Run Text="Press" />
                                <Run FontWeight="SemiBold" Text=" Ctrl+K " />
                                <Run Text="from anywhere in the app to open the Command Palette overlay." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="2"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource BodyStyle}" VerticalAlignment="Center"
                                       Text="Start typing to filter available pages and actions. Results update instantly as you type." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="3"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource BodyStyle}" VerticalAlignment="Center"
                                       Text="Use the arrow keys to navigate through results, then press Enter to go to the selected page. Press Escape to close the palette without navigating." />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Text="The Command Palette searches across all pages including Dashboard, Chat, Knowledge Vault, Search, Collections, Quick Actions, Model Manager, Hardware Advisor, Settings, and this User Guide." />
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 15: SUPPORTED FILE FORMATS
                 ========================================================== -->
            <Border Grid.Row="15" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8A5;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Supported File Formats"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Agent-X can ingest a wide variety of file formats into the Knowledge Vault. Each format has a specialized parser that extracts text content optimally." />

                    <!-- File Format Table -->
                    <StackPanel Spacing="0">

                        <!-- Table Header -->
                        <Border Background="{StaticResource InputBackgroundBrush}"
                                CornerRadius="8,8,0,0"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="FORMAT"
                                           Style="{StaticResource OverlineStyle}" />
                                <TextBlock Grid.Column="1" Text="EXTENSION"
                                           Style="{StaticResource OverlineStyle}" />
                                <TextBlock Grid.Column="2" Text="EXTRACTION METHOD"
                                           Style="{StaticResource OverlineStyle}" />
                            </Grid>
                        </Border>

                        <!-- PDF -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PDF" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text=".pdf" Style="{StaticResource MonoSmallStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Full text extraction with page tracking and structural analysis."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </Grid>
                        </Border>

                        <!-- Word -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Word Document" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text=".docx" Style="{StaticResource MonoSmallStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Paragraph and table extraction with formatting preservation."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </Grid>
                        </Border>

                        <!-- Plain Text -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Plain Text" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text=".txt" Style="{StaticResource MonoSmallStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Direct text ingestion with line-break aware chunking."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </Grid>
                        </Border>

                        <!-- Markdown -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Markdown" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text=".md" Style="{StaticResource MonoSmallStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Parsed with heading-level structure preservation and section awareness."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </Grid>
                        </Border>

                        <!-- Code Files -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Code Files" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Style="{StaticResource MonoSmallStyle}" VerticalAlignment="Center"
                                           Text=".cs .py .js ..." />
                                <TextBlock Grid.Column="2" Text="Syntax-aware chunking that respects function, class, and block boundaries."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </Grid>
                        </Border>

                        <!-- Images (last row, bottom corners) -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="0,0,8,8"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Images" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text=".png .jpg .jpeg" Style="{StaticResource MonoSmallStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="OCR (Optical Character Recognition) text extraction from image content."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </Grid>
                        </Border>

                    </StackPanel>

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Text="Code file support includes .cs, .py, .js, .ts, .cpp, .c, .java, .go, .rs, .rb, .php, .swift, .kt, and more. Any plain-text-based source file can be imported." />
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 16: TROUBLESHOOTING
                 ========================================================== -->
            <Border Grid.Row="16" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE90F;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Troubleshooting"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="If you encounter issues, check the common problems and solutions below before reaching out for support." />

                    <!-- Issue 1: Ollama not detected -->
                    <Border Style="{StaticResource CardInsetStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="&quot;Ollama not detected&quot;"
                                           Style="{StaticResource HeadingSmallStyle}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodySecondaryStyle}">
                                <Run Text="Ensure Ollama is running on your system. Open a terminal and run" />
                                <Run Text=" ollama serve " FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                <Run Text="to start the Ollama server. If you are using a custom endpoint, verify the URL is correct in Settings. The default endpoint is http://localhost:11434." />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Issue 2: Slow responses -->
                    <Border Style="{StaticResource CardInsetStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="Slow responses"
                                           Style="{StaticResource HeadingSmallStyle}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                       Text="Try switching to a smaller model (e.g., 3B or 7B parameters instead of 13B or larger). Check the Hardware Advisor page to see which models are recommended for your VRAM. Using quantized models (Q4 or Q5) significantly reduces memory usage and improves speed." />
                        </StackPanel>
                    </Border>

                    <!-- Issue 3: Documents not indexing -->
                    <Border Style="{StaticResource CardInsetStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="Documents not indexing"
                                           Style="{StaticResource HeadingSmallStyle}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                       Text="Verify the file format is supported (see Supported File Formats above). Ensure an embedding model is configured in Settings — documents cannot be indexed without one. If you recently changed embedding models, you may need to re-index existing documents from the Knowledge Vault." />
                        </StackPanel>
                    </Border>

                    <!-- Issue 4: High memory usage -->
                    <Border Style="{StaticResource CardInsetStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="High memory usage"
                                           Style="{StaticResource HeadingSmallStyle}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                       Text="Reduce the context window size in Settings (lower values use less RAM). Switch to a quantized model variant (e.g., Q4_0 instead of FP16). Close other memory-intensive applications while running large models. The Hardware Advisor can help identify optimal settings for your system." />
                        </StackPanel>
                    </Border>

                    <!-- Issue 5: Search returns no results -->
                    <Border Style="{StaticResource CardInsetStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="Search returns no results"
                                           Style="{StaticResource HeadingSmallStyle}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                       Text="Ensure your documents have been fully indexed (check indexing status in the Knowledge Vault). Try rephrasing your query using different terminology. Semantic search works on meaning, so broader or more descriptive queries often yield better results than very specific technical terms." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 17: PRIVACY & SECURITY
                 ========================================================== -->
            <Border Grid.Row="17" Style="{StaticResource CardElevatedStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE72E;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Privacy &amp; Security"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Agent-X is designed from the ground up to be a fully local-first application. Your privacy is not a feature — it is the architecture." />

                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="#FF22C55E" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">All data stored locally</Run>
                                <Run Text=" — Documents, embeddings, conversations, and settings are stored in a local SQLite database on your machine." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="#FF22C55E" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">No cloud services</Run>
                                <Run Text=" — All AI inference happens locally through Ollama. No data is sent to external APIs, cloud servers, or third-party services." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="#FF22C55E" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">No telemetry</Run>
                                <Run Text=" — Agent-X does not collect usage analytics, crash reports, or any form of telemetry. Your activity stays on your device." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="#FF22C55E" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Your data, your control</Run>
                                <Run Text=" — Documents and conversations are never shared, uploaded, or used for training. You can delete any data at any time from within the app." />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 18: GETTING HELP
                 ========================================================== -->
            <Border Grid.Row="18" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE897;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Text="Getting Help"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="If you need assistance beyond what this guide covers, we are here to help." />

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardInsetStyle}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                              Foreground="{StaticResource TextAccentBrush}" />
                                    <TextBlock Text="Email Support" Style="{StaticResource AccentBodyStyle}" />
                                </StackPanel>
                                <TextBlock Text="support@strategia-x.com"
                                           Style="{StaticResource MonoStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="For bug reports, feature requests, or general questions."
                                           Style="{StaticResource BodySmallStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardInsetStyle}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                              Foreground="{StaticResource TextAccentBrush}" />
                                    <TextBlock Text="Documentation" Style="{StaticResource AccentBodyStyle}" />
                                </StackPanel>
                                <TextBlock Text="docs.strategia-x.com"
                                           Style="{StaticResource MonoStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="Full online documentation, tutorials, and API reference."
                                           Style="{StaticResource BodySmallStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Style="{StaticResource CaptionStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0">
                        <Run Text="Agent-X by Strategia" />
                        <Run Text="  |  " />
                        <Run Text="Local-first AI for everyone" />
                    </TextBlock>
                </StackPanel>
            </Border>


        </Grid>
    </ScrollViewer>
</Page>
