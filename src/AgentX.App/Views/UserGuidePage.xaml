                                   Style="{StaticResource HeadingMediumStyle}" />
                    </Grid>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="The Settings page gives you fine-grained control over every aspect of Agent-X. All settings are persisted locally." />

