            <!-- ==========================================================
                 ROW 16: COMMAND PALETTE
                 ========================================================== -->
            <Border Grid.Row="16" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE773;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Grid.Column="1" Text="Command Palette"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </Grid>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="The Command Palette is the fastest way to navigate Agent-X. Inspired by VS Code and Spotlight, it provides instant access to every page and action through a single search interface." />

                    <TextBlock Text="How to Use"
                               Style="{StaticResource HeadingSmallStyle}" />

                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="1"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}" VerticalAlignment="Center">
                                <Run Text="Press" />
                                <Run FontWeight="SemiBold" Text=" Ctrl+K " />
                                <Run Text="from anywhere in the app to open the Command Palette overlay." />
                            </TextBlock>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="2"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}" VerticalAlignment="Center"
                                       Text="Start typing to filter available pages and actions. Results update instantly as you type." />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28"
                                    CornerRadius="{StaticResource RadiusRound}"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="3"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}" VerticalAlignment="Center"
                                       Text="Use the arrow keys to navigate through results, then press Enter to go to the selected page. Press Escape to close the palette without navigating." />
                        </Grid>
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Text="The Command Palette searches across all pages including Dashboard, Chat, Knowledge Vault, Search, Collections, Quick Actions, Model Manager, Hardware Advisor, Settings, and this User Guide." />
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 17: SUPPORTED FILE FORMATS
                 ========================================================== -->
            <Border Grid.Row="17" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Grid.Column="1" Text="Supported File Formats"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </Grid>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Agent-X can ingest a wide variety of file formats into the Knowledge Vault. Each format has a specialized parser that extracts text content optimally." />

                    <!-- File Format Table -->
                    <StackPanel Spacing="0">

                        <!-- Table Header -->
                        <Border Background="{StaticResource InputBackgroundBrush}"
                                CornerRadius="8,8,0,0"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="FORMAT"
                                           Style="{StaticResource OverlineStyle}" />
                                <TextBlock Grid.Column="1" Text="EXTENSION"
                                           Style="{StaticResource OverlineStyle}" />
                                <TextBlock Grid.Column="2" Text="EXTRACTION METHOD"
                                           Style="{StaticResource OverlineStyle}" />
                            </Grid>
                        </Border>

                        <!-- PDF -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PDF" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text=".pdf" Style="{StaticResource MonoSmallStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Full text extraction with page tracking and structural analysis."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </Grid>
                        </Border>

                        <!-- Word -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Word Document" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text=".docx" Style="{StaticResource MonoSmallStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Paragraph and table extraction with formatting preservation."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </Grid>
                        </Border>

                        <!-- Plain Text -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Plain Text" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text=".txt" Style="{StaticResource MonoSmallStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Direct text ingestion with line-break aware chunking."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </Grid>
                        </Border>

                        <!-- Markdown -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Markdown" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text=".md" Style="{StaticResource MonoSmallStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Parsed with heading-level structure preservation and section awareness."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </Grid>
                        </Border>

                        <!-- Code Files -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Code Files" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Style="{StaticResource MonoSmallStyle}" VerticalAlignment="Center"
                                           Text=".cs .py .js ..." />
                                <TextBlock Grid.Column="2" Text="Syntax-aware chunking that respects function, class, and block boundaries."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </Grid>
                        </Border>

                        <!-- Images (last row, bottom corners) -->
                        <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="0,0,8,8"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Images" Style="{StaticResource BodyStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text=".png .jpg .jpeg" Style="{StaticResource MonoSmallStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="OCR (Optical Character Recognition) text extraction from image content."
                                           Style="{StaticResource BodySecondaryStyle}" />
                            </Grid>
                        </Border>

                    </StackPanel>

                    <TextBlock Style="{StaticResource BodySecondaryStyle}"
                               Text="Code file support includes .cs, .py, .js, .ts, .cpp, .c, .java, .go, .rs, .rb, .php, .swift, .kt, and more. Any plain-text-based source file can be imported." />
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 18: TROUBLESHOOTING
                 ========================================================== -->
            <Border Grid.Row="18" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE90F;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Grid.Column="1" Text="Troubleshooting"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </Grid>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="If you encounter issues, check the common problems and solutions below before reaching out for support." />

                    <!-- Issue 1: Ollama not detected -->
                    <Border Style="{StaticResource CardInsetStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Grid.Column="1" Text="&quot;Ollama not detected&quot;"
                                           Style="{StaticResource HeadingSmallStyle}" />
                            </Grid>
                            <TextBlock Style="{StaticResource BodySecondaryStyle}">
                                <Run Text="Ensure Ollama is running on your system. Open a terminal and run" />
                                <Run Text=" ollama serve " FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                <Run Text="to start the Ollama server. If you are using a custom endpoint, verify the URL is correct in Settings. The default endpoint is http://localhost:11434." />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Issue 2: Slow responses -->
                    <Border Style="{StaticResource CardInsetStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Grid.Column="1" Text="Slow responses"
                                           Style="{StaticResource HeadingSmallStyle}" />
                            </Grid>
                            <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                       Text="Try switching to a smaller model (e.g., 3B or 7B parameters instead of 13B or larger). Check the Hardware Advisor page to see which models are recommended for your VRAM. Using quantized models (Q4 or Q5) significantly reduces memory usage and improves speed." />
                        </StackPanel>
                    </Border>

                    <!-- Issue 3: Documents not indexing -->
                    <Border Style="{StaticResource CardInsetStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Grid.Column="1" Text="Documents not indexing"
                                           Style="{StaticResource HeadingSmallStyle}" />
                            </Grid>
                            <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                       Text="Verify the file format is supported (see Supported File Formats above). Ensure an embedding model is configured in Settings — documents cannot be indexed without one. If you recently changed embedding models, you may need to re-index existing documents from the Knowledge Vault." />
                        </StackPanel>
                    </Border>

                    <!-- Issue 4: High memory usage -->
                    <Border Style="{StaticResource CardInsetStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Grid.Column="1" Text="High memory usage"
                                           Style="{StaticResource HeadingSmallStyle}" />
                            </Grid>
                            <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                       Text="Reduce the context window size in Settings (lower values use less RAM). Switch to a quantized model variant (e.g., Q4_0 instead of FP16). Close other memory-intensive applications while running large models. The Hardware Advisor can help identify optimal settings for your system." />
                        </StackPanel>
                    </Border>

                    <!-- Issue 5: Search returns no results -->
                    <Border Style="{StaticResource CardInsetStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Grid.Column="1" Text="Search returns no results"
                                           Style="{StaticResource HeadingSmallStyle}" />
                            </Grid>
                            <TextBlock Style="{StaticResource BodySecondaryStyle}"
                                       Text="Ensure your documents have been fully indexed (check indexing status in the Knowledge Vault). Try rephrasing your query using different terminology. Semantic search works on meaning, so broader or more descriptive queries often yield better results than very specific technical terms." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>


            <!-- ==========================================================
                 ROW 19: PRIVACY & SECURITY
                 ========================================================== -->
            <Border Grid.Row="19" Style="{StaticResource CardElevatedStyle}">
                <StackPanel Spacing="16">
                    <!-- Section Header -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE72E;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="20"
                                  Foreground="{StaticResource TextAccentBrush}" />
                        <TextBlock Grid.Column="1" Text="Privacy &amp; Security"
                                   Style="{StaticResource HeadingMediumStyle}" />
                    </Grid>

                    <TextBlock Style="{StaticResource BodyStyle}"
                               Text="Agent-X is designed from the ground up to be a fully local-first application. Your privacy is not a feature — it is the architecture." />

                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="#FF22C55E" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">All data stored locally</Run>
                                <Run Text=" — Documents, embeddings, conversations, and settings are stored in a local SQLite database on your machine." />
                            </TextBlock>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="#FF22C55E" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Local-first by default</Run>
                                <Run Text=" — All AI inference defaults to running locally through Ollama. No data is sent to external services unless you explicitly opt into cloud providers." />
                            </TextBlock>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="#FF22C55E" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">No telemetry</Run>
                                <Run Text=" — Agent-X does not collect usage analytics, crash reports, or any form of telemetry. Your activity stays on your device." />
                            </TextBlock>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="#FF22C55E" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStyle}">
                                <Run FontWeight="SemiBold">Your data, your control</Run>
                                <Run Text=" — Documents and conversations are never shared, uploaded, or used for training. You can delete any data at any time from within the app." />
                            </TextBlock>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
