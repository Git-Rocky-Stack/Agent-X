<Page
    x:Class="AgentX.App.Views.EmailSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AgentX.App.Controls"
    xmlns:c="using:AgentX.App.Converters"
    xmlns:vm="using:AgentX.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled"
    Background="Transparent">

    <Page.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <c:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" IsInverted="True"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">
        <Grid Padding="{StaticResource PaddingPage}"
              RowSpacing="24"
              MaxWidth="900"
              HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==========================================================
                 ROW 0: PAGE HEADER
                 ========================================================== -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock x:Uid="EmailSet_EmailConnector" Text="Email Connector"
                           Style="{StaticResource DisplaySmallStyle}"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock x:Uid="EmailSet_SyncGmailAndOutlook" Text="Sync Gmail and Outlook emails into your knowledge vault for AI-powered search and triage."
                           Style="{StaticResource BodySecondaryStyle}"/>
            </StackPanel>

            <!-- ==========================================================
                 ROW 1: ERROR BAR
                 ========================================================== -->
            <InfoBar Grid.Row="1"
                     x:Uid="EmailSet_Error" Title="Error"
                     Severity="Error"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsClosable="True"/>

            <!-- ==========================================================
                 ROW 2: CONNECTED ACCOUNTS
                 ========================================================== -->
            <controls:Faceplate Grid.Row="2" Kicker="MOD - MAIL - 01">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="EmailSet_ConnectedAccounts" Text="Connected Accounts"
                               Style="{StaticResource HeadingSmallStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>

                    <!-- Gmail -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE715;"
                                  FontSize="24"
                                  Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Gmail"
                                       Style="{StaticResource BodyStrongStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.GoogleStatusText, Mode=OneWay}"
                                       Style="{StaticResource BodySecondaryStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                x:Uid="EmailSet_Connect" Content="Connect"
                                Command="{x:Bind ViewModel.ConnectGoogleCommand, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsGoogleConnected, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"
                                Style="{StaticResource AccentButtonStyle}"
                                MinWidth="120"/>
                        <Button Grid.Column="2"
                                x:Uid="EmailSet_Disconnect" Content="Disconnect"
                                Click="OnDisconnectGoogleClick"
                                Visibility="{x:Bind ViewModel.IsGoogleConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="120"/>
                    </Grid>

                    <!-- Outlook Email -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE77B;"
                                  FontSize="24"
                                  Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Uid="EmailSet_OutlookEmail" Text="Outlook Email"
                                       Style="{StaticResource BodyStrongStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.MicrosoftStatusText, Mode=OneWay}"
                                       Style="{StaticResource BodySecondaryStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                x:Uid="EmailSet_Connect2" Content="Connect"
                                Command="{x:Bind ViewModel.ConnectMicrosoftCommand, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsMicrosoftConnected, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}"
                                Style="{StaticResource AccentButtonStyle}"
                                MinWidth="120"/>
                        <Button Grid.Column="2"
                                x:Uid="EmailSet_Disconnect2" Content="Disconnect"
                                Click="OnDisconnectMicrosoftClick"
                                Visibility="{x:Bind ViewModel.IsMicrosoftConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="120"/>
                    </Grid>
                </StackPanel>
            </controls:Faceplate>

            <!-- ==========================================================
                 ROW 3: OAUTH APP CREDENTIALS (the same form as on the Calendar page)
                 ========================================================== -->
            <controls:Faceplate Grid.Row="3" Kicker="MOD - MAIL - 02">
                <controls:OAuthAppCredentialsPanel/>
            </controls:Faceplate>

            <!-- ==========================================================
                 ROW 4: SYNC SETTINGS
                 ========================================================== -->
            <controls:Faceplate Grid.Row="4" Kicker="MOD - MAIL - 03">
                <StackPanel Spacing="16">
                    <TextBlock x:Uid="EmailSet_SyncSettings" Text="Sync Settings"
                               Style="{StaticResource HeadingSmallStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>

                    <ToggleSwitch x:Uid="EmailSet_EmailSync" Header="Email sync"
                                  IsOn="{x:Bind ViewModel.EnableEmailSync, Mode=TwoWay}"
                                  OffContent="Off" OnContent="On"/>

                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="EmailSet_SyncIntervalMinutes" Text="Sync interval (minutes)"
                                   Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{x:Bind ViewModel.SyncIntervalOptions, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.SyncIntervalIndex, Mode=TwoWay}"
                                  MinWidth="200"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="EmailSet_MaxMessagesPerSync" Text="Max messages per sync"
                                   Style="{StaticResource LabelStyle}"/>
                        <NumberBox Value="{x:Bind ViewModel.MaxMessagesPerSync, Mode=TwoWay}"
                                   Minimum="1" Maximum="500"
                                   SpinButtonPlacementMode="Compact"
                                   MinWidth="200"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="EmailSet_SyncDaysBack" Text="Sync days back"
                                   Style="{StaticResource LabelStyle}"/>
                        <NumberBox Value="{x:Bind ViewModel.SyncDaysBack, Mode=TwoWay}"
                                   Minimum="1" Maximum="365"
                                   SpinButtonPlacementMode="Compact"
                                   MinWidth="200"/>
                    </StackPanel>

                    <ToggleSwitch x:Uid="EmailSet_IncludeAttachmentNamesIn" Header="Include attachment names in search index"
                                  IsOn="{x:Bind ViewModel.IncludeAttachmentNames, Mode=TwoWay}"
                                  OffContent="Exclude" OnContent="Include"/>

                    <!-- Folders to sync: the folders of the connected accounts, saved per folder id -->
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="EmailSet_FoldersToSync" Text="Folders to sync"
                                           Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Uid="EmailSet_FoldersToSyncHint" Text="Mail is read only from the selected folders. By default, only the inbox is selected."
                                           Style="{StaticResource CaptionStyle}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Uid="EmailSet_RefreshFolders" Content="Refresh folders"
                                    Command="{x:Bind ViewModel.RefreshFoldersCommand, Mode=OneWay}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    VerticalAlignment="Top"/>
                        </Grid>

                        <Border Style="{StaticResource CardInsetStyle}" Padding="12">
                            <Grid>
                                <ScrollViewer MaxHeight="240"
                                              VerticalScrollBarVisibility="Auto"
                                              Visibility="{x:Bind ViewModel.HasFolders, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="8"/>
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EmailFolderSelectionItem">
                                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                          AutomationProperties.Name="{x:Bind Name}">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind Name}"
                                                                   Style="{StaticResource BodyStyle}"/>
                                                        <TextBlock Text="{x:Bind Accounts}"
                                                                   Style="{StaticResource CaptionStyle}"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>

                                <TextBlock x:Uid="EmailSet_NoFolders" Text="No folders to show. Connect an account above, then refresh the folders."
                                           Style="{StaticResource CaptionStyle}"
                                           TextWrapping="Wrap"
                                           Visibility="{x:Bind ViewModel.ShowNoFoldersHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Uid="EmailSet_NoFolderSelected" Text="No folder is selected, so no mail will be synced."
                                   Style="{StaticResource CaptionStyle}"
                                   Foreground="{ThemeResource LedNoGoTextBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.IsFolderSelectionEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </StackPanel>
            </controls:Faceplate>

            <!-- ==========================================================
                 ROW 5: ACTIONS
                 ========================================================== -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12">
                <Button x:Uid="EmailSet_SaveSettings" Content="Save Settings"
                        Command="{x:Bind ViewModel.SaveSettingsCommand, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Uid="EmailSet_SyncNow" Content="Sync Now"
                        Command="{x:Bind ViewModel.SyncNowCommand, Mode=OneWay}"
                        Style="{StaticResource SecondaryButtonStyle}"/>
                <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                             Style="{StaticResource AccentProgressBarStyle}"
                             Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                             Width="100"
                             VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ==========================================================
                 ROW 6: STATUS (3-column metric strip)
                 ========================================================== -->
            <controls:Faceplate Grid.Row="6" Kicker="MOD - MAIL - 04">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock x:Uid="EmailSet_LastSynced" Text="Last synced"
                                   Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.LastSyncTime, Mode=OneWay}"
                                   Style="{StaticResource BodyStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Uid="EmailSet_NextSync" Text="Next sync"
                                   Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.NextSyncTime, Mode=OneWay}"
                                   Style="{StaticResource BodyStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock x:Uid="EmailSet_Status" Text="Status"
                                   Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.SyncStatusText, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource BodyStyle}"/>
                    </StackPanel>
                </Grid>
            </controls:Faceplate>
        </Grid>
    </ScrollViewer>
</Page>
