<Window
    x:Class="AgentX.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentX.App"
    xmlns:controls="using:AgentX.App.Controls"
    xmlns:tb="using:H.NotifyIcon"
    Title="Agent-X">

    <Grid x:Name="RootGrid" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════
             AMBIENT GLOW LAYER (subtle red radial glow, top-left)
             Creates premium depth perception on the dark canvas.
             ═══════════════════════════════════════════════════════ -->
        <Border x:Name="AmbientGlow"
                Grid.RowSpan="2"
                IsHitTestVisible="False"
                Opacity="0.35">
            <Border.Background>
                <RadialGradientBrush Center="0.05,0.02"
                                     RadiusX="0.5" RadiusY="0.6"
                                     MappingMode="RelativeToBoundingBox"
                                     SpreadMethod="Pad">
                    <GradientStop Color="{StaticResource RedGlow10}" Offset="0.0" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             SECONDARY GLOW (cool tone, bottom-right for balance)
             ═══════════════════════════════════════════════════════ -->
        <Border x:Name="SecondaryGlow"
                Grid.RowSpan="2"
                IsHitTestVisible="False"
                Opacity="0.15">
            <Border.Background>
                <RadialGradientBrush Center="0.95,0.95"
                                     RadiusX="0.5" RadiusY="0.5"
                                     MappingMode="RelativeToBoundingBox"
                                     SpreadMethod="Pad">
                    <GradientStop Color="#0A3B82F6" Offset="0.0" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             MAIN NAVIGATION SHELL
             ═══════════════════════════════════════════════════════ -->
        <NavigationView x:Name="NavView"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="260"
                        CompactPaneLength="48"
                        IsPaneOpen="True"
                        SelectionChanged="NavView_SelectionChanged"
                        Background="Transparent"
                        IsTabStop="False">

            <!-- ═══════════════════════════════════════════════════
                 PANE HEADER — App Logo & Title
                 ═══════════════════════════════════════════════════ -->
            <NavigationView.PaneHeader>
                <Grid Margin="12,16,12,8" Height="56">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="14">
                        <!-- Agent-X Logo Mark -->
                        <Grid Width="36" Height="36">
                            <Border CornerRadius="{StaticResource RadiusMD}"
                                    Background="{StaticResource AccentGradientBrush}">
                                <TextBlock Text="AX"
                                           FontFamily="{StaticResource FontDisplay}"
                                           FontSize="15"
                                           FontWeight="Black"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           CharacterSpacing="-30" />
                            </Border>
                        </Grid>

                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="Agent-X"
                                       Style="{StaticResource HeadingSmallStyle}"
                                       FontWeight="Bold"
                                       CharacterSpacing="-10" />
                            <TextBlock Text="INTELLIGENCE HUB"
                                       Style="{StaticResource OverlineStyle}"
                                       FontSize="9"
                                       Opacity="0.5"
                                       Margin="0,-1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <!-- ═══════════════════════════════════════════════════
                 NAVIGATION MENU ITEMS
                 ═══════════════════════════════════════════════════ -->
            <NavigationView.MenuItems>

                <!-- PRIMARY SECTION -->
                <NavigationViewItemHeader Content="INTELLIGENCE"
                                          Foreground="{StaticResource TextTertiaryBrush}"
                                          FontSize="10"
                                          FontWeight="SemiBold" />

                <NavigationViewItem x:Name="NavDashboard"
                                    Content="Dashboard"
                                    Tag="Dashboard"
                                    Style="{StaticResource AgentXNavItemStyle}"
                                    IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavDigest"
                                    Content="Weekly Digest"
                                    Tag="Digest"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavChat"
                                    Content="AI Chat"
                                    Tag="Chat"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavAskFiles"
                                    Content="Ask Your Files"
                                    Tag="AskFiles"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavQuickActions"
                                    Content="Quick Actions"
                                    Tag="QuickActions"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavWorkflows"
                                    Content="Workflows"
                                    Tag="Workflows"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C7;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator Margin="12,6" />

                <!-- KNOWLEDGE SECTION -->
                <NavigationViewItemHeader Content="KNOWLEDGE"
                                          Foreground="{StaticResource TextTertiaryBrush}"
                                          FontSize="10"
                                          FontWeight="SemiBold" />

                <NavigationViewItem x:Name="NavVault"
                                    Content="Knowledge Vault"
                                    Tag="KnowledgeVault"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavWebImport"
                                    Content="Web Import"
                                    Tag="WebImport"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavCollections"
                                    Content="Collections"
                                    Tag="Collections"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF168;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavSearch"
                                    Content="Semantic Search"
                                    Tag="Search"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE773;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavKnowledgeGraph"
                                    Content="Knowledge Graph"
                                    Tag="KnowledgeGraph"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavComparison"
                                    Content="Compare Documents"
                                    Tag="Comparison"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F4;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator Margin="12,6" />

                <!-- TRIAGE SECTION -->
                <NavigationViewItemHeader Content="TRIAGE"
                                          Foreground="{StaticResource TextTertiaryBrush}"
                                          FontSize="10"
                                          FontWeight="SemiBold" />

                <NavigationViewItem x:Name="NavInbox"
                                    Content="Smart Inbox"
                                    Tag="Inbox"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator Margin="12,6" />

                <!-- SYSTEM SECTION -->
                <NavigationViewItemHeader Content="SYSTEM"
                                          Foreground="{StaticResource TextTertiaryBrush}"
                                          FontSize="10"
                                          FontWeight="SemiBold" />

                <NavigationViewItem x:Name="NavModels"
                                    Content="Model Manager"
                                    Tag="ModelManager"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE964;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavHardware"
                                    Content="Hardware Advisor"
                                    Tag="HardwareAdvisor"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavBackupRestore"
                                    Content="Backup &amp; Restore"
                                    Tag="BackupRestore"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavWorkspaceProfiles"
                                    Content="Workspace Profiles"
                                    Tag="WorkspaceProfiles"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavPluginManager"
                                    Content="Plugin Manager"
                                    Tag="PluginManager"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA86;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavSyncSettings"
                                    Content="Collaborative Sync"
                                    Tag="SyncSettings"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavCalendarSettings"
                                    Content="Calendar"
                                    Tag="CalendarSettings"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator Margin="12,6" />

                <!-- ANNOTATIONS SECTION -->
                <NavigationViewItem x:Name="NavAnnotations"
                                    Content="Annotations"
                                    Tag="Annotations"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BC;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator Margin="12,6" />

                <!-- SUPPORT SECTION -->
                <NavigationViewItemHeader Content="SUPPORT"
                                          Foreground="{StaticResource TextTertiaryBrush}"
                                          FontSize="10"
                                          FontWeight="SemiBold" />

                <NavigationViewItem x:Name="NavUserGuide"
                                    Content="User Guide"
                                    Tag="UserGuide"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BE;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavPrivacyPolicy"
                                    Content="Privacy Policy"
                                    Tag="PrivacyPolicy"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavTermsOfService"
                                    Content="Terms of Service"
                                    Tag="TermsOfService"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <!-- ═══════════════════════════════════════════════════
                 FOOTER — Settings at bottom
                 ═══════════════════════════════════════════════════ -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavSettings"
                                    Content="Settings"
                                    Tag="Settings"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- ═══════════════════════════════════════════════════
                 CONTENT FRAME (Page host)
                 ═══════════════════════════════════════════════════ -->
            <Grid>
                <!-- Content gradient overlay (subtle depth at top) -->
                <Border IsHitTestVisible="False"
                        VerticalAlignment="Top"
                        Height="120"
                        Opacity="0.6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{StaticResource BackgroundSecondary}" Offset="0.0" />
                            <GradientStop Color="Transparent" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Main Content Frame -->
                <Frame x:Name="ContentFrame"
                       Margin="0"
                       Background="Transparent"
                       IsNavigationStackEnabled="False" />
            </Grid>

        </NavigationView>

        <!-- ═══════════════════════════════════════════════════════
             STATUS BAR (Bottom) — Connection status, model info
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Height="28"
                Background="{StaticResource PageBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Connection Status + Keyboard Shortcut Hint -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Ellipse x:Name="StatusIndicator"
                             Width="6" Height="6"
                             Fill="{StaticResource OfflineBrush}" />
                    <TextBlock x:Name="StatusText"
                               Text="Initializing..."
                               Style="{StaticResource CaptionStyle}"
                               VerticalAlignment="Center" />

                    <!-- Ctrl+K shortcut hint -->
                    <Border Background="{StaticResource InputBackgroundBrush}"
                            CornerRadius="3"
                            Padding="6,1"
                            Margin="12,0,0,0"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <TextBlock Text="Ctrl+K"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="10"
                                   Opacity="0.4" />
                    </Border>
                </StackPanel>

                <!-- Center: Indexing Status -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Margin="0,0,24,0">
                    <ProgressRing x:Name="IndexingRing"
                                  IsActive="False"
                                  Width="12" Height="12" />
                    <TextBlock x:Name="IndexingText"
                               Text=""
                               Style="{StaticResource CaptionStyle}"
                               VerticalAlignment="Center"
                               Opacity="0.6" />
                </StackPanel>

                <!-- Right: Document Count + Version -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="DocCountText"
                               Text=""
                               Style="{StaticResource CaptionStyle}"
                               VerticalAlignment="Center"
                               Opacity="0.4" />
                    <TextBlock Text="Agent-X v1.2.0"
                               Style="{StaticResource CaptionStyle}"
                               VerticalAlignment="Center"
                               Opacity="0.5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             TOAST NOTIFICATION OVERLAY (#21)
             Renders above all content in top-right corner.
             ═══════════════════════════════════════════════════════ -->
        <controls:NotificationOverlay Grid.RowSpan="2"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="0,48,0,0" />

        <!-- ═══════════════════════════════════════════════════════
             COMMAND PALETTE OVERLAY
             Floating command palette (Ctrl+K). Renders above all content.
             ═══════════════════════════════════════════════════════ -->
        <controls:CommandPalette x:Name="CommandPalette"
                                  Grid.RowSpan="2"
                                  Visibility="Collapsed" />

        <!-- ═══════════════════════════════════════════════════════
             SYSTEM TRAY ICON (H.NotifyIcon)
             Manages minimize-to-tray, context menu, and tray interactions.
             ═══════════════════════════════════════════════════════ -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            Grid.RowSpan="2"
            ToolTipText="Agent-X — Intelligence Hub"
            MenuActivation="RightClick"
            ContextMenuMode="SecondWindow">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="AX" Foreground="White" FontSize="28" FontWeight="Bold" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open Agent-X" Click="TrayMenu_OpenAgentX">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Quick Chat" Click="TrayMenu_QuickChat">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8BD;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Settings" Click="TrayMenu_Settings">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Click="TrayMenu_Exit">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8BB;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
