<Window
    x:Class="AgentX.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentX.App"
    xmlns:controls="using:AgentX.App.Controls"
    Title="Agent-X">

    <Grid x:Name="RootGrid" Background="{StaticResource WindowBackgroundBrush}">

        <!-- ═══════════════════════════════════════════════════════
             AMBIENT GLOW LAYER (subtle red radial glow, top-left)
             Creates premium depth perception on the dark canvas.
             ═══════════════════════════════════════════════════════ -->
        <Border x:Name="AmbientGlow"
                IsHitTestVisible="False"
                Opacity="0.35">
            <Border.Background>
                <RadialGradientBrush Center="0.05,0.02"
                                     RadiusX="0.5" RadiusY="0.6"
                                     MappingMode="RelativeToBoundingBox"
                                     SpreadMethod="Pad">
                    <GradientStop Color="{StaticResource RedGlow10}" Offset="0.0" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             SECONDARY GLOW (cool tone, bottom-right for balance)
             ═══════════════════════════════════════════════════════ -->
        <Border x:Name="SecondaryGlow"
                IsHitTestVisible="False"
                Opacity="0.15">
            <Border.Background>
                <RadialGradientBrush Center="0.95,0.95"
                                     RadiusX="0.5" RadiusY="0.5"
                                     MappingMode="RelativeToBoundingBox"
                                     SpreadMethod="Pad">
                    <GradientStop Color="#0A3B82F6" Offset="0.0" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             MAIN NAVIGATION SHELL
             ═══════════════════════════════════════════════════════ -->
        <NavigationView x:Name="NavView"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="260"
                        CompactPaneLength="48"
                        IsPaneOpen="True"
                        SelectionChanged="NavView_SelectionChanged"
                        Background="Transparent"
                        IsTabStop="False">

            <!-- ═══════════════════════════════════════════════════
                 PANE HEADER — App Logo & Title
                 ═══════════════════════════════════════════════════ -->
            <NavigationView.PaneHeader>
                <Grid Margin="12,16,12,8" Height="56">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="14">
                        <!-- Agent-X Logo Mark -->
                        <Grid Width="36" Height="36">
                            <Border CornerRadius="{StaticResource RadiusMD}"
                                    Background="{StaticResource AccentGradientBrush}">
                                <TextBlock Text="AX"
                                           FontFamily="{StaticResource FontDisplay}"
                                           FontSize="15"
                                           FontWeight="Black"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           CharacterSpacing="-30" />
                            </Border>
                        </Grid>

                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="Agent-X"
                                       Style="{StaticResource HeadingSmallStyle}"
                                       FontWeight="Bold"
                                       CharacterSpacing="-10" />
                            <TextBlock Text="INTELLIGENCE HUB"
                                       Style="{StaticResource OverlineStyle}"
                                       FontSize="9"
                                       Opacity="0.5"
                                       Margin="0,-1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <!-- ═══════════════════════════════════════════════════
                 NAVIGATION MENU ITEMS
                 ═══════════════════════════════════════════════════ -->
            <NavigationView.MenuItems>

                <!-- PRIMARY SECTION -->
                <NavigationViewItemHeader Content="INTELLIGENCE"
                                          Foreground="{StaticResource TextTertiaryBrush}"
                                          FontSize="10"
                                          FontWeight="SemiBold" />

                <NavigationViewItem x:Name="NavDashboard"
                                    Content="Dashboard"
                                    Tag="Dashboard"
                                    Style="{StaticResource AgentXNavItemStyle}"
                                    IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavChat"
                                    Content="AI Chat"
                                    Tag="Chat"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavAskFiles"
                                    Content="Ask Your Files"
                                    Tag="AskFiles"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavQuickActions"
                                    Content="Quick Actions"
                                    Tag="QuickActions"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator Margin="12,6" />

                <!-- KNOWLEDGE SECTION -->
                <NavigationViewItemHeader Content="KNOWLEDGE"
                                          Foreground="{StaticResource TextTertiaryBrush}"
                                          FontSize="10"
                                          FontWeight="SemiBold" />

                <NavigationViewItem x:Name="NavVault"
                                    Content="Knowledge Vault"
                                    Tag="KnowledgeVault"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavCollections"
                                    Content="Collections"
                                    Tag="Collections"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF168;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavSearch"
                                    Content="Semantic Search"
                                    Tag="Search"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE773;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator Margin="12,6" />

                <!-- SYSTEM SECTION -->
                <NavigationViewItemHeader Content="SYSTEM"
                                          Foreground="{StaticResource TextTertiaryBrush}"
                                          FontSize="10"
                                          FontWeight="SemiBold" />

                <NavigationViewItem x:Name="NavModels"
                                    Content="Model Manager"
                                    Tag="ModelManager"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE964;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavHardware"
                                    Content="Hardware Advisor"
                                    Tag="HardwareAdvisor"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <!-- ═══════════════════════════════════════════════════
                 FOOTER — Settings at bottom
                 ═══════════════════════════════════════════════════ -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavSettings"
                                    Content="Settings"
                                    Tag="Settings"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- ═══════════════════════════════════════════════════
                 CONTENT FRAME (Page host)
                 ═══════════════════════════════════════════════════ -->
            <Grid>
                <!-- Content gradient overlay (subtle depth at top) -->
                <Border IsHitTestVisible="False"
                        VerticalAlignment="Top"
                        Height="120"
                        Opacity="0.6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{StaticResource BackgroundSecondary}" Offset="0.0" />
                            <GradientStop Color="Transparent" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Main Content Frame -->
                <Frame x:Name="ContentFrame"
                       Margin="0"
                       Background="Transparent"
                       IsNavigationStackEnabled="False" />
            </Grid>

        </NavigationView>

        <!-- ═══════════════════════════════════════════════════════
             STATUS BAR (Bottom) — Connection status, model info
             ═══════════════════════════════════════════════════════ -->
        <Border VerticalAlignment="Bottom"
                Height="28"
                Background="{StaticResource PageBackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Connection Status + Keyboard Shortcut Hint -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Ellipse x:Name="StatusIndicator"
                             Width="6" Height="6"
                             Fill="{StaticResource OfflineBrush}" />
                    <TextBlock x:Name="StatusText"
                               Text="Initializing..."
                               Style="{StaticResource CaptionStyle}"
                               VerticalAlignment="Center" />

                    <!-- Ctrl+K shortcut hint -->
                    <Border Background="{StaticResource InputBackgroundBrush}"
                            CornerRadius="3"
                            Padding="6,1"
                            Margin="12,0,0,0"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <TextBlock Text="Ctrl+K"
                                   Style="{StaticResource CaptionStyle}"
                                   FontSize="10"
                                   Opacity="0.4" />
                    </Border>
                </StackPanel>

                <!-- Center: Indexing Status -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Margin="0,0,24,0">
                    <ProgressRing x:Name="IndexingRing"
                                  IsActive="False"
                                  Width="12" Height="12" />
                    <TextBlock x:Name="IndexingText"
                               Text=""
                               Style="{StaticResource CaptionStyle}"
                               VerticalAlignment="Center"
                               Opacity="0.6" />
                </StackPanel>

                <!-- Right: Document Count + Version -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="DocCountText"
                               Text=""
                               Style="{StaticResource CaptionStyle}"
                               VerticalAlignment="Center"
                               Opacity="0.4" />
                    <TextBlock Text="Agent-X v1.0.0"
                               Style="{StaticResource CaptionStyle}"
                               VerticalAlignment="Center"
                               Opacity="0.5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             COMMAND PALETTE OVERLAY
             Floating command palette (Ctrl+K). Renders above all content.
             ═══════════════════════════════════════════════════════ -->
        <controls:CommandPalette x:Name="CommandPalette"
                                  Visibility="Collapsed" />
    </Grid>
</Window>
