<Window
    x:Class="AgentX.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgentX.App"
    xmlns:controls="using:AgentX.App.Controls"
    xmlns:tb="using:H.NotifyIcon"
    Title="Agent-X">

    <Grid x:Name="RootGrid" Background="{ThemeResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Caption strip: reserves the title-bar region so page content
                 (e.g. right-panel headers on Ask Your Files / Search) never
                 renders under the system min/max/close caption buttons. -->
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Removed: AmbientGlow + SecondaryGlow radial gradient decorations.
             The off-palette blue glow (#3B82F6) and the red radial glow
             were AI-slop ambient lighting. Depth now comes from the layered
             solid surfaces (Surface0..4) and confident typography, not from
             gradients painted onto the canvas. -->

        <!-- ═══════════════════════════════════════════════════════
             MAIN NAVIGATION SHELL
             Spans the caption row (0) and the content row (1) so the left
             pane / logo still reaches the top edge. The content host inside
             reserves the caption strip via a top margin (see below).
             ═══════════════════════════════════════════════════════ -->
        <NavigationView x:Name="NavView"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="260"
                        CompactPaneLength="48"
                        IsPaneOpen="True"
                        Background="Transparent"
                        IsTabStop="False">

            <!-- ═══════════════════════════════════════════════════
                 PANE HEADER — App Logo & Title
                 ═══════════════════════════════════════════════════ -->
            <NavigationView.PaneHeader>
                <Grid Margin="12,16,12,8" Height="56">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="14">
                        <!-- Agent-X Logo Mark: armed machined cap -->
                        <Grid Width="36" Height="36">
                            <Border CornerRadius="{StaticResource RControl}"
                                    Background="{ThemeResource ArmedCapBrush}"
                                    BorderBrush="{ThemeResource ArmedCapBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="AX"
                                           FontFamily="{StaticResource FontDisplayHeavy}"
                                           FontSize="14"
                                           FontWeight="ExtraBold"
                                           Foreground="{ThemeResource ArmedCapTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="Agent-X"
                                       Style="{StaticResource HeadingSmallStyle}"
                                       FontWeight="Bold"
                                       CharacterSpacing="-10" />
                            <TextBlock Text="INTELLIGENCE HUB"
                                       Style="{StaticResource OverlineStyle}"
                                       FontSize="9"
                                       Opacity="0.5"
                                       Margin="0,-1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <!-- ═══════════════════════════════════════════════════
                 NAVIGATION MENU ITEMS
                 ═══════════════════════════════════════════════════ -->
            <NavigationView.MenuItems>

                <!-- PRIMARY SECTION -->
                <NavigationViewItemHeader x:Uid="Main_Intelligence" Content="INTELLIGENCE"
                                          Style="{StaticResource NavHeaderStyle}" />

                <NavigationViewItem x:Name="NavDashboard"
                                    x:Uid="Main_Dashboard" Content="Dashboard"
                                    Tag="Dashboard"
                                    Style="{StaticResource AgentXNavItemStyle}"
                                    IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavOperations"
                                    x:Uid="Main_Operations" Content="Operations"
                                    Tag="Operations"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BA;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavDigest"
                                    x:Uid="Main_WeeklyDigest" Content="Weekly Digest"
                                    Tag="Digest"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavAnalytics"
                                    x:Uid="Main_Analytics" Content="Analytics"
                                    Tag="Analytics"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavPastSelf"
                                    x:Uid="Main_PastSelf" Content="Past Self"
                                    Tag="PastSelf"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE917;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavChat"
                                    x:Uid="Main_AiChat" Content="AI Chat"
                                    Tag="Chat"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavAskFiles"
                                    x:Uid="Main_AskYourFiles" Content="Ask Your Files"
                                    Tag="AskFiles"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavQuickActions"
                                    x:Uid="Main_QuickActions" Content="Quick Actions"
                                    Tag="QuickActions"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavWorkflows"
                                    x:Uid="Main_Workflows" Content="Workflows"
                                    Tag="Workflows"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C7;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator Margin="12,6" />

                <!-- KNOWLEDGE SECTION -->
                <NavigationViewItemHeader x:Uid="Main_Knowledge" Content="KNOWLEDGE"
                                          Style="{StaticResource NavHeaderStyle}" />

                <NavigationViewItem x:Name="NavVault"
                                    x:Uid="Main_KnowledgeVault" Content="Knowledge Vault"
                                    Tag="KnowledgeVault"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavWebImport"
                                    x:Uid="Main_WebImport" Content="Web Import"
                                    Tag="WebImport"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavCollections"
                                    x:Uid="Main_Collections" Content="Collections"
                                    Tag="Collections"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF168;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavSearch"
                                    x:Uid="Main_SemanticSearch" Content="Semantic Search"
                                    Tag="Search"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE773;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavKnowledgeGraph"
                                    x:Uid="Main_KnowledgeGraph" Content="Knowledge Graph"
                                    Tag="KnowledgeGraph"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavComparison"
                                    x:Uid="Main_CompareDocuments" Content="Compare Documents"
                                    Tag="Comparison"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F4;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator Margin="12,6" />

                <!-- TRIAGE SECTION -->
                <NavigationViewItemHeader x:Uid="Main_Triage" Content="TRIAGE"
                                          Style="{StaticResource NavHeaderStyle}" />

                <NavigationViewItem x:Name="NavInbox"
                                    x:Uid="Main_SmartInbox" Content="Smart Inbox"
                                    Tag="Inbox"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator Margin="12,6" />

                <!-- SYSTEM SECTION -->
                <NavigationViewItemHeader x:Uid="Main_System" Content="SYSTEM"
                                          Style="{StaticResource NavHeaderStyle}" />

                <NavigationViewItem x:Name="NavModels"
                                    x:Uid="Main_ModelManager" Content="Model Manager"
                                    Tag="ModelManager"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE964;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavHardware"
                                    x:Uid="Main_HardwareAdvisor" Content="Hardware Advisor"
                                    Tag="HardwareAdvisor"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavBackupRestore"
                                    x:Uid="Main_BackupRestore" Content="Backup &amp; Restore"
                                    Tag="BackupRestore"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavWorkspaceProfiles"
                                    x:Uid="Main_WorkspaceProfiles" Content="Workspace Profiles"
                                    Tag="WorkspaceProfiles"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavPluginManager"
                                    x:Uid="Main_PluginManager" Content="Plugin Manager"
                                    Tag="PluginManager"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA86;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavSyncSettings"
                                    x:Uid="Main_CollaborativeSync" Content="Collaborative Sync"
                                    Tag="SyncSettings"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavCalendarSettings"
                                    x:Uid="Main_Calendar" Content="Calendar"
                                    Tag="CalendarSettings"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavEmailSettings"
                                    x:Uid="Main_Email" Content="Email"
                                    Tag="EmailSettings"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE715;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator Margin="12,6" />

                <!-- ANNOTATIONS SECTION -->
                <NavigationViewItem x:Name="NavAnnotations"
                                    x:Uid="Main_Annotations" Content="Annotations"
                                    Tag="Annotations"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BC;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator Margin="12,6" />

                <!-- SUPPORT SECTION -->
                <NavigationViewItemHeader x:Uid="Main_Support" Content="SUPPORT"
                                          Style="{StaticResource NavHeaderStyle}" />

                <NavigationViewItem x:Name="NavUserGuide"
                                    x:Uid="Main_UserGuide" Content="User Guide"
                                    Tag="UserGuide"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BE;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavPrivacyPolicy"
                                    x:Uid="Main_PrivacyPolicy" Content="Privacy Policy"
                                    Tag="PrivacyPolicy"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavTermsOfService"
                                    x:Uid="Main_TermsOfService" Content="Terms of Service"
                                    Tag="TermsOfService"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <!-- ═══════════════════════════════════════════════════
                 FOOTER — Settings at bottom
                 ═══════════════════════════════════════════════════ -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavSettings"
                                    x:Uid="Main_Settings" Content="Settings"
                                    Tag="Settings"
                                    Style="{StaticResource AgentXNavItemStyle}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- ═══════════════════════════════════════════════════
                 CONTENT FRAME (Page host)
                 Top margin reserves the 32px caption strip so page
                 right-panel headers don't collide with the caption buttons.
                 ClipToBounds (wired in code-behind) prevents a cached page
                 (NavigationCacheMode="Enabled") from painting below the row
                 boundary and bleeding under the status bar during transitions.
                 ═══════════════════════════════════════════════════ -->
            <Grid x:Name="ContentHost"
                  Margin="0,32,0,0"
                  SizeChanged="ContentHost_SizeChanged">
                <!-- Removed: top-edge gradient overlay. Page chrome reads
                     cleanly on flat BackgroundPrimary; no fade needed. -->

                <!-- Main Content Frame -->
                <Frame x:Name="ContentFrame"
                       Margin="0"
                       Background="Transparent"
                       IsNavigationStackEnabled="False" />
            </Grid>

        </NavigationView>

        <!-- ═══════════════════════════════════════════════════════
             TITLE-BAR DRAG REGION
             Transparent strip in the caption row, offset past the nav pane so
             pane interaction is preserved. Registered via SetTitleBar() in
             code-behind to give the window a proper draggable caption and to
             reserve the min/max/close region. Sits above the content host.
             ═══════════════════════════════════════════════════════ -->
        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Margin="260,0,0,0"
                Background="Transparent" />

        <!-- ═══════════════════════════════════════════════════════
             INSTRUMENT STRIP (Bottom) - DESIGN.md signature element.
             A dark strip in BOTH shifts (displays-stay-dark) carrying
             recessed LCD readouts and the annunciator lamps. Every
             value is real: StatusBarService + IPrivacyStatusService.
             Stencil codes (MDL/IDX/VAULT/LOCAL) are equipment
             vocabulary and are intentionally not localized.
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Height="32"
                Background="{ThemeResource WellBrush}"
                BorderBrush="{ThemeResource HairlineBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: MDL lamp + model LCD + Ctrl+K hint -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <controls:LampTile x:Name="MdlLamp"
                                       Code="MDL"
                                       State="Hold"
                                       IsCompact="True"
                                       VerticalAlignment="Center" />
                    <Border Background="{ThemeResource VoidBrush}"
                            BorderBrush="{ThemeResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusXS}"
                            Height="20"
                            Padding="8,0"
                            VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <Grid x:Name="MdlGlowHost" IsHitTestVisible="False" />
                            <TextBlock x:Name="StatusText"
                                       x:Uid="Main_Initializing" Text="Initializing..."
                                       Style="{StaticResource LcdStyle}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Ctrl+K shortcut hint (kbd well) -->
                    <Border Background="{ThemeResource VoidBrush}"
                            CornerRadius="{StaticResource RadiusXS}"
                            Padding="6,1"
                            Margin="8,0,0,0"
                            Height="20"
                            VerticalAlignment="Center"
                            BorderBrush="{ThemeResource HairlineBrush}"
                            BorderThickness="1">
                        <TextBlock Text="Ctrl+K"
                                   Style="{StaticResource TelemetrySmallStyle}"
                                   Foreground="{ThemeResource WellTextBrush}"
                                   Opacity="0.45"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Center: IDX (embedding queue) readout -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Margin="0,0,24,0">
                    <TextBlock Text="IDX"
                               Style="{StaticResource PlacardStyle}"
                               FontSize="9"
                               Foreground="{ThemeResource TextDisabledBrush}"
                               VerticalAlignment="Center" />
                    <Border Background="{ThemeResource VoidBrush}"
                            BorderBrush="{ThemeResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusXS}"
                            Height="20"
                            MinWidth="42"
                            Padding="8,0"
                            VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid x:Name="IdxGlowHost" IsHitTestVisible="False" />
                            <TextBlock x:Name="IndexingText"
                                       Text="0"
                                       Style="{StaticResource LcdStyle}"
                                       FontSize="11"
                                       Opacity="0.35"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Right: VAULT readout + annunciator cluster + version -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="VAULT"
                               Style="{StaticResource PlacardStyle}"
                               FontSize="9"
                               Foreground="{ThemeResource TextDisabledBrush}"
                               VerticalAlignment="Center" />
                    <Border Background="{ThemeResource VoidBrush}"
                            BorderBrush="{ThemeResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusXS}"
                            Height="20"
                            MinWidth="42"
                            Padding="8,0"
                            VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid x:Name="VaultGlowHost" IsHitTestVisible="False" />
                            <TextBlock x:Name="DocCountText"
                                       Text="0"
                                       Style="{StaticResource LcdStyle}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Annunciator cluster (typed sources via
                         IAnnunciatorService; lit lamps teleport) -->
                    <controls:LampTile x:Name="InboxLamp"
                                       Code="INBOX"
                                       State="Off"
                                       IsCompact="True"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center" />
                    <controls:LampTile x:Name="SyncLamp"
                                       Code="SYNC"
                                       State="Off"
                                       IsCompact="True"
                                       VerticalAlignment="Center" />
                    <controls:LampTile x:Name="JobsLamp"
                                       Code="JOBS"
                                       State="Off"
                                       IsCompact="True"
                                       VerticalAlignment="Center" />
                    <controls:LampTile x:Name="BakLamp"
                                       Code="BAK"
                                       State="Off"
                                       IsCompact="True"
                                       VerticalAlignment="Center" />
                    <controls:LampTile x:Name="LocalLamp"
                                       Code="LOCAL"
                                       State="Off"
                                       IsCompact="True"
                                       VerticalAlignment="Center" />

                    <!-- Text set in code-behind from AppVersionInfo (single source) so it
                         never drifts from the shipped build (AX-QA-014). -->
                    <TextBlock x:Name="AppVersionText"
                               Text="Agent-X"
                               Style="{StaticResource TelemetrySmallStyle}"
                               Foreground="{ThemeResource WellTextBrush}"
                               Opacity="0.45"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             TOAST NOTIFICATION OVERLAY (#21)
             Renders above all content in top-right corner.
             ═══════════════════════════════════════════════════════ -->
        <controls:NotificationOverlay Grid.RowSpan="3"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="0,48,0,0" />

        <!-- ═══════════════════════════════════════════════════════
             COMMAND PALETTE OVERLAY
             Floating command palette (Ctrl+K). Renders above all content.
             ═══════════════════════════════════════════════════════ -->
        <controls:CommandPalette x:Name="CommandPalette"
                                  Grid.RowSpan="3"
                                  Visibility="Collapsed" />

        <!-- ═══════════════════════════════════════════════════════
             SYSTEM TRAY ICON (H.NotifyIcon)
             Manages minimize-to-tray, context menu, and tray interactions.
             ═══════════════════════════════════════════════════════ -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            Grid.RowSpan="3"
            ToolTipText="Agent-X — Intelligence Hub"
            MenuActivation="RightClick"
            ContextMenuMode="SecondWindow">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="AX" Foreground="White" FontSize="28" FontWeight="Bold" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="Main_OpenAgentX" Text="Open Agent-X" Click="TrayMenu_OpenAgentX">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="Main_QuickChat" Text="Quick Chat" Click="TrayMenu_QuickChat">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8BD;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="Main_Settings2" Text="Settings" Click="TrayMenu_Settings">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="Main_Exit" Text="Exit" Click="TrayMenu_Exit">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8BB;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
