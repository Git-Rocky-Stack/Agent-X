<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>AgentX.Core</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentX.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- AI Providers -->
    <PackageReference Include="HnswLite.RamStorage" Version="1.0.6" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="9.0.0-preview.9.24525.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.59.0" />
    <PackageReference Include="OllamaSharp" Version="4.0.6" />

    <!-- Built-in Local LLM (LLamaSharp — .NET bindings for llama.cpp) -->
    <PackageReference Include="LLamaSharp" Version="0.19.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.19.0" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.19.0" />

    <!-- Data & Persistence -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.7" />

    <!-- Document Processing -->
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="QuestPDF" Version="2024.12.2" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.67" />

    <!-- System -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.6" />

    <!-- Audio Transcription (Whisper local speech-to-text) -->
    <PackageReference Include="Whisper.Net" Version="1.5.0" />
    <PackageReference Include="Whisper.Net.Runtime" Version="1.5.0" />

    <!-- Vector Search (HNSW approximate nearest neighbor index) -->
    <PackageReference Include="HnswLite" Version="1.0.6" />

    <!-- Utilities -->
    <PackageReference Include="Serilog" Version="4.0.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />

    <!--
      Analyzers — surface threading gaps (missing ConfigureAwait, sync-over-async,
      etc.) at build time rather than via runtime UI-thread deadlocks. Warnings only;
      a follow-up should sweep existing offenders and consider TreatWarningsAsErrors.
    -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.10.48">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    ──────────────────────────────────────────────────────────────────────────
    EF Core design-time tooling support (`dotnet ef`)
    ──────────────────────────────────────────────────────────────────────────
    `dotnet ef` loads this assembly through the shared-framework host, which
    resolves Microsoft.Windows.SDK.NET.dll (the WinRT projection) from a Windows
    SDK *runtime pack*. A framework-dependent class-library build does not lay
    that pack down — it is normally supplied by the self-contained WinUI app at
    publish time — so the host aborts with:
      "An assembly specified in the application dependencies manifest
       (AgentX.Core.deps.json) was not found:
       package: 'runtimepack.Microsoft.Windows.SDK.NET.Ref' ... Microsoft.Windows.SDK.NET.dll"

    Fix: copy the already-resolved projection assembly into this project's build
    output so the EF host can load it from the app base directory. This touches
    build OUTPUT only — the shipping app is WindowsAppSDKSelfContained and is
    unaffected, and duplicate-at-publish is tolerated via
    ErrorOnDuplicatePublishOutputFiles=false (Directory.Build.props). The target
    is a no-op when the projection is unavailable, so non-EF builds never break.
  -->
  <Target Name="CopyWindowsSdkProjectionForEfTooling"
          AfterTargets="ResolveReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <!--
      The projection runtime pack contributes two sibling assemblies
      (Microsoft.Windows.SDK.NET.dll + WinRT.Runtime.dll) from the same folder.
      Derive that folder from the already-resolved reference and copy every DLL
      in it, so the set stays correct version-agnostically and survives the pack
      adding future siblings.
    -->
    <PropertyGroup>
      <_WinSdkProjectionDir>@(ReferencePath->WithMetadataValue('FileName','Microsoft.Windows.SDK.NET')->'%(RootDir)%(Directory)')</_WinSdkProjectionDir>
    </PropertyGroup>
    <ItemGroup>
      <_WinSdkProjectionFiles Include="$(_WinSdkProjectionDir)*.dll"
                              Condition="'$(_WinSdkProjectionDir)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinSdkProjectionFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_WinSdkProjectionFiles)' != ''" />
  </Target>
</Project>
