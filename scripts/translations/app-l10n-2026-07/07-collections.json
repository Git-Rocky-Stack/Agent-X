    { "uid": "CollMgr_RemoveFromCollectionTip", "attr": "ToolTipService.ToolTip", "en": "Remove from collection",
      "t": { "de": "Aus Sammlung entfernen", "es": "Quitar de la colección", "fr": "Retirer de la collection", "ja": "コレクションから削除", "zh-CN": "从合集中移除" } },
    { "uid": "CollMgr_RemoveFromCollectionTip", "attr": "AutomationProperties.Name", "en": "Remove from collection", "skipUid": true,
