    { "uid": "Dash_Subtitle", "attr": "Text", "en": "Your private AI intelligence center. Everything runs on your machine.",
      "t": { "de": "Ihre private KI-Intelligenzzentrale. Alles läuft auf Ihrem Rechner.", "es": "Su centro privado de inteligencia de IA. Todo se ejecuta en su equipo.", "fr": "Votre centre privé d'intelligence IA. Tout s'exécute sur votre machine.", "ja": "あなた専用のプライベート AI インテリジェンス センター。すべてお使いのマシン上で動作します。", "zh-CN": "您的私人 AI 智能中心。一切都在您的电脑上运行。" } },
