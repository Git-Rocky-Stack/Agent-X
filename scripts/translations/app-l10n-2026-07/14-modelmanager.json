{
  "file": "src/AgentX.App/Views/ModelManagerPage.xaml",
  "entries": [
    { "uid": "ModelMgr_ManageYourLocalAi", "attr": "Text", "en": "Manage your local AI models powered by Ollama.",
      "t": { "de": "Verwalten Sie Ihre lokalen KI-Modelle auf Basis von Ollama.", "es": "Gestione sus modelos de IA locales impulsados por Ollama.", "fr": "Gérez vos modèles d'IA locaux propulsés par Ollama.", "ja": "Ollama を利用してローカル AI モデルを管理します。", "zh-CN": "管理由 Ollama 驱动的本地 AI 模型。" } },
    { "uid": "ModelMgr_Refresh", "attr": "Content", "en": "Refresh",
