{
  "file": "src/AgentX.App/Views/SearchPage.xaml",
  "entries": [
    { "uid": "Search_Title", "attr": "Text", "en": "Search",
      "t": { "de": "Suche", "es": "Búsqueda", "fr": "Recherche", "ja": "検索", "zh-CN": "搜索" } },
    { "uid": "Search_Subtitle", "attr": "Text", "en": "Search across your entire document library using semantic AI, keywords, or both.",
      "t": { "de": "Durchsuchen Sie Ihre gesamte Dokumentbibliothek mit semantischer KI, Stichwörtern oder beidem.", "es": "Busque en toda su biblioteca de documentos con IA semántica, palabras clave o ambas.", "fr": "Recherchez dans toute votre bibliothèque de documents avec l'IA sémantique, des mots-clés ou les deux.", "ja": "セマンティック AI、キーワード、またはその両方でドキュメント ライブラリ全体を検索します。", "zh-CN": "使用语义 AI、关键词或两者结合搜索整个文档库。" } },
    { "uid": "Search_InputBox", "attr": "PlaceholderText", "en": "Search your documents...",
      "t": { "de": "Dokumente durchsuchen...", "es": "Buscar en sus documentos...", "fr": "Rechercher dans vos documents...", "ja": "ドキュメントを検索...", "zh-CN": "搜索您的文档..." } },
    { "uid": "Search_SearchBtn", "attr": "ToolTipService.ToolTip", "en": "Search (Enter)",
      "t": { "de": "Suchen (Enter)", "es": "Buscar (Enter)", "fr": "Rechercher (Entrée)", "ja": "検索 (Enter)", "zh-CN": "搜索 (Enter)" } },
    { "uid": "Search_SearchLabel", "attr": "Text", "en": "Search",
      "t": { "de": "Suchen", "es": "Buscar", "fr": "Rechercher", "ja": "検索", "zh-CN": "搜索" } },
    { "uid": "Search_ClearBtn", "attr": "ToolTipService.ToolTip", "en": "Clear search",
      "t": { "de": "Suche leeren", "es": "Borrar búsqueda", "fr": "Effacer la recherche", "ja": "検索をクリア", "zh-CN": "清空搜索" } },
    { "uid": "Search_ClearBtn", "attr": "AutomationProperties.Name", "en": "Clear search", "skipUid": true,
      "t": { "de": "Suche leeren", "es": "Borrar búsqueda", "fr": "Effacer la recherche", "ja": "検索をクリア", "zh-CN": "清空搜索" } },
    { "uid": "Search_SearchModeOverline", "attr": "Text", "en": "SEARCH MODE",
      "t": { "de": "SUCHMODUS", "es": "MODO DE BÚSQUEDA", "fr": "MODE DE RECHERCHE", "ja": "検索モード", "zh-CN": "搜索模式" } },
    { "uid": "Search_ModeSemantic", "attr": "Content", "en": "Semantic",
      "t": { "de": "Semantisch", "es": "Semántica", "fr": "Sémantique", "ja": "セマンティック", "zh-CN": "语义" } },
    { "uid": "Search_ModeSemantic", "attr": "ToolTipService.ToolTip", "en": "Vector similarity search using AI embeddings", "skipUid": true,
      "t": { "de": "Vektor-Ähnlichkeitssuche mit KI-Embeddings", "es": "Búsqueda por similitud vectorial con embeddings de IA", "fr": "Recherche par similarité vectorielle avec des embeddings d'IA", "ja": "AI 埋め込みによるベクトル類似検索", "zh-CN": "基于 AI 嵌入的向量相似度搜索" } },
    { "uid": "Search_ModeKeyword", "attr": "Content", "en": "Keyword",
      "t": { "de": "Stichwort", "es": "Palabra clave", "fr": "Mot-clé", "ja": "キーワード", "zh-CN": "关键词" } },
    { "uid": "Search_ModeKeyword", "attr": "ToolTipService.ToolTip", "en": "Full-text keyword search with BM25 ranking", "skipUid": true,
      "t": { "de": "Volltext-Stichwortsuche mit BM25-Ranking", "es": "Búsqueda de texto completo con clasificación BM25", "fr": "Recherche plein texte par mots-clés avec classement BM25", "ja": "BM25 ランキングによる全文キーワード検索", "zh-CN": "基于 BM25 排序的全文关键词搜索" } },
    { "uid": "Search_ModeHybrid", "attr": "Content", "en": "Hybrid",
      "t": { "de": "Hybrid", "es": "Híbrida", "fr": "Hybride", "ja": "ハイブリッド", "zh-CN": "混合" } },
    { "uid": "Search_ModeHybrid", "attr": "ToolTipService.ToolTip", "en": "Combined semantic + keyword search for best results", "skipUid": true,
      "t": { "de": "Kombinierte semantische + Stichwortsuche für beste Ergebnisse", "es": "Búsqueda semántica + por palabras clave combinada para mejores resultados", "fr": "Recherche sémantique + mots-clés combinée pour de meilleurs résultats", "ja": "セマンティック検索とキーワード検索を組み合わせて最良の結果を取得", "zh-CN": "语义 + 关键词组合搜索,获得最佳结果" } },
    { "uid": "Search_CollectionOverline", "attr": "Text", "en": "COLLECTION",
      "t": { "de": "SAMMLUNG", "es": "COLECCIÓN", "fr": "COLLECTION", "ja": "コレクション", "zh-CN": "合集" } },
    { "uid": "Search_AdvancedBtn", "attr": "ToolTipService.ToolTip", "en": "Toggle advanced search filters",
      "t": { "de": "Erweiterte Suchfilter ein-/ausblenden", "es": "Mostrar u ocultar filtros avanzados", "fr": "Afficher/masquer les filtres de recherche avancés", "ja": "詳細検索フィルターの表示切り替え", "zh-CN": "切换高级搜索筛选器" } },
    { "uid": "Search_AdvancedLabel", "attr": "Text", "en": "Advanced",
      "t": { "de": "Erweitert", "es": "Avanzado", "fr": "Avancé", "ja": "詳細", "zh-CN": "高级" } },
    { "uid": "Search_FileTypeOverline", "attr": "Text", "en": "FILE TYPE",
      "t": { "de": "DATEITYP", "es": "TIPO DE ARCHIVO", "fr": "TYPE DE FICHIER", "ja": "ファイルの種類", "zh-CN": "文件类型" } },
    { "uid": "Search_FilterAllTypes", "attr": "Content", "en": "All Types",
      "t": { "de": "Alle Typen", "es": "Todos los tipos", "fr": "Tous les types", "ja": "すべての種類", "zh-CN": "全部类型" } },
    { "uid": "Search_FilterText", "attr": "Text", "en": "Text",
      "t": { "de": "Text", "es": "Texto", "fr": "Texte", "ja": "テキスト", "zh-CN": "文本" } },
    { "uid": "Search_FilterCode", "attr": "Text", "en": "Code",
      "t": { "de": "Code", "es": "Código", "fr": "Code", "ja": "コード", "zh-CN": "代码" } },
    { "uid": "Search_FilterCalendar", "attr": "Text", "en": "Calendar",
      "t": { "de": "Kalender", "es": "Calendario", "fr": "Calendrier", "ja": "カレンダー", "zh-CN": "日历" } },
    { "uid": "Search_FilterEmail", "attr": "Text", "en": "Email",
      "t": { "de": "E-Mail", "es": "Correo", "fr": "E-mail", "ja": "メール", "zh-CN": "邮件" } },
    { "uid": "Search_MinRelevanceOverline", "attr": "Text", "en": "MIN RELEVANCE",
      "t": { "de": "MIN. RELEVANZ", "es": "RELEVANCIA MÍN.", "fr": "PERTINENCE MIN.", "ja": "最小関連度", "zh-CN": "最低相关性" } },
    { "uid": "Search_MaxResultsOverline", "attr": "Text", "en": "MAX RESULTS",
      "t": { "de": "MAX. ERGEBNISSE", "es": "RESULTADOS MÁX.", "fr": "RÉSULTATS MAX.", "ja": "最大結果数", "zh-CN": "最多结果数" } },
    { "uid": "Search_ResetBtn", "attr": "ToolTipService.ToolTip", "en": "Reset all advanced filters",
      "t": { "de": "Alle erweiterten Filter zurücksetzen", "es": "Restablecer todos los filtros avanzados", "fr": "Réinitialiser tous les filtres avancés", "ja": "すべての詳細フィルターをリセット", "zh-CN": "重置所有高级筛选器" } },
    { "uid": "Search_ResetLabel", "attr": "Text", "en": "Reset",
      "t": { "de": "Zurücksetzen", "es": "Restablecer", "fr": "Réinitialiser", "ja": "リセット", "zh-CN": "重置" } },
    { "uid": "Search_CreatedAfterOverline", "attr": "Text", "en": "CREATED AFTER",
      "t": { "de": "ERSTELLT NACH", "es": "CREADO DESPUÉS DE", "fr": "CRÉÉ APRÈS", "ja": "作成日 (以降)", "zh-CN": "创建于之后" } },
    { "uid": "Search_CreatedAfterPicker", "attr": "PlaceholderText", "en": "Any date",
      "t": { "de": "Beliebiges Datum", "es": "Cualquier fecha", "fr": "Toute date", "ja": "任意の日付", "zh-CN": "任意日期" } },
    { "uid": "Search_CreatedBeforeOverline", "attr": "Text", "en": "CREATED BEFORE",
      "t": { "de": "ERSTELLT VOR", "es": "CREADO ANTES DE", "fr": "CRÉÉ AVANT", "ja": "作成日 (以前)", "zh-CN": "创建于之前" } },
    { "uid": "Search_CreatedBeforePicker", "attr": "PlaceholderText", "en": "Any date",
      "t": { "de": "Beliebiges Datum", "es": "Cualquier fecha", "fr": "Toute date", "ja": "任意の日付", "zh-CN": "任意日期" } },
    { "uid": "Search_SortRelevance", "attr": "Content", "en": "Relevance",
      "t": { "de": "Relevanz", "es": "Relevancia", "fr": "Pertinence", "ja": "関連度", "zh-CN": "相关性" } },
    { "uid": "Search_SortNewest", "attr": "Content", "en": "Newest First",
      "t": { "de": "Neueste zuerst", "es": "Más recientes primero", "fr": "Plus récents d'abord", "ja": "新しい順", "zh-CN": "最新优先" } },
    { "uid": "Search_SortOldest", "attr": "Content", "en": "Oldest First",
      "t": { "de": "Älteste zuerst", "es": "Más antiguos primero", "fr": "Plus anciens d'abord", "ja": "古い順", "zh-CN": "最早优先" } },
    { "uid": "Search_SortFileName", "attr": "Content", "en": "File Name",
      "t": { "de": "Dateiname", "es": "Nombre de archivo", "fr": "Nom de fichier", "ja": "ファイル名", "zh-CN": "文件名" } },
    { "uid": "Search_SaveFilterBtn", "attr": "ToolTipService.ToolTip", "en": "Save current search as a filter",
      "t": { "de": "Aktuelle Suche als Filter speichern", "es": "Guardar la búsqueda actual como filtro", "fr": "Enregistrer la recherche actuelle comme filtre", "ja": "現在の検索をフィルターとして保存", "zh-CN": "将当前搜索保存为筛选器" } },
    { "uid": "Search_SaveLabel", "attr": "Text", "en": "Save",
      "t": { "de": "Speichern", "es": "Guardar", "fr": "Enregistrer", "ja": "保存", "zh-CN": "保存" } },
    { "uid": "Search_ResultsRun", "attr": "Text", "en": "results",
      "t": { "de": "Ergebnisse", "es": "resultados", "fr": "résultats", "ja": "件の結果", "zh-CN": "条结果" } },
    { "uid": "Search_EmptyTitle", "attr": "Text", "en": "Search Your Documents",
      "t": { "de": "Durchsuchen Sie Ihre Dokumente", "es": "Busque en sus documentos", "fr": "Recherchez dans vos documents", "ja": "ドキュメントを検索しましょう", "zh-CN": "搜索您的文档" } },
    { "uid": "Search_EmptyBody", "attr": "Text", "en": "Search across your entire document library using natural language. Vector embeddings find semantically similar content even when the exact words differ.",
      "t": { "de": "Durchsuchen Sie Ihre gesamte Dokumentbibliothek in natürlicher Sprache. Vektor-Embeddings finden semantisch ähnliche Inhalte, selbst wenn die genauen Wörter abweichen.", "es": "Busque en toda su biblioteca de documentos con lenguaje natural. Los embeddings vectoriales encuentran contenido semánticamente similar aunque las palabras exactas difieran.", "fr": "Recherchez dans toute votre bibliothèque de documents en langage naturel. Les embeddings vectoriels trouvent du contenu sémantiquement similaire même lorsque les mots exacts diffèrent.", "ja": "自然言語でドキュメント ライブラリ全体を検索できます。ベクトル埋め込みにより、単語が完全に一致しなくても意味的に類似したコンテンツが見つかります。", "zh-CN": "使用自然语言搜索整个文档库。即使措辞不同,向量嵌入也能找到语义相似的内容。" } },
    { "uid": "Search_EnterToSearch", "attr": "Text", "en": "Enter to search",
      "t": { "de": "Enter zum Suchen", "es": "Enter para buscar", "fr": "Entrée pour rechercher", "ja": "Enter で検索", "zh-CN": "Enter 搜索" } },
    { "uid": "Search_SemanticAiBadge", "attr": "Text", "en": "Semantic AI Search",
      "t": { "de": "Semantische KI-Suche", "es": "Búsqueda semántica con IA", "fr": "Recherche sémantique par IA", "ja": "セマンティック AI 検索", "zh-CN": "语义 AI 搜索" } },
    { "uid": "Search_NoResultsTitle", "attr": "Text", "en": "No Results Found",
      "t": { "de": "Keine Ergebnisse gefunden", "es": "No se encontraron resultados", "fr": "Aucun résultat trouvé", "ja": "結果が見つかりません", "zh-CN": "未找到结果" } },
    { "uid": "Search_NoResultsPrefixRun", "attr": "Text", "en": "No results found for '",
      "t": { "de": "Keine Ergebnisse für '", "es": "No se encontraron resultados para '", "fr": "Aucun résultat pour « ", "ja": "「", "zh-CN": "未找到“" } },
    { "uid": "Search_NoResultsSuffixRun", "attr": "Text", "en": "'. Try different keywords or broaden your filters.",
      "t": { "de": "'. Versuchen Sie andere Suchbegriffe oder erweitern Sie Ihre Filter.", "es": "'. Pruebe con otras palabras clave o amplíe los filtros.", "fr": " ». Essayez d'autres mots-clés ou élargissez vos filtres.", "ja": "」の結果は見つかりませんでした。キーワードを変更するか、フィルターを広げてください。", "zh-CN": "”的相关结果。请尝试其他关键词或放宽筛选条件。" } },
    { "uid": "Search_ClearFiltersBtn", "attr": "Content", "en": "Clear Filters",
      "t": { "de": "Filter zurücksetzen", "es": "Borrar filtros", "fr": "Effacer les filtres", "ja": "フィルターをクリア", "zh-CN": "清除筛选器" } },
    { "uid": "Search_RelevanceLabel", "attr": "Text", "en": "Relevance",
      "t": { "de": "Relevanz", "es": "Relevancia", "fr": "Pertinence", "ja": "関連度", "zh-CN": "相关性" } },
    { "uid": "Search_PageRun", "attr": "Text", "en": "Page",
      "t": { "de": "Seite", "es": "Página", "fr": "Page", "ja": "ページ", "zh-CN": "页" } },
    { "uid": "Search_ChunkRun", "attr": "Text", "en": "Chunk",
      "t": { "de": "Abschnitt", "es": "Fragmento", "fr": "Fragment", "ja": "チャンク", "zh-CN": "块" } },
    { "uid": "Search_OpenBtn", "attr": "ToolTipService.ToolTip", "en": "Open in Explorer",
      "t": { "de": "Im Explorer öffnen", "es": "Abrir en el Explorador", "fr": "Ouvrir dans l'Explorateur", "ja": "エクスプローラーで開く", "zh-CN": "在文件资源管理器中打开" } },
    { "uid": "Search_OpenLabel", "attr": "Text", "en": "Open",
      "t": { "de": "Öffnen", "es": "Abrir", "fr": "Ouvrir", "ja": "開く", "zh-CN": "打开" } },
    { "uid": "Search_WorkflowBtn", "attr": "ToolTipService.ToolTip", "en": "Use this result in a workflow",
      "t": { "de": "Dieses Ergebnis in einem Workflow verwenden", "es": "Usar este resultado en un flujo de trabajo", "fr": "Utiliser ce résultat dans un flux de travail", "ja": "この結果をワークフローで使用", "zh-CN": "在工作流中使用此结果" } },
    { "uid": "Search_WorkflowLabel", "attr": "Text", "en": "Workflow",
      "t": { "de": "Workflow", "es": "Flujo de trabajo", "fr": "Flux de travail", "ja": "ワークフロー", "zh-CN": "工作流" } },
    { "uid": "Search_HistoryTitle", "attr": "Text", "en": "Search History",
      "t": { "de": "Suchverlauf", "es": "Historial de búsqueda", "fr": "Historique de recherche", "ja": "検索履歴", "zh-CN": "搜索历史" } },
    { "uid": "Search_ClearHistoryBtn", "attr": "ToolTipService.ToolTip", "en": "Clear search history",
      "t": { "de": "Suchverlauf löschen", "es": "Borrar historial de búsqueda", "fr": "Effacer l'historique de recherche", "ja": "検索履歴をクリア", "zh-CN": "清空搜索历史" } },
    { "uid": "Search_ClearHistoryLabel", "attr": "Text", "en": "Clear",
      "t": { "de": "Löschen", "es": "Borrar", "fr": "Effacer", "ja": "クリア", "zh-CN": "清空" } },
    { "uid": "Search_HistoryResultsRun", "attr": "Text", "en": "results",
      "t": { "de": "Ergebnisse", "es": "resultados", "fr": "résultats", "ja": "件の結果", "zh-CN": "条结果" } },
    { "uid": "Search_SavedFiltersTitle", "attr": "Text", "en": "Saved Filters",
      "t": { "de": "Gespeicherte Filter", "es": "Filtros guardados", "fr": "Filtres enregistrés", "ja": "保存済みフィルター", "zh-CN": "已保存的筛选器" } },
    { "uid": "Search_ApplyFilterBtn", "attr": "ToolTipService.ToolTip", "en": "Apply this filter",
      "t": { "de": "Diesen Filter anwenden", "es": "Aplicar este filtro", "fr": "Appliquer ce filtre", "ja": "このフィルターを適用", "zh-CN": "应用此筛选器" } },
    { "uid": "Search_ApplyFilterBtn", "attr": "AutomationProperties.Name", "en": "Apply this filter", "skipUid": true,
      "t": { "de": "Diesen Filter anwenden", "es": "Aplicar este filtro", "fr": "Appliquer ce filtre", "ja": "このフィルターを適用", "zh-CN": "应用此筛选器" } },
    { "uid": "Search_RemoveFilterBtn", "attr": "ToolTipService.ToolTip", "en": "Remove saved filter",
      "t": { "de": "Gespeicherten Filter entfernen", "es": "Eliminar filtro guardado", "fr": "Supprimer le filtre enregistré", "ja": "保存済みフィルターを削除", "zh-CN": "删除已保存的筛选器" } },
    { "uid": "Search_RemoveFilterBtn", "attr": "AutomationProperties.Name", "en": "Remove saved filter", "skipUid": true,
      "t": { "de": "Gespeicherten Filter entfernen", "es": "Eliminar filtro guardado", "fr": "Supprimer le filtre enregistré", "ja": "保存済みフィルターを削除", "zh-CN": "删除已保存的筛选器" } },
    { "uid": "Search_RecentSearchesRun", "attr": "Text", "en": "recent searches",
      "t": { "de": "letzte Suchvorgänge", "es": "búsquedas recientes", "fr": "recherches récentes", "ja": "件の最近の検索", "zh-CN": "条最近搜索" } }
  ]
}
