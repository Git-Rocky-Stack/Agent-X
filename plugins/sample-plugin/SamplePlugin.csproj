<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>AgentX.Plugins.Sample</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Produces a deps.json the host's plugin loader reads to resolve private dependencies. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!--
    AgentX.Core and Serilog are provided by the host at run time. They are referenced for
    compilation only (Private=false, ExcludeAssets) so the build output, and so the
    .agentx-plugin package, never carries its own AgentX.Core.dll or Serilog.dll, nor the
    host's native libraries. A second AgentX.Core would give the plugin a different IPlugin
    type than the host's.
  -->
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.0.2">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentX.Core\AgentX.Core.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime;native;contentfiles;build;buildtransitive</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- The package needs manifest.json at its root, so it travels with the build output. -->
  <ItemGroup>
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
