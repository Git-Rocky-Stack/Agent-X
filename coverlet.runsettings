<?xml version="1.0" encoding="utf-8"?>
<!--
  AX-QA-009: coverage collection settings for the `dotnet test` run that collects "XPlat Code
  Coverage" and feeds the coverage gate (see .github/workflows/build-test.yml + scripts/check-coverage.ps1).

  The coverage gate measures *authored* AgentX.Core code, not generated scaffolding. The raw
  audit figure (46.43% line / 33.15% branch) was deflated because the cobertura report counted
  code that no test can meaningfully exercise:

    - Source-generated members ([GeneratedCode]): the source-gen regex engine and the
      CommunityToolkit.Mvvm [ObservableProperty]/[RelayCommand] plumbing.
    - Explicit opt-outs ([ExcludeFromCodeCoverage]).
    - EF Core migration scaffolds (Data/Migrations/*.cs + *.Designer.cs): generated by
      `dotnet ef migrations add`. The *runner* that applies them (Data/MigrationRunner) IS
      measured and carries an elevated coverage floor; the scaffolds themselves are not authored.

  We deliberately do NOT exclude [CompilerGenerated]: coverlet maps async state machines,
  iterators, and lambda closures back to their authored source lines, so excluding that attribute
  would silently drop real async/LINQ logic from the denominator. Keeping it in keeps the number
  honest about the code the team actually wrote.

  Excluding the generated scaffolding yields an honest denominator so the gate reflects code the
  team actually writes and can test. IncludeTestAssembly stays false (the default) so the
  AgentX.Tests.dll assembly — which also
  hosts the linked WinUI ViewModels — is not self-counted; the gate scopes to AgentX.Core, exactly
  as AX-QA-009 frames it ("Core coverage").
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Authored code only: drop [GeneratedCode] and explicit [ExcludeFromCodeCoverage].
               [CompilerGenerated] is intentionally NOT excluded (see header) so async/lambda
               bodies, which coverlet maps back to source, remain measured. -->
          <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <!-- EF migration scaffolds + any *.Designer.cs + build output are generated, not authored. -->
          <ExcludeByFile>**/Data/Migrations/*.cs,**/*.Designer.cs,**/obj/**/*.cs</ExcludeByFile>
          <!-- Belt-and-suspenders: the source-generated regex engine lives in a Generated namespace. -->
          <Exclude>[*]System.Text.RegularExpressions.Generated.*</Exclude>
          <SingleHit>false</SingleHit>
          <UseSourceLink>false</UseSourceLink>
          <IncludeTestAssembly>false</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
