<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>AgentX.Tests</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.7" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.6" />
    <!-- Wave 3c: real ConfigurationBuilder + Options DI for the prompt-catalog
         end-to-end test. Versions match Microsoft.Extensions.Hosting in App. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <!-- Runtime-skippable facts: the JS-rendering integration tests run when a Playwright
         browser is installed (CI installs it) and skip gracefully otherwise, so a developer
         machine without `playwright install` still gets a green suite. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- NAudio required by VoiceCoordinator linked source -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentX.Core\AgentX.Core.csproj" />
    <!-- QuickChatViewModel is linked from AgentX.App because the WinUI 3 app project
         cannot be referenced directly (WindowsAppSDKSelfContained requires a RID). -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\QuickChatViewModel.cs" Link="ViewModels\QuickChatViewModel.cs" />
    <!-- LocalizationService is linked (same WinUI 3 RID constraint). The A1
         IResourceLoaderAdapter seam means the service itself has no Windows.*
         dependencies, so linking compiles cleanly against AgentX.Core alone.
         AppSettingsExtended travels with the file (same compilation unit). -->
    <Compile Include="..\..\src\AgentX.App\Services\LocalizationService.cs" Link="Services\LocalizationService.cs" />
    <!-- CommandPaletteViewModel depends only on AgentX.Core.Services.Shortcuts
         and CommunityToolkit.Mvvm — no Windows.* deps — so it links cleanly. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\CommandPaletteViewModel.cs" Link="ViewModels\CommandPaletteViewModel.cs" />
    <!-- JumpToViewModel follows the same pure-VM shape as CommandPaletteViewModel. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\JumpToViewModel.cs" Link="ViewModels\JumpToViewModel.cs" />
    <!-- CheatsheetViewModel is pure registry grouping logic; link it for A2 unit tests. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\CheatsheetViewModel.cs" Link="ViewModels\CheatsheetViewModel.cs" />
    <!-- ComparisonViewModel is pure orchestration/state logic; link it for Phase 5 UI sync tests. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\ComparisonViewModel.cs" Link="ViewModels\ComparisonViewModel.cs" />
    <!-- AnalyticsViewModel is pure orchestration/state logic over core services; link it for persistent intelligence UI tests. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\AnalyticsViewModel.cs" Link="ViewModels\AnalyticsViewModel.cs" />
    <!-- DashboardViewModel is pure orchestration/state logic; link it for dashboard cohesion tests. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\DashboardViewModel.cs" Link="ViewModels\DashboardViewModel.cs" />
    <Compile Include="..\..\src\AgentX.App\ViewModels\OperationsViewModel.cs" Link="ViewModels\OperationsViewModel.cs" />
    <Compile Include="..\..\src\AgentX.App\ViewModels\QuickActionsViewModel.cs" Link="ViewModels\QuickActionsViewModel.cs" />
    <!-- InboxViewModel is pure inbox orchestration/state logic. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\InboxViewModel.cs" Link="ViewModels\InboxViewModel.cs" />
    <!-- AnnotationsViewModel is pure annotation orchestration/state logic. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\AnnotationsViewModel.cs" Link="ViewModels\AnnotationsViewModel.cs" />
    <!-- KnowledgeVaultViewModel is pure document-orchestration logic aside from an App.GetService seam stubbed in tests. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\KnowledgeVaultViewModel.cs" Link="ViewModels\KnowledgeVaultViewModel.cs" />
    <!-- SearchViewModel is pure search orchestration/state logic. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\SearchViewModel.cs" Link="ViewModels\SearchViewModel.cs" />
    <!-- PluginManagerViewModel is pure plugin-orchestration logic with no WinUI dependencies. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\PluginManagerViewModel.cs" Link="ViewModels\PluginManagerViewModel.cs" />
    <!-- WorkspaceProfileViewModel is pure workspace-profile orchestration/state logic. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\WorkspaceProfileViewModel.cs" Link="ViewModels\WorkspaceProfileViewModel.cs" />
    <!-- WorkflowBuilderViewModel is pure workflow orchestration/state logic. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\WorkflowBuilderViewModel.cs" Link="ViewModels\WorkflowBuilderViewModel.cs" />
    <!-- ChatViewModel is linked for context-inspector state tests; test stubs cover the small remaining window seam. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\ChatViewModel.cs" Link="ViewModels\ChatViewModel.cs" />
    <Compile Include="..\..\src\AgentX.App\ViewModels\ChatMessageItem.cs" Link="ViewModels\ChatMessageItem.cs" />
    <Compile Include="..\..\src\AgentX.App\ViewModels\ConversationListItem.cs" Link="ViewModels\ConversationListItem.cs" />
    <Compile Include="..\..\src\AgentX.App\ViewModels\SystemPromptItem.cs" Link="ViewModels\SystemPromptItem.cs" />
    <!-- SyncSettingsViewModel is pure sync orchestration/state logic; link it for selected-scope UI tests. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\SyncSettingsViewModel.cs" Link="ViewModels\SyncSettingsViewModel.cs" />
    <Compile Include="..\..\src\AgentX.App\ViewModels\CalendarSettingsViewModel.cs" Link="ViewModels\CalendarSettingsViewModel.cs" />
    <Compile Include="..\..\src\AgentX.App\ViewModels\EmailSettingsViewModel.cs" Link="ViewModels\EmailSettingsViewModel.cs" />
    <Compile Include="..\..\src\AgentX.App\ViewModels\Sync\SyncLogDisplayItem.cs" Link="ViewModels\Sync\SyncLogDisplayItem.cs" />
    <Compile Include="..\..\src\AgentX.App\ViewModels\Sync\SyncHistoryItem.cs" Link="ViewModels\Sync\SyncHistoryItem.cs" />
    <!-- ShortcutInputRouter dispatch core is pure; WinUI attach lives in a separate file. -->
    <Compile Include="..\..\src\AgentX.App\Services\ShortcutInputRouter.cs" Link="Services\ShortcutInputRouter.cs" />
    <!-- ShortcutRegistrationExtensions is pure registry composition for page-scoped shortcuts. -->
    <Compile Include="..\..\src\AgentX.App\Helpers\ShortcutRegistrationExtensions.cs" Link="Helpers\ShortcutRegistrationExtensions.cs" />
    <!-- ShortcutCatalog is pure global shortcut seeding logic. -->
    <Compile Include="..\..\src\AgentX.App\Services\ShortcutCatalog.cs" Link="Services\ShortcutCatalog.cs" />
    <!-- Coordinators: pure service-orchestration logic with no WinUI dependencies. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\Coordinators\IConversationCoordinator.cs" Link="ViewModels\Coordinators\IConversationCoordinator.cs" />
    <Compile Include="..\..\src\AgentX.App\ViewModels\Coordinators\ConversationCoordinator.cs" Link="ViewModels\Coordinators\ConversationCoordinator.cs" />
    <Compile Include="..\..\src\AgentX.App\ViewModels\Coordinators\IMessagingCoordinator.cs" Link="ViewModels\Coordinators\IMessagingCoordinator.cs" />
    <Compile Include="..\..\src\AgentX.App\ViewModels\Coordinators\MessagingCoordinator.cs" Link="ViewModels\Coordinators\MessagingCoordinator.cs" />
    <Compile Include="..\..\src\AgentX.App\ViewModels\Coordinators\IVoiceCoordinator.cs" Link="ViewModels\Coordinators\IVoiceCoordinator.cs" />
    <Compile Include="..\..\src\AgentX.App\ViewModels\Coordinators\VoiceCoordinator.cs" Link="ViewModels\Coordinators\VoiceCoordinator.cs" />
    <Compile Include="..\..\src\AgentX.App\ViewModels\Coordinators\IBranchingCoordinator.cs" Link="ViewModels\Coordinators\IBranchingCoordinator.cs" />
    <Compile Include="..\..\src\AgentX.App\ViewModels\Coordinators\BranchingCoordinator.cs" Link="ViewModels\Coordinators\BranchingCoordinator.cs" />
    <!-- StatusBarService is pure (no WinUI deps) — uses IServiceProvider and Core services only. -->
    <Compile Include="..\..\src\AgentX.App\Services\IStatusBarService.cs" Link="Services\IStatusBarService.cs" />
    <Compile Include="..\..\src\AgentX.App\Services\StatusBarService.cs" Link="Services\StatusBarService.cs" />
    <Compile Include="..\..\src\AgentX.App\Services\NotificationService.cs" Link="Services\NotificationService.cs" />
    <Compile Include="..\..\src\AgentX.App\Services\IApiHostLifecycleService.cs" Link="Services\IApiHostLifecycleService.cs" />
    <Compile Include="..\..\src\AgentX.App\Services\ApiHostLifecycleService.cs" Link="Services\ApiHostLifecycleService.cs" />
    <Compile Include="..\..\src\AgentX.App\Services\IBuiltinConnectorLifecycleService.cs" Link="Services\IBuiltinConnectorLifecycleService.cs" />
    <Compile Include="..\..\src\AgentX.App\Services\BuiltinConnectorLifecycleService.cs" Link="Services\BuiltinConnectorLifecycleService.cs" />
    <!-- StartupOrchestrator is the pure, awaitable critical-startup sequence (AX-QA-003). It depends
         only on IMigrationRunner + the two lifecycle interfaces + Serilog (no WinUI), so it links
         cleanly for ordering / fail-closed unit tests. -->
    <Compile Include="..\..\src\AgentX.App\Services\StartupOrchestrator.cs" Link="Services\StartupOrchestrator.cs" />
    <!-- StartupGate is the WinUI-free data-ready signal the orchestrator opens after migration and
         DashboardViewModel awaits before reading the DB (AX-QA-003 follow-up: dashboard race). -->
    <Compile Include="..\..\src\AgentX.App\Services\StartupGate.cs" Link="Services\StartupGate.cs" />
    <Compile Include="..\..\src\AgentX.App\Services\IOperationsActionService.cs" Link="Services\IOperationsActionService.cs" />
    <Compile Include="..\..\src\AgentX.App\Services\IOperationsDrillInService.cs" Link="Services\IOperationsDrillInService.cs" />
    <Compile Include="..\..\src\AgentX.App\Services\OperationsActionService.cs" Link="Services\OperationsActionService.cs" />
    <Compile Include="..\..\src\AgentX.App\Services\OperationsDrillInService.cs" Link="Services\OperationsDrillInService.cs" />
    <Compile Include="..\..\src\AgentX.App\Services\IOperationsOverviewService.cs" Link="Services\IOperationsOverviewService.cs" />
    <Compile Include="..\..\src\AgentX.App\Services\OperationsOverviewModels.cs" Link="Services\OperationsOverviewModels.cs" />
    <Compile Include="..\..\src\AgentX.App\Services\OperationsOverviewService.cs" Link="Services\OperationsOverviewService.cs" />
    <Compile Include="..\..\src\AgentX.App\Services\IWorkflowLaunchService.cs" Link="Services\IWorkflowLaunchService.cs" />
    <Compile Include="..\..\src\AgentX.App\Services\WorkflowLaunchRequest.cs" Link="Services\WorkflowLaunchRequest.cs" />
    <Compile Include="..\..\src\AgentX.App\Helpers\MarkdownParser.cs" Link="Helpers\MarkdownParser.cs" />
    <Compile Include="..\..\src\AgentX.App\Helpers\StatusToneResolver.cs" Link="Helpers\StatusToneResolver.cs" />
    <!-- UserGuideViewModel is pure (no WinUI deps) — only ObservableCollection and Models. -->
    <Compile Include="..\..\src\AgentX.App\ViewModels\UserGuideViewModel.cs" Link="ViewModels\UserGuideViewModel.cs" />
    <Compile Include="..\..\src\AgentX.App\Models\UserGuideSection.cs" Link="Models\UserGuideSection.cs" />
  </ItemGroup>
</Project>
